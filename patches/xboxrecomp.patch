+static uint64_t now_ms(void)
+{
+    LARGE_INTEGER f, c;
+    if (s_test_now) return s_test_now;
+    QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&c);
+    return (uint64_t)(c.QuadPart * 1000 / f.QuadPart) + 1;
+}
