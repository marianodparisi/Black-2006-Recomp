+
+    for (i = 0; i < sizeof(map) / sizeof(map[0]); i++) {
+        if (strlen(map[i].name) == n && !_strnicmp(map[i].name, name, n)) {
+            if (map[i].stick >= 0)
+                p->sticks |= (uint8_t)(1u << map[i].stick);
+            else if (map[i].analog >= 0)
+                p->analog |= (uint8_t)(1u << map[i].analog);
