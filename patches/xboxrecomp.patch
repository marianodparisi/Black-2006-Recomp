+#define MIN(a, b) ((a) < (b) ? (a) : (b))
+#define DSP_SPACE_X 0
+#define DSP_SPACE_Y 1
+#define DSP_SPACE_P 2
+
+#ifdef DEBUG
+
+const char *buffer_names[] = {
+    "fifo0",            /* 0x0 */
+    "fifo1",            /* 0x1 */
+    "fifo2",            /* 0x2 */
+    "fifo3",            /* 0x3 */
+    "<unknown-0x4>",    /* 0x4 */
+    "<unknown-0x5>",    /* 0x5 */
+    "<unknown-0x6>",    /* 0x6 */
+    "<unknown-0x7>",    /* 0x7 */
+    "<unknown-0x8>",    /* 0x8 */
+    "<unknown-0x9>",    /* 0x9 */
+    "<unknown-0xa>",    /* 0xA */
+    "<unknown-0xb>",    /* 0xB */
+    "<unknown-0xc>",    /* 0xC */
+    "<unknown-0xd>",    /* 0xD */
+    "scratch-circular", /* 0xE */
+    "scratch"           /* 0xF */
