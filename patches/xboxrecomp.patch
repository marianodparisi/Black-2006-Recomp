+        if (*q == '/')
+            p->hold_ms = (uint32_t)strtoul(q + 1, (char **)&q, 10);
+        if (*q == '*')
+            p->period_ms = (uint32_t)strtoul(q + 1, (char **)&q, 10);
+        s_script_n++;
+        e = (*q == ',') ? q + 1 : NULL;
