+/* ---- tests -------------------------------------------------------------------------------------------------------------- */
+
+void pc_input_test_reset(void)
+{
+    int i;
+    pc_input_init();                 /* consume the once-only init, then start from a clean slate */
+    clear_state(0);
+    for (i = 0; i < PC_ACTION_COUNT; i++) s_bindings[i].count = 0;
+    s_resolver = NULL;
+    s_movie_active = NULL;
+    s_gameplay_blocked_query = NULL;
