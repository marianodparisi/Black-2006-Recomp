+PcMode pc_input_input_mode(void) { pc_input_init(); return s_input_mode; }
+PcMode pc_input_prompt_mode(void) { pc_input_init(); return s_prompt_mode; }
+
+int pc_input_trace_enabled(void) { pc_input_init(); return s_trace; }
