+            KELVIN_DPRINTF("Begin without End!\n");
+            return;
+        }
+        KELVIN_ASSERT(parameter <= NV097_SET_BEGIN_END_OP_POLYGON);
+        pg->primitive_mode = parameter;
+        pgraph_reset_inline_buffers(pg);
+        kelvin_render_draw_begin(pg);
