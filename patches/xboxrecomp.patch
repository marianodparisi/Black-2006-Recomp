diff --git a/src/video/pc_video.c b/src/video/pc_video.c
new file mode 100644
index 0000000..b7b77eb
--- /dev/null
+++ b/src/video/pc_video.c
@@ -0,0 +1,610 @@
+/* PC video settings: defaults, settings file, environment overrides. See pc_video.h. */
+#include "pc_video.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <ctype.h>
+#include <math.h>
+#if defined(_WIN32)
+#include <windows.h>
+#endif
+
+const unsigned pc_video_internal_heights[] = { 480, 720, 1080, 1440, 2160 };
+const unsigned pc_video_internal_height_count = 5;
+const unsigned pc_video_fps_limits[] = { 0, 30, 60, 120, 144, 165, 240 };
+const unsigned pc_video_fps_limit_count = 7;
+const unsigned pc_video_af_levels[] = { 1, 2, 4, 8, 16 };
+const unsigned pc_video_af_level_count = 5;
+
+#define PCV_MAX_PIXELS 16777216u
+
+#if defined(_WIN32)
+static INIT_ONCE s_once = INIT_ONCE_STATIC_INIT;
+static SRWLOCK s_lock = SRWLOCK_INIT;
+static volatile LONG s_generation, s_aspect, s_fov_milli, s_blur_off;
+#else
+static int s_once_done;
+static unsigned s_generation, s_aspect, s_fov_milli, s_blur_off;
+#endif
+static PcVideoSettings s_cur, s_file;    /* what is in force; what the settings file holds */
+static unsigned s_locked;
+static char s_path[512];
+static PcVideoResizeHook s_resize_hook;
+
+void pc_video_defaults(PcVideoSettings *s)
+{
+    memset(s, 0, sizeof(*s));
+    s->internal_height = 720;
+    s->window_width = 1280; s->window_height = 960;
+    s->scale = PCV_SCALE_FIT;
+    s->vsync = 1;
+    s->aspect = PCV_ASPECT_ORIGINAL;
+    s->aa = PCV_AA_FXAA;
+    s->af = 16;
+    s->dof = PCV_STEP_OFF;
+    s->sharpen = PCV_STEP_OFF;
+    s->ao_method = PCV_AO_OFF;
+    s->ao_quality = PCV_AOQ_HIGH;
+}
+
+static int in_list(const unsigned *list, unsigned count, unsigned v)
+{
+    unsigned i;
+    for (i = 0; i < count; i++) if (list[i] == v) return 1;
+    return 0;
+}
+static int valid_fov(double f) { return f == 0.0 || (isfinite(f) && f >= 35.0 && f <= 100.0); }
+
+const char *pc_video_aspect_name(unsigned a)
+{
+    static const char *const names[PCV_ASPECT_COUNT] = { "original", "4:3", "16:9", "21:9", "32:9" };
+    return a < PCV_ASPECT_COUNT ? names[a] : names[0];
+}
+static int aspect_from_name(const char *t)
+{
+    unsigned a;
+    for (a = 0; a < PCV_ASPECT_COUNT; a++) if (!_stricmp(t, pc_video_aspect_name(a))) return (int)a;
+    return -1;
+}
+
+static const char *const k_aa_names[PCV_AA_COUNT] = { "off", "fxaa", "ssaa" };
+static const char *const k_step_names[PCV_STEP_COUNT] = { "off", "low", "medium", "high" };
+static const char *const k_ao_names[PCV_AO_COUNT] = { "off", "ssao", "hbao", "hbao_plus", "gtao" };
+static const char *const k_ao_quality_names[PCV_AOQ_COUNT] = { "low", "medium", "high", "ultra" };
+static int name_index(const char *const *names, unsigned count, const char *t)
+{
+    unsigned i;
+    for (i = 0; i < count; i++) if (!_stricmp(t, names[i])) return (int)i;
+    return -1;
+}
+
+void pc_video_aspect_ratio(unsigned aspect, unsigned *num, unsigned *den)
+{
+    static const unsigned n[PCV_ASPECT_COUNT] = { 0, 4, 16, 21, 32 }, d[PCV_ASPECT_COUNT] = { 0, 3, 9, 9, 9 };
+    if (aspect >= PCV_ASPECT_COUNT) aspect = PCV_ASPECT_ORIGINAL;
+    *num = n[aspect]; *den = d[aspect];
+}
+
+void pc_video_render_size_for(const PcVideoSettings *s, unsigned *w, unsigned *h)
+{
+    unsigned num, den, width, height;
+    if (s->render_override_w && s->render_override_h) { *w = s->render_override_w; *h = s->render_override_h; return; }
+    pc_video_aspect_ratio(s->aspect, &num, &den);
+    if (!num) { num = 4; den = 3; }               /* the game's own camera is 4:3 */
+    height = s->internal_height;
+    width = (unsigned)(((uint64_t)height * num + den / 2) / den);
+    width = (width + 1u) & ~1u;
+    if (width < 640) width = 640;
+    if (height < 480) height = 480;
+    *w = width; *h = height;
+}
+
+unsigned pc_video_ssaa_factor_for(const PcVideoSettings *s)
+{
+    unsigned w, h;
+    if (s->aa != PCV_AA_SSAA || (s->render_override_w && s->render_override_h)) return 1;
+    pc_video_render_size_for(s, &w, &h);
+    if (w * 2u > 8192u || h * 2u > 8192u || (uint64_t)w * 2u * h * 2u > PCV_MAX_PIXELS) return 1;
+    return 2;
+}
+
+void pc_video_raster_size_for(const PcVideoSettings *s, unsigned *w, unsigned *h)
+{
+    const unsigned f = pc_video_ssaa_factor_for(s);
+    pc_video_render_size_for(s, w, h);
+    *w *= f; *h *= f;
+}
+
+/* ---- the settings file ------------------------------------------------------------------------------- */
+
+static char *trim(char *p)
+{
+    char *e;
+    while (*p && isspace((unsigned char)*p)) p++;
+    e = p + strlen(p);
+    while (e > p && isspace((unsigned char)e[-1])) *--e = 0;
+    return p;
+}
+
+static int parse_uint(const char *t, unsigned lo, unsigned hi, unsigned *out)
+{
+    char *end;
+    unsigned long v;
+    if (!t || !*t || !isdigit((unsigned char)*t)) return 0;
+    v = strtoul(t, &end, 10);
+    if (*end || v < lo || v > hi) return 0;
+    *out = (unsigned)v;
+    return 1;
+}
+
+static int apply_key(PcVideoSettings *s, const char *key, const char *value)
+{
+    unsigned u;
+    if (!_stricmp(key, "internal_height")) {
+        if (parse_uint(value, 1, 100000, &u) && in_list(pc_video_internal_heights, pc_video_internal_height_count, u)) { s->internal_height = u; return 1; }
+    } else if (!_stricmp(key, "window_width")) {
+        if (parse_uint(value, 320, 7680, &u)) { s->window_width = u; return 1; }
+    } else if (!_stricmp(key, "window_height")) {
+        if (parse_uint(value, 240, 4320, &u)) { s->window_height = u; return 1; }
+    } else if (!_stricmp(key, "window_mode")) {
+        if (!_stricmp(value, "borderless")) { s->borderless = 1; return 1; }
+        if (!_stricmp(value, "windowed")) { s->borderless = 0; return 1; }
+    } else if (!_stricmp(key, "scale")) {
+        if (!_stricmp(value, "fit")) { s->scale = PCV_SCALE_FIT; return 1; }
+        if (!_stricmp(value, "stretch")) { s->scale = PCV_SCALE_STRETCH; return 1; }
+        if (!_stricmp(value, "integer")) { s->scale = PCV_SCALE_INTEGER; return 1; }
+    } else if (!_stricmp(key, "filter")) {
+        if (!_stricmp(value, "nearest")) { s->nearest = 1; return 1; }
+        if (!_stricmp(value, "linear")) { s->nearest = 0; return 1; }
+    } else if (!_stricmp(key, "vsync")) {
+        if (parse_uint(value, 0, 1, &u)) { s->vsync = u; return 1; }
+    } else if (!_stricmp(key, "fps_limit")) {
+        if (parse_uint(value, 0, 1000, &u) && in_list(pc_video_fps_limits, pc_video_fps_limit_count, u)) { s->fps_limit = u; return 1; }
+    } else if (!_stricmp(key, "aspect")) {
+        int a = aspect_from_name(value);
+        if (a >= 0) { s->aspect = (unsigned)a; return 1; }
+    } else if (!_stricmp(key, "fov")) {
+        char *end;
+        double f = strtod(value, &end);
+        if (end != value && !*end && valid_fov(f)) { s->fov = f; return 1; }
+    } else if (!_stricmp(key, "motion_blur")) {
+        if (!_stricmp(value, "off")) { s->motion_blur_off = 1; return 1; }
+        if (!_stricmp(value, "original")) { s->motion_blur_off = 0; return 1; }
+    } else if (!_stricmp(key, "action_blur")) {
+        if (!_stricmp(value, "off")) { s->action_blur_off = 1; return 1; }
+        if (!_stricmp(value, "original")) { s->action_blur_off = 0; return 1; }
+    } else if (!_stricmp(key, "aa")) {
+        int a = name_index(k_aa_names, PCV_AA_COUNT, value);
+        if (a >= 0) { s->aa = (unsigned)a; return 1; }
+    } else if (!_stricmp(key, "af")) {
+        if (parse_uint(value, 1, 64, &u) && in_list(pc_video_af_levels, pc_video_af_level_count, u)) { s->af = u; return 1; }
+    } else if (!_stricmp(key, "dof")) {
+        int a = name_index(k_step_names, PCV_STEP_COUNT, value);
+        if (a >= 0) { s->dof = (unsigned)a; return 1; }
+    } else if (!_stricmp(key, "sharpen")) {
+        int a = name_index(k_step_names, PCV_STEP_COUNT, value);
+        if (a >= 0) { s->sharpen = (unsigned)a; return 1; }
+    } else if (!_stricmp(key, "ao_method")) {
+        int a = name_index(k_ao_names, PCV_AO_COUNT, value);
+        if (a >= 0) { s->ao_method = (unsigned)a; return 1; }
+    } else if (!_stricmp(key, "ao_quality")) {
+        int a = name_index(k_ao_quality_names, PCV_AOQ_COUNT, value);
+        if (a >= 0) { s->ao_quality = (unsigned)a; return 1; }
+    } else if (!_stricmp(key, "ssao")) {
+        /* The original single SSAO setting combined method and quality. */
+        int a = name_index(k_ao_quality_names, PCV_AOQ_COUNT, value);
+        if (!_stricmp(value, "off")) { s->ao_method = PCV_AO_OFF; return 1; }
+        if (a >= 0) { s->ao_method = PCV_AO_SSAO; s->ao_quality = (unsigned)a; return 1; }
+    }
+    return 0;
+}
+
+int pc_video_parse(const char *text, PcVideoSettings *inout)
+{
+    char line[256];
+    int applied = 0;
+    const char *p = text;
+    while (p && *p) {
+        size_t n = strcspn(p, "\r\n");
+        char *eq, *key, *value;
+        if (n >= sizeof(line)) n = sizeof(line) - 1;
+        memcpy(line, p, n); line[n] = 0;
+        p += strcspn(p, "\r\n");
+        while (*p == '\r' || *p == '\n') p++;
+        key = trim(line);
+        if (!*key || *key == ';' || *key == '#' || *key == '[') continue;
+        eq = strchr(key, '=');
+        if (!eq) continue;
+        *eq = 0;
+        value = trim(eq + 1);
+        key = trim(key);
+        applied += apply_key(inout, key, value);
+    }
+    return applied;
+}
+
+size_t pc_video_format(const PcVideoSettings *s, char *out, size_t cap)
+{
+    int n = snprintf(out, cap,
+        "; BLACK video settings. Edited by the in-game Video Settings page and by the launcher.\n"
+        "[video]\n"
+        "internal_height=%u\n"
+        "window_width=%u\n"
+        "window_height=%u\n"
+        "window_mode=%s\n"
+        "scale=%s\n"
+        "filter=%s\n"
+        "vsync=%u\n"
+        "fps_limit=%u\n"
+        "aspect=%s\n"
+        "fov=%g\n"
+        "motion_blur=%s\n"
+        "action_blur=%s\n"
+        "aa=%s\n"
+        "af=%u\n"
+        "dof=%s\n"
+        "sharpen=%s\n"
+        "ao_method=%s\n"
+        "ao_quality=%s\n",
+        s->internal_height, s->window_width, s->window_height,
+        s->borderless ? "borderless" : "windowed",
+        s->scale == PCV_SCALE_STRETCH ? "stretch" : s->scale == PCV_SCALE_INTEGER ? "integer" : "fit",
+        s->nearest ? "nearest" : "linear", s->vsync ? 1u : 0u, s->fps_limit,
+        pc_video_aspect_name(s->aspect), s->fov, s->motion_blur_off ? "off" : "original",
+        s->action_blur_off ? "off" : "original",
+        k_aa_names[s->aa < PCV_AA_COUNT ? s->aa : 0], s->af, k_step_names[s->dof < PCV_STEP_COUNT ? s->dof : 0],
+        k_step_names[s->sharpen < PCV_STEP_COUNT ? s->sharpen : 0],
+        k_ao_names[s->ao_method < PCV_AO_COUNT ? s->ao_method : PCV_AO_OFF],
+        k_ao_quality_names[s->ao_quality < PCV_AOQ_COUNT ? s->ao_quality : PCV_AOQ_HIGH]);
+    return n < 0 ? 0 : (size_t)n;
+}
+
+#if defined(_WIN32)
+static void save_file(const PcVideoSettings *s)
+{
+    char text[1024], tmp[sizeof(s_path) + 8], dir[sizeof(s_path)], *slash;
+    size_t n = pc_video_format(s, text, sizeof(text));
+    FILE *f;
+    if (!n || n >= sizeof(text) || !s_path[0]) return;
+    snprintf(dir, sizeof(dir), "%s", s_path);
+    slash = strrchr(dir, '\\'); if (!slash) slash = strrchr(dir, '/');
+    if (slash) { *slash = 0; CreateDirectoryA(dir, NULL); }
+    snprintf(tmp, sizeof(tmp), "%s.tmp", s_path);
+    f = fopen(tmp, "wb");
+    if (!f) { fprintf(stderr, "[VIDEO] cannot write %s\n", tmp); return; }
+    if (fwrite(text, 1, n, f) != n) { fclose(f); DeleteFileA(tmp); return; }
+    if (fclose(f) != 0) { DeleteFileA(tmp); return; }
+    if (!MoveFileExA(tmp, s_path, MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH))
+        fprintf(stderr, "[VIDEO] cannot replace %s: %lu\n", s_path, GetLastError());
+}
+#else
+static void save_file(const PcVideoSettings *s) { (void)s; }
+#endif
+
+static int load_file(PcVideoSettings *s)
+{
+    FILE *f = fopen(s_path, "rb");
+    char text[4096];
+    size_t n;
+    if (!f) return -1;
+    n = fread(text, 1, sizeof(text) - 1, f);
+    fclose(f);
+    text[n] = 0;
+    return pc_video_parse(text, s);
+}
+
+/* ---- the environment --------------------------------------------------------------------------------- */
+
+static const char *env_text(const char *name)
+{
+    const char *v = getenv(name);
+    return v && *v ? v : NULL;
+}
+
+static unsigned apply_environment(PcVideoSettings *s)
+{
+    unsigned lock = 0, u;
+    const char *w = env_text("RECOMP_WINDOW_WIDTH"), *h = env_text("RECOMP_WINDOW_HEIGHT"), *t;
+    if (w || h) {
+        lock |= PCV_LOCK_WINDOW_SIZE;
+        if (!(w && parse_uint(w, 320, 7680, &s->window_width))) { if (w) s->window_width = 1280; }
+        if (!(h && parse_uint(h, 240, 4320, &s->window_height))) { if (h) s->window_height = 960; }
+    }
+    if ((t = env_text("RECOMP_WINDOW_MODE")) != NULL) { lock |= PCV_LOCK_WINDOW_MODE; s->borderless = !strcmp(t, "borderless"); }
+    if ((t = env_text("RECOMP_SCALE_MODE")) != NULL) {
+        lock |= PCV_LOCK_SCALE;
+        s->scale = !strcmp(t, "stretch") ? PCV_SCALE_STRETCH : !strcmp(t, "integer") ? PCV_SCALE_INTEGER : PCV_SCALE_FIT;
+    }
+    if ((t = env_text("RECOMP_PRESENT_FILTER")) != NULL) { lock |= PCV_LOCK_FILTER; s->nearest = !strcmp(t, "nearest"); }
+    if ((t = env_text("RECOMP_VSYNC")) != NULL) { lock |= PCV_LOCK_VSYNC; s->vsync = strcmp(t, "0") != 0; }
+    if ((t = env_text("RECOMP_FPS_LIMIT")) != NULL) {
+        lock |= PCV_LOCK_FPS;
+        s->fps_limit = parse_uint(t, 0, 240, &u) && in_list(pc_video_fps_limits, pc_video_fps_limit_count, u) ? u : 0;
+    }
+    if ((t = env_text("RECOMP_BLACK_ASPECT")) != NULL) {
+        int a = aspect_from_name(t);
+        lock |= PCV_LOCK_ASPECT;
+        s->aspect = a > 0 ? (unsigned)a : PCV_ASPECT_ORIGINAL;
+    }
+    if ((t = env_text("RECOMP_BLACK_FOV")) != NULL) {
+        char *end;
+        double f = strtod(t, &end);
+        lock |= PCV_LOCK_FOV;
+        s->fov = end != t && !*end && valid_fov(f) ? f : 0.0;
+    }
+    if ((t = env_text("RECOMP_BLACK_MOTION_BLUR")) != NULL) { lock |= PCV_LOCK_BLUR; s->motion_blur_off = !strcmp(t, "off"); }
+    if ((t = env_text("RECOMP_AA")) != NULL) {
+        int a = name_index(k_aa_names, PCV_AA_COUNT, t);
+        lock |= PCV_LOCK_AA; s->aa = a >= 0 ? (unsigned)a : PCV_AA_OFF;
+    }
+    if ((t = env_text("RECOMP_AF")) != NULL) {
+        lock |= PCV_LOCK_AF;
+        s->af = parse_uint(t, 1, 64, &u) && in_list(pc_video_af_levels, pc_video_af_level_count, u) ? u : 1u;
+    }
+    if ((t = env_text("RECOMP_DOF")) != NULL) {
+        int a = name_index(k_step_names, PCV_STEP_COUNT, t);
+        lock |= PCV_LOCK_DOF; s->dof = a >= 0 ? (unsigned)a : PCV_STEP_OFF;
+    }
+    if ((t = env_text("RECOMP_SHARPEN")) != NULL) {
+        int a = name_index(k_step_names, PCV_STEP_COUNT, t);
+        lock |= PCV_LOCK_SHARPEN; s->sharpen = a >= 0 ? (unsigned)a : PCV_STEP_OFF;
+    }
+    if ((t = env_text("RECOMP_SSAO")) != NULL) {
+        lock |= PCV_LOCK_AO_METHOD | PCV_LOCK_AO_QUALITY;
+        if (!apply_key(s, "ssao", t)) { s->ao_method = PCV_AO_OFF; s->ao_quality = PCV_AOQ_HIGH; }
+    }
+    if ((t = env_text("RECOMP_AO_METHOD")) != NULL) {
+        int a = name_index(k_ao_names, PCV_AO_COUNT, t);
+        lock |= PCV_LOCK_AO_METHOD; s->ao_method = a >= 0 ? (unsigned)a : PCV_AO_OFF;
+    }
+    if ((t = env_text("RECOMP_AO_QUALITY")) != NULL) {
+        int a = name_index(k_ao_quality_names, PCV_AOQ_COUNT, t);
+        lock |= PCV_LOCK_AO_QUALITY; s->ao_quality = a >= 0 ? (unsigned)a : PCV_AOQ_HIGH;
+    }
+    if ((t = env_text("RECOMP_INTERNAL_HEIGHT")) != NULL && parse_uint(t, 1, 100000, &u) &&
+        in_list(pc_video_internal_heights, pc_video_internal_height_count, u)) {
+        lock |= PCV_LOCK_INTERNAL; s->internal_height = u;
+    }
+    w = env_text("RECOMP_RENDER_WIDTH"); h = env_text("RECOMP_RENDER_HEIGHT");
+    if (w && h) {
+        unsigned rw, rh;
+        if (parse_uint(w, 240, 8192, &rw) && parse_uint(h, 240, 8192, &rh) && (uint64_t)rw * rh <= PCV_MAX_PIXELS) {
+            s->render_override_w = rw; s->render_override_h = rh;
+            lock |= PCV_LOCK_INTERNAL;
+        }
+    }
+    return lock;
+}
+
+static void publish_mirrors(const PcVideoSettings *s)
+{
+#if defined(_WIN32)
+    InterlockedExchange(&s_aspect, (LONG)s->aspect);
+    InterlockedExchange(&s_fov_milli, (LONG)(s->fov * 1000.0 + 0.5));
+    InterlockedExchange(&s_blur_off, (LONG)s->motion_blur_off);
+#else
+    s_aspect = s->aspect; s_fov_milli = (unsigned)(s->fov * 1000.0 + 0.5); s_blur_off = s->motion_blur_off;
+#endif
+}
+
+static void do_init(const char *path_override)
+{
+    const char *p = path_override ? path_override : env_text("RECOMP_VIDEO_INI");
+    pc_video_defaults(&s_file);
+    snprintf(s_path, sizeof(s_path), "%s", p ? p : "local\\video.ini");
+    if (load_file(&s_file) < 0) fprintf(stderr, "[VIDEO] no settings file at %s: defaults\n", s_path);
+    s_cur = s_file;
+    s_locked = apply_environment(&s_cur);
+    publish_mirrors(&s_cur);
+    {
+        unsigned rw, rh;
+        pc_video_render_size_for(&s_cur, &rw, &rh);
+        fprintf(stderr, "[VIDEO] internal %ux%u (%up), window %ux%u %s, scale %u, filter %s, vsync %u, cap %u, camera %s, fov %g, blur %s%s; "
+                        "aa %s, af %ux, dof %s, sharpen %s, ao %s (%s); locked 0x%X\n",
+                rw, rh, s_cur.internal_height, s_cur.window_width, s_cur.window_height,
+                s_cur.borderless ? "borderless" : "windowed", s_cur.scale, s_cur.nearest ? "nearest" : "linear",
+                s_cur.vsync, s_cur.fps_limit, pc_video_aspect_name(s_cur.aspect), s_cur.fov,
+                s_cur.motion_blur_off ? "off" : "original", s_cur.render_override_w ? " (raster size overridden)" : "",
+                k_aa_names[s_cur.aa], s_cur.af, k_step_names[s_cur.dof], k_step_names[s_cur.sharpen],
+                k_ao_names[s_cur.ao_method], k_ao_quality_names[s_cur.ao_quality], s_locked);
+    }
+}
+
+#if defined(_WIN32)
+static BOOL CALLBACK init_cb(PINIT_ONCE once, PVOID param, PVOID *ctx)
+{
+    (void)once; (void)ctx;
+    do_init((const char *)param);
+    return TRUE;
+}
+void pc_video_init(void) { InitOnceExecuteOnce(&s_once, init_cb, NULL, NULL); }
+void pc_video_test_reset(const char *path)
+{
+    INIT_ONCE fresh = INIT_ONCE_STATIC_INIT;
+    s_once = fresh; s_resize_hook = NULL; s_generation = 0;
+    InitOnceExecuteOnce(&s_once, init_cb, (PVOID)path, NULL);
+}
+#define READ_LOCK() AcquireSRWLockShared(&s_lock)
+#define READ_UNLOCK() ReleaseSRWLockShared(&s_lock)
+#define WRITE_LOCK() AcquireSRWLockExclusive(&s_lock)
+#define WRITE_UNLOCK() ReleaseSRWLockExclusive(&s_lock)
+#else
+void pc_video_init(void) { if (!s_once_done) { s_once_done = 1; do_init(NULL); } }
+void pc_video_test_reset(const char *path) { s_once_done = 1; s_resize_hook = NULL; s_generation = 0; do_init(path); }
+#define READ_LOCK() ((void)0)
+#define READ_UNLOCK() ((void)0)
+#define WRITE_LOCK() ((void)0)
+#define WRITE_UNLOCK() ((void)0)
+#endif
+
+void pc_video_get(PcVideoSettings *out)
+{
+    pc_video_init();
+    READ_LOCK();
+    *out = s_cur;
+    READ_UNLOCK();
+}
+
+unsigned pc_video_locked(void) { pc_video_init(); return s_locked; }
+
+unsigned pc_video_generation(void)
+{
+#if defined(_WIN32)
+    return (unsigned)InterlockedCompareExchange(&s_generation, 0, 0);
+#else
+    return s_generation;
+#endif
+}
+
+unsigned pc_video_aspect(void)
+{
+    pc_video_init();
+#if defined(_WIN32)
+    return (unsigned)InterlockedCompareExchange(&s_aspect, 0, 0);
+#else
+    return s_aspect;
+#endif
+}
+
+double pc_video_fov(void)
+{
+    pc_video_init();
+#if defined(_WIN32)
+    return (double)InterlockedCompareExchange(&s_fov_milli, 0, 0) / 1000.0;
+#else
+    return (double)s_fov_milli / 1000.0;
+#endif
+}
+
+int pc_video_motion_blur_off(void)
+{
+    pc_video_init();
+#if defined(_WIN32)
+    return InterlockedCompareExchange(&s_blur_off, 0, 0) != 0;
+#else
+    return s_blur_off != 0;
+#endif
+}
+
+static int valid_settings(const PcVideoSettings *s)
+{
+    return in_list(pc_video_internal_heights, pc_video_internal_height_count, s->internal_height) &&
+           s->window_width >= 320 && s->window_width <= 7680 && s->window_height >= 240 && s->window_height <= 4320 &&
+           s->scale <= PCV_SCALE_INTEGER && in_list(pc_video_fps_limits, pc_video_fps_limit_count, s->fps_limit) &&
+           s->aspect < PCV_ASPECT_COUNT && valid_fov(s->fov) && s->aa < PCV_AA_COUNT &&
+           in_list(pc_video_af_levels, pc_video_af_level_count, s->af) && s->dof < PCV_STEP_COUNT && s->sharpen < PCV_STEP_COUNT &&
+           s->ao_method < PCV_AO_COUNT && s->ao_quality < PCV_AOQ_COUNT;
+}
+
+/* The new values over the current ones, except where the environment holds a field. */
+static PcVideoSettings merge_unlocked(const PcVideoSettings *base, const PcVideoSettings *wanted, unsigned locked)
+{
+    PcVideoSettings r = *wanted;
+    if (locked & PCV_LOCK_WINDOW_SIZE) { r.window_width = base->window_width; r.window_height = base->window_height; }
+    if (locked & PCV_LOCK_WINDOW_MODE) r.borderless = base->borderless;
+    if (locked & PCV_LOCK_INTERNAL) { r.internal_height = base->internal_height; }
+    r.render_override_w = base->render_override_w; r.render_override_h = base->render_override_h;
+    if (locked & PCV_LOCK_SCALE) r.scale = base->scale;
+    if (locked & PCV_LOCK_FILTER) r.nearest = base->nearest;
+    if (locked & PCV_LOCK_VSYNC) r.vsync = base->vsync;
+    if (locked & PCV_LOCK_FPS) r.fps_limit = base->fps_limit;
+    if (locked & PCV_LOCK_ASPECT) r.aspect = base->aspect;
+    if (locked & PCV_LOCK_FOV) r.fov = base->fov;
+    if (locked & PCV_LOCK_BLUR) r.motion_blur_off = base->motion_blur_off;
+    if (locked & PCV_LOCK_AA) r.aa = base->aa;
+    if (locked & PCV_LOCK_AF) r.af = base->af;
+    if (locked & PCV_LOCK_DOF) r.dof = base->dof;
+    if (locked & PCV_LOCK_SHARPEN) r.sharpen = base->sharpen;
+    if (locked & PCV_LOCK_AO_METHOD) r.ao_method = base->ao_method;
+    if (locked & PCV_LOCK_AO_QUALITY) r.ao_quality = base->ao_quality;
+    return r;
+}
+
+static int publish(const PcVideoSettings *wanted, int announce)
+{
+    PcVideoSettings next, file_next, before;
+    unsigned ow, oh, nw, nh, orw, orh, nrw, nrh;
+    PcVideoResizeHook hook;
+    pc_video_init();
+    if (!valid_settings(wanted)) return 0;
+    WRITE_LOCK();
+    before = s_cur;
+    next = merge_unlocked(&s_cur, wanted, s_locked);
+    /* The file keeps the player's choice for every field the environment does not pin. */
+    file_next = merge_unlocked(&s_file, wanted, s_locked);
+    file_next.render_override_w = file_next.render_override_h = 0;
+    s_cur = next; s_file = file_next;
+    publish_mirrors(&s_cur);
+    hook = s_resize_hook;
+    WRITE_UNLOCK();
+    save_file(&file_next);
+    if (announce) {
+#if defined(_WIN32)
+        InterlockedIncrement(&s_generation);
+#else
+        s_generation++;
+#endif
+    }
+    pc_video_render_size_for(&before, &ow, &oh);
+    pc_video_render_size_for(&next, &nw, &nh);
+    pc_video_raster_size_for(&before, &orw, &orh);
+    pc_video_raster_size_for(&next, &nrw, &nrh);
+    if (hook && (ow != nw || oh != nh || orw != nrw || orh != nrh)) hook(nrw, nrh, nw, nh);
+    return 1;
+}
+
+int pc_video_set(const PcVideoSettings *wanted) { return publish(wanted, 1); }
+
+void pc_video_reset(void)
+{
+    PcVideoSettings d;
+    pc_video_defaults(&d);
+    publish(&d, 1);
+}
+
+void pc_video_note_borderless(unsigned borderless)
+{
+    PcVideoSettings file;
+    pc_video_init();
+    borderless = borderless ? 1u : 0u;
+    WRITE_LOCK();
+    if (s_cur.borderless == borderless) { WRITE_UNLOCK(); return; }
+    s_cur.borderless = borderless;
+    /* F11 works even where the environment chose the starting mode; only an unpinned choice is remembered. */
+    if (!(s_locked & PCV_LOCK_WINDOW_MODE)) s_file.borderless = borderless;
+    file = s_file;
+    WRITE_UNLOCK();
+    if (!(s_locked & PCV_LOCK_WINDOW_MODE)) save_file(&file);
+}
+
+void pc_video_render_size(unsigned *w, unsigned *h)
+{
+    PcVideoSettings s;
+    pc_video_get(&s);
+    pc_video_render_size_for(&s, w, h);
+}
+
+void pc_video_raster_size(unsigned *w, unsigned *h)
+{
+    PcVideoSettings s;
+    pc_video_get(&s);
+    pc_video_raster_size_for(&s, w, h);
+}
+
+void pc_video_set_resize_hook(PcVideoResizeHook hook)
+{
+    pc_video_init();
+    WRITE_LOCK();
+    s_resize_hook = hook;
+    WRITE_UNLOCK();
+}
+
+int pc_video_live_resize(void)
+{
+    int live;
+    pc_video_init();
+    READ_LOCK();
+    live = s_resize_hook != NULL;
+    READ_UNLOCK();
+    return live;
+}
diff --git a/src/video/pc_video.h b/src/video/pc_video.h
new file mode 100644
index 0000000..5610b01
--- /dev/null
+++ b/src/video/pc_video.h
@@ -0,0 +1,131 @@
+/*
+ * pc_video.h -- the PC video settings of the recompiled game: one model for the window, the
+ * internal (render) resolution, the camera and the presenter.
+ *
+ * Where the values come from, lowest priority first:
+ *   1. built-in defaults (720p internal resolution, a 1280x960 window, original camera);
+ *   2. the settings file, local\video.ini (RECOMP_VIDEO_INI overrides the path), which the
+ *      in-game Video Settings page and the launcher both write;
+ *   3. the RECOMP_* environment variables the diagnostics and lab scripts have always used
+ *      (RECOMP_WINDOW_WIDTH/HEIGHT/MODE, RECOMP_RENDER_WIDTH/HEIGHT, RECOMP_SCALE_MODE,
+ *      RECOMP_PRESENT_FILTER, RECOMP_VSYNC, RECOMP_FPS_LIMIT, RECOMP_BLACK_ASPECT,
+ *      RECOMP_BLACK_FOV, RECOMP_BLACK_MOTION_BLUR, RECOMP_INTERNAL_HEIGHT). A variable that is
+ *      set wins for the life of the process and its row in the menu is shown locked.
+ *
+ * The internal resolution is a number of lines (480p .. 2160p); the width follows from the
+ * camera aspect ratio, so the raster always matches what the camera sees. The window is a
+ * separate setting: the picture is scaled to it (fit, stretch or integer).
+ *
+ * Threads: any thread may read; changes come from the game thread (native menus) or presenter and are
+ * announced by pc_video_generation(), which every consumer polls at its own safe point.
+ */
+#ifndef XBOXRECOMP_PC_VIDEO_H
+#define XBOXRECOMP_PC_VIDEO_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Camera aspect. ORIGINAL is the game's own 4:3 camera; 4:3 is the same shape chosen explicitly. */
+enum { PCV_ASPECT_ORIGINAL, PCV_ASPECT_4_3, PCV_ASPECT_16_9, PCV_ASPECT_21_9, PCV_ASPECT_32_9, PCV_ASPECT_COUNT };
+enum { PCV_SCALE_FIT, PCV_SCALE_STRETCH, PCV_SCALE_INTEGER };
+/* Anti-aliasing: FXAA filters the finished scene (before the HUD); SSAA renders at twice the width and height and
+ * resolves back to the internal resolution. Depth of field and sharpening have four steps: off, low, medium, high. */
+enum { PCV_AA_OFF, PCV_AA_FXAA, PCV_AA_SSAA, PCV_AA_COUNT };
+enum { PCV_STEP_OFF, PCV_STEP_LOW, PCV_STEP_MEDIUM, PCV_STEP_HIGH, PCV_STEP_COUNT };
+/* Ambient occlusion is a scene-depth effect applied before the HUD. Quality controls sampling
+ * density and radius; the AO mask and its depth-aware blur stay at the scene resolution. */
+enum { PCV_AO_OFF, PCV_AO_SSAO, PCV_AO_HBAO, PCV_AO_HBAO_PLUS, PCV_AO_GTAO, PCV_AO_COUNT };
+enum { PCV_AOQ_LOW, PCV_AOQ_MEDIUM, PCV_AOQ_HIGH, PCV_AOQ_ULTRA, PCV_AOQ_COUNT };
+
+typedef struct PcVideoSettings {
+    unsigned internal_height;                 /* 480, 720, 1080, 1440 or 2160 */
+    unsigned window_width, window_height;     /* client size of the window when windowed */
+    unsigned borderless;                      /* 1 = borderless full screen */
+    unsigned scale;                           /* PCV_SCALE_* */
+    unsigned nearest;                         /* 1 = nearest filter when scaling to the window */
+    unsigned vsync;
+    unsigned fps_limit;                       /* 0 or one of the entries of pc_video_fps_limits */
+    unsigned aspect;                          /* PCV_ASPECT_* */
+    double fov;                               /* vertical degrees (35..100) or 0 = the game's own */
+    unsigned motion_blur_off;
+    unsigned action_blur_off;                 /* BLACK's own reload/aim blur (the game's hook reads it) */
+    unsigned aa;                              /* PCV_AA_* */
+    unsigned af;                              /* anisotropic filtering: 1 (off), 2, 4, 8 or 16 */
+    unsigned dof;                             /* depth of field, PCV_STEP_* */
+    unsigned sharpen;                         /* sharpening, PCV_STEP_* */
+    unsigned ao_method;                       /* ambient occlusion, PCV_AO_* */
+    unsigned ao_quality;                      /* ambient occlusion sampling, PCV_AOQ_* */
+    unsigned render_override_w, render_override_h; /* both non-zero: an explicit raster size (RECOMP_RENDER_*) */
+} PcVideoSettings;
+
+/* Fields that the environment pins for this process (bit set = locked). */
+enum {
+    PCV_LOCK_WINDOW_SIZE = 1u << 0, PCV_LOCK_WINDOW_MODE = 1u << 1, PCV_LOCK_INTERNAL = 1u << 2,
+    PCV_LOCK_SCALE = 1u << 3, PCV_LOCK_FILTER = 1u << 4, PCV_LOCK_VSYNC = 1u << 5,
+    PCV_LOCK_FPS = 1u << 6, PCV_LOCK_ASPECT = 1u << 7, PCV_LOCK_FOV = 1u << 8, PCV_LOCK_BLUR = 1u << 9,
+    PCV_LOCK_AA = 1u << 10, PCV_LOCK_AF = 1u << 11, PCV_LOCK_DOF = 1u << 12, PCV_LOCK_SHARPEN = 1u << 13,
+    PCV_LOCK_AO_METHOD = 1u << 14, PCV_LOCK_AO_QUALITY = 1u << 15
+};
+
+extern const unsigned pc_video_internal_heights[];   /* 480 .. 2160 */
+extern const unsigned pc_video_internal_height_count;
+extern const unsigned pc_video_fps_limits[];         /* 0 (unlimited), 30, 60, ... */
+extern const unsigned pc_video_fps_limit_count;
+extern const unsigned pc_video_af_levels[];          /* 1 (off), 2, 4, 8, 16 */
+extern const unsigned pc_video_af_level_count;
+
+/* Reads the settings file and the environment once (idempotent, thread safe). */
+void pc_video_init(void);
+void pc_video_get(PcVideoSettings *out);
+unsigned pc_video_locked(void);
+/* Bumped by every successful pc_video_set. Cheap enough to poll every frame. */
+unsigned pc_video_generation(void);
+/* Validates and publishes new values (locked fields keep the environment's value) and writes the
+ * settings file. Returns 0 when a value was out of range (nothing changes). */
+int pc_video_set(const PcVideoSettings *wanted);
+/* Back to the built-in defaults (locked fields excepted). */
+void pc_video_reset(void);
+/* Remember the window mode chosen outside the menu (F11) without announcing it as a change. */
+void pc_video_note_borderless(unsigned borderless);
+
+/* The internal resolution: what the game's picture is, and what is presented. */
+void pc_video_render_size_for(const PcVideoSettings *s, unsigned *w, unsigned *h);
+void pc_video_render_size(unsigned *w, unsigned *h);
+/* What the GPU renderer rasterises at: the internal resolution, doubled in each direction under SSAA (when that
+ * fits the renderer's limits; otherwise SSAA is not available and it is the internal resolution). */
+void pc_video_raster_size_for(const PcVideoSettings *s, unsigned *w, unsigned *h);
+void pc_video_raster_size(unsigned *w, unsigned *h);
+unsigned pc_video_ssaa_factor_for(const PcVideoSettings *s);   /* 1 or 2 */
+/* The camera's aspect as a ratio, or 0/0 for the game's own. */
+void pc_video_aspect_ratio(unsigned aspect, unsigned *num, unsigned *den);
+const char *pc_video_aspect_name(unsigned aspect);       /* "original", "4:3", "16:9", ... */
+
+/* Cheap reads for the guest hooks (the camera runs these every frame). */
+unsigned pc_video_aspect(void);
+double pc_video_fov(void);
+int pc_video_motion_blur_off(void);
+
+/* A renderer that can change its raster size while running registers here; the new sizes (the raster it draws at and
+ * the internal resolution it presents) are delivered on the thread that calls pc_video_set. Without one, the internal resolution applies
+ * at the next start (the menu says so). */
+typedef void (*PcVideoResizeHook)(unsigned raster_w, unsigned raster_h, unsigned out_w, unsigned out_h);
+void pc_video_set_resize_hook(PcVideoResizeHook hook);
+int pc_video_live_resize(void);
+
+/* The settings file's text for these settings (also what the launcher and tests parse). */
+size_t pc_video_format(const PcVideoSettings *s, char *out, size_t cap);
+/* Parses settings-file text over `inout`; unknown and invalid keys are skipped. Returns the number of keys applied. */
+int pc_video_parse(const char *text, PcVideoSettings *inout);
+void pc_video_defaults(PcVideoSettings *out);
+/* Tests only: forget everything and read the environment again; `path` overrides the file. */
+void pc_video_test_reset(const char *path);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* XBOXRECOMP_PC_VIDEO_H */
diff --git a/src/video/pc_video_menu.c b/src/video/pc_video_menu.c
new file mode 100644
index 0000000..bc9c3a2b9161476380ee87edaf51ef1556595d35
--- /dev/null
+++ b/src/video/pc_video_menu.c
@@ -0,0 +1,835 @@
+/* The native Video Settings page. See pc_video_menu.h. */
+#include "pc_video_menu.h"
+#include "pc_video.h"
+#include "../input/pc_input.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <wchar.h>
+
+#if defined(_WIN32)
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+
+/* ---- rows ------------------------------------------------------------------------------------------- */
+
+enum {
+    R_MODE = PCV_ROW_MODE, R_WINDOW = PCV_ROW_WINDOW, R_INTERNAL = PCV_ROW_INTERNAL, R_AA = PCV_ROW_AA, R_AF = PCV_ROW_AF,
+    R_DOF = PCV_ROW_DOF, R_SHARPEN = PCV_ROW_SHARPEN, R_ASPECT = PCV_ROW_ASPECT, R_FOV = PCV_ROW_FOV, R_SCALE = PCV_ROW_SCALE,
+    R_AO_METHOD = PCV_ROW_AO_METHOD, R_AO_QUALITY = PCV_ROW_AO_QUALITY,
+    R_FILTER = PCV_ROW_FILTER, R_VSYNC = PCV_ROW_VSYNC, R_FPS = PCV_ROW_FPS, R_BLUR = PCV_ROW_BLUR, R_RESET = PCV_ROW_RESET,
+    R_DONE = PCV_ROW_DONE, R_COUNT = PCV_ROW_COUNT
+};
+enum { A_UP, A_DOWN, A_LEFT, A_RIGHT, A_ACCEPT, A_BACK, A_OPEN };
+
+#define KEY_ESC 0x001u
+#define KEY_BACKSPACE 0x00Eu
+#define KEY_ENTER 0x01Cu
+#define KEY_SPACE 0x039u
+#define KEY_NUMENTER 0x11Cu
+#define KEY_UP 0x148u
+#define KEY_LEFT 0x14Bu
+#define KEY_RIGHT 0x14Du
+#define KEY_DOWN 0x150u
+#define KEY_F11 0x057u
+#define KEY_V 0x02Fu
+#define KEY_W 0x011u
+#define KEY_A 0x01Eu
+#define KEY_S 0x01Fu
+#define KEY_D 0x020u
+
+static SRWLOCK m_lock = SRWLOCK_INIT;
+static int m_open, m_sel, m_force;
+static void (*m_native_opener)(void);
+static volatile LONG m_hint_hidden;
+static ULONGLONG m_seen_tick;
+static unsigned char m_key_swallowed[0x200];
+static unsigned m_button_swallowed;
+static unsigned m_pad_prev;
+static int m_pad_hold;
+static ULONGLONG m_pad_repeat[4];
+
+/* Pad bits as tracked by the report filter. */
+enum { P_UP = 1, P_DOWN = 2, P_LEFT = 4, P_RIGHT = 8, P_A = 16, P_B = 32, P_OPEN = 64, P_DIR = P_UP | P_DOWN | P_LEFT | P_RIGHT, P_ALL = 127 };
+
+void pc_video_menu_page_seen(void)
+{
+    m_seen_tick = GetTickCount64();     /* a word-sized store; the reader tolerates a stale value */
+}
+
+static int available_locked(void)
+{
+    ULONGLONG now = GetTickCount64(), seen = m_seen_tick;
+    return m_force || (seen && now - seen < 400);
+}
+
+int pc_video_menu_is_open(void)
+{
+    int open;
+    AcquireSRWLockShared(&m_lock);
+    open = m_open;
+    ReleaseSRWLockShared(&m_lock);
+    return open;
+}
+
+/* ---- the window sizes the page offers --------------------------------------------------------------------- */
+
+static const unsigned k_sizes[][2] = {
+    { 640, 480 }, { 800, 600 }, { 1024, 768 }, { 1152, 864 }, { 1280, 720 }, { 1280, 800 }, { 1280, 960 }, { 1280, 1024 },
+    { 1366, 768 }, { 1400, 1050 }, { 1440, 900 }, { 1600, 900 }, { 1600, 1200 }, { 1680, 1050 }, { 1920, 1080 }, { 1920, 1200 },
+    { 1920, 1440 }, { 2048, 1536 }, { 2560, 1080 }, { 2560, 1440 }, { 2560, 1600 }, { 3440, 1440 }, { 3840, 1080 }, { 3840, 1600 },
+    { 3840, 2160 }, { 3840, 2400 }, { 5120, 1440 }, { 5120, 2160 }, { 7680, 2160 }
+};
+#define N_SIZES (sizeof(k_sizes) / sizeof(k_sizes[0]))
+
+/* The offered sizes that fit the screen, with the current one included wherever it falls. */
+static unsigned size_list(const PcVideoSettings *cur, unsigned out[][2], unsigned cap, unsigned *index)
+{
+    const unsigned sw = (unsigned)GetSystemMetrics(SM_CXSCREEN), sh = (unsigned)GetSystemMetrics(SM_CYSCREEN);
+    unsigned n = 0, i, at = (unsigned)-1;
+    const uint64_t cur_area = (uint64_t)cur->window_width * cur->window_height;
+    for (i = 0; i < N_SIZES && n < cap; i++) {
+        const unsigned w = k_sizes[i][0], h = k_sizes[i][1];
+        if (w == cur->window_width && h == cur->window_height) at = n;
+        else {
+            if (at == (unsigned)-1 && (uint64_t)w * h > cur_area && (w > sw || h > sh) == 0) {
+                /* the current size is not a preset: it goes before the first larger one */
+                out[n][0] = cur->window_width; out[n][1] = cur->window_height; at = n++;
+                if (n >= cap) break;
+            }
+            if (w > sw || h > sh) continue;
+        }
+        out[n][0] = w; out[n][1] = h; n++;
+    }
+    if (at == (unsigned)-1 && n < cap) { out[n][0] = cur->window_width; out[n][1] = cur->window_height; at = n++; }
+    if (at == (unsigned)-1) at = 0;
+    *index = at;
+    return n;
+}
+
+/* ---- changing a row ------------------------------------------------------------------------------------- */
+
+static unsigned wrap(int v, unsigned n) { return (unsigned)(((v % (int)n) + (int)n) % (int)n); }
+
+static unsigned row_lock_bit(int row);
+
+int pc_video_menu_row_locked(int row)
+{
+    return (pc_video_locked() & row_lock_bit(row)) != 0;
+}
+
+int pc_video_menu_row_change(int row, int dir)
+{
+    PcVideoSettings s;
+    unsigned locked = pc_video_locked(), i;
+    if (!dir || row < 0 || row >= R_RESET || (locked & row_lock_bit(row))) return 0;
+    dir = dir < 0 ? -1 : 1;
+    pc_video_get(&s);
+    switch (row) {
+    case R_MODE:
+        s.borderless = !s.borderless; break;
+    case R_WINDOW: {
+        unsigned list[40][2], at, n;
+        n = size_list(&s, list, 40, &at);
+        at = wrap((int)at + dir, n);
+        s.window_width = list[at][0]; s.window_height = list[at][1];
+        break;
+    }
+    case R_INTERNAL:
+        for (i = 0; i < pc_video_internal_height_count && pc_video_internal_heights[i] != s.internal_height; i++) {}
+        if (i >= pc_video_internal_height_count) i = 1;
+        s.internal_height = pc_video_internal_heights[wrap((int)i + dir, pc_video_internal_height_count)];
+        break;
+    case R_AA:
+        s.aa = wrap((int)s.aa + dir, PCV_AA_COUNT); break;
+    case R_AF:
+        for (i = 0; i < pc_video_af_level_count && pc_video_af_levels[i] != s.af; i++) {}
+        if (i >= pc_video_af_level_count) i = 0;
+        s.af = pc_video_af_levels[wrap((int)i + dir, pc_video_af_level_count)];
+        break;
+    case R_DOF:
+        s.dof = wrap((int)s.dof + dir, PCV_STEP_COUNT); break;
+    case R_SHARPEN:
+        s.sharpen = wrap((int)s.sharpen + dir, PCV_STEP_COUNT); break;
+    case R_AO_METHOD:
+        s.ao_method = wrap((int)s.ao_method + dir, PCV_AO_COUNT); break;
+    case R_AO_QUALITY:
+        s.ao_quality = wrap((int)s.ao_quality + dir, PCV_AOQ_COUNT); break;
+    case R_ASPECT:
+        s.aspect = wrap((int)s.aspect + dir, PCV_ASPECT_COUNT); break;
+    case R_FOV: {
+        int deg;
+        /* Original, then 35 .. 100 degrees in steps of 5. */
+        deg = s.fov == 0.0 ? 30 : (int)(s.fov / 5.0 + 0.5) * 5;
+        deg += dir * 5;
+        if (deg < 30) deg = 100;                 /* wrap: below Original is the widest */
+        if (deg > 100) deg = 30;
+        if (deg < 35) s.fov = 0.0; else s.fov = (double)deg;
+        break;
+    }
+    case R_SCALE:
+        s.scale = wrap((int)s.scale + dir, 3); break;
+    case R_FILTER:
+        s.nearest = !s.nearest; break;
+    case R_VSYNC:
+        s.vsync = !s.vsync; break;
+    case R_FPS:
+        for (i = 0; i < pc_video_fps_limit_count && pc_video_fps_limits[i] != s.fps_limit; i++) {}
+        if (i >= pc_video_fps_limit_count) i = 0;
+        s.fps_limit = pc_video_fps_limits[wrap((int)i + dir, pc_video_fps_limit_count)];
+        break;
+    case R_BLUR:
+        s.motion_blur_off = !s.motion_blur_off; break;
+    default: return 0;
+    }
+    return pc_video_set(&s);
+}
+
+void pc_video_menu_reset_settings(void) { pc_video_reset(); }
+
+static void act(int a)
+{
+    int row = -1, dir = 0, reset = 0;
+    void (*request)(void) = NULL;
+    AcquireSRWLockExclusive(&m_lock);
+    switch (a) {
+    case A_UP: if (m_open) m_sel = (m_sel + R_COUNT - 1) % R_COUNT; break;
+    case A_DOWN: if (m_open) m_sel = (m_sel + 1) % R_COUNT; break;
+    case A_LEFT: if (m_open) { row = m_sel; dir = -1; } break;
+    case A_RIGHT: if (m_open) { row = m_sel; dir = 1; } break;
+    case A_ACCEPT:
+        if (!m_open) break;
+        if (m_sel == R_RESET) reset = 1;
+        else if (m_sel == R_DONE) m_open = 0;
+        else { row = m_sel; dir = 1; }
+        break;
+    case A_BACK: m_open = 0; break;
+    case A_OPEN:
+        if (available_locked()) {
+            if (m_native_opener) request = m_native_opener;
+            else { m_open = 1; m_sel = 0; }
+        }
+        break;
+    default: break;
+    }
+    ReleaseSRWLockExclusive(&m_lock);
+    if (request) request();
+    if (reset) pc_video_menu_reset_settings();
+    else if (row >= 0) pc_video_menu_row_change(row, dir);
+}
+
+void pc_video_menu_open(void)
+{
+    void (*request)(void);
+    AcquireSRWLockExclusive(&m_lock);
+    m_seen_tick = GetTickCount64();
+    request = m_native_opener;
+    if (!request && !m_open) { m_open = 1; m_sel = 0; }
+    ReleaseSRWLockExclusive(&m_lock);
+    if (request) request();
+}
+
+void pc_video_menu_set_native_opener(void (*request)(void))
+{
+    AcquireSRWLockExclusive(&m_lock);
+    m_native_opener = request;
+    if (request) m_open = 0;
+    ReleaseSRWLockExclusive(&m_lock);
+}
+
+void pc_video_menu_hide_hint(int hide) { InterlockedExchange(&m_hint_hidden, hide ? 1 : 0); }
+
+void pc_video_menu_test_action(int action) { act(action); }
+void pc_video_menu_test_force_available(int on) { AcquireSRWLockExclusive(&m_lock); m_force = on; ReleaseSRWLockExclusive(&m_lock); }
+int pc_video_menu_test_selected(void) { return m_sel; }
+
+/* ---- the input filters --------------------------------------------------------------------------------------- */
+
+static int f_key(unsigned id, int down, int repeat)
+{
+    int action = -1, take = 0;
+    if (id >= 0x200 || id == KEY_F11) return 0;
+    AcquireSRWLockExclusive(&m_lock);
+    if (!down) {
+        take = m_key_swallowed[id];
+        m_key_swallowed[id] = 0;
+    } else if (m_open) {
+        take = 1;
+        m_key_swallowed[id] = 1;
+        switch (id) {
+        case KEY_UP: case KEY_W: action = A_UP; break;
+        case KEY_DOWN: case KEY_S: action = A_DOWN; break;
+        case KEY_LEFT: case KEY_A: action = A_LEFT; break;
+        case KEY_RIGHT: case KEY_D: action = A_RIGHT; break;
+        case KEY_ENTER: case KEY_NUMENTER: case KEY_SPACE: if (!repeat) action = A_ACCEPT; break;
+        case KEY_ESC: case KEY_BACKSPACE: if (!repeat) action = A_BACK; break;
+        default: break;
+        }
+    } else if (id == KEY_V && !repeat && available_locked()) {
+        take = 1;
+        m_key_swallowed[id] = 1;
+        action = A_OPEN;
+    } else if (id == KEY_V && repeat && m_key_swallowed[id]) {
+        take = 1;
+    }
+    ReleaseSRWLockExclusive(&m_lock);
+    if (action >= 0) act(action);
+    return take;
+}
+
+static int f_button(int button, int down)
+{
+    int action = -1, take = 0;
+    if (button < 0 || button > 4) return 0;
+    AcquireSRWLockExclusive(&m_lock);
+    if (!down) {
+        take = (m_button_swallowed >> button) & 1u;
+        m_button_swallowed &= ~(1u << button);
+    } else if (m_open) {
+        take = 1;
+        m_button_swallowed |= 1u << button;
+        action = button == 0 ? A_ACCEPT : button == 1 ? A_BACK : -1;
+    }
+    ReleaseSRWLockExclusive(&m_lock);
+    if (action >= 0) act(action);
+    return take;
+}
+
+static int f_wheel(int delta)
+{
+    int open;
+    AcquireSRWLockShared(&m_lock);
+    open = m_open;
+    ReleaseSRWLockShared(&m_lock);
+    if (!open) return 0;
+    act(delta > 0 ? A_UP : A_DOWN);
+    return 1;
+}
+
+static unsigned pad_bits(const uint8_t out[20])
+{
+    unsigned b = 0;
+    const int lx = (int16_t)(out[12] | (out[13] << 8)), ly = (int16_t)(out[14] | (out[15] << 8));
+    if ((out[2] & 1) || ly > 20000) b |= P_UP;
+    if ((out[2] & 2) || ly < -20000) b |= P_DOWN;
+    if ((out[2] & 4) || lx < -20000) b |= P_LEFT;
+    if ((out[2] & 8) || lx > 20000) b |= P_RIGHT;
+    if (out[4] > 100) b |= P_A;
+    if (out[5] > 100) b |= P_B;
+    if (out[9] > 100) b |= P_OPEN;           /* the White button: the right shoulder of an XInput pad */
+    return b;
+}
+
+static int f_report(uint8_t out[20], int pad_present)
+{
+    unsigned held = pad_present ? pad_bits(out) : 0, edges;
+    ULONGLONG now = GetTickCount64();
+    int actions[8], n = 0, take, i;
+    AcquireSRWLockExclusive(&m_lock);
+    edges = held & ~m_pad_prev;
+    if (!m_open) {
+        if ((edges & P_OPEN) && available_locked()) { actions[n++] = A_OPEN; m_pad_hold = 1; }
+    } else {
+        static const unsigned dir_bit[4] = { P_UP, P_DOWN, P_LEFT, P_RIGHT };
+        static const int dir_action[4] = { A_UP, A_DOWN, A_LEFT, A_RIGHT };
+        for (i = 0; i < 4; i++) {
+            if (!(held & dir_bit[i])) continue;
+            if (edges & dir_bit[i]) { actions[n++] = dir_action[i]; m_pad_repeat[i] = now + 400; }
+            else if (now >= m_pad_repeat[i]) { actions[n++] = dir_action[i]; m_pad_repeat[i] = now + 90; }
+        }
+        if (edges & P_A) actions[n++] = A_ACCEPT;
+        if (edges & P_B) { actions[n++] = A_BACK; m_pad_hold = 1; }
+    }
+    m_pad_prev = held;
+    take = m_open || m_pad_hold || n > 0;
+    /* Whatever closed or opened the page is not the game's press: keep the pad neutral until it is let go. */
+    if (m_pad_hold && !(held & P_ALL)) m_pad_hold = 0;
+    ReleaseSRWLockExclusive(&m_lock);
+    for (i = 0; i < n; i++) act(actions[i]);
+    if (!take) {
+        AcquireSRWLockShared(&m_lock);
+        take = m_open || m_pad_hold;
+        ReleaseSRWLockShared(&m_lock);
+    }
+    return take;
+}
+
+static const PcInputFilter k_filter = { f_key, f_button, f_wheel, f_report, NULL };
+
+void pc_video_menu_install(void)
+{
+    const char *force = getenv("RECOMP_VIDEO_MENU_FORCE");
+    if (force && *force && *force != '0') m_force = 1;
+    pc_input_set_filter(&k_filter);
+}
+
+/* ---- drawing ------------------------------------------------------------------------------------------------- */
+
+static uint32_t *m_buf;
+static unsigned m_buf_w, m_buf_h;
+static uint64_t m_last_key;
+static int m_last_visible;
+
+#define RGBA(r, g, b, a) (((uint32_t)(a) << 24) | ((uint32_t)(r) << 16) | ((uint32_t)(g) << 8) | (uint32_t)(b))
+
+static void blend_px(uint32_t *dst, unsigned r, unsigned g, unsigned b, unsigned a)
+{
+    /* source premultiplied; a is its alpha 0..255 */
+    uint32_t d = *dst;
+    unsigned inv = 255 - a;
+    unsigned dr = (d >> 16) & 255, dg = (d >> 8) & 255, db = d & 255, da = d >> 24;
+    dr = r + (dr * inv + 127) / 255; dg = g + (dg * inv + 127) / 255; db = b + (db * inv + 127) / 255; da = a + (da * inv + 127) / 255;
+    *dst = ((uint32_t)da << 24) | ((uint32_t)dr << 16) | ((uint32_t)dg << 8) | db;
+}
+
+static void fill_rect(int x, int y, int w, int h, uint32_t argb)
+{
+    int xx, yy;
+    const unsigned a = argb >> 24, r = ((argb >> 16) & 255) * a / 255, g = ((argb >> 8) & 255) * a / 255, b = (argb & 255) * a / 255;
+    if (x < 0) { w += x; x = 0; }
+    if (y < 0) { h += y; y = 0; }
+    if (x + w > (int)m_buf_w) w = (int)m_buf_w - x;
+    if (y + h > (int)m_buf_h) h = (int)m_buf_h - y;
+    for (yy = 0; yy < h; yy++) {
+        uint32_t *row = m_buf + (size_t)(y + yy) * m_buf_w + x;
+        for (xx = 0; xx < w; xx++) blend_px(row + xx, r, g, b, a);
+    }
+}
+
+static void frame_rect(int x, int y, int w, int h, int t, uint32_t argb)
+{
+    fill_rect(x, y, w, t, argb); fill_rect(x, y + h - t, w, t, argb);
+    fill_rect(x, y + t, t, h - 2 * t, argb); fill_rect(x + w - t, y + t, t, h - 2 * t, argb);
+}
+
+/* A triangle pointing left (dir -1) or right (dir 1): s pixels tall, two thirds as deep, centred on cy. */
+static void triangle(int x, int cy, int s, int dir, uint32_t argb)
+{
+    const int depth = s * 2 / 3;
+    int i;
+    for (i = 0; i < s; i++) {
+        const int c = i * 2 + 1 - s;                          /* -s+1 .. s-1: distance from the middle, doubled */
+        const int width = depth * (s - (c < 0 ? -c : c)) / s + 1;
+        fill_rect(dir > 0 ? x : x + depth - width, cy - s / 2 + i, width, 1, argb);
+    }
+}
+
+static HFONT make_font(int px, int weight)
+{
+    static const wchar_t *const faces[] = { L"Bahnschrift", L"Segoe UI", L"Arial" };
+    unsigned i;
+    HDC dc = CreateCompatibleDC(NULL);
+    HFONT chosen = NULL;
+    for (i = 0; i < sizeof(faces) / sizeof(faces[0]); i++) {
+        HFONT f = CreateFontW(-px, 0, 0, 0, weight, FALSE, FALSE, FALSE, DEFAULT_CHARSET, OUT_TT_PRECIS, CLIP_DEFAULT_PRECIS,
+                              ANTIALIASED_QUALITY, DEFAULT_PITCH | FF_SWISS, faces[i]);
+        wchar_t got[64] = L"";
+        HGDIOBJ old;
+        if (!f) continue;
+        old = SelectObject(dc, f);
+        GetTextFaceW(dc, 64, got);
+        SelectObject(dc, old);
+        if (!_wcsnicmp(got, faces[i], wcslen(faces[i])) || i + 1 == sizeof(faces) / sizeof(faces[0])) { chosen = f; break; }
+        DeleteObject(f);
+    }
+    DeleteDC(dc);
+    return chosen;
+}
+
+/* align: 0 left, 1 right, 2 centre; (x, y) is the top-left / top-right / top-centre of the text. */
+static int draw_text(HFONT font, const wchar_t *text, int x, int y, int align, uint32_t rgb, unsigned alpha)
+{
+    HDC dc;
+    SIZE sz;
+    BITMAPINFO bi;
+    void *bits = NULL;
+    HBITMAP bmp;
+    HGDIOBJ old_font, old_bmp;
+    int len = (int)wcslen(text), w, h, ox, oy, xx, yy;
+    const unsigned cr = (rgb >> 16) & 255, cg = (rgb >> 8) & 255, cb = rgb & 255;
+    if (!len || !font) return 0;
+    dc = CreateCompatibleDC(NULL);
+    old_font = SelectObject(dc, font);
+    GetTextExtentPoint32W(dc, text, len, &sz);
+    w = sz.cx + 8; h = sz.cy + 4;
+    memset(&bi, 0, sizeof(bi));
+    bi.bmiHeader.biSize = sizeof(bi.bmiHeader); bi.bmiHeader.biWidth = w; bi.bmiHeader.biHeight = -h;
+    bi.bmiHeader.biPlanes = 1; bi.bmiHeader.biBitCount = 32; bi.bmiHeader.biCompression = BI_RGB;
+    bmp = CreateDIBSection(dc, &bi, DIB_RGB_COLORS, &bits, NULL, 0);
+    if (!bmp || !bits) { SelectObject(dc, old_font); DeleteDC(dc); return sz.cx; }
+    old_bmp = SelectObject(dc, bmp);
+    memset(bits, 0, (size_t)w * h * 4);
+    SetBkMode(dc, TRANSPARENT);
+    SetTextColor(dc, RGB(255, 255, 255));
+    TextOutW(dc, 4, 2, text, len);
+    GdiFlush();
+    ox = align == 1 ? x - sz.cx - 4 : align == 2 ? x - sz.cx / 2 - 4 : x - 4;
+    oy = y - 2;
+    for (yy = 0; yy < h; yy++) {
+        const int py = oy + yy;
+        const uint32_t *src = (const uint32_t *)bits + (size_t)yy * w;
+        if (py < 0 || py >= (int)m_buf_h) continue;
+        for (xx = 0; xx < w; xx++) {
+            const int px = ox + xx;
+            const unsigned cov = (src[xx] >> 8) & 255;          /* grayscale antialiasing: any channel */
+            unsigned a;
+            if (!cov || px < 0 || px >= (int)m_buf_w) continue;
+            a = cov * alpha / 255;
+            blend_px(m_buf + (size_t)py * m_buf_w + px, cr * a / 255, cg * a / 255, cb * a / 255, a);
+        }
+    }
+    SelectObject(dc, old_bmp); DeleteObject(bmp);
+    SelectObject(dc, old_font); DeleteDC(dc);
+    return sz.cx;
+}
+
+static int text_width(HFONT font, const wchar_t *text)
+{
+    HDC dc = CreateCompatibleDC(NULL);
+    HGDIOBJ old = SelectObject(dc, font);
+    SIZE sz = { 0, 0 };
+    GetTextExtentPoint32W(dc, text, (int)wcslen(text), &sz);
+    SelectObject(dc, old); DeleteDC(dc);
+    return sz.cx;
+}
