+static void trace(const char *fmt, ...)
+{
+    va_list ap;
+    if (!s_trace) return;
+    fprintf(stderr, "[INPUT +%llu ms] ", (unsigned long long)(now_ms() - s_trace_t0));
+    va_start(ap, fmt);
+    vfprintf(stderr, fmt, ap);
+    va_end(ap);
+    fputc('\n', stderr);
+    fflush(stderr);
+}
