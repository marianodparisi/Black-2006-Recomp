@@ -0,0 +1,27 @@
+#ifndef NV2A_VSH_CPU_SRC_NV2A_VSH_EMULATOR_H_
+#define NV2A_VSH_CPU_SRC_NV2A_VSH_EMULATOR_H_
+
+#include "nv2a_vsh_emulator_execution_state.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Emulates the given program by applying each step to the given state.
+void nv2a_vsh_emu_execute(Nv2aVshExecutionState *state,
+                          const Nv2aVshProgram *program);
+
+// context_dirty is an array of 192 bools that will be set when writing to
+// entries in context_regs.
+void nv2a_vsh_emu_execute_track_context_writes(Nv2aVshExecutionState *state,
+                                               const Nv2aVshProgram *program,
+                                               bool *context_dirty);
+
+// Emulates the given step by applying it to the given state.
+void nv2a_vsh_emu_apply(Nv2aVshExecutionState *state, const Nv2aVshStep *step);
+
+#ifdef __cplusplus
+}  // extern "C"
+#endif
+
+#endif  // NV2A_VSH_CPU_SRC_NV2A_VSH_EMULATOR_H_
diff --git a/src/nv2a/kelvin/nv2a_vsh_cpu/nv2a_vsh_emulator4.c b/src/nv2a/kelvin/nv2a_vsh_cpu/nv2a_vsh_emulator4.c
new file mode 100644
index 0000000..ef85a34
--- /dev/null
+++ b/src/nv2a/kelvin/nv2a_vsh_cpu/nv2a_vsh_emulator4.c
@@ -0,0 +1,299 @@
+/*
+ * Four vertices at once through one vertex program (nv2a_vsh_emulator4.h).
+ *
+ * Every operation follows nv2a_vsh_emulator.c and nv2a_vsh_cpu.c exactly:
+ * operands are fetched, swizzled and multiplied by +-1 as fetch_value does,
+ * both operations of a step read their inputs before either writes, and the
+ * arithmetic is the same IEEE single operations in the same order, so each
+ * lane's result is bit for bit the scalar emulator's. The common MAC
+ * operations run on all four lanes in SSE; the rest call the scalar
+ * functions lane by lane.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+#include "nv2a_vsh_emulator4.h"
+
+#include <emmintrin.h>
+#include <string.h>
+
+#include "nv2a_vsh_cpu.h"
+
+static const Nv2aVshCpuFunc kScalar[] = {
+    NULL,
+    nv2a_vsh_cpu_mov,
+    nv2a_vsh_cpu_mul,
+    nv2a_vsh_cpu_add,
+    nv2a_vsh_cpu_mad,
+    nv2a_vsh_cpu_dp3,
+    nv2a_vsh_cpu_dph,
+    nv2a_vsh_cpu_dp4,
+    nv2a_vsh_cpu_dst,
+    nv2a_vsh_cpu_min,
+    nv2a_vsh_cpu_max,
+    nv2a_vsh_cpu_slt,
+    nv2a_vsh_cpu_sge,
+    nv2a_vsh_cpu_arl,
+    nv2a_vsh_cpu_rcp,
+    nv2a_vsh_cpu_rcc,
+    nv2a_vsh_cpu_rsq,
+    nv2a_vsh_cpu_exp,
+    nv2a_vsh_cpu_log,
+    nv2a_vsh_cpu_lit,
+};
+
+void nv2a_vsh_emu4_reset(Nv2aVshState4 *state) {
+  __m128 zero = _mm_setzero_ps(), one = _mm_set1_ps(1.0f);
+  int i;
+  for (i = 0; i < 12; ++i) {
+    state->temp[i].c[0] = state->temp[i].c[1] = zero;
+    state->temp[i].c[2] = state->temp[i].c[3] = zero;
+  }
+  for (i = 0; i < 13; ++i) {
+    state->output[i].c[0] = state->output[i].c[1] = zero;
+    state->output[i].c[2] = zero;
+    state->output[i].c[3] = one;
+  }
+  state->address[0] = state->address[1] = 0.0f;
+  state->address[2] = state->address[3] = 0.0f;
+}
+
+/* fetch_value: register, relative context address, swizzle, and the
+ * multiply by +1 or -1 that set_register always does. */
+static void fetch4(const Nv2aVshState4 *state, const Nv2aVshInput *input,
+                   Nv2aVshReg4 *out) {
+  Nv2aVshReg4 gathered;
+  const Nv2aVshReg4 *in;
+  __m128 mult = _mm_set1_ps(input->is_negated ? -1.0f : 1.0f);
+  int k;
+
+  switch (input->type) {
+    case NV2ART_INPUT:
+      in = &state->input[input->index];
+      break;
+    case NV2ART_CONTEXT: {
+      float v[4][4];
+      int lane;
+      if (!input->is_relative) {
+        /* The same register for every lane: each component broadcast. */
+        __m128 c = _mm_loadu_ps(&state->context[input->index * 4]);
+        gathered.c[0] = _mm_shuffle_ps(c, c, 0x00);
+        gathered.c[1] = _mm_shuffle_ps(c, c, 0x55);
+        gathered.c[2] = _mm_shuffle_ps(c, c, 0xAA);
+        gathered.c[3] = _mm_shuffle_ps(c, c, 0xFF);
+        in = &gathered;
+        break;
+      }
+      for (lane = 0; lane < 4; ++lane) {
+        uint32_t offset = input->index;
+        if (input->is_relative) {
+          offset += (int)state->address[lane];
+        }
+        memcpy(v[lane], &state->context[offset * 4], sizeof(v[lane]));
+      }
+      for (k = 0; k < 4; ++k) {
+        gathered.c[k] = _mm_setr_ps(v[0][k], v[1][k], v[2][k], v[3][k]);
+      }
+      in = &gathered;
+      break;
+    }
+    default: /* NV2ART_TEMPORARY, and what the scalar code falls into */
+      in = input->index == 12 ? &state->output[0] : &state->temp[input->index];
+      break;
+  }
+  for (k = 0; k < 4; ++k) {
+    out->c[k] = _mm_mul_ps(mult, in->c[input->swizzle[k]]);
+  }
+}
+
+static __m128 bits(uint32_t v) { return _mm_castsi128_ps(_mm_set1_epi32((int)v)); }
+
+static __m128 select4(__m128 mask, __m128 a, __m128 b) {
+  return _mm_or_ps(_mm_and_ps(mask, a), _mm_andnot_ps(mask, b));
+}
+
+/* |x| is infinite. */
+static __m128 is_inf4(__m128 x) {
+  return _mm_cmpeq_ps(_mm_and_ps(x, bits(0x7FFFFFFF)), bits(0x7F800000));
+}
+
+/* The largest finite value of an infinity's sign, as fix_inf builds it. */
+static __m128 finite_of4(__m128 x) {
+  return _mm_castsi128_ps(_mm_add_epi32(
+      _mm_and_si128(_mm_castps_si128(x), _mm_set1_epi32((int)0xFF000000)),
+      _mm_set1_epi32(0x7FFFFF)));
+}
+
+/* fix_inf_mult */
+static __m128 mul4(__m128 a, __m128 b) {
+  __m128 zero = _mm_setzero_ps();
+  __m128 either_zero = _mm_or_ps(_mm_cmpeq_ps(a, zero), _mm_cmpeq_ps(b, zero));
+  __m128 p = _mm_mul_ps(a, b);
+  __m128 fix = _mm_andnot_ps(_mm_or_ps(is_inf4(a), is_inf4(b)), is_inf4(p));
+  p = select4(fix, finite_of4(p), p);
+  return _mm_andnot_ps(either_zero, p);
+}
+
+/* fix_inf */
+static __m128 fix_inf4(__m128 x) { return select4(is_inf4(x), finite_of4(x), x); }
+
+/* nv2a_less_than: 1 or 0, with -0 below +0. */
+static __m128 less4(__m128 a, __m128 b) {
+  __m128i ai = _mm_castps_si128(a), bi = _mm_castps_si128(b);
+  __m128 neg_zero = _mm_castsi128_ps(_mm_and_si128(
+      _mm_cmpeq_epi32(ai, _mm_set1_epi32((int)0x80000000)),
+      _mm_cmpeq_epi32(bi, _mm_setzero_si128())));
+  return _mm_and_ps(_mm_or_ps(_mm_cmplt_ps(a, b), neg_zero), _mm_set1_ps(1.0f));
+}
+
+/* One operation on all lanes: SSE for the MAC arithmetic, the scalar
+ * function lane by lane for the rest. */
+static void operate4(Nv2aVshOpcode opcode, const Nv2aVshReg4 in[3],
+                     Nv2aVshReg4 *r) {
+  int k;
+  switch (opcode) {
+    case NV2AOP_MOV:
+      *r = in[0];
+      return;
+    case NV2AOP_MUL:
+      for (k = 0; k < 4; ++k) r->c[k] = mul4(in[0].c[k], in[1].c[k]);
+      return;
+    case NV2AOP_ADD:
+      for (k = 0; k < 4; ++k) r->c[k] = _mm_add_ps(in[0].c[k], in[1].c[k]);
+      return;
+    case NV2AOP_MAD:
+      for (k = 0; k < 4; ++k) {
+        r->c[k] = _mm_add_ps(mul4(in[0].c[k], in[1].c[k]), in[2].c[k]);
+      }
+      return;
+    case NV2AOP_DP3:
+    case NV2AOP_DPH:
+    case NV2AOP_DP4: {
+      __m128 s = _mm_add_ps(mul4(in[0].c[0], in[1].c[0]),
+                            mul4(in[0].c[1], in[1].c[1]));
+      s = _mm_add_ps(s, mul4(in[0].c[2], in[1].c[2]));
+      if (opcode == NV2AOP_DPH) {
+        s = _mm_add_ps(s, in[1].c[3]);
+      } else if (opcode == NV2AOP_DP4) {
+        s = _mm_add_ps(s, mul4(in[0].c[3], in[1].c[3]));
+      }
+      s = fix_inf4(s);
+      r->c[0] = r->c[1] = r->c[2] = r->c[3] = s;
+      return;
+    }
+    case NV2AOP_DST:
+      r->c[0] = _mm_set1_ps(1.0f);
+      r->c[1] = mul4(in[0].c[1], in[1].c[1]);
+      r->c[2] = in[0].c[2];
+      r->c[3] = in[1].c[3];
+      return;
+    case NV2AOP_MIN:
+      /* a < b ? a : b */
+      for (k = 0; k < 4; ++k) r->c[k] = _mm_min_ps(in[0].c[k], in[1].c[k]);
+      return;
+    case NV2AOP_MAX:
+      /* a > b ? a : b */
+      for (k = 0; k < 4; ++k) r->c[k] = _mm_max_ps(in[0].c[k], in[1].c[k]);
+      return;
+    case NV2AOP_SLT:
+      for (k = 0; k < 4; ++k) r->c[k] = less4(in[0].c[k], in[1].c[k]);
+      return;
+    case NV2AOP_SGE:
+      for (k = 0; k < 4; ++k) {
+        r->c[k] = _mm_add_ps(_mm_mul_ps(_mm_set1_ps(-1.0f),
+                                        less4(in[0].c[k], in[1].c[k])),
+                             _mm_set1_ps(1.0f));
+      }
+      return;
+    default: {
+      float lanes_in[3][4][4], lanes_out[4][4];
+      int j, lane;
+      for (j = 0; j < 3; ++j) {
+        for (k = 0; k < 4; ++k) {
+          float v[4];
+          _mm_storeu_ps(v, in[j].c[k]);
+          for (lane = 0; lane < 4; ++lane) lanes_in[j][lane][k] = v[lane];
+        }
+      }
+      for (lane = 0; lane < 4; ++lane) {
+        float inputs[12];
+        for (j = 0; j < 3; ++j) memcpy(&inputs[j * 4], lanes_in[j][lane], 16);
+        kScalar[opcode](lanes_out[lane], inputs);
+      }
+      for (k = 0; k < 4; ++k) {
+        r->c[k] = _mm_setr_ps(lanes_out[0][k], lanes_out[1][k],
+                              lanes_out[2][k], lanes_out[3][k]);
+      }
+      return;
+    }
+  }
+}
+
+/* apply_operation's writes. */
+static void write4(Nv2aVshState4 *state, const Nv2aVshOperation *op,
+                   const Nv2aVshReg4 *result) {
+  const Nv2aVshOutput *out = op->outputs;
+  int i;
+  for (i = 0; i < 2; ++i, ++out) {
+    Nv2aVshReg4 *reg;
+    switch (out->type) {
+      case NV2ART_OUTPUT:
+        reg = &state->output[out->index];
+        break;
+      case NV2ART_TEMPORARY:
+        if (out->index >= 12) {
+          continue; /* r12 is read-only (o0); the scalar array has 12 */
+        }
+        reg = &state->temp[out->index];
+        break;
+      case NV2ART_ADDRESS: {
+        /* ARL writes the scalar address register without a mask. */
+        _mm_storeu_ps(state->address, result->c[0]);
+        continue;
+      }
+      default: /* none, an input, or a context register (not allowed) */
+        continue;
+    }
+    if (out->writemask & NV2AWM_X) reg->c[0] = result->c[0];
+    if (out->writemask & NV2AWM_Y) reg->c[1] = result->c[1];
+    if (out->writemask & NV2AWM_Z) reg->c[2] = result->c[2];
+    if (out->writemask & NV2AWM_W) reg->c[3] = result->c[3];
+  }
+}
+
+void nv2a_vsh_emu4_execute(Nv2aVshState4 *state, const Nv2aVshProgram *program) {
+  const Nv2aVshStep *step = program->steps;
+  for (;;) {
+    Nv2aVshReg4 mac_in[3], ilu_in[3], result;
+    int i;
+
+    memset(mac_in, 0, sizeof(mac_in));
+    memset(ilu_in, 0, sizeof(ilu_in));
+    /* Both operations' inputs first, as prepare_inputs does. */
+    if (step->mac.opcode) {
+      for (i = 0; i < 3; ++i) {
+        if (step->mac.inputs[i].type == NV2ART_NONE) {
+          break;
+        }
+        fetch4(state, &step->mac.inputs[i], &mac_in[i]);
+      }
+    }
+    if (step->ilu.opcode) {
+      fetch4(state, &step->ilu.inputs[0], &ilu_in[0]);
+    }
+    if (step->mac.opcode) {
+      operate4(step->mac.opcode, mac_in, &result);
+      write4(state, &step->mac, &result);
+    }
+    if (step->ilu.opcode) {
+      operate4(step->ilu.opcode, ilu_in, &result);
+      write4(state, &step->ilu, &result);
+    }
+    if (step->is_final) {
+      break;
+    }
+    ++step;
+  }
+}
diff --git a/src/nv2a/kelvin/nv2a_vsh_cpu/nv2a_vsh_emulator4.h b/src/nv2a/kelvin/nv2a_vsh_cpu/nv2a_vsh_emulator4.h
new file mode 100644
index 0000000..b4e7a01
--- /dev/null
+++ b/src/nv2a/kelvin/nv2a_vsh_cpu/nv2a_vsh_emulator4.h
@@ -0,0 +1,48 @@
+/*
+ * Four vertices at once through one vertex program: the scalar emulator's
+ * semantics, operation for operation, with each register held as four SSE
+ * vectors (x, y, z, w), one lane per vertex.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+#ifndef NV2A_VSH_CPU_SRC_NV2A_VSH_EMULATOR4_H_
+#define NV2A_VSH_CPU_SRC_NV2A_VSH_EMULATOR4_H_
+
+#include <xmmintrin.h>
+
+#include "nv2a_vsh_disassembler.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* A register of four vertices: c[k] holds component k of each lane. */
+typedef struct Nv2aVshReg4 {
+  __m128 c[4];
+} Nv2aVshReg4;
+
+typedef struct Nv2aVshState4 {
+  Nv2aVshReg4 input[16];   /* v0-v15 */
+  Nv2aVshReg4 output[13];  /* o0-o12 */
+  Nv2aVshReg4 temp[12];    /* r0-r11; r12 reads o0 */
+  float address[4];        /* a0 of each lane */
+  /* c0-c191, shared by every lane, as the scalar emulator reads them. */
+  const float *context;
+} Nv2aVshState4;
+
+/* Clear temporaries, set every output to (0, 0, 0, 1) and a0 to 0, as the
+ * scalar driver does before each vertex. */
+void nv2a_vsh_emu4_reset(Nv2aVshState4 *state);
+
+/* Run the program on all four lanes. The program must not write context
+ * registers: every lane would write the same shared array. */
+void nv2a_vsh_emu4_execute(Nv2aVshState4 *state, const Nv2aVshProgram *program);
+
+#ifdef __cplusplus
+}  // extern "C"
+#endif
+
+#endif  // NV2A_VSH_CPU_SRC_NV2A_VSH_EMULATOR4_H_
diff --git a/src/nv2a/kelvin/nv2a_vsh_cpu/nv2a_vsh_emulator8.c b/src/nv2a/kelvin/nv2a_vsh_cpu/nv2a_vsh_emulator8.c
new file mode 100644
index 0000000..cebd55b
--- /dev/null
+++ b/src/nv2a/kelvin/nv2a_vsh_cpu/nv2a_vsh_emulator8.c
@@ -0,0 +1,289 @@
+/*
+ * Eight vertices at once through one vertex program (nv2a_vsh_emulator8.h).
+ *
+ * nv2a_vsh_emulator4.c on 256-bit vectors: the same operations in the same
+ * order per lane, the same compare predicates (_mm_cmpeq_ps is EQ_OQ,
+ * _mm_cmplt_ps is LT_OS), the scalar functions lane by lane for the rest.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+#include "nv2a_vsh_emulator8.h"
+
+#ifdef NV2A_VSH_HAVE_EMU8
+
+#include <string.h>
+
+#include "nv2a_vsh_cpu.h"
+
+static const Nv2aVshCpuFunc kScalar[] = {
+    NULL,
+    nv2a_vsh_cpu_mov,
+    nv2a_vsh_cpu_mul,
+    nv2a_vsh_cpu_add,
+    nv2a_vsh_cpu_mad,
+    nv2a_vsh_cpu_dp3,
+    nv2a_vsh_cpu_dph,
+    nv2a_vsh_cpu_dp4,
+    nv2a_vsh_cpu_dst,
+    nv2a_vsh_cpu_min,
+    nv2a_vsh_cpu_max,
+    nv2a_vsh_cpu_slt,
+    nv2a_vsh_cpu_sge,
+    nv2a_vsh_cpu_arl,
+    nv2a_vsh_cpu_rcp,
+    nv2a_vsh_cpu_rcc,
+    nv2a_vsh_cpu_rsq,
+    nv2a_vsh_cpu_exp,
+    nv2a_vsh_cpu_log,
+    nv2a_vsh_cpu_lit,
+};
+
+void nv2a_vsh_emu8_reset(Nv2aVshState8 *state) {
+  __m256 zero = _mm256_setzero_ps(), one = _mm256_set1_ps(1.0f);
+  int i;
+  for (i = 0; i < 12; ++i) {
+    state->temp[i].c[0] = state->temp[i].c[1] = zero;
+    state->temp[i].c[2] = state->temp[i].c[3] = zero;
+  }
+  for (i = 0; i < 13; ++i) {
+    state->output[i].c[0] = state->output[i].c[1] = zero;
+    state->output[i].c[2] = zero;
+    state->output[i].c[3] = one;
+  }
+  memset(state->address, 0, sizeof(state->address));
+}
+
+/* fetch_value: register, relative context address, swizzle, and the
+ * multiply by +1 or -1 that set_register always does. */
+static void fetch8(const Nv2aVshState8 *state, const Nv2aVshInput *input,
+                   Nv2aVshReg8 *out) {
+  Nv2aVshReg8 gathered;
+  const Nv2aVshReg8 *in;
+  __m256 mult = _mm256_set1_ps(input->is_negated ? -1.0f : 1.0f);
+  int k;
+
+  switch (input->type) {
+    case NV2ART_INPUT:
+      in = &state->input[input->index];
+      break;
+    case NV2ART_CONTEXT: {
+      int lane;
+      if (!input->is_relative) {
+        /* The same register for every lane: each component broadcast. */
+        const float *c = &state->context[input->index * 4];
+        for (k = 0; k < 4; ++k) gathered.c[k] = _mm256_set1_ps(c[k]);
+      } else {
+        float v[4][8];
+        for (lane = 0; lane < 8; ++lane) {
+          uint32_t offset = input->index + (int)state->address[lane];
+          const float *c = &state->context[offset * 4];
+          for (k = 0; k < 4; ++k) v[k][lane] = c[k];
+        }
+        for (k = 0; k < 4; ++k) gathered.c[k] = _mm256_loadu_ps(v[k]);
+      }
+      in = &gathered;
+      break;
+    }
+    default: /* NV2ART_TEMPORARY, and what the scalar code falls into */
+      in = input->index == 12 ? &state->output[0] : &state->temp[input->index];
+      break;
+  }
+  for (k = 0; k < 4; ++k) {
+    out->c[k] = _mm256_mul_ps(mult, in->c[input->swizzle[k]]);
+  }
+}
+
+static __m256 bits(uint32_t v) {
+  return _mm256_castsi256_ps(_mm256_set1_epi32((int)v));
+}
+
+static __m256 select8(__m256 mask, __m256 a, __m256 b) {
+  return _mm256_or_ps(_mm256_and_ps(mask, a), _mm256_andnot_ps(mask, b));
+}
+
+/* |x| is infinite. */
+static __m256 is_inf8(__m256 x) {
+  return _mm256_cmp_ps(_mm256_and_ps(x, bits(0x7FFFFFFF)), bits(0x7F800000),
+                       _CMP_EQ_OQ);
+}
+
+/* The largest finite value of an infinity's sign, as fix_inf builds it. */
+static __m256 finite_of8(__m256 x) {
+  return _mm256_castsi256_ps(_mm256_add_epi32(
+      _mm256_and_si256(_mm256_castps_si256(x), _mm256_set1_epi32((int)0xFF000000)),
+      _mm256_set1_epi32(0x7FFFFF)));
+}
+
+/* fix_inf_mult */
+static __m256 mul8(__m256 a, __m256 b) {
+  __m256 zero = _mm256_setzero_ps();
+  __m256 either_zero = _mm256_or_ps(_mm256_cmp_ps(a, zero, _CMP_EQ_OQ),
+                                    _mm256_cmp_ps(b, zero, _CMP_EQ_OQ));
+  __m256 p = _mm256_mul_ps(a, b);
+  __m256 fix = _mm256_andnot_ps(_mm256_or_ps(is_inf8(a), is_inf8(b)), is_inf8(p));
+  p = select8(fix, finite_of8(p), p);
+  return _mm256_andnot_ps(either_zero, p);
+}
+
+/* fix_inf */
+static __m256 fix_inf8(__m256 x) { return select8(is_inf8(x), finite_of8(x), x); }
+
+/* nv2a_less_than: 1 or 0, with -0 below +0. */
+static __m256 less8(__m256 a, __m256 b) {
+  __m256i ai = _mm256_castps_si256(a), bi = _mm256_castps_si256(b);
+  __m256 neg_zero = _mm256_castsi256_ps(_mm256_and_si256(
+      _mm256_cmpeq_epi32(ai, _mm256_set1_epi32((int)0x80000000)),
+      _mm256_cmpeq_epi32(bi, _mm256_setzero_si256())));
+  return _mm256_and_ps(_mm256_or_ps(_mm256_cmp_ps(a, b, _CMP_LT_OS), neg_zero),
+                       _mm256_set1_ps(1.0f));
+}
+
+/* One operation on all lanes: AVX for the MAC arithmetic, the scalar
+ * function lane by lane for the rest. */
+static void operate8(Nv2aVshOpcode opcode, const Nv2aVshReg8 in[3],
+                     Nv2aVshReg8 *r) {
+  int k;
+  switch (opcode) {
+    case NV2AOP_MOV:
+      *r = in[0];
+      return;
+    case NV2AOP_MUL:
+      for (k = 0; k < 4; ++k) r->c[k] = mul8(in[0].c[k], in[1].c[k]);
+      return;
+    case NV2AOP_ADD:
+      for (k = 0; k < 4; ++k) r->c[k] = _mm256_add_ps(in[0].c[k], in[1].c[k]);
+      return;
+    case NV2AOP_MAD:
+      for (k = 0; k < 4; ++k) {
+        r->c[k] = _mm256_add_ps(mul8(in[0].c[k], in[1].c[k]), in[2].c[k]);
+      }
+      return;
+    case NV2AOP_DP3:
+    case NV2AOP_DPH:
+    case NV2AOP_DP4: {
+      __m256 s = _mm256_add_ps(mul8(in[0].c[0], in[1].c[0]),
+                               mul8(in[0].c[1], in[1].c[1]));
+      s = _mm256_add_ps(s, mul8(in[0].c[2], in[1].c[2]));
+      if (opcode == NV2AOP_DPH) {
+        s = _mm256_add_ps(s, in[1].c[3]);
+      } else if (opcode == NV2AOP_DP4) {
+        s = _mm256_add_ps(s, mul8(in[0].c[3], in[1].c[3]));
+      }
+      s = fix_inf8(s);
+      r->c[0] = r->c[1] = r->c[2] = r->c[3] = s;
+      return;
+    }
+    case NV2AOP_DST:
+      r->c[0] = _mm256_set1_ps(1.0f);
+      r->c[1] = mul8(in[0].c[1], in[1].c[1]);
+      r->c[2] = in[0].c[2];
+      r->c[3] = in[1].c[3];
+      return;
+    case NV2AOP_MIN:
+      /* a < b ? a : b */
+      for (k = 0; k < 4; ++k) r->c[k] = _mm256_min_ps(in[0].c[k], in[1].c[k]);
+      return;
+    case NV2AOP_MAX:
+      /* a > b ? a : b */
+      for (k = 0; k < 4; ++k) r->c[k] = _mm256_max_ps(in[0].c[k], in[1].c[k]);
+      return;
+    case NV2AOP_SLT:
+      for (k = 0; k < 4; ++k) r->c[k] = less8(in[0].c[k], in[1].c[k]);
+      return;
+    case NV2AOP_SGE:
+      for (k = 0; k < 4; ++k) {
+        r->c[k] = _mm256_add_ps(_mm256_mul_ps(_mm256_set1_ps(-1.0f),
+                                              less8(in[0].c[k], in[1].c[k])),
+                                _mm256_set1_ps(1.0f));
+      }
+      return;
+    default: {
+      float lanes_in[3][4][8], lanes_out[4][8];
+      int j, lane;
+      for (j = 0; j < 3; ++j) {
+        for (k = 0; k < 4; ++k) _mm256_storeu_ps(lanes_in[j][k], in[j].c[k]);
+      }
+      for (lane = 0; lane < 8; ++lane) {
+        float inputs[12], out[4];
+        for (j = 0; j < 3; ++j) {
+          for (k = 0; k < 4; ++k) inputs[j * 4 + k] = lanes_in[j][k][lane];
+        }
+        kScalar[opcode](out, inputs);
+        for (k = 0; k < 4; ++k) lanes_out[k][lane] = out[k];
+      }
+      for (k = 0; k < 4; ++k) r->c[k] = _mm256_loadu_ps(lanes_out[k]);
+      return;
+    }
+  }
+}
+
+/* apply_operation's writes. */
+static void write8(Nv2aVshState8 *state, const Nv2aVshOperation *op,
+                   const Nv2aVshReg8 *result) {
+  const Nv2aVshOutput *out = op->outputs;
+  int i;
+  for (i = 0; i < 2; ++i, ++out) {
+    Nv2aVshReg8 *reg;
+    switch (out->type) {
+      case NV2ART_OUTPUT:
+        reg = &state->output[out->index];
+        break;
+      case NV2ART_TEMPORARY:
+        if (out->index >= 12) {
+          continue; /* r12 is read-only (o0); the scalar array has 12 */
+        }
+        reg = &state->temp[out->index];
+        break;
+      case NV2ART_ADDRESS:
+        /* ARL writes the scalar address register without a mask. */
+        _mm256_storeu_ps(state->address, result->c[0]);
+        continue;
+      default: /* none, an input, or a context register (not allowed) */
+        continue;
+    }
+    if (out->writemask & NV2AWM_X) reg->c[0] = result->c[0];
+    if (out->writemask & NV2AWM_Y) reg->c[1] = result->c[1];
+    if (out->writemask & NV2AWM_Z) reg->c[2] = result->c[2];
+    if (out->writemask & NV2AWM_W) reg->c[3] = result->c[3];
+  }
+}
+
+void nv2a_vsh_emu8_execute(Nv2aVshState8 *state, const Nv2aVshProgram *program) {
+  const Nv2aVshStep *step = program->steps;
+  for (;;) {
+    Nv2aVshReg8 mac_in[3], ilu_in[3], result;
+    int i;
+
+    memset(mac_in, 0, sizeof(mac_in));
+    memset(ilu_in, 0, sizeof(ilu_in));
+    /* Both operations' inputs first, as prepare_inputs does. */
+    if (step->mac.opcode) {
+      for (i = 0; i < 3; ++i) {
+        if (step->mac.inputs[i].type == NV2ART_NONE) {
+          break;
+        }
+        fetch8(state, &step->mac.inputs[i], &mac_in[i]);
+      }
+    }
+    if (step->ilu.opcode) {
+      fetch8(state, &step->ilu.inputs[0], &ilu_in[0]);
+    }
+    if (step->mac.opcode) {
+      operate8(step->mac.opcode, mac_in, &result);
+      write8(state, &step->mac, &result);
+    }
+    if (step->ilu.opcode) {
+      operate8(step->ilu.opcode, ilu_in, &result);
+      write8(state, &step->ilu, &result);
+    }
+    if (step->is_final) {
+      break;
+    }
+    ++step;
+  }
+}
+
+#endif  /* NV2A_VSH_HAVE_EMU8 */
diff --git a/src/nv2a/kelvin/nv2a_vsh_cpu/nv2a_vsh_emulator8.h b/src/nv2a/kelvin/nv2a_vsh_cpu/nv2a_vsh_emulator8.h
