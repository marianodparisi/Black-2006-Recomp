+        fprintf(stderr, "[KTRACE]   v%zu pos %.1f %.1f %.4g w %.4g | d0 %.3f"
+                        " %.3f %.3f %.3f | t0 %.3f %.3f %.3f %.3f\n",
+                i, v->pos[0], v->pos[1], v->pos[2], v->pos[3], v->d0[0],
+                v->d0[1], v->d0[2], v->d0[3], v->t[0][0], v->t[0][1],
