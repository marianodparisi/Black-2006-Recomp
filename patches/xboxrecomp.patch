+        mode = NV_PGRAPH_CONTROL_3_FOG_MODE_LINEAR; break;
+    case NV097_SET_FOG_MODE_V_EXP:
+        mode = NV_PGRAPH_CONTROL_3_FOG_MODE_EXP; break;
+    case NV097_SET_FOG_MODE_V_EXP2:
+        mode = NV_PGRAPH_CONTROL_3_FOG_MODE_EXP2; break;
