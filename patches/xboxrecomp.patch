+static int resolve_slot(int slot)
+{
+    int c = -1;
+    if (slot < 0 || slot > 36) return -1;
+    if (s_resolver) c = s_resolver(slot);
+    if (c == -2) c = -1;   /* The game resolver reads its fallback from the user's loaded XBE. */
+    return c;
+}
