+/*
+ * pc_menu.h -- native, editable menus, drawn by the presenter over the game picture.
+ *
+ * A definition file (local\menus.ini; RECOMP_MENUS_INI moves it) describes pages by the names the
+ * game itself gives them: a title, a few texts and a column of items whose actions are the game's
+ * own menu calls. The game project supplies the services that touch guest state (PcMenuHost) and
+ * calls pc_menu_tick once per front-end update on the game thread. A page the file does not list,
+ * or lists with an error, is left to the game. The game project also supplies the built-in
+ * definition, which is written to the file when the file does not exist, so there is always a
+ * file to edit; RECOMP_NATIVE_MENUS=0 turns the native pages off for a run.
+ *
+ * Pages are drawn at window resolution into the presenter's overlay, in the original 640 x 480
+ * menu space centred on the game picture, with fonts and images the game project registers from
+ * the user's own game files (pc_menu_set_font / pc_menu_set_image).
+ *
+ * Threads: pc_menu_tick runs on the game thread; the input filter on the input threads (window
+ * thread, OHCI thread); the overlay on the presenter thread. They share an action queue and a
+ * display list under one lock; drawing works on a private copy of the display list.
+ */
+#ifndef XBOXRECOMP_PC_MENU_H
+#define XBOXRECOMP_PC_MENU_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* ---- assets ------------------------------------------------------------------------------------------- */
+
+enum { PCM_FONT_SMALL, PCM_FONT_BIG, PCM_FONT_COUNT };
+enum { PCM_IMAGE_LOGO, PCM_IMAGE_BULLET, PCM_IMAGE_COUNT };
+
+/* One glyph, in texels of the font's atlas: the cell (u, v, w, h), where the cell's top-left goes
+ * relative to the pen (ox, oy) and how far the pen moves (advance). */
+typedef struct PcMenuGlyph {
+    uint16_t code;
+    float u, v, w, h, ox, oy, advance;
+} PcMenuGlyph;
+
+/* A bitmap font: a straight-alpha BGRA atlas and its glyphs. `nominal` is the text size (in menu
+ * units) at which one texel is one menu unit. Copied by pc_menu_set_font. */
+typedef struct PcMenuFont {
+    const uint32_t *pixels;
+    unsigned width, height;
+    float nominal;
+    const PcMenuGlyph *glyphs;
+    unsigned count;
+} PcMenuFont;
+
+int pc_menu_set_font(int slot, const PcMenuFont *font);
+/* Any thread: a font has been successfully registered. Assets are registered during initialization;
+ * use this to share that initialization between menus and movie hints without replacing a live atlas. */
+int pc_menu_has_font(int slot);
+/* A straight-alpha BGRA image, copied. */
+int pc_menu_set_image(int slot, const uint32_t *pixels, unsigned width, unsigned height);
+
+/* Decoders for the game's own files, in memory (pc_menu_assets.c). A "4.1v" bitmap font into a font slot;
+ * images by id from an APT bundle's texture page (movie = the bundle's movie name, e.g. "core"). Return
+ * 1 / the number of images registered, 0 when the data is not what they expect. */
+int pc_menu_load_font_file(int slot, const uint8_t *data, size_t size);
+int pc_menu_load_bundle_images(const uint8_t *data, size_t size, const char *movie, const uint32_t *ids, const int *slots, int n);
+int pc_menu_decode_dxt(const uint8_t *src, size_t size, unsigned w, unsigned h, unsigned format, uint32_t *out);
+
+/* ---- the game's services ------------------------------------------------------------------------------- */
+
+/* Called on the game thread, from inside pc_menu_tick only. */
+typedef struct PcMenuHost {
+    void *ctx;
+    /* The game's menu function NAME with up to three text arguments (NULL = "0"). Returns 1 when it was
+     * requested, 0 when another request is still waiting and `force` is 0 (the original refuses then). */
+    int (*gamecode)(void *ctx, const char *name, const char *const args[3], int force);
+    /* Go to another page (the game unloads this one and loads that one). */
+    void (*page)(void *ctx, const char *name);
+    /* A number the game publishes to its menus (FEInvertLookFlag ...). 1 = found. */
+    int (*value)(void *ctx, const char *name, int *out);
+    /* Text for "$KEY" (the game's localized string) or "&KEY" (live text the game writes). Writes
+     * UTF-16 and returns its length, or -1 when the game has no such text. */
+    int (*text)(void *ctx, const char *spec, uint16_t *out, unsigned cap);
+    /* Play one of the page's sound clips (SNDChange, SNDSelect, SNDBack, SNDError, SNDValueChange). */
+    void (*sound)(void *ctx, const char *clip);
+    /* Open the Video Settings page. */
+    void (*video)(void *ctx);
+    /* The game's own menu variables (what its pages keep in ActionScript, _global.NAME in BLACK's). `set` writes
+     * them as well as the page's own, and @NAME reads them when no native page set it, so a page of the game's
+     * own that follows a native one -- or the other way round -- finds what the first one set. May be NULL. */
+    void (*set_var)(void *ctx, const char *name, const char *value);
+    int (*get_var)(void *ctx, const char *name, char *out, unsigned cap);
+    /* Close the game, the way closing its window does ("exit"). May be NULL. */
+    void (*quit)(void *ctx);
+} PcMenuHost;
+
+/* ---- the game thread -------------------------------------------------------------------------------------- */
+
+/* The definition the game ships with (UTF-8, the file syntax). Call before the first tick. */
+void pc_menu_set_default_definition(const char *text);
+/* Earlier built-in definitions, by the FNV-1a 64 hash of the file's bytes: a file that is still exactly one of them
+ * (written by an older build, never edited) is replaced with the current one when it is read. */
+void pc_menu_set_replaced_defaults(const uint64_t *fnv1a, int count);
+
+/* Once per front-end update. `page` is the game's current page ("" or NULL for none), `ready` says it is
+ * prepared and takes input. Returns 1 while a native page is shown: the game hides its own page then. */
+int pc_menu_tick(const char *page, int ready, const PcMenuHost *host);
+
+/* ---- presenter / input ----------------------------------------------------------------------------------- */
+
+/* Registers the input filter and routes the Video Settings shortcut into the native action queue. */
+void pc_menu_install(void);
+/* Any thread: request native Video Settings. Revalidated and opened on the game thread. */
+void pc_menu_request_video(void);
+
+/* A native page is on screen (any thread). */
+int pc_menu_active(void);
+/* Window thread: the pointer moved to (x, y) in client pixels, the same space as pc_menu_overlay's picture
+ * rectangle. On a native page the item under it takes the focus, and a left click acts on that item
+ * (confirm; ON/OFF and sliders by where the click lands); a click away from the items does nothing. */
+void pc_menu_pointer(int x, int y);
+
+/* 1 when the player used a native page (a key, button or stick) since the last call; clears it (any thread). A
+ * native page takes all input, so the game's own idle checks (an attract mode) would see none: the game project
+ * counts this as input there. */
+int pc_menu_take_input(void);
+
+/* Any thread: show the cutscene's "Press again to skip" hint in the client area's bottom-right
+ * corner, including when no native page is open. The game clears it on timeout, skip or movie end.
+ * Uses the registered small font; this does not open a page or take input. */
+void pc_menu_set_movie_skip_prompt(int visible);
+
+/* Presenter thread: the overlay for a client area of w x h, with the game picture at (px, py, pw, ph).
+ * Video Settings uses this same page renderer. The legacy overlay remains available for fallback runs. Same contract as
+ * pc_video_menu_overlay: 1 = draw *pixels (w*h premultiplied BGRA, valid until the next call). */
+int pc_menu_overlay(unsigned w, unsigned h, int px, int py, unsigned pw, unsigned ph,
+                    const uint32_t **pixels, int *changed);
+
+/* After pc_menu_overlay reported a change: the part of the pixels that changed (x, y, w, h), so only that part
+ * needs uploading. 0 when it cannot say (upload everything). */
+int pc_menu_overlay_dirty(unsigned box[4]);
+
+/* ---- the definition -------------------------------------------------------------------------------------- */
+
+/* Parses definition text. Returns the number of valid pages; errors are written one per line to `log`
+ * ("menus.ini:LINE: message"). Used by the loader and the tests. */
+int pc_menu_check_definition(const char *text, char *log, size_t log_cap);
+const char *pc_menu_definition_path(void);
+
+/* ---- tests ------------------------------------------------------------------------------------------------- */
+
+/* START is the pad's start button: back on a page with "start = back", confirm elsewhere (as the original). */
+enum { PCM_ACT_UP = 1, PCM_ACT_DOWN, PCM_ACT_LEFT, PCM_ACT_RIGHT, PCM_ACT_CONFIRM, PCM_ACT_BACK, PCM_ACT_START, PCM_ACT_VIDEO };
+/* Tests: the menu-space to pixel mapping the pointer uses, as pc_menu_test_render sets it for w x h. */
+void pc_menu_test_pointer_space(unsigned w, unsigned h);
+void pc_menu_test_button(int button, int down);  /* a mouse button, through the native page's input filter */
+int pc_menu_test_pointer_item(void);              /* the item under the pointer, -1 none */
+void pc_menu_test_reset(const char *definition);   /* forget state, use this definition (no file) */
+void pc_menu_test_action(int action);              /* as if the player pressed it */
+int pc_menu_test_focus(void);                      /* index of the focused item, -1 none */
+int pc_menu_test_load_file(const char *path);      /* read the definition from this file, as the game does; pages */
+/* Renders the current display list into w x h premultiplied BGRA (picture = the whole buffer). */
+int pc_menu_test_render(uint32_t *pixels, unsigned w, unsigned h);
+/* The display list as text, one primitive per line (for tests and logs). */
+size_t pc_menu_test_dump(char *out, size_t cap);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* XBOXRECOMP_PC_MENU_H */
diff --git a/src/video/pc_menu_assets.c b/src/video/pc_menu_assets.c
new file mode 100644
index 0000000..6affd56
--- /dev/null
+++ b/src/video/pc_menu_assets.c
@@ -0,0 +1,147 @@
+/* Assets for the native menus, decoded from the game's own files in memory (see pc_menu.h):
+ *   - "4.1v" bitmap fonts (RenderWare-era EA fonts, BLACK's language/fonts/*.bin): texture offset at +4,
+ *     atlas texels per text-size unit at +8/+12, 128 glyph chains from +0x20, 0x28-byte glyphs from
+ *     +0x220 {u, v, w, h, x, y, advance (fractions of the atlas), code at +0x1C}, then the texture;
+ *   - APT bundles (export/FrontEnd/*.bin): a table of {name, block}; a block holds the texture pages at
+ *     +8 (a 0x40-byte header, then 0x80-byte texture headers each followed by the pixels) and the image
+ *     map at +0x14 {magic, count, entries -> {id, 0, rect offset, 0}, rect = {u, v, w, h (fractions)}}.
+ * Textures are Xbox DXT2/3 (0x0E) or DXT4/5 (0x0F), not swizzled.
+ */
+#include "pc_menu.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static uint32_t rd32(const uint8_t *d, size_t size, size_t at)
+{
+    uint32_t v;
+    if (at > size || size - at < 4) return 0;
+    memcpy(&v, d + at, 4);
+    return v;
+}
+
+static float rdf(const uint8_t *d, size_t size, size_t at)
+{
+    float v;
+    if (at > size || size - at < 4) return 0.0f;
+    memcpy(&v, d + at, 4);
+    return v;
+}
+
+static void rgb565(unsigned c, unsigned rgb[3])
+{
+    const unsigned r = (c >> 11) & 31u, g = (c >> 5) & 63u, b = c & 31u;
+    rgb[0] = (r << 3) | (r >> 2); rgb[1] = (g << 2) | (g >> 4); rgb[2] = (b << 3) | (b >> 2);
+}
+
+int pc_menu_decode_dxt(const uint8_t *src, size_t size, unsigned w, unsigned h, unsigned format, uint32_t *out)
+{
+    unsigned bx, by, i;
+    const uint8_t *b = src;
+    if ((format != 0x0Eu && format != 0x0Fu) || !w || !h || (w & 3u) || (h & 3u) || (size_t)w * h > size) return 0;
+    for (by = 0; by < h; by += 4) for (bx = 0; bx < w; bx += 4, b += 16) {
+        unsigned alpha[16], pal[4][3];
+        const unsigned c0 = b[8] | (b[9] << 8), c1 = b[10] | (b[11] << 8);
+        const uint32_t idx = (uint32_t)b[12] | ((uint32_t)b[13] << 8) | ((uint32_t)b[14] << 16) | ((uint32_t)b[15] << 24);
+        if (format == 0x0Eu) {
+            for (i = 0; i < 16; i++) alpha[i] = ((b[i / 2] >> ((i & 1) * 4)) & 15u) * 17u;
+        } else {
+            unsigned ap[8];
+            const unsigned a0 = b[0], a1 = b[1];
+            uint64_t bits = 0;
+            for (i = 0; i < 6; i++) bits |= (uint64_t)b[2 + i] << (8 * i);
+            ap[0] = a0; ap[1] = a1;
+            if (a0 > a1) for (i = 0; i < 6; i++) ap[2 + i] = ((6 - i) * a0 + (1 + i) * a1 + 3) / 7;
+            else { for (i = 0; i < 4; i++) ap[2 + i] = ((4 - i) * a0 + (1 + i) * a1 + 2) / 5; ap[6] = 0; ap[7] = 255; }
+            for (i = 0; i < 16; i++) alpha[i] = ap[(bits >> (3 * i)) & 7u];
+        }
+        rgb565(c0, pal[0]); rgb565(c1, pal[1]);
+        for (i = 0; i < 3; i++) { pal[2][i] = (2 * pal[0][i] + pal[1][i] + 1) / 3; pal[3][i] = (pal[0][i] + 2 * pal[1][i] + 1) / 3; }
+        for (i = 0; i < 16; i++) {
+            const unsigned k = (idx >> (2 * i)) & 3u, x = bx + (i & 3u), y = by + (i >> 2);
+            out[(size_t)y * w + x] = ((uint32_t)alpha[i] << 24) | (pal[k][0] << 16) | (pal[k][1] << 8) | pal[k][2];
+        }
+    }
+    return 1;
+}
+
+int pc_menu_load_font_file(int slot, const uint8_t *d, size_t size)
+{
+    uint32_t tex, format, w, h, n = 0;
+    size_t at;
+    uint32_t *pixels = NULL;
+    PcMenuGlyph *glyphs = NULL;
+    PcMenuFont font;
+    int ok = 0;
+    if (!d || size < 0x300 || memcmp(d, "4.1v", 4)) return 0;
+    tex = rd32(d, size, 4);
+    if (tex < 0x220u || tex > size || size - tex < 0x80u) return 0;
+    format = rd32(d, size, tex + 0x34u); w = rd32(d, size, tex + 0x38u); h = rd32(d, size, tex + 0x3Cu);
+    if (!w || !h || w > 2048u || h > 2048u) return 0;
+    pixels = (uint32_t *)malloc((size_t)w * h * 4u);
+    glyphs = (PcMenuGlyph *)calloc((tex - 0x220u) / 0x28u + 1u, sizeof(PcMenuGlyph));
+    if (!pixels || !glyphs || !pc_menu_decode_dxt(d + tex + 0x80u, size - tex - 0x80u, w, h, format, pixels)) goto done;
+    for (at = 0x220u; at + 0x28u <= tex; at += 0x28u) {
+        PcMenuGlyph *g = &glyphs[n];
+        uint16_t code;
+        memcpy(&code, d + at + 0x1Cu, 2);
+        if (!code) continue;
+        g->code = code;
+        g->u = rdf(d, size, at) * (float)w; g->v = rdf(d, size, at + 4) * (float)h;
+        g->w = rdf(d, size, at + 8) * (float)w; g->h = rdf(d, size, at + 12) * (float)h;
+        g->ox = rdf(d, size, at + 16) * (float)w; g->oy = rdf(d, size, at + 20) * (float)h;
+        g->advance = rdf(d, size, at + 24) * (float)w;
+        if (g->u < 0 || g->v < 0) g->w = g->h = 0;            /* the space has no cell */
+        n++;
+    }
+    font.pixels = pixels; font.width = w; font.height = h; font.glyphs = glyphs; font.count = n;
+    /* +12 is the atlas height over the size at which one texel is one unit: 256 / 15 for Small, 256 / 30 for Big */
+    font.nominal = rdf(d, size, 12) > 0 ? (float)h / rdf(d, size, 12) : 0.0f;
+    ok = font.nominal > 1.0f && font.nominal < 200.0f && pc_menu_set_font(slot, &font);
+done:
+    free(pixels); free(glyphs);
+    return ok;
+}
+
+int pc_menu_load_bundle_images(const uint8_t *d, size_t size, const char *movie, const uint32_t *ids, const int *slots, int n)
+{
+    uint32_t count, table, i, block = 0, texblock, map, format, w, h;
+    uint32_t *page = NULL;
+    int ok = 0;
+    if (!d || size < 16) return 0;
+    count = rd32(d, size, 8); table = rd32(d, size, 12);
+    for (i = 0; i < count && i < 64u; i++) {
+        const uint32_t e = rd32(d, size, table + i * 4u), name = rd32(d, size, e);
+        const size_t len = strlen(movie) + 1;
+        if (name < size && size - name >= len && !memcmp(d + name, movie, len)) { block = rd32(d, size, e + 4u); break; }
+    }
+    if (!block || block >= size) return 0;
+    texblock = block + rd32(d, size, block + 8u);
+    map = block + rd32(d, size, block + 0x14u);
+    if (texblock == block || map == block || texblock > size || size - texblock < 0xC0u) return 0;
+    format = rd32(d, size, texblock + 0x40u + 0x34u); w = rd32(d, size, texblock + 0x40u + 0x38u); h = rd32(d, size, texblock + 0x40u + 0x3Cu);
+    if (!w || !h || w > 2048u || h > 2048u) return 0;
+    page = (uint32_t *)malloc((size_t)w * h * 4u);
+    if (!page || !pc_menu_decode_dxt(d + texblock + 0xC0u, size - texblock - 0xC0u, w, h, format, page)) { free(page); return 0; }
+    {
+        const uint32_t m = rd32(d, size, map + 8u), entries = map + rd32(d, size, map + 12u);
+        for (i = 0; i < m && i < 256u; i++) {
+            const uint32_t id = rd32(d, size, entries + i * 16u), r = map + rd32(d, size, entries + i * 16u + 8u);
+            int k, slot = -1;
+            unsigned x0, y0, iw, ih, y;
+            uint32_t *img;
+            for (k = 0; k < n; k++) if (ids[k] == id) slot = slots[k];
+            if (slot < 0) continue;
+            x0 = (unsigned)(rdf(d, size, r) * (float)w + 0.5f); y0 = (unsigned)(rdf(d, size, r + 4) * (float)h + 0.5f);
+            iw = (unsigned)(rdf(d, size, r + 8) * (float)w + 0.5f); ih = (unsigned)(rdf(d, size, r + 12) * (float)h + 0.5f);
+            if (!iw || !ih || x0 + iw > w || y0 + ih > h) continue;
+            img = (uint32_t *)malloc((size_t)iw * ih * 4u);
+            if (!img) continue;
+            for (y = 0; y < ih; y++) memcpy(img + (size_t)y * iw, page + (size_t)(y0 + y) * w + x0, (size_t)iw * 4u);
+            if (pc_menu_set_image(slot, img, iw, ih)) ok++;
+            free(img);
+        }
+    }
+    free(page);
+    return ok;
+}
diff --git a/src/video/pc_movie_skip.c b/src/video/pc_movie_skip.c
new file mode 100644
--- /dev/null
+++ b/src/video/pc_movie_skip.c
@@ -0,0 +1,370 @@
+/* BLACK's native XMV input. Decoder ownership and EOF stay with the guest. */
+#include "pc_movie_skip.h"
+#include "pc_menu.h"
+#include "../input/pc_input.h"
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+
+#define MOVIE_LEASE_MS 500u
+#define CONFIRM_MS 3000u
+#define KEY_ESC 0x001u
+#define KEY_ENTER 0x01Cu
+#define KEY_SPACE 0x039u
+#define KEY_NUMENTER 0x11Cu
+#define KEY_F11 0x057u
+
+static SRWLOCK m_lock = SRWLOCK_INIT;
+static uint64_t m_session, m_seen, m_confirm;
+static uint64_t m_started;
+static int m_kind, m_request, m_release;
+static int m_subtitle_target, m_subtitle_loaded;
+static char m_subtitle_stem[16];
+static int m_focused = 1;
+#define PC_MOVIE_CAPTIONS 64
+#define PC_MOVIE_CAPTION_CHARS PC_MOVIE_SUBTITLE_CHARS
+typedef struct MovieCaption { uint64_t start, end; uint16_t text[PC_MOVIE_CAPTION_CHARS]; } MovieCaption;
+static MovieCaption m_captions[PC_MOVIE_CAPTIONS];
+static unsigned m_caption_count;
+/* Physical state survives movie transitions, so a held button cannot affect the
+ * next movie. Consumed releases also stay consumed after the movie ends. */
+static unsigned m_keys, m_pad, m_mouse;
+static unsigned char m_swallowed[0x200];
+static unsigned m_mouse_swallowed;
+static int m_pad_swallowed;
+#ifdef PC_MOVIE_SKIP_TEST
+static uint64_t m_test_now;
+void pc_movie_skip_test_time(uint64_t now) { m_test_now = now; }
+static uint64_t now_ms(void) { return m_test_now; }
+#else
+static uint64_t now_ms(void) { return GetTickCount64(); }
+#endif
+
+static void retire_locked(void)
+{
+    m_session = m_seen = m_confirm = 0;
+    m_started = 0;
+    m_kind = PC_MOVIE_SKIP_NONE;
+    m_request = 0;
+    m_subtitle_target = m_subtitle_loaded = 0;
+    m_subtitle_stem[0] = 0;
+    m_caption_count = 0;
+    m_release = (m_keys | m_pad | m_mouse) != 0;
+    pc_menu_set_movie_skip_prompt(0);
+}
+
+static int active_locked(uint64_t now)
+{
+    if (m_kind && (now < m_seen || now - m_seen > MOVIE_LEASE_MS)) retire_locked();
+    if (m_confirm && now >= m_confirm) {
+        m_confirm = 0;
+        pc_menu_set_movie_skip_prompt(0);
+    }
+    return m_kind != PC_MOVIE_SKIP_NONE;
+}
+
+static void press_locked(uint64_t now)
+{
+    if (!m_focused || !active_locked(now) || m_release || m_request) return;
+    m_release = 1;
+    if (m_kind == PC_MOVIE_SKIP_INTRO || m_confirm) {
+        m_request = 1;
+        m_confirm = 0;
+        pc_menu_set_movie_skip_prompt(0);
+        fprintf(stderr, "[MOVIE] skip requested (%s)\n",
+                m_kind == PC_MOVIE_SKIP_INTRO ? "intro" : "confirmed");
+    } else {
+        m_confirm = now + CONFIRM_MS;
+        pc_menu_set_movie_skip_prompt(1);
+        fprintf(stderr, "[MOVIE] confirmation: Press again to skip\n");
+    }
+}
+
+static void release_locked(void)
+{
+    if (!(m_keys | m_pad | m_mouse)) m_release = 0;
+}
+
+void pc_movie_skip_update(uint64_t session, int kind, int playing)
+{
+    const uint64_t now = now_ms();
+    AcquireSRWLockExclusive(&m_lock);
+    active_locked(now);
+    if (!playing || !session || kind < PC_MOVIE_SKIP_INTRO || kind > PC_MOVIE_SKIP_CUTSCENE) {
+        retire_locked();
+    } else {
+        if (m_session != session || m_kind != kind) {
+            retire_locked();
+            m_session = session;
+            m_kind = kind;
+            m_started = now;
+        }
+        m_seen = now;
+    }
+    ReleaseSRWLockExclusive(&m_lock);
+}
+
+static int srt_time_ms(const char *s, uint64_t *out)
+{
+    int h, m, sec, ms;
+    if (sscanf(s, "%d:%d:%d,%d", &h, &m, &sec, &ms) != 4 ||
+        h < 0 || m < 0 || m > 59 || sec < 0 || sec > 59 || ms < 0 || ms > 999) return 0;
+    *out = (((uint64_t)h * 60u + (unsigned)m) * 60u + (unsigned)sec) * 1000u + (unsigned)ms;
+    return 1;
+}
+
+static int subtitle_supported_stem(const char *stem)
+{
+    static const char *const supported[] = {
+        "03_N", "05_N", "07_N", "09_N", "11_N", "13_N", "15_N", "17_N", "18_N"
+    };
+    unsigned i;
+    if (!stem || !*stem) return 0;
+    for (i = 0; i < sizeof(supported) / sizeof(supported[0]); ++i)
+        if (!_stricmp(stem, supported[i])) return 1;
+    return 0;
+}
+
+static void subtitle_load_locked(void)
+{
+    FILE *f;
+    char line[1024];
+    char subtitle_path[MAX_PATH];
+    const char *language = getenv("RECOMP_LANGUAGE");
+    const char *directory = language && !_stricmp(language, "pt-BR") ? "subtitles\\pt-BR\\" :
+        language && !_stricmp(language, "es") ? "subtitles\\es\\" :
+        language && !_stricmp(language, "fr") ? "subtitles\\fr\\" :
+        language && !_stricmp(language, "de") ? "subtitles\\de\\" :
+        language && !_stricmp(language, "it") ? "subtitles\\it\\" : "subtitles\\";
+    m_subtitle_loaded = 1;
+    m_caption_count = 0;
+    if (!m_subtitle_target || !m_subtitle_stem[0] ||
+        _snprintf_s(subtitle_path, sizeof(subtitle_path), _TRUNCATE,
+                    "%s%s.srt", directory, m_subtitle_stem) < 0) return;
+    f = fopen(subtitle_path, "rb");
+    if (!f) {
+        fprintf(stderr, "[SUBTITLE] %s not found\n", subtitle_path);
+        return;
+    }
+    while (m_caption_count < PC_MOVIE_CAPTIONS && fgets(line, sizeof(line), f)) {
+        uint64_t start, end;
+        char *arrow, joined[PC_MOVIE_CAPTION_CHARS * 4];
+        size_t used = 0;
+        int wide_count;
+        while (fgets(line, sizeof(line), f)) {
+            char *p = line;
+            while (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n') p++;
+            if (*p) break;
+        }
+        if (!line[0]) break;
+        arrow = strstr(line, " --> ");
+        if (!arrow) continue;
+        *arrow = 0;
+        if (!srt_time_ms(line, &start) || !srt_time_ms(arrow + 5, &end) || end <= start) continue;
+        joined[0] = 0;
+        while (fgets(line, sizeof(line), f)) {
+            size_t n = strlen(line);
+            while (n && (line[n - 1] == '\r' || line[n - 1] == '\n')) line[--n] = 0;
+            if (!n) break;
+            if (used && used + 1 < sizeof(joined)) joined[used++] = '\n';
+            if (n > sizeof(joined) - used - 1) n = sizeof(joined) - used - 1;
+            memcpy(joined + used, line, n); used += n; joined[used] = 0;
+        }
+        if (!used) continue;
+        wide_count = MultiByteToWideChar(CP_UTF8, 0, joined, -1,
+            (wchar_t *)m_captions[m_caption_count].text, PC_MOVIE_CAPTION_CHARS);
+        if (!wide_count) continue;
+        m_captions[m_caption_count].start = start;
+        m_captions[m_caption_count].end = end;
+        m_caption_count++;
+    }
+    fclose(f);
+    fprintf(stderr, "[SUBTITLE] loaded %u cues for %s\n", m_caption_count, m_subtitle_stem);
+}
+
+void pc_movie_skip_subtitle_target(uint64_t session, const char *stem)
+{
+    AcquireSRWLockExclusive(&m_lock);
+    if (active_locked(now_ms()) && session == m_session) {
+        const int target = subtitle_supported_stem(stem);
+        if (target != m_subtitle_target ||
+            (target && _stricmp(stem, m_subtitle_stem) != 0)) {
+            m_subtitle_target = target;
+            if (target) strncpy_s(m_subtitle_stem, sizeof(m_subtitle_stem), stem, _TRUNCATE);
+            else m_subtitle_stem[0] = 0;
+            m_subtitle_loaded = 0;
+            m_caption_count = 0;
+        }
+    }
+    ReleaseSRWLockExclusive(&m_lock);
+}
+
+int pc_movie_skip_subtitle(uint16_t *out, unsigned capacity)
+{
+    uint64_t elapsed;
+    unsigned i;
+    int found = 0;
+    if (!out || !capacity) return 0;
+    out[0] = 0;
+    AcquireSRWLockExclusive(&m_lock);
+    if (active_locked(now_ms()) && m_subtitle_target && m_started) {
+        if (!m_subtitle_loaded) subtitle_load_locked();
+        elapsed = now_ms() - m_started;
+        for (i = 0; i < m_caption_count; ++i) {
+            if (elapsed >= m_captions[i].start && elapsed < m_captions[i].end) {
+                unsigned n = 0;
+                while (m_captions[i].text[n] && n + 1 < capacity) { out[n] = m_captions[i].text[n]; n++; }
+                out[n] = 0;
+                found = n != 0;
+                break;
+            }
+        }
+    }
+    ReleaseSRWLockExclusive(&m_lock);
+    return found;
+}
+
+int pc_movie_skip_take_request(uint64_t session)
+{
+    int take;
+    AcquireSRWLockExclusive(&m_lock);
+    take = active_locked(now_ms()) && session == m_session && m_request;
+    if (take) retire_locked();
+    ReleaseSRWLockExclusive(&m_lock);
+    return take;
+}
+
+void pc_movie_skip_clear(void)
+{
+    AcquireSRWLockExclusive(&m_lock);
+    retire_locked();
+    ReleaseSRWLockExclusive(&m_lock);
+}
+
+int pc_movie_skip_active(void)
+{
+    int active;
+    AcquireSRWLockExclusive(&m_lock);
+    active = active_locked(now_ms());
+    ReleaseSRWLockExclusive(&m_lock);
+    return active;
+}
+
+static unsigned key_bit(unsigned id)
+{
+    switch (id) {
+    case KEY_ESC: return 1u;
+    case KEY_ENTER: return 2u;
+    case KEY_SPACE: return 4u;
+    case KEY_NUMENTER: return 8u;
+    default: return 0u;
+    }
+}
+
+static int f_key(unsigned id, int down, int repeat)
+{
+    const uint64_t now = now_ms();
+    const unsigned bit = key_bit(id);
+    int active, take;
+    if (id >= sizeof(m_swallowed) || id == KEY_F11) return 0;
+    AcquireSRWLockExclusive(&m_lock);
+    active = active_locked(now);
+    take = active || m_swallowed[id];
+    if (down) {
+        const int edge = bit && !(m_keys & bit) && !repeat;
+        m_keys |= bit;
+        if (active) m_swallowed[id] = 1;
+        if (edge) press_locked(now);
+    } else {
+        m_keys &= ~bit;
+        m_swallowed[id] = 0;
+        release_locked();
+    }
+    ReleaseSRWLockExclusive(&m_lock);
+    return take;
+}
+
+static int f_button(int button, int down)
+{
+    const uint64_t now = now_ms();
+    unsigned bit;
+    int active, take;
+    if (button < 0 || button > 4) return 0;
+    bit = 1u << button;
+    AcquireSRWLockExclusive(&m_lock);
+    active = active_locked(now);
+    take = active || (m_mouse_swallowed & bit) != 0;
+    if (down) {
+        const int edge = button == 0 && !m_mouse;
+        if (button == 0) m_mouse = 1;
+        if (active) m_mouse_swallowed |= bit;
+        if (edge) press_locked(now);
+    } else {
+        if (button == 0) m_mouse = 0;
+        m_mouse_swallowed &= ~bit;
+        release_locked();
+    }
+    ReleaseSRWLockExclusive(&m_lock);
+    return take;
+}
+
+static int f_wheel(int delta) { (void)delta; return pc_movie_skip_active(); }
+
+static int f_report(uint8_t out[20], int pad_present)
+{
+    const uint64_t now = now_ms();
+    /* Xbox report: digital START, analog A/B. A real or scripted pad
+     * enters the same filter before the guest can act on its own skip input. */
+    const unsigned down = pad_present ?
+        ((out[2] & 0x10u) ? 1u : 0u) |
+        ((out[4] > 30u) ? 2u : 0u) | ((out[5] > 30u) ? 4u : 0u) : 0u;
+    int active, take;
+    AcquireSRWLockExclusive(&m_lock);
+    active = active_locked(now);
+    take = active || (m_pad_swallowed && down);
+    {
+        const unsigned edge = down & ~m_pad;
+        m_pad = down;
+        if (active && down) m_pad_swallowed = 1;
+        if (edge) press_locked(now);
+        if (!down) m_pad_swallowed = 0;
+        release_locked();
+    }
+    ReleaseSRWLockExclusive(&m_lock);
+    return take;
+}
+
+static void f_focus(int focused)
+{
+    AcquireSRWLockExclusive(&m_lock);
+    m_focused = focused != 0;
+    m_release = 1; /* A held pad on focus return needs a fresh release. */
+    if (!focused) {
+        m_confirm = m_request = 0;
+        pc_menu_set_movie_skip_prompt(0);
+        /* Key-up may go to another window; require a fresh release on return. */
+        m_keys = m_mouse = 0;
+        m_release = 1;
+    }
+    ReleaseSRWLockExclusive(&m_lock);
+}
+
+static const PcInputFilter k_filter = { f_key, f_button, f_wheel, f_report, f_focus };
+void pc_movie_skip_install(void) { pc_input_set_filter_slot(2, &k_filter); }
+
+#ifdef PC_MOVIE_SKIP_TEST
+void pc_movie_skip_test_reset(void)
+{
+    AcquireSRWLockExclusive(&m_lock);
+    m_keys = m_pad = m_mouse = m_mouse_swallowed = 0;
+    m_pad_swallowed = 0;
+    m_focused = 1;
+    memset(m_swallowed, 0, sizeof(m_swallowed));
+    retire_locked();
+    ReleaseSRWLockExclusive(&m_lock);
+}
+#endif
