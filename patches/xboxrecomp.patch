+++ b/src/nv2a/kelvin/kelvin_int.h
@@ -0,0 +1,414 @@
+/*
+ * Kelvin: a CPU implementation of the NV2A 3D engine, for titles that drive
+ * the GPU themselves through a statically linked D3D8 (D3D8LTCG and friends).
+ *
+ * Structure and semantics follow xemu (hw/xbox/nv2a): the method handlers and
+ * PGRAPH register model are ported from pgraph/pgraph.c, and the vertex and
+ * pixel pipelines implement what xemu's GLSL generators (glsl/vsh*.c,
+ * glsl/psh.c, glsl/geom.c) emit, evaluated per vertex and per pixel instead of
+ * compiled. By default rendering writes into guest surfaces. The opt-in
+ * resolution path owns larger full-screen surfaces and mirrors them at GPU
+ * fences while retaining their detail for render-target texture feedback.
+ *
+ * Copyright (c) 2012 espes
+ * Copyright (c) 2015 Jannik Vogel
+ * Copyright (c) 2018-2025 Matt Borgerson
+ * (xemu PGRAPH, from which the state model and method handlers are ported)
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+#ifndef XBOX_NV2A_KELVIN_INT_H
+#define XBOX_NV2A_KELVIN_INT_H
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <string.h>
+#include <stdio.h>
+#include <math.h>
+
+#include "../qemu_shim.h"
+#include "../nv2a_regs.h"
+#include "kelvin_enums.h"
+#include "psh_regs.h"
+
+#define KELVIN_SUBCHANNELS 8
+
+/* Guest-visible NV2A aperture layout. */
+#define KELVIN_APERTURE_VA   0xFD000000u
+#define KELVIN_PFIFO_BASE    0x00002000u
+#define KELVIN_PGRAPH_BASE   0x00400000u
+#define KELVIN_PRAMIN_BASE   0x00700000u
+#define KELVIN_PRAMIN_SIZE   0x00100000u
+#define KELVIN_USER_BASE     0x00800000u
+#define KELVIN_USER_DMA_PUT  0x00800040u
+#define KELVIN_USER_DMA_GET  0x00800044u
+
+/* Every surface, texture and vertex address is physical; the contiguous
+ * window is the physical view of guest RAM. */
+#define KELVIN_PHYS_WINDOW   0x80000000u
+/* 128 MB: the contiguous window's 64 MB, then low RAM's own physical view
+ * above it (xbox_PhysicalAddressOf), both reached as 0x80000000 + P. */
+#define KELVIN_PHYS_SIZE     0x08000000u
+
+typedef struct VertexAttribute {
+    bool dma_select;
+    uint32_t offset;
+    unsigned int inline_array_offset;
+    float inline_value[4];
+    unsigned int format;
+    unsigned int size;   /* size of the data type */
+    unsigned int count;  /* number of components */
+    uint32_t stride;
+    float *inline_buffer;
+    bool inline_buffer_populated;
+} VertexAttribute;
+
+typedef struct SurfaceShape {
+    unsigned int z_format;
+    unsigned int color_format;
+    unsigned int zeta_format;
+    unsigned int log_width, log_height;
+    unsigned int clip_x, clip_y;
+    unsigned int clip_width, clip_height;
+    unsigned int anti_aliasing;
+} SurfaceShape;
+
+typedef struct Surface {
+    unsigned int pitch;
+    uint32_t offset;
+} Surface;
+
+typedef struct ContextSurfaces2DState {
+    uint32_t object_instance;
+    uint32_t dma_image_source;
+    uint32_t dma_image_dest;
+    unsigned int color_format;
+    unsigned int source_pitch, dest_pitch;
+    uint32_t source_offset, dest_offset;
+} ContextSurfaces2DState;
+
+typedef struct ImageBlitState {
+    uint32_t object_instance;
+    uint32_t context_surfaces;
+    unsigned int operation;
+    unsigned int in_x, in_y;
+    unsigned int out_x, out_y;
+    unsigned int width, height;
+} ImageBlitState;
+
+typedef struct BetaState {
+    uint32_t object_instance;
+    uint32_t beta;
+} BetaState;
+
+/* What the engine did, for the report and for deciding what to build next.
+ * A feature the pipeline does not implement is counted here and never
+ * silently approximated. */
+typedef struct KelvinStats {
+    uint64_t methods, words, jumps, calls;
+    uint64_t draws, draws_nop, prims, triangles, lines, pixels;
+    uint64_t triangles_bounds_clamped;
+    uint64_t clears, flips, semaphores, image_blits, notifies;
+    uint64_t swizzled_clears;
+    /* Batches handed to the raster threads, and those that waited for
+     * every earlier batch: scanned by one thread, sampling their own
+     * target, or conflicting with an unfinished batch. */
+    uint64_t raster_batches, raster_batches_single, raster_batches_snapshot,
+        raster_batches_conflict;
+    /* Vertices shaded, and those shaded on several threads at once. */
+    uint64_t vertices, vertices_parallel;
+    /* Draws whose vertices were shaded and triangles set up on the raster
+     * threads after the GPU thread went on (kelvin_render.c draw jobs). */
+    uint64_t draws_deferred;
+    uint64_t unhandled_methods;
+    uint64_t unsupported[64];
+} KelvinStats;
+
+/* Unimplemented features, indexed into KelvinStats.unsupported. */
+enum {
+    KU_CLASS = 0,           /* method on an object class we do not model */
+    KU_KELVIN_METHOD,       /* Kelvin method with no handler */
+    KU_FF_LIGHTING,
+    KU_FF_TEXGEN,
+    KU_FF_SKINNING,
+    KU_FF_FOGGEN,
+    KU_POINT_PRIM,
+    KU_POLY_MODE,
+    KU_TEX_MODE,
+    KU_TEX_FORMAT,
+    KU_TEX_3D,
+    KU_TEX_CUBE,
+    KU_TEX_BORDER,
+    KU_SHADOW_MAP,
+    KU_SURFACE_FORMAT,
+    KU_SWIZZLED_SURFACE,
+    KU_ZETA_FLOAT,
+    KU_LOGIC_OP,
+    KU_WINDOW_CLIP,
+    KU_REPORT,
+    KU_DMA_UNRESOLVED,
+    KU_IMAGE_BLIT_OP,
+    KU_CONVOLUTION,
+    KU_DOTMAP_HILO,
+    KU_SPECULAR_POWER,
+    KU_COUNT
+};
+
+typedef struct KelvinState {
+    /* PGRAPH registers, NV_PGRAPH_* offsets. The title reaches the same
+     * array through the trapped PGRAPH page (kelvin_mmio.c). */
+    uint32_t *regs;
+
+    /* NV_PGRAPH_INTR and NV_PGRAPH_INTR_EN, which are not storage: reads of
+     * INTR return what is pending and writes clear what they name. */
+    uint32_t pending_interrupts;
+    uint32_t enabled_interrupts;
+
+    unsigned int subch_class[KELVIN_SUBCHANNELS];
+    uint32_t subch_instance[KELVIN_SUBCHANNELS];
+
+    ContextSurfaces2DState context_surfaces_2d;
+    ImageBlitState image_blit;
+    BetaState beta;
+    uint32_t kelvin_object_instance;
+
+    uint32_t dma_color, dma_zeta;
+    Surface surface_color, surface_zeta;
+    unsigned int surface_type;
+    SurfaceShape surface_shape;
+
+    uint32_t dma_a, dma_b;
+    bool texture_matrix_enable[NV2A_MAX_TEXTURES];
+
+    uint32_t dma_state, dma_notifies, dma_semaphore, dma_report;
+    bool zpass_pixel_count_enable;
+    uint32_t dma_vertex_a, dma_vertex_b;
+
+    uint32_t primitive_mode;
+    bool enable_vertex_program_write;
+
+    uint32_t vertex_state_shader_v0[4];
+    uint32_t program_data[NV2A_MAX_TRANSFORM_PROGRAM_LENGTH][VSH_TOKEN_SIZE];
+    uint32_t program_writes;         /* words written to program_data */
+    uint32_t vsh_constants[NV2A_VERTEXSHADER_CONSTANTS][4];
+    bool vsh_constants_dirty[NV2A_VERTEXSHADER_CONSTANTS];
+
+    uint32_t ltctxa[NV2A_LTCTXA_COUNT][4];
+    uint32_t ltctxb[NV2A_LTCTXB_COUNT][4];
+    uint32_t ltc1[NV2A_LTC1_COUNT][4];
+
+    float material_alpha;
+    float light_infinite_half_vector[NV2A_MAX_LIGHTS][3];
+    float light_infinite_direction[NV2A_MAX_LIGHTS][3];
+    float light_local_position[NV2A_MAX_LIGHTS][3];
+    float light_local_attenuation[NV2A_MAX_LIGHTS][3];
+    float specular_params[6];
+    float specular_power;
+    float specular_params_back[6];
+    float specular_power_back;
+    float point_params[8];
+
+    VertexAttribute vertex_attributes[NV2A_VERTEXSHADER_ATTRIBUTES];
+    uint16_t compressed_attrs;
+
+    unsigned int inline_array_length;
+    uint32_t inline_array[NV2A_MAX_BATCH_LENGTH];
+    unsigned int inline_elements_length;
+    uint32_t inline_elements[NV2A_MAX_BATCH_LENGTH];
+    unsigned int inline_buffer_length;
+
+    unsigned int draw_arrays_length;
+    unsigned int draw_arrays_min_start;
+    unsigned int draw_arrays_max_count;
+    int32_t draw_arrays_start[1250];
+    int32_t draw_arrays_count[1250];
+    bool draw_arrays_prevent_connect;
+
+    bool waiting_for_flip;
+    bool waiting_for_nop;
+    bool waiting_for_context_switch;
+
+    KelvinStats stats;
+} KelvinState;
+
+extern KelvinState g_kelvin;
+
+/* For the small helpers of the per-pixel path, which the compiler would
+ * otherwise call. */
+#ifdef _MSC_VER
+#define KELVIN_INLINE static __forceinline
+#else
+#define KELVIN_INLINE static inline __attribute__((always_inline))
+#endif
+
+static inline uint32_t pgraph_reg_r(KelvinState *pg, unsigned int r)
+{
+    return pg->regs[r / 4];
+}
+
+static inline void pgraph_reg_w(KelvinState *pg, unsigned int r, uint32_t v)
+{
+    pg->regs[r / 4] = v;
+}
+
+#define PG_GET_MASK(reg, mask) GET_MASK(pgraph_reg_r(pg, reg), mask)
+#define PG_SET_MASK(reg, mask, value)        \
+    do {                                     \
+        uint32_t rv = pgraph_reg_r(pg, reg); \
+        SET_MASK(rv, mask, value);           \
+        pgraph_reg_w(pg, reg, rv);           \
+    } while (0)
+
+static inline float kelvin_u2f(uint32_t v)
+{
+    float f;
+    memcpy(&f, &v, 4);
+    return f;
+}
+
+static inline uint32_t kelvin_f2u(float f)
+{
+    uint32_t v;
+    memcpy(&v, &f, 4);
+    return v;
+}
+
+/* Count an unimplemented feature, and say so the first time. */
+void kelvin_unsupported(int what, const char *detail, uint32_t value);
+
+/* Guest memory. */
+uint8_t *kelvin_guest(uint32_t va);
+uint8_t *kelvin_aperture(uint32_t offset);
+uint32_t kelvin_aperture_r32(uint32_t offset);
+
+/* Objects: instance address of a RAMHT handle, and the DMA objects there. */
+bool kelvin_ramht_lookup(uint32_t handle, uint32_t *instance,
+                         unsigned int *engine);
+uint32_t kelvin_pramin_r32(uint32_t offset);
+/* Guest VA of `offset` bytes into the DMA object at `instance` (an instance
+ * address, as PGRAPH receives it), or 0 if out of range. */
+uint32_t kelvin_dma_va(uint32_t instance, uint32_t offset, uint32_t bytes);
+uint32_t kelvin_dma_limit(uint32_t instance);
+
+/* Registers with behaviour (kelvin_mmio.c). The lock serialises the engine
+ * against the title's register accesses, as xemu's pgraph lock does; every
+ * method runs under it, and so does every trapped access. */
+void kelvin_lock(void);
+void kelvin_unlock(void);
+void kelvin_lock_yield(void);
+/* Whether a register access or vblank is waiting for the lock. */
+bool kelvin_lock_wanted(void);
+bool kelvin_mmio_start(KelvinState *pg);
+void kelvin_mmio_report(void);
+/* Recompute the interrupt line after a source changed. Lock held. */
+void kelvin_irq_update(void);
+/* Before a method on channel `chid`: PGRAPH holds another channel's context,
+ * so raise the context-switch interrupt and wait for the title to load it
+ * (xemu pgraph_context_switch). Lock held. */
+void kelvin_context_switch(KelvinState *pg, unsigned int chid);
+
+/* PGRAPH, ported from xemu. */
+void kelvin_pgraph_init(KelvinState *pg, uint32_t *regs);
+bool kelvin_pgraph_method_run(KelvinState *pg, unsigned int subchannel, unsigned int method,
+                              const uint32_t *words, uint32_t n);
+void kelvin_pgraph_method(KelvinState *pg, unsigned int subchannel,
+                          unsigned int method, uint32_t parameter, bool inc);
+
+/* Vertex bookkeeping (xemu pgraph/vertex.c). */
+void pgraph_update_inline_value(VertexAttribute *attr, const uint8_t *data);
+void pgraph_allocate_inline_buffer_vertices(KelvinState *pg, unsigned int attr);
+void pgraph_finish_inline_buffer_vertex(KelvinState *pg);
+void pgraph_reset_inline_buffers(KelvinState *pg);
+void pgraph_reset_draw_arrays(KelvinState *pg);
+
+/* The renderer: what xemu's renderer ops do, on the CPU. */
+void kelvin_render_clear_surface(KelvinState *pg, uint32_t parameter);
+void kelvin_render_draw_begin(KelvinState *pg);
+void kelvin_render_draw_end(KelvinState *pg);
+void kelvin_render_flush_draw(KelvinState *pg);
+void kelvin_render_image_blit(KelvinState *pg);
+void kelvin_render_flip_stall(KelvinState *pg,
+                              uint32_t aspect_w, uint32_t aspect_h);
+/* GPU-pusher current-method metadata; never sampled from title state. */
+extern uint32_t g_kelvin_frame_aspect_w, g_kelvin_frame_aspect_h;
+void kelvin_render_semaphore_release(KelvinState *pg, uint32_t value);
+/* Wait until every pixel handed to the raster threads is written. Anything
+ * that touches surfaces or tells the title how far the GPU has got calls it
+ * first. */
+void kelvin_render_sync(void);
+
+/* RECOMP_KELVIN_TIMING=1: where the GPU thread's time goes, in
+ * QueryPerformanceCounter ticks, reported per flip by kelvin_report. */
+enum {
+    KT_LOOP,            /* the GPU thread's whole loop */
+    KT_PUSHER,          /* inside pusher_run */
+    KT_DRAW,            /* kelvin_render_flush_draw */
+    KT_PRESHADE,        /* its parallel vertex shading */
+    KT_SUBMIT,          /* its waits for queue room */
+    KT_GEOMETRY,        /* waits for draw jobs to finish, wherever */
+    KT_SYNC_CLEAR,      /* waits for the raster queue to empty, by cause */
+    KT_SYNC_SEMAPHORE,
+    KT_SYNC_FLIP,
+    KT_SYNC_NOTIFY,
+    KT_SYNC_IDLE,       /* the pusher reaching PUT */
+    KT_SYNC_OTHER,
+    KT_WAIT_PUT,        /* loops that read no word: nothing past GET, */
+    KT_WAIT_FLIP,       /* a flip stall waiting for the vblank ISR, */
+    KT_WAIT_ACK,        /* or a notify, context switch or FIFO access off */
+    KT_COUNT
+};
+extern int g_kelvin_timing;
+extern long long g_kelvin_ticks[KT_COUNT];
+/* With timing: pixel positions scanned in triangles' bounds, fragments
+ * inside them, and fragments written. */
+extern volatile long long g_kelvin_scan[3];
+/* The method the engine is executing, subchannel << 16 | method, for the
+ * job trace. */
+extern uint32_t g_kelvin_method;
+long long kelvin_ticks(void);
+/* kelvin_render_sync, charging the wait to one of the KT_SYNC_ causes. */
+void kelvin_render_sync_for(int cause);
+/* RECOMP_KELVIN_JOBTRACE: a GPU-thread event from t0 to t1 (kelvin_ticks):
+ * 1 a draw, 2 a wait for a draw job, 3 a loop that read no word (detail:
+ * the KT_WAIT_ cause), 4 pusher_run. */
+void kelvin_render_trace_event(int kind, long long t0, long long t1, uint32_t detail);
+/* Whether the job trace is recording (the traced frame). */
+extern bool g_kelvin_tracing;
+/* The pushbuffer address of the word the engine is executing, set by the
+ * pusher before each method. */
+extern uint32_t g_kelvin_word_get;
+/* The GET to publish with the pusher at `get` after `words` words: never
+ * past a draw whose vertices a draw job may still be reading from guest
+ * memory, which the title may reuse once GET is past it. A draw job more
+ * than a bounded number of words behind is finished first, so GET stays
+ * well inside D3D's fence margin. */
+uint32_t kelvin_render_get_bound(uint32_t get, uint64_t words);
+
+/* Surface description, as the pipeline needs it. */
+typedef struct KelvinTarget {
+    uint8_t *color;          /* host pointer to the colour surface, or NULL */
+    uint8_t *zeta;           /* host pointer to the zeta surface, or NULL */
+    uint32_t color_va, zeta_va;
+    unsigned int color_bpp, zeta_bpp;
+    unsigned int color_pitch, zeta_pitch;
+    bool swizzled;
+    uint32_t swz_mask_x, swz_mask_y;     /* when swizzled */
+    unsigned int width, height;          /* in stored pixels (AA-scaled) */
+    unsigned int aa_x, aa_y;             /* anti-aliasing scale factors */
+    int clip_x0, clip_y0, clip_x1, clip_y1;   /* scissor, stored pixels */
+    /* Host raster size is independent of the unchanged guest allocation.
+     * Zero scales retain the legacy AA factors (also for standalone tests). */
+    double raster_x, raster_y;
+    unsigned int guest_width, guest_height, guest_color_pitch, guest_zeta_pitch;
+    size_t guest_color_bytes, guest_zeta_bytes;
+    unsigned int host_color, host_zeta;   /* cache slot + 1, zero for guest */
+} KelvinTarget;
+
+bool kelvin_bind_target(KelvinState *pg, KelvinTarget *t, bool need_color,
+                        bool need_zeta);
+
+#endif
diff --git a/src/nv2a/kelvin/kelvin_mmio.c b/src/nv2a/kelvin/kelvin_mmio.c
new file mode 100644
index 0000000..b2f896e
--- /dev/null
+++ b/src/nv2a/kelvin/kelvin_mmio.c
@@ -0,0 +1,585 @@
+/*
+ * Kelvin: the NV2A registers that behave rather than store.
+ *
+ * The GPU's interrupt protocol lives in three register blocks: PMC, whose
+ * INTR_0 summarises which unit is interrupting; PGRAPH, with the graphics
+ * engine's status, the notify trap and the flip read index; and PCRTC, with
+ * vblank. Their status registers are write-1-to-clear, PMC_INTR_0 is computed
+ * from the others, and a few PGRAPH registers are triggers. None of that works
+ * as plain memory -- an ISR acknowledging an interrupt writes the pending bit
+ * back rather than clearing it -- so while the engine runs these pages are
+ * PAGE_NOACCESS and every access by the title is serviced here, decoded by
+ * platform/mmio_decode.h.
+ *
+ * Semantics follow xemu: pmc.c, pcrtc.c, pgraph_read/pgraph_write and
+ * nv2a_update_irq. A register without behaviour keeps plain storage, so a
+ * value the title wrote reads back as before; the one departure from xemu is
+ * that unlisted PMC and PCRTC registers store rather than read as zero.
+ *
+ * The interrupt is level-triggered, as on hardware: the line is up while an
+ * enabled source is pending and PMC_INTR_EN_0 is set. The kernel's interrupt
+ * thread polls kelvin_irq_asserted() and runs the title's ISR; this module
+ * signals kelvin_irq_event() so that thread need not wait out its tick.
+ * Not modelled: PFIFO, PBUS, PTIMER and PVIDEO interrupts (nothing here
+ * raises them), and hardware context switching.
+ *
+ * Copyright (c) 2012 espes
+ * Copyright (c) 2015 Jannik Vogel
+ * Copyright (c) 2018-2025 Matt Borgerson
+ * (xemu PMC/PCRTC/PGRAPH register semantics this follows)
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include <windows.h>
+
+#include "kelvin_int.h"
+#include "kelvin.h"
+#include "platform/mmio_decode.h"
+
+#define PMC_BASE     0x000000u
+#define PMC_SIZE     0x1000u
+#define PGRAPH_SIZE  0x2000u
+#define PCRTC_BASE   0x600000u
+#define PCRTC_SIZE   0x1000u
+
+static uint32_t s_pmc[PMC_SIZE / 4];
+static uint32_t s_pgraph[PGRAPH_SIZE / 4];
+static uint32_t s_pcrtc[PCRTC_SIZE / 4];
+static uint32_t s_pcrtc_raster;
+
+static KelvinState *s_pg;
+static SRWLOCK s_lock = SRWLOCK_INIT;
+static volatile LONG s_waiters;
+static HANDLE s_irq_event;
+static PVOID s_veh;
+static uint8_t *s_ap;             /* host address of aperture offset 0 */
+static volatile LONG s_trapped;
+
+static uint64_t s_irqs_raised;
+
+void kelvin_lock(void)
+{
+    AcquireSRWLockExclusive(&s_lock);
+}
+
+void kelvin_unlock(void)
+{
+    ReleaseSRWLockExclusive(&s_lock);
+}
+
+bool kelvin_lock_wanted(void)
+{
+#ifdef _MSC_VER
+    return ReadAcquire(&s_waiters) != 0;
+#else
+    return __atomic_load_n(&s_waiters, __ATOMIC_ACQUIRE) != 0;
+#endif
+}
+
+/* The engine lets the lock go as soon as a register access is waiting (see
+ * pusher_run). SRW locks are not fair, so after each release it steps aside
+ * when one is. */
+void kelvin_lock_yield(void)
+{
+    if (InterlockedCompareExchange(&s_waiters, 0, 0)) {
+        SwitchToThread();
+    }
+}
+
+/* ---- the interrupt line ------------------------------------------------------ */
+
+/* NV_PMC_INTR_0: one bit per unit with an enabled interrupt pending. Lock
+ * held. */
+static uint32_t pmc_pending(void)
+{
+    uint32_t p = 0;
+
+    if (s_pcrtc[NV_PCRTC_INTR_0 / 4] & s_pcrtc[NV_PCRTC_INTR_EN_0 / 4]) {
+        p |= NV_PMC_INTR_0_PCRTC;
+    }
+    if (s_pg->pending_interrupts & s_pg->enabled_interrupts) {
+        p |= NV_PMC_INTR_0_PGRAPH;
+    }
+    return p;
+}
+
+static bool line_up(void)
+{
+    return pmc_pending() && s_pmc[NV_PMC_INTR_EN_0 / 4];
+}
+
+void kelvin_irq_update(void)
+{
+    if (line_up()) {
+        s_irqs_raised++;
+        if (s_irq_event) {
+            SetEvent(s_irq_event);
+        }
+    }
+}
+
+int kelvin_irq_asserted(void)
+{
+    int up;
+
+    if (!InterlockedCompareExchange(&s_trapped, 0, 0)) {
+        return 0;
+    }
+    /* The timer polls this immediately after raising vblank. Announce the
+     * wait just like vblank and guest register accesses: otherwise the
+     * pusher cannot see this reader and keeps reacquiring the unfair SRW
+     * lock at word boundaries, delaying both the ISR and the next tick. */
+    InterlockedIncrement(&s_waiters);
+    AcquireSRWLockShared(&s_lock);
+    InterlockedDecrement(&s_waiters);
+    up = line_up();
+    ReleaseSRWLockShared(&s_lock);
+    return up;
+}
+
+void *kelvin_irq_event(void)
+{
+    return InterlockedCompareExchange(&s_trapped, 0, 0) ? s_irq_event : NULL;
+}
+
+void kelvin_vblank(void)
+{
+    if (!InterlockedCompareExchange(&s_trapped, 0, 0)) {
+        return;
+    }
+    InterlockedIncrement(&s_waiters);
+    kelvin_lock();
+    InterlockedDecrement(&s_waiters);
+    s_pcrtc[NV_PCRTC_INTR_0 / 4] |= NV_PCRTC_INTR_0_VBLANK;
+    kelvin_irq_update();
+    kelvin_unlock();
+}
+
+void kelvin_context_switch(KelvinState *pg, unsigned int chid)
+{
+    static unsigned said;
+    bool channel_valid =
+        pgraph_reg_r(pg, NV_PGRAPH_CTX_CONTROL) & NV_PGRAPH_CTX_CONTROL_CHID;
+    unsigned int current = PG_GET_MASK(NV_PGRAPH_CTX_USER,
+                                       NV_PGRAPH_CTX_USER_CHID);
+
+    if (channel_valid && current == chid) {
+        return;
+    }
+    if (said++ < 4) {
+        fprintf(stderr, "[KELVIN] context switch to channel %u requested"
+                        " (CTX_CONTROL 0x%08X, CTX_USER 0x%08X)\n", chid,
+                pgraph_reg_r(pg, NV_PGRAPH_CTX_CONTROL),
+                pgraph_reg_r(pg, NV_PGRAPH_CTX_USER));
+        fflush(stderr);
+    }
+    PG_SET_MASK(NV_PGRAPH_TRAPPED_ADDR, NV_PGRAPH_TRAPPED_ADDR_CHID, chid);
+    pg->waiting_for_context_switch = true;
+    pg->pending_interrupts |= NV_PGRAPH_INTR_CONTEXT_SWITCH;
+    kelvin_irq_update();
+}
+
+/* ---- PMC ------------------------------------------------------------------------ */
+
+static uint32_t pmc_read(uint32_t reg)
+{
+    switch (reg) {
+    case NV_PMC_BOOT_0:
+        return 0x02A000A3;           /* NV2A, A03, rev 0 -- as xemu reports */
+    case NV_PMC_INTR_0:
+        return pmc_pending();
+    default:
+        return s_pmc[reg / 4];
+    }
+}
+
+static void pmc_write(uint32_t reg, uint32_t val, uint32_t mask)
+{
+    switch (reg) {
+    case NV_PMC_INTR_0:
+        /* Write-1-to-clear, but every bit here is computed from a unit's
+         * own status: clearing it means clearing that. */
+        kelvin_irq_update();
+        break;
+    case NV_PMC_INTR_EN_0:
+        s_pmc[reg / 4] = (s_pmc[reg / 4] & ~mask) | (val & mask);
+        kelvin_irq_update();
+        break;
+    default:
+        s_pmc[reg / 4] = (s_pmc[reg / 4] & ~mask) | (val & mask);
+        break;
+    }
+}
+
+/* ---- PCRTC ---------------------------------------------------------------------- */
+
+static uint32_t pcrtc_read(uint32_t reg)
+{
+    if (reg == NV_PCRTC_RASTER) {
+        return s_pcrtc_raster++;
+    }
+    return s_pcrtc[reg / 4];
+}
+
+static void pcrtc_write(uint32_t reg, uint32_t val, uint32_t mask)
+{
+    switch (reg) {
+    case NV_PCRTC_INTR_0:
+        s_pcrtc[reg / 4] &= ~(val & mask);
+        kelvin_irq_update();
+        break;
+    case NV_PCRTC_INTR_EN_0:
+        s_pcrtc[reg / 4] = (s_pcrtc[reg / 4] & ~mask) | (val & mask);
+        kelvin_irq_update();
+        break;
+    case NV_PCRTC_START: {
+        static unsigned said;
+        uint32_t start = ((s_pcrtc[reg / 4] & ~mask) | (val & mask))
+                         & 0x07FFFFFF;
+        if (start != s_pcrtc[reg / 4] && said++ < 8) {
+            fprintf(stderr, "[KELVIN] scanout (PCRTC_START) -> 0x%08X\n",
+                    start);
+            fflush(stderr);
+        }
+        s_pcrtc[reg / 4] = start;
+        break;
+    }
+    default:
+        s_pcrtc[reg / 4] = (s_pcrtc[reg / 4] & ~mask) | (val & mask);
+        break;
+    }
+}
+
+/* ---- PGRAPH --------------------------------------------------------------------- */
+
+static uint32_t rdi_access(KelvinState *pg, bool write, uint32_t val)
+{
+    unsigned int select = PG_GET_MASK(NV_PGRAPH_RDI_INDEX,
+                                      NV_PGRAPH_RDI_INDEX_SELECT);
+    unsigned int address = PG_GET_MASK(NV_PGRAPH_RDI_INDEX,
+                                       NV_PGRAPH_RDI_INDEX_ADDRESS);
+    uint32_t r = 0;
+
+    if ((select == RDI_INDEX_VTX_CONSTANTS0 ||
+         select == RDI_INDEX_VTX_CONSTANTS1) &&
+        address / 4 < NV2A_VERTEXSHADER_CONSTANTS) {
+        uint32_t *c = &pg->vsh_constants[address / 4][3 - address % 4];
+        if (write) {
+            pg->vsh_constants_dirty[address / 4] |= (val != *c);
+            *c = val;
+        } else {
+            r = *c;
+        }
+    } else {
+        /* xemu does not model other RAM selects either: reads are zero and
+         * writes vanish. */
+        static unsigned said;
+        if (said++ < 4) {
+            fprintf(stderr, "[KELVIN] RDI %s select 0x%X address 0x%X"
+                            " not modelled\n", write ? "write" : "read",
+                    select, address);
+            fflush(stderr);
+        }
+    }
+    PG_SET_MASK(NV_PGRAPH_RDI_INDEX, NV_PGRAPH_RDI_INDEX_ADDRESS,
+                address + 1);
+    return r;
+}
+
+static uint32_t pgraph_read(uint32_t reg)
+{
+    KelvinState *pg = s_pg;
+
+    switch (reg) {
+    case NV_PGRAPH_INTR:
+        return pg->pending_interrupts;
+    case NV_PGRAPH_INTR_EN:
+        return pg->enabled_interrupts;
+    case NV_PGRAPH_RDI_DATA:
+        return rdi_access(pg, false, 0);
+    default:
+        return pgraph_reg_r(pg, reg);
+    }
+}
+
+static void pgraph_write(uint32_t reg, uint32_t val, uint32_t mask)
+{
+    KelvinState *pg = s_pg;
+
+    switch (reg) {
+    case NV_PGRAPH_INTR:
+        pg->pending_interrupts &= ~(val & mask);
+        if (!(pg->pending_interrupts & NV_PGRAPH_INTR_ERROR)) {
+            if (pg->waiting_for_nop) {
+                extern volatile long long g_kelvin_notify_raise_qpc, g_kelvin_notify_ticks, g_kelvin_notify_count;
+                LARGE_INTEGER now;
+                QueryPerformanceCounter(&now);
+                g_kelvin_notify_ticks += now.QuadPart - g_kelvin_notify_raise_qpc;
+                g_kelvin_notify_count++;
+            }
+            pg->waiting_for_nop = false;
+        }
+        if (!(pg->pending_interrupts & NV_PGRAPH_INTR_CONTEXT_SWITCH)) {
+            pg->waiting_for_context_switch = false;
+        }
+        kelvin_irq_update();
+        break;
+    case NV_PGRAPH_INTR_EN:
+        pg->enabled_interrupts = (pg->enabled_interrupts & ~mask)
+                                 | (val & mask);
+        kelvin_irq_update();
+        break;
+    case NV_PGRAPH_INCREMENT:
+        /* A trigger: the vblank handler advancing the flip read index. */
+        if (val & mask & NV_PGRAPH_INCREMENT_READ_3D) {
+            uint32_t modulo = PG_GET_MASK(NV_PGRAPH_SURFACE,
+                                          NV_PGRAPH_SURFACE_MODULO_3D);
+            uint32_t next = PG_GET_MASK(NV_PGRAPH_SURFACE,
+                                        NV_PGRAPH_SURFACE_READ_3D) + 1;
+            if (modulo) {
+                next %= modulo;
+            }
+            PG_SET_MASK(NV_PGRAPH_SURFACE, NV_PGRAPH_SURFACE_READ_3D, next);
+        }
+        break;
+    case NV_PGRAPH_RDI_DATA:
+        rdi_access(pg, true, val);
+        break;
+    case NV_PGRAPH_CHANNEL_CTX_TRIGGER:
+        if (val & mask & NV_PGRAPH_CHANNEL_CTX_TRIGGER_READ_IN) {
+            uint32_t ctx = PG_GET_MASK(NV_PGRAPH_CHANNEL_CTX_POINTER,
+                                       NV_PGRAPH_CHANNEL_CTX_POINTER_INST)
+                           << 4;
+            pgraph_reg_w(pg, NV_PGRAPH_CTX_USER, kelvin_pramin_r32(ctx));
+        }
+        break;
+    default:
+        pgraph_reg_w(pg, reg, (pgraph_reg_r(pg, reg) & ~mask) | (val & mask));
+        break;
+    }
+}
+
+/* ---- dispatch ------------------------------------------------------------------- */
+
+static bool owned(uint32_t off)
+{
+    return off - PMC_BASE < PMC_SIZE ||
+           off - KELVIN_PGRAPH_BASE < PGRAPH_SIZE ||
+           off - PCRTC_BASE < PCRTC_SIZE;
+}
+
+int kelvin_owns_register(unsigned int offset)
+{
+    /* Unowned blocks never need a state query. The trap publisher uses an
+     * InterlockedExchange after initialization; keep every owned query fresh
+     * without taking exclusive ownership of the flag's cache line. */
+    if (!owned(offset)) {
+        return 0;
+    }
+#ifdef _MSC_VER
+    return ReadAcquire(&s_trapped) != 0;
+#else
+    return __atomic_load_n(&s_trapped, __ATOMIC_ACQUIRE) != 0;
+#endif
+}
+
+static uint32_t reg_read(uint32_t reg)
+{
+    if (reg - PMC_BASE < PMC_SIZE) {
+        return pmc_read(reg - PMC_BASE);
+    }
+    if (reg - KELVIN_PGRAPH_BASE < PGRAPH_SIZE) {
+        return pgraph_read(reg - KELVIN_PGRAPH_BASE);
+    }
+    return pcrtc_read(reg - PCRTC_BASE);
+}
+
+/* `mask` names the bytes the access covers: a narrow write to a storage
+ * register merges, and one to a write-1-to-clear register clears only what
+ * it wrote. */
+static void reg_write(uint32_t reg, uint32_t val, uint32_t mask)
+{
+    if (reg - PMC_BASE < PMC_SIZE) {
+        pmc_write(reg - PMC_BASE, val, mask);
+    } else if (reg - KELVIN_PGRAPH_BASE < PGRAPH_SIZE) {
+        pgraph_write(reg - KELVIN_PGRAPH_BASE, val, mask);
+    } else {
+        pcrtc_write(reg - PCRTC_BASE, val, mask);
+    }
+}
+
+static uint64_t access_read(void *dev, uint32_t off, int size)
+{
+    unsigned shift = (off & 3) * 8;
+    uint64_t v;
+    (void)dev;
+
+    if (size == 8) {
+        return reg_read(off & ~3u) | ((uint64_t)reg_read((off & ~3u) + 4) << 32);
+    }
+    v = reg_read(off & ~3u) >> shift;
+    return size >= 4 ? v & 0xFFFFFFFFu : v & ((1u << (size * 8)) - 1);
+}
+
+static void access_write(void *dev, uint32_t off, uint64_t val, int size)
+{
+    unsigned shift = (off & 3) * 8;
+    uint32_t mask;
+    (void)dev;
+
+    if (size == 8) {
+        reg_write(off & ~3u, (uint32_t)val, 0xFFFFFFFFu);
+        reg_write((off & ~3u) + 4, (uint32_t)(val >> 32), 0xFFFFFFFFu);
+        return;
+    }
+    mask = size >= 4 ? 0xFFFFFFFFu : ((1u << (size * 8)) - 1);
+    reg_write(off & ~3u, (uint32_t)(val << shift), mask << shift);
+}
+
+extern void kgpu_symbol_name(uint64_t addr, char *out, size_t cap);
+
+static LONG CALLBACK kelvin_mmio_veh(PEXCEPTION_POINTERS ep)
+{
+    const EXCEPTION_RECORD *er = ep->ExceptionRecord;
+    uintptr_t fault;
+    uint32_t off;
+    int done;
+
+    if (er->ExceptionCode != EXCEPTION_ACCESS_VIOLATION ||
+        er->NumberParameters < 2) {
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
+    fault = (uintptr_t)er->ExceptionInformation[1];
+    if (fault < (uintptr_t)s_ap || fault - (uintptr_t)s_ap >= 0x01000000u) {
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
+    off = (uint32_t)(fault - (uintptr_t)s_ap);
+    if (!owned(off)) {
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
+
+    {
+        /* RECOMP_KELVIN_MMIOSTAT=1: once a second, which registers were touched how often and by which thread */
+        static int stat_on = -1;
+        static struct { uint32_t off; DWORD tid; uint64_t rip; unsigned n; } tab[64];
+        static ULONGLONG last_tick;
+        if (stat_on < 0) { const char *e = getenv("RECOMP_KELVIN_MMIOSTAT"); stat_on = e && *e && *e != '0'; }
+        if (stat_on) {
+            unsigned k;
+            ULONGLONG now = GetTickCount64();
+            DWORD tid = GetCurrentThreadId();
+            for (k = 0; k < 64 && tab[k].n; k++) if (tab[k].off == off && tab[k].tid == tid && tab[k].rip == ep->ContextRecord->Rip) break;
+            if (k < 64) { tab[k].off = off; tab[k].tid = tid; tab[k].rip = ep->ContextRecord->Rip; tab[k].n++; }
+            if (!last_tick) last_tick = now;
+            if (now - last_tick >= 1000) {
+                fprintf(stderr, "[KMMIO] last second:");
+                for (k = 0; k < 64 && tab[k].n; k++) { char nm[64]; kgpu_symbol_name(tab[k].rip, nm, sizeof(nm)); fprintf(stderr, " 0x%X/tid%lu/%s x%u", tab[k].off, (unsigned long)tab[k].tid, nm, tab[k].n); }
+                fprintf(stderr, "\n");
+                memset(tab, 0, sizeof(tab));
+                last_tick = now;
+            }
+        }
+    }
+    InterlockedIncrement(&s_waiters);
+    kelvin_lock();
+    InterlockedDecrement(&s_waiters);
+    done = mmio_emulate(ep->ContextRecord, off, NULL, access_read,
+                        access_write);
+    kelvin_unlock();
+    if (done) {
+        return EXCEPTION_CONTINUE_EXECUTION;
+    }
+    {
+        const uint8_t *ip = (const uint8_t *)ep->ContextRecord->Rip;
+        fprintf(stderr, "[KELVIN] register access at 0x%08X by an"
+                        " instruction the decoder does not know: %02X %02X"
+                        " %02X %02X %02X %02X (host RIP %p)\n",
+                KELVIN_APERTURE_VA + off, ip[0], ip[1], ip[2], ip[3], ip[4],
+                ip[5], (void *)ip);
+        fflush(stderr);
+    }
+    return EXCEPTION_CONTINUE_SEARCH;
+}
+
+bool kelvin_mmio_start(KelvinState *pg)
+{
+    static const struct { uint32_t base, size; uint32_t *shadow; } blocks[] = {
+        { PMC_BASE, PMC_SIZE, s_pmc },
+        { KELVIN_PGRAPH_BASE, PGRAPH_SIZE, s_pgraph },
+        { PCRTC_BASE, PCRTC_SIZE, s_pcrtc },
+    };
+    size_t i;
+    DWORD old;
+
+    s_pg = pg;
+    s_ap = kelvin_aperture(0);
+    for (i = 0; i < sizeof(blocks) / sizeof(blocks[0]); i++) {
+        memcpy(blocks[i].shadow, s_ap + blocks[i].base, blocks[i].size);
+    }
+    /* As plain memory nothing could have been pending; what an ack thread
+     * may have left in the status words is not an interrupt. */
+    s_pmc[NV_PMC_INTR_0 / 4] = 0;
+    s_pcrtc[NV_PCRTC_INTR_0 / 4] = 0;
+    pg->regs = s_pgraph;
+    pg->pending_interrupts = 0;
+    pg->enabled_interrupts = s_pgraph[NV_PGRAPH_INTR_EN / 4];
+
+    s_irq_event = CreateEventW(NULL, FALSE, FALSE, NULL);
+    /* First, so it runs before the game target's own crash reporter. */
+    s_veh = AddVectoredExceptionHandler(1, kelvin_mmio_veh);
+    if (!s_irq_event || !s_veh) {
+        goto fail;
+    }
+    for (i = 0; i < sizeof(blocks) / sizeof(blocks[0]); i++) {
+        if (!VirtualProtect(s_ap + blocks[i].base, blocks[i].size,
+                            PAGE_NOACCESS, &old)) {
+            while (i--) {
+                VirtualProtect(s_ap + blocks[i].base, blocks[i].size,
+                               PAGE_READWRITE, &old);
+            }
+            goto fail;
+        }
+    }
+    InterlockedExchange(&s_trapped, 1);
+    fprintf(stderr, "[KELVIN] PMC, PGRAPH and PCRTC registers trapped"
+                    " (interrupt status, enables and triggers modelled)\n");
+    fflush(stderr);
+    return true;
+
+fail:
+    fprintf(stderr, "[KELVIN] could not trap the NV2A registers (error %lu)\n",
+            GetLastError());
+    fflush(stderr);
+    if (s_veh) {
+        RemoveVectoredExceptionHandler(s_veh);
+        s_veh = NULL;
+    }
+    if (s_irq_event) {
+        CloseHandle(s_irq_event);
+        s_irq_event = NULL;
+    }
+    return false;
+}
+
+void kelvin_mmio_report(void)
+{
+    KelvinState *pg = s_pg;
+
+    if (!pg) {
+        return;
+    }
+    AcquireSRWLockShared(&s_lock);
+    fprintf(stderr, "[KELVIN]   interrupts: raised %llu; PMC_INTR_EN_0 %u,"
+                    " PGRAPH pending 0x%08X enabled 0x%08X, PCRTC pending %u"
+                    " enabled %u, FIFO access %u, scanout 0x%08X\n",
+            (unsigned long long)s_irqs_raised, s_pmc[NV_PMC_INTR_EN_0 / 4],
+            pg->pending_interrupts, pg->enabled_interrupts,
+            s_pcrtc[NV_PCRTC_INTR_0 / 4], s_pcrtc[NV_PCRTC_INTR_EN_0 / 4],
+            pgraph_reg_r(pg, NV_PGRAPH_FIFO) & NV_PGRAPH_FIFO_ACCESS,
+            s_pcrtc[NV_PCRTC_START / 4]);
+    ReleaseSRWLockShared(&s_lock);
+}
diff --git a/src/nv2a/kelvin/kelvin_pgraph.c b/src/nv2a/kelvin/kelvin_pgraph.c
