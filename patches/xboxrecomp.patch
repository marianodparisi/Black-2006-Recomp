+/* ---- clears ------------------------------------------------------------------------------------- */
+
+static void kgpu_clear_now(const KelvinTarget *t, bool color, bool depth, bool stencil,
+                           uint32_t color_value, uint32_t zs_value, unsigned int channel_mask,
+                           int x0, int y0, int x1, int y1, unsigned int color_format)
+{
+    KGpuSurf *cs = NULL, *zs = NULL;
+    double sx = 1.0, sy = 1.0;
+    unsigned int zfmt = 0;
+    if (!G.ok) return;
+    kt_begin();
+    kg_bound_reset();
+    if (color && t->color) cs = surf_get(t, false, color_format);
+    if ((depth || stencil) && t->zeta) {
+        zfmt = t->zeta_bpp == 2 ? NV097_SET_SURFACE_FORMAT_ZETA_Z16 : NV097_SET_SURFACE_FORMAT_ZETA_Z24S8;
+        zs = surf_get(t, true, zfmt);
+    }
+    if (cs) { sx = (double)cs->hw / cs->gw; sy = (double)cs->hh / cs->gh; }
+    else if (zs) { sx = (double)zs->hw / zs->gw; sy = (double)zs->hh / zs->gh; }
+    if (s_dl.mode != 0 && kg_dl_on())
+        fprintf(stderr, "[KDL] f%llu #%u clear colour %d depth %d stencil %d rect %d,%d-%d,%d target %ux%u\n", (unsigned long long)s_dl.frame, s_dl.ord,
+                (int)color, (int)depth, (int)stencil, x0, y0, x1, y1, t->width, t->height);
+    if (cs) { cs->ver++; cs->wseq = ++s_wseq; }
+    if (zs) { zs->real = true; zs->from_color = false; zs->ver++; zs->wseq = ++s_wseq; }
+    /* the rectangle arrives in guest-stored pixels */
+    x0 = (int)floor(x0 * sx); y0 = (int)floor(y0 * sy);
+    x1 = (int)ceil(x1 * sx); y1 = (int)ceil(y1 * sy);
+    if (cs) {
+        bool full = x0 <= 0 && y0 <= 0 && x1 >= (int)cs->hw && y1 >= (int)cs->hh;
+        float c[4];
+        c[0] = ((color_value >> 16) & 0xFF) / 255.0f;
+        c[1] = ((color_value >> 8) & 0xFF) / 255.0f;
+        c[2] = (color_value & 0xFF) / 255.0f;
+        c[3] = ((color_value >> 24) & 0xFF) / 255.0f;
+        if (color_format == NV097_SET_SURFACE_FORMAT_COLOR_LE_X8R8G8B8_Z8R8G8B8) c[3] = 0.0f;
+        if (color_format == NV097_SET_SURFACE_FORMAT_COLOR_LE_X8R8G8B8_O8R8G8B8) c[3] = 1.0f;
+        if (full && channel_mask == 0xF) {
+            if (s_kp_mode != 0) { KpInfo ki; memset(&ki, 0, sizeof(ki)); ki.kind = 1; ki.psh = 0xC1; ki.tw = cs->hw; ki.th = cs->hh; kp_mark(&ki); }
+            ID3D11DeviceContext_ClearRenderTargetView(G.ctx, cs->rtv, c);
+            if (s_kp_mode != 0) kp_done();
+        } else if (x1 > x0 && y1 > y0) {
+            /* masked / partial: a rectangle drawn with a colour write mask */
+            D3D11_BLEND_DESC bd;
+            ID3D11BlendState *bs = NULL;
+            D3D11_RASTERIZER_DESC rd;
+            ID3D11RasterizerState *rs = NULL;
+            D3D11_DEPTH_STENCIL_DESC dd;
+            ID3D11DepthStencilState *ds = NULL;
+            D3D11_MAPPED_SUBRESOURCE ms;
+            D3D11_VIEWPORT vp;
+            D3D11_RECT sc;
+            memset(&bd, 0, sizeof(bd));
+            /* channel_mask bits: B=1, G=2, R=4, A=8 */
+            bd.RenderTarget[0].RenderTargetWriteMask = (UINT8)(((channel_mask & 4) ? 1 : 0) |
+                ((channel_mask & 2) ? 2 : 0) | ((channel_mask & 1) ? 4 : 0) | ((channel_mask & 8) ? 8 : 0));
+            memset(&rd, 0, sizeof(rd));
+            rd.FillMode = D3D11_FILL_SOLID; rd.CullMode = D3D11_CULL_NONE; rd.ScissorEnable = TRUE; rd.DepthClipEnable = TRUE;
+            memset(&dd, 0, sizeof(dd));
+            ID3D11Device_CreateBlendState(G.dev, &bd, &bs);
+            ID3D11Device_CreateRasterizerState(G.dev, &rd, &rs);
+            ID3D11Device_CreateDepthStencilState(G.dev, &dd, &ds);
+            if (SUCCEEDED(ID3D11DeviceContext_Map(G.ctx, (ID3D11Resource *)G.cb_clear, 0, D3D11_MAP_WRITE_DISCARD, 0, &ms))) {
+                memcpy(ms.pData, c, 16);
+                ID3D11DeviceContext_Unmap(G.ctx, (ID3D11Resource *)G.cb_clear, 0);
+            }
+            ID3D11DeviceContext_OMSetRenderTargets(G.ctx, 1, &cs->rtv, NULL);
+            ID3D11DeviceContext_OMSetBlendState(G.ctx, bs, NULL, 0xFFFFFFFFu);
+            ID3D11DeviceContext_OMSetDepthStencilState(G.ctx, ds, 0);
+            ID3D11DeviceContext_RSSetState(G.ctx, rs);
+            vp.TopLeftX = vp.TopLeftY = 0; vp.Width = (FLOAT)cs->hw; vp.Height = (FLOAT)cs->hh;
+            vp.MinDepth = 0; vp.MaxDepth = 1;
+            ID3D11DeviceContext_RSSetViewports(G.ctx, 1, &vp);
+            sc.left = x0 < 0 ? 0 : x0; sc.top = y0 < 0 ? 0 : y0;
+            sc.right = x1 > (int)cs->hw ? (LONG)cs->hw : x1; sc.bottom = y1 > (int)cs->hh ? (LONG)cs->hh : y1;
+            ID3D11DeviceContext_RSSetScissorRects(G.ctx, 1, &sc);
+            ID3D11DeviceContext_IASetInputLayout(G.ctx, NULL);
+            ID3D11DeviceContext_IASetPrimitiveTopology(G.ctx, D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+            ID3D11DeviceContext_VSSetShader(G.ctx, G.clear_vs, NULL, 0);
+            ID3D11DeviceContext_PSSetShader(G.ctx, G.clear_ps, NULL, 0);
+            ID3D11DeviceContext_PSSetConstantBuffers(G.ctx, 0, 1, &G.cb_clear);
+            ID3D11DeviceContext_Draw(G.ctx, 3, 0);
+            SAFE_RELEASE(bs); SAFE_RELEASE(rs); SAFE_RELEASE(ds);
+        }
+    }
+    if (zs) {
+        bool full = x0 <= 0 && y0 <= 0 && x1 >= (int)zs->hw && y1 >= (int)zs->hh;
+        float zv = zfmt == NV097_SET_SURFACE_FORMAT_ZETA_Z16 ? (float)(zs_value & 0xFFFF) / 65535.0f
+                                                           : (float)(zs_value >> 8) / 16777215.0f;
+        if (full) {
+            UINT fl = 0;
+            if (depth) fl |= D3D11_CLEAR_DEPTH;
+            if (stencil) fl |= D3D11_CLEAR_STENCIL;
+            if (s_kp_mode != 0) { KpInfo ki; memset(&ki, 0, sizeof(ki)); ki.kind = 1; ki.psh = 0xC2; ki.tw = zs->hw; ki.th = zs->hh; kp_mark(&ki); }
+            ID3D11DeviceContext_ClearDepthStencilView(G.ctx, zs->dsv, fl, zv, (UINT8)(zs_value & 0xFF));
+            if (s_kp_mode != 0) kp_done();
+        } else if (depth && x1 > x0 && y1 > y0) {
+            D3D11_BLEND_DESC bd;
+            ID3D11BlendState *bs = NULL;
+            D3D11_RASTERIZER_DESC rd;
+            ID3D11RasterizerState *rs = NULL;
+            D3D11_DEPTH_STENCIL_DESC dd;
+            ID3D11DepthStencilState *ds = NULL;
+            D3D11_MAPPED_SUBRESOURCE ms;
+            D3D11_VIEWPORT vp;
+            D3D11_RECT sc;
+            float c[8];
+            memset(&bd, 0, sizeof(bd));
+            memset(&rd, 0, sizeof(rd));
+            rd.FillMode = D3D11_FILL_SOLID; rd.CullMode = D3D11_CULL_NONE; rd.ScissorEnable = TRUE; rd.DepthClipEnable = FALSE;
+            memset(&dd, 0, sizeof(dd));
+            dd.DepthEnable = TRUE; dd.DepthWriteMask = D3D11_DEPTH_WRITE_MASK_ALL; dd.DepthFunc = D3D11_COMPARISON_ALWAYS;
+            ID3D11Device_CreateBlendState(G.dev, &bd, &bs);
+            ID3D11Device_CreateRasterizerState(G.dev, &rd, &rs);
+            ID3D11Device_CreateDepthStencilState(G.dev, &dd, &ds);
+            memset(c, 0, sizeof(c)); c[4] = zv;
+            if (SUCCEEDED(ID3D11DeviceContext_Map(G.ctx, (ID3D11Resource *)G.cb_clear, 0, D3D11_MAP_WRITE_DISCARD, 0, &ms))) {
+                memcpy(ms.pData, c, 32);
+                ID3D11DeviceContext_Unmap(G.ctx, (ID3D11Resource *)G.cb_clear, 0);
+            }
+            ID3D11DeviceContext_OMSetRenderTargets(G.ctx, 0, NULL, zs->dsv);
+            ID3D11DeviceContext_OMSetBlendState(G.ctx, bs, NULL, 0xFFFFFFFFu);
+            ID3D11DeviceContext_OMSetDepthStencilState(G.ctx, ds, 0);
+            ID3D11DeviceContext_RSSetState(G.ctx, rs);
+            vp.TopLeftX = vp.TopLeftY = 0; vp.Width = (FLOAT)zs->hw; vp.Height = (FLOAT)zs->hh;
+            vp.MinDepth = 0; vp.MaxDepth = 1;
+            ID3D11DeviceContext_RSSetViewports(G.ctx, 1, &vp);
+            sc.left = x0 < 0 ? 0 : x0; sc.top = y0 < 0 ? 0 : y0;
+            sc.right = x1 > (int)zs->hw ? (LONG)zs->hw : x1; sc.bottom = y1 > (int)zs->hh ? (LONG)zs->hh : y1;
+            ID3D11DeviceContext_RSSetScissorRects(G.ctx, 1, &sc);
+            ID3D11DeviceContext_IASetInputLayout(G.ctx, NULL);
+            ID3D11DeviceContext_IASetPrimitiveTopology(G.ctx, D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+            ID3D11DeviceContext_VSSetShader(G.ctx, G.clear_vs, NULL, 0);
+            ID3D11DeviceContext_PSSetShader(G.ctx, G.clear_depth_ps, NULL, 0);
+            ID3D11DeviceContext_PSSetConstantBuffers(G.ctx, 0, 1, &G.cb_clear);
+            ID3D11DeviceContext_Draw(G.ctx, 3, 0);
+            SAFE_RELEASE(bs); SAFE_RELEASE(rs); SAFE_RELEASE(ds);
+        }
+    }
+}
+
+/* ---- presentation (readback path) ------------------------------------------------------------------ */
+
+static void write_bmp(const char *path, const uint8_t *bgra, unsigned int w, unsigned int h,
+                      unsigned int pitch)
+{
+    FILE *f = fopen(path, "wb");
+    uint32_t row_bytes = w * 3, pad = (4 - (row_bytes & 3)) & 3, filesz, y, x;
+    uint8_t hdr[54], *row;
+    if (!f) return;
+    row = (uint8_t *)malloc(row_bytes + pad);
+    if (!row) { fclose(f); return; }
+    memset(row + row_bytes, 0, pad);
+    filesz = 54 + (row_bytes + pad) * h;
+    memset(hdr, 0, sizeof(hdr));
+    hdr[0] = 'B'; hdr[1] = 'M';
+    memcpy(hdr + 2, &filesz, 4);
+    hdr[10] = 54; hdr[14] = 40;
+    memcpy(hdr + 18, &w, 4);
+    memcpy(hdr + 22, &h, 4);
+    hdr[26] = 1; hdr[28] = 24;
+    fwrite(hdr, 1, sizeof(hdr), f);
+    for (y = h; y-- > 0;) {
+        const uint8_t *src = bgra + (size_t)y * pitch;
+        for (x = 0; x < w; x++) { row[x * 3] = src[x * 4]; row[x * 3 + 1] = src[x * 4 + 1]; row[x * 3 + 2] = src[x * 4 + 2]; }
+        fwrite(row, 1, row_bytes + pad, f);
+    }
+    free(row);
+    fclose(f);
+}
+
+static uint32_t crc_frame(const uint8_t *p, unsigned int w, unsigned int h, unsigned int pitch)
+{
+    uint64_t s[2];
+    uint32_t acc = 0;
+    unsigned int y;
+    for (y = 0; y < h; y++) {
+        sig_bytes(p + (size_t)y * pitch, (size_t)w * 4, s);
+        acc = (acc * 16777619u) ^ (uint32_t)s[0] ^ (uint32_t)(s[0] >> 32);
+    }
+    return acc;
+}
+
+static void publish_staged(unsigned int slot, unsigned int format)
+{
+    D3D11_MAPPED_SUBRESOURCE ms;
+    uint64_t n = G.stage_frame[slot];
+    bool logged = n <= 8 || (n % 60) == 0;
+    bool dumped = G.dump && *G.dump && (n % G.dump_every) == 0;
+    if (!G.stage[slot] || !n) return;
+    if (FAILED(ID3D11DeviceContext_Map(G.ctx, (ID3D11Resource *)G.stage[slot], 0, D3D11_MAP_READ, 0, &ms))) return;
+    {
+        uint32_t h = logged || dumped ? crc_frame((const uint8_t *)ms.pData, G.stage_w, G.stage_h, ms.RowPitch) : 0;
+        if (logged) {
+            LARGE_INTEGER now;
+            QueryPerformanceCounter(&now);
+            fprintf(stderr, "[KELVIN] frame %llu: surface 0x%08X %ux%u gpu hash %08X (%llu distinct so far) [qpc %lld freq %lld]\n",
+                    (unsigned long long)n, G.stage_va[slot], G.stage_w, G.stage_h, h,
+                    (unsigned long long)n, (long long)now.QuadPart, (long long)G.qpf);
+            fflush(stderr);
+        }
+        if (dumped) {
+            char path[512];
+            snprintf(path, sizeof(path), "%s%05llu_%08X.bmp", G.dump, (unsigned long long)n, h);
+            write_bmp(path, (const uint8_t *)ms.pData, G.stage_w, G.stage_h, ms.RowPitch);
+        }
+        xbox_FramebufferPublishAspect(ms.pData, (size_t)ms.RowPitch * G.stage_h, G.stage_va[slot],
+                                      G.stage_w, G.stage_h, ms.RowPitch, format,
+                                      G.stage_aspect_w[slot], G.stage_aspect_h[slot]);
+    }
+    ID3D11DeviceContext_Unmap(G.ctx, (ID3D11Resource *)G.stage[slot], 0);
+    G.stage_frame[slot] = 0;
+}
+
+static int s_compare = -1;
+bool kgpu_compare_enabled(void)
+{
+    if (s_compare < 0) {
+        const char *e = getenv("RECOMP_KGPU_COMPARE");
+        s_compare = e && *e ? (int)strtol(e, NULL, 10) : 0;
+        if (s_compare < 0) s_compare = 0;
+    }
+    return kgpu_enabled() && s_compare > 0;
+}
+
+/* Readback of one colour surface, synchronously. */
+static bool readback(const KGpuSurf *cs, ID3D11Texture2D **stage_out, D3D11_MAPPED_SUBRESOURCE *ms)
+{
+    D3D11_TEXTURE2D_DESC td;
+    ID3D11Texture2D *st = NULL;
+    memset(&td, 0, sizeof(td));
+    td.Width = cs->hw; td.Height = cs->hh; td.MipLevels = td.ArraySize = 1;
+    td.Format = DXGI_FORMAT_B8G8R8A8_UNORM; td.SampleDesc.Count = 1;
+    td.Usage = D3D11_USAGE_STAGING; td.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    if (FAILED(ID3D11Device_CreateTexture2D(G.dev, &td, NULL, &st))) return false;
+    ID3D11DeviceContext_CopyResource(G.ctx, (ID3D11Resource *)st, (ID3D11Resource *)cs->tex);
+    if (FAILED(ID3D11DeviceContext_Map(G.ctx, (ID3D11Resource *)st, 0, D3D11_MAP_READ, 0, ms))) {
+        IUnknown_Release((IUnknown *)st);
+        return false;
+    }
+    *stage_out = st;
+    return true;
+}
+
+void kgpu_compare_frame(const KelvinTarget *t, unsigned int color_format)
+{
+    static uint64_t n, last;
+    KGpuSurf *cs;
+    ID3D11Texture2D *st;
+    D3D11_MAPPED_SUBRESOURCE ms;
+    unsigned int x, y;
+    uint64_t sum = 0, gt8 = 0, gt32 = 0, pixels;
+    unsigned int maxd = 0;
+    if (!G.ok || !t->color || t->color_bpp != 4) return;
+    n++;
+    s_cmp_frames = n;
+    if (s_compare <= 0 || n % (uint64_t)s_compare) return;
+    cs = surf_get(t, false, color_format);
+    if (!cs || cs->hw != t->width || cs->hh != t->height) return;
+    if (!readback(cs, &st, &ms)) return;
+    pixels = (uint64_t)t->width * t->height;
+    for (y = 0; y < t->height; y++) {
+        const uint8_t *g = (const uint8_t *)ms.pData + (size_t)y * ms.RowPitch;
+        const uint8_t *c = t->color + (size_t)y * t->color_pitch;
+        for (x = 0; x < t->width; x++) {
+            unsigned int d0 = (unsigned int)abs((int)g[x * 4] - (int)c[x * 4]);
+            unsigned int d1 = (unsigned int)abs((int)g[x * 4 + 1] - (int)c[x * 4 + 1]);
+            unsigned int d2 = (unsigned int)abs((int)g[x * 4 + 2] - (int)c[x * 4 + 2]);
+            unsigned int d = d0 > d1 ? d0 : d1;
+            if (d2 > d) d = d2;
+            sum += d0 + d1 + d2;
+            if (d > maxd) maxd = d;
+            if (d > 8) gt8++;
+            if (d > 32) gt32++;
+        }
+    }
+    fprintf(stderr, "[KCMP] flip %llu: mean abs diff %.3f, max %u, >8: %.3f%%, >32: %.3f%%\n",
+            (unsigned long long)n, (double)sum / (3.0 * (double)pixels), maxd,
+            100.0 * (double)gt8 / (double)pixels, 100.0 * (double)gt32 / (double)pixels);
+    if (G.dump && *G.dump && ((double)sum / (3.0 * (double)pixels) > 0.5 || (n / (uint64_t)s_compare) % 20 == 0)) {
+        char path[512];
+        uint8_t *buf = (uint8_t *)malloc((size_t)t->width * t->height * 4);
+        if (buf) {
+            for (y = 0; y < t->height; y++)
+                memcpy(buf + (size_t)y * t->width * 4, t->color + (size_t)y * t->color_pitch, (size_t)t->width * 4);
+            snprintf(path, sizeof(path), "%scmp%05llu_cpu.bmp", G.dump, (unsigned long long)n);
+            write_bmp(path, buf, t->width, t->height, t->width * 4);
+            snprintf(path, sizeof(path), "%scmp%05llu_gpu.bmp", G.dump, (unsigned long long)n);
+            write_bmp(path, (const uint8_t *)ms.pData, t->width, t->height, ms.RowPitch);
+            for (y = 0; y < t->height; y++) {
+                const uint8_t *g = (const uint8_t *)ms.pData + (size_t)y * ms.RowPitch;
+                for (x = 0; x < t->width * 4; x++) {
+                    int d = abs((int)g[x] - (int)buf[(size_t)y * t->width * 4 + x]) * 4;
+                    buf[(size_t)y * t->width * 4 + x] = (uint8_t)(d > 255 ? 255 : d);
+                }
+            }
+            snprintf(path, sizeof(path), "%scmp%05llu_diff.bmp", G.dump, (unsigned long long)n);
+            write_bmp(path, buf, t->width, t->height, t->width * 4);
+            free(buf);
+        }
+    }
+    last = n;
+    (void)last;
+    ID3D11DeviceContext_Unmap(G.ctx, (ID3D11Resource *)st, 0);
+    IUnknown_Release((IUnknown *)st);
+}
+
+/* ---- direct presentation through shared textures ----------------------------------------------------- */
+
+#define KG_RING 4
+static ID3D11Device5 *s_dev5;
+static ID3D11DeviceContext4 *s_ctx4;
+static ID3D11Fence *s_frame_fence, *s_done_fence;
+static HANDLE s_frame_fence_h, s_done_fence_h;
+static ID3D11Texture2D *s_ring[KG_RING];
+static HANDLE s_ring_h[KG_RING];
+static uint64_t s_ring_value[KG_RING], s_fence_next;
+static unsigned int s_ring_w, s_ring_h_dim, s_ring_next;
+static int s_shared_mode = -1;      /* -1 untried, 0 readback, 1 shared textures */
+
+static void ring_free(void)
+{
+    unsigned int i;
+    for (i = 0; i < KG_RING; i++) {
+        SAFE_RELEASE(s_ring[i]);
+        if (s_ring_h[i]) { CloseHandle(s_ring_h[i]); s_ring_h[i] = NULL; }
+        s_ring_value[i] = 0;
+    }
+    s_ring_w = s_ring_h_dim = 0;
+}
+
+static bool ring_setup(unsigned int w, unsigned int h)
+{
+    unsigned int i;
+    D3D11_TEXTURE2D_DESC td;
+    if (!s_dev5) {
+        if (FAILED(ID3D11Device_QueryInterface(G.dev, &IID_ID3D11Device5, (void **)&s_dev5)) ||
+            FAILED(ID3D11DeviceContext_QueryInterface(G.ctx, &IID_ID3D11DeviceContext4, (void **)&s_ctx4))) {
+            SAFE_RELEASE(s_dev5); SAFE_RELEASE(s_ctx4);
+            return false;
+        }
+    }
+    if (!s_frame_fence) {
+        if (FAILED(ID3D11Device5_CreateFence(s_dev5, 0, D3D11_FENCE_FLAG_SHARED, &IID_ID3D11Fence, (void **)&s_frame_fence)) ||
+            FAILED(ID3D11Device5_CreateFence(s_dev5, 0, D3D11_FENCE_FLAG_SHARED, &IID_ID3D11Fence, (void **)&s_done_fence)) ||
+            FAILED(ID3D11Fence_CreateSharedHandle(s_frame_fence, NULL, GENERIC_ALL, NULL, &s_frame_fence_h)) ||
+            FAILED(ID3D11Fence_CreateSharedHandle(s_done_fence, NULL, GENERIC_ALL, NULL, &s_done_fence_h))) {
+            return false;
+        }
+        s_fence_next = 0;
+    }
+    ring_free();
+    memset(&td, 0, sizeof(td));
+    td.Width = w; td.Height = h; td.MipLevels = td.ArraySize = 1;
+    td.Format = DXGI_FORMAT_B8G8R8A8_UNORM; td.SampleDesc.Count = 1; td.Usage = D3D11_USAGE_DEFAULT;
+    td.BindFlags = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET;
+    td.MiscFlags = D3D11_RESOURCE_MISC_SHARED | D3D11_RESOURCE_MISC_SHARED_NTHANDLE;
+    for (i = 0; i < KG_RING; i++) {
+        IDXGIResource1 *r1 = NULL;
+        if (FAILED(ID3D11Device_CreateTexture2D(G.dev, &td, NULL, &s_ring[i]))) { ring_free(); return false; }
+        if (FAILED(ID3D11Texture2D_QueryInterface(s_ring[i], &IID_IDXGIResource1, (void **)&r1)) ||
+            FAILED(IDXGIResource1_CreateSharedHandle(r1, NULL, DXGI_SHARED_RESOURCE_READ | DXGI_SHARED_RESOURCE_WRITE,
+                                                     NULL, &s_ring_h[i]))) {
+            if (r1) IDXGIResource1_Release(r1);
+            ring_free();
+            return false;
+        }
+        IDXGIResource1_Release(r1);
+    }
+    s_ring_w = w; s_ring_h_dim = h; s_ring_next = 0;
+    if (!xbox_FramebufferGpuRegister((void *const *)s_ring_h, KG_RING, s_frame_fence_h, s_done_fence_h, w, h)) {
+        ring_free();
+        return false;
+    }
+    fprintf(stderr, "[KGPU] direct presentation: %u shared %ux%u textures\n", KG_RING, w, h);
+    return true;
+}
+
+static void flip_readback(KGpuSurf *cs, uint32_t aspect_w, uint32_t aspect_h);
+
+/* A finished frame to the presenter without touching the CPU. */
+static bool flip_shared(KGpuSurf *cs, uint32_t aspect_w, uint32_t aspect_h)
+{
+    unsigned int k, slot = 0;
+    uint64_t done;
+    bool found = false;
+    ID3D11Texture2D *src;
+    unsigned int sw, sh;
+    src = kg_post_flip_source(cs, &sw, &sh);
+    if (s_ring_w != sw || s_ring_h_dim != sh) {
+        if (!ring_setup(sw, sh)) return false;
+    }
+    done = ID3D11Fence_GetCompletedValue(s_done_fence);
+    for (k = 0; k < KG_RING; k++) {
+        slot = (s_ring_next + k) % KG_RING;
+        if (s_ring_value[slot] <= done) { found = true; break; }
+    }
+    if (!found) return true;             /* the presenter is behind: this frame is dropped */
+    ID3D11DeviceContext_CopyResource(G.ctx, (ID3D11Resource *)s_ring[slot], (ID3D11Resource *)src);
+    ID3D11DeviceContext4_Signal(s_ctx4, s_frame_fence, ++s_fence_next);
+    s_ring_value[slot] = s_fence_next;
+    ID3D11DeviceContext_Flush(G.ctx);
+    kgq_publish_frame(slot, s_fence_next, cs->va, aspect_w, aspect_h);
+    s_ring_next = (slot + 1) % KG_RING;
+    return true;
+}
+
+static void kgpu_flip_inner(const KelvinTarget *t, unsigned int color_format, uint32_t aspect_w, uint32_t aspect_h)
+{
+    KGpuSurf *cs;
+    long long prof_t = kg_tick();
+    uint64_t n;
+    if (!G.ok) return;
+    cs = surf_get(t, false, color_format);
+    if (!cs || cs->bpp != 4) return;
+    if (s_shared_mode < 0) {
+        const char *rb = getenv("RECOMP_KGPU_READBACK");
+        s_shared_mode = !(rb && *rb && *rb != '0') && xbox_FramebufferGpuWanted() ? 1 : 0;
+        fprintf(stderr, "[KGPU] presentation: %s\n", s_shared_mode ? "shared textures" : "CPU readback");
+    }
+    n = ++G.frames;
+    kt_end(n);
+    kt_poll();
+    if ((n % 120) == 0 && G.dev) {
+        /* A removed or reset device (driver update, TDR) leaves every later call failing quietly; say so once. */
+        static bool lost_said;
+        HRESULT removed = ID3D11Device_GetDeviceRemovedReason(G.dev);
+        if (removed != S_OK && !lost_said) {
+            lost_said = true;
+            fprintf(stderr, "[KGPU] the GPU device was removed (0x%08lX): the picture will stop updating; "
+                            "restart the game, or turn off the GPU renderer in the launcher\n", (unsigned long)removed);
+            fflush(stderr);
+        }
+    }
+    {
+        long long now = qpc_now();
+        if (s_flip_prev_qpc) {
+            double ms = (double)(now - s_flip_prev_qpc) * 1000.0 / (double)G.qpf;
+            s_hist[ms <= 18.0 ? 0 : ms <= 20.0 ? 1 : ms <= 25.0 ? 2 : ms <= 34.0 ? 3 : ms <= 70.0 ? 4 : 5]++;
+            if (ms > s_hist_max_ms) s_hist_max_ms = ms;
+            s_fine[ms >= 19.99 ? 39 : (unsigned int)(ms * 2.0)]++;
+        }
+        s_flip_prev_qpc = now;
+        s_flip_q[n & 1023] = now;
+        s_flip_count = (LONG64)n;
+    }
+    xbox_FramebufferWindowStart();
+    if (s_shared_mode && xbox_FramebufferGpuFailed()) {
+        fprintf(stderr, "[KGPU] the presenter could not open the shared textures; using CPU readback\n");
+        s_shared_mode = 0;
+    }
+    if (s_shared_mode) {
+        bool logged = n <= 8 || (n % 60) == 0;
+        bool dumped = G.dump && *G.dump && (n % G.dump_every) == 0;
+        if (logged || dumped) {
+            D3D11_MAPPED_SUBRESOURCE ms;
+            ID3D11Texture2D *st = NULL;
+            uint32_t h = 0;
+            if (dumped && readback(cs, &st, &ms)) {
+                char path[512];
+                h = crc_frame((const uint8_t *)ms.pData, cs->hw, cs->hh, ms.RowPitch);
+                snprintf(path, sizeof(path), "%s%05llu_%08X.bmp", G.dump, (unsigned long long)n, h);
+                write_bmp(path, (const uint8_t *)ms.pData, cs->hw, cs->hh, ms.RowPitch);
+                ID3D11DeviceContext_Unmap(G.ctx, (ID3D11Resource *)st, 0);
+                IUnknown_Release((IUnknown *)st);
+            }
+            if (logged) {
+                LARGE_INTEGER now;
+                QueryPerformanceCounter(&now);
+                fprintf(stderr, "[KELVIN] frame %llu: surface 0x%08X %ux%u gpu hash %08X (%llu distinct so far) [qpc %lld freq %lld]\n",
+                        (unsigned long long)n, cs->va, cs->hw, cs->hh, h, (unsigned long long)n,
+                        (long long)now.QuadPart, (long long)G.qpf);
+                fflush(stderr);
+            }
+        }
+        if (flip_shared(cs, aspect_w, aspect_h)) {
+            g_kgpu_ticks[KGP_FLIP] += kg_tick() - prof_t;
+            return;
+        }
+        fprintf(stderr, "[KGPU] shared textures unavailable; using CPU readback\n");
+        s_shared_mode = 0;
+    }
+    flip_readback(cs, aspect_w, aspect_h);
+    g_kgpu_ticks[KGP_FLIP] += kg_tick() - prof_t;
+}
+
+static void flip_readback(KGpuSurf *cs, uint32_t aspect_w, uint32_t aspect_h)
+{
+    unsigned int slot, prev, i, sw, sh;
+    ID3D11Texture2D *src = kg_post_flip_source(cs, &sw, &sh);
+    if (G.stage_w != sw || G.stage_h != sh) {
+        for (i = 0; i < KG_STAGING; i++) { SAFE_RELEASE(G.stage[i]); G.stage_frame[i] = 0; }
+        G.stage_w = sw; G.stage_h = sh;
+    }
+    slot = (unsigned int)(G.frames % KG_STAGING);
+    if (!G.stage[slot]) {
+        D3D11_TEXTURE2D_DESC td;
+        memset(&td, 0, sizeof(td));
+        td.Width = sw; td.Height = sh; td.MipLevels = td.ArraySize = 1;
+        td.Format = DXGI_FORMAT_B8G8R8A8_UNORM; td.SampleDesc.Count = 1;
+        td.Usage = D3D11_USAGE_STAGING; td.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        if (FAILED(ID3D11Device_CreateTexture2D(G.dev, &td, NULL, &G.stage[slot]))) return;
+    }
+    ID3D11DeviceContext_CopyResource(G.ctx, (ID3D11Resource *)G.stage[slot], (ID3D11Resource *)src);
+    G.stage_frame[slot] = G.frames;
+    G.stage_va[slot] = cs->va;
+    G.stage_aspect_w[slot] = aspect_w ? aspect_w : sw;
+    G.stage_aspect_h[slot] = aspect_h ? aspect_h : sh;
+    ID3D11DeviceContext_Flush(G.ctx);
+    /* publish the frame two flips back, so the copy has had time to finish */
+    prev = (unsigned int)((G.frames + KG_STAGING - 2) % KG_STAGING);
+    if (G.frames > 1) publish_staged(prev, 8);
+}
+
+/* The raster size changes between frames: every surface rendered at the host size is dropped and made again at the
+ * new one the next time a draw or clear names it. Their contents are one frame old at most. */
+static void kg_apply_pending_size(void)
+{
+    const ULONG64 want = (ULONG64)s_pending_size;
+    unsigned int w = (unsigned int)(want >> 48), h = (unsigned int)((want >> 32) & 0xFFFFu);
+    unsigned int ow = (unsigned int)((want >> 16) & 0xFFFFu), oh = (unsigned int)(want & 0xFFFFu), i;
+    if (!want || (w == G.host_w && h == G.host_h && ow == G.out_w && oh == G.out_h)) return;
+    if (w != G.host_w || h != G.host_h) {
+        for (i = 0; i < KG_MAX_SURF; i++)
+            if (G.surf[i].used && G.surf[i].gw == 640 && G.surf[i].gh == 480) surf_free(&G.surf[i]);
+        SAFE_RELEASE(G.fb_copy);
+        kg_post_free();
+    }
+    kg_cache_invalidate();
+    fprintf(stderr, "[KGPU] host raster %ux%u -> %ux%u, presented at %ux%u\n", G.host_w, G.host_h, w, h, ow, oh);
+    G.host_w = w; G.host_h = h; G.out_w = ow; G.out_h = oh;
+}
+
+static void kgpu_flip_now(const KelvinTarget *t, unsigned int color_format, uint32_t aspect_w, uint32_t aspect_h)
+{
+    kg_post_before_flip(t, color_format);
+    kgpu_flip_inner(t, color_format, aspect_w, aspect_h);
+    kg_post_after_flip();
+    kg_apply_pending_size();
+}
+
+#include <tlhelp32.h>
+extern volatile DWORD g_black_main_tid;
+extern volatile DWORD g_kelvin_pusher_tid;
+extern volatile DWORD g_kgq_tid;
+/* RECOMP_KGPU_THREADS=1: which threads of this process burned CPU since the last report. */
+static void thread_cpu_report(void)
+{
+    static ULONGLONG prev_ticks[4096][2];
+    static DWORD prev_ids[4096];
+    static unsigned int nprev;
+    static long long last_qpc;
+    HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+    THREADENTRY32 te;
+    long long now = qpc_now();
+    double wall = last_qpc ? (double)(now - last_qpc) / (double)G.qpf : 0.0;
+    DWORD pid = GetCurrentProcessId();
+    unsigned int seen = 0;
+    if (snap == INVALID_HANDLE_VALUE) return;
+    te.dwSize = sizeof(te);
+    if (Thread32First(snap, &te)) {
+        do {
+            if (te.th32OwnerProcessID == pid && seen < 4096) {
+                HANDLE h = OpenThread(THREAD_QUERY_LIMITED_INFORMATION, FALSE, te.th32ThreadID);
+                FILETIME c, e, k, u;
+                if (h) {
+                    if (GetThreadTimes(h, &c, &e, &k, &u)) {
+                        ULONGLONG kk = ((ULONGLONG)k.dwHighDateTime << 32) | k.dwLowDateTime;
+                        ULONGLONG uu = ((ULONGLONG)u.dwHighDateTime << 32) | u.dwLowDateTime;
+                        unsigned int i, found = nprev;
+                        for (i = 0; i < nprev; i++) if (prev_ids[i] == te.th32ThreadID) { found = i; break; }
+                        if (found < nprev && wall > 0.0) {
+                            double dk = (double)(kk - prev_ticks[found][0]) * 1e-7;
+                            double du = (double)(uu - prev_ticks[found][1]) * 1e-7;
+                            if ((dk + du) / wall > 0.02) {
+                                PWSTR name = NULL;
+                                typedef HRESULT (WINAPI *GetDesc)(HANDLE, PWSTR *);
+                                static GetDesc get_desc;
+                                if (!get_desc) get_desc = (GetDesc)GetProcAddress(GetModuleHandleA("kernel32.dll"), "GetThreadDescription");
+                                if (get_desc) get_desc(h, &name);
+                                fprintf(stderr, "[KTHR] tid %lu %-14ls cpu %5.1f%% (user %5.1f%%, kernel %5.1f%%)\n",
+                                        (unsigned long)te.th32ThreadID,
+                                        te.th32ThreadID == g_black_main_tid ? L"MAIN" : te.th32ThreadID == g_kelvin_pusher_tid ? L"PUSHER" :
+                                        te.th32ThreadID == g_kgq_tid ? L"GPUQ" :
+                                        name && *name ? name : L"-",
+                                        100.0 * (dk + du) / wall, 100.0 * du / wall, 100.0 * dk / wall);
+                                if (name) LocalFree(name);
+                            }
+                        }
+                        if (found == nprev && nprev < 4096) { prev_ids[nprev++] = te.th32ThreadID; }
+                        if (found < 4096) { prev_ticks[found][0] = kk; prev_ticks[found][1] = uu; }
+                        seen++;
+                    }
+                    CloseHandle(h);
+                }
+            }
+        } while (Thread32Next(snap, &te));
+    }
+    CloseHandle(snap);
+    last_qpc = now;
+}
+
+void kgpu_report(void)
+{
+    static long long prev[KGP_COUNT];
+    static uint64_t prev_frames;
+    static const char *const names[KGP_COUNT] = { "vertex", "tex", "upload", "state", "draw", "flip", "clear" };
+    double k;
+    int i;
+    if (!G.ok) return;
+    if (getenv("RECOMP_KGPU_THREADS")) thread_cpu_report();
+    kt_report();
+    kgq_report();
+    {
+        extern volatile long g_kgpu_cpuv[8];
+        static long prev[8];
+        fprintf(stderr, "[KGPU] draws on the CPU vertex stage since the last report: no GPU VS %ld, flat shading %ld, lines/points %ld, no vertex program %ld, "
+                        "program not ready %ld, GPU path refused %ld\n", g_kgpu_cpuv[0] - prev[0], g_kgpu_cpuv[1] - prev[1], g_kgpu_cpuv[2] - prev[2],
+                g_kgpu_cpuv[3] - prev[3], g_kgpu_cpuv[4] - prev[4], g_kgpu_cpuv[5] - prev[5]);
+        memcpy(prev, (const void *)g_kgpu_cpuv, sizeof(prev));
+        {
+            extern volatile long g_kgpu_flat_mode[16];
+            extern volatile long long g_kgpu_flat_elems;
+            static long pm[16];
+            static long long pe;
+            int q;
+            fprintf(stderr, "[KGPU] flat-shaded draws by primitive mode:");
+            for (q = 0; q < 16; q++) if (g_kgpu_flat_mode[q] - pm[q]) fprintf(stderr, " mode%d x%ld", q, g_kgpu_flat_mode[q] - pm[q]);
+            fprintf(stderr, "; elements %lld\n", g_kgpu_flat_elems - pe);
+            memcpy(pm, (const void *)g_kgpu_flat_mode, sizeof(pm));
+            pe = g_kgpu_flat_elems;
+        }
+    }
+    k = G.frames > prev_frames ? 1000.0 / (double)G.qpf / (double)(G.frames - prev_frames) : 0.0;
+    fprintf(stderr, "[KGPU] ms per flip over %llu flips:", (unsigned long long)(G.frames - prev_frames));
+    for (i = 0; i < KGP_COUNT; i++) {
+        fprintf(stderr, " %s %.2f", names[i], (g_kgpu_ticks[i] - prev[i]) * k);
+        prev[i] = g_kgpu_ticks[i];
+    }
+    fprintf(stderr, "\n");
+    fprintf(stderr, "[KGPU] flip intervals (ms): <=18 %u, <=20 %u, <=25 %u, <=34 %u, <=70 %u, longer %u; longest %.1f\n",
+            s_hist[0], s_hist[1], s_hist[2], s_hist[3], s_hist[4], s_hist[5], s_hist_max_ms);
+    {
+        char line[400];
+        int len = 0, b;
+        for (b = 0; b < 40; b++) {
+            if (s_fine[b] && len < 360) len += snprintf(line + len, sizeof(line) - len, " %.1f:%u", b * 0.5, s_fine[b]);
+        }
+        line[len] = 0;
+        fprintf(stderr, "[KGPU] flip intervals by 0.5 ms bin:%s\n", line);
+    }
+    memset(s_fine, 0, sizeof(s_fine));
+    memset(s_hist, 0, sizeof(s_hist));
+    s_hist_max_ms = 0.0;
+    prev_frames = G.frames;
+    fprintf(stderr, "[KGPU] draws %llu (%llu with GPU vertices), triangles %llu, skipped %llu; textures: %llu uploads, %llu hits, "
+                    "%llu validations, %.1f MiB; vertex bytes %.1f MiB\n",
+            (unsigned long long)G.draws, (unsigned long long)G.gvs_draws, (unsigned long long)G.tris, (unsigned long long)G.skipped,
+            (unsigned long long)G.tex_uploads, (unsigned long long)G.tex_hits,
+            (unsigned long long)G.tex_validations, G.tex_bytes / 1048576.0, G.vb_bytes / 1048576.0);
+}
+
+/* ---- sampling profiler (diagnostic) -------------------------------------------------------------------
+ * RECOMP_KGPU_PROFILE=start,seconds: after `start` seconds, sample the instruction pointer of every
+ * thread of the process once a millisecond for `seconds`, then print each busy thread's hottest symbols
+ * (the generated guest functions are named sub_XXXXXXXX; needs the PDB beside the executable). */
+#include <dbghelp.h>
+typedef struct ProfSym { uint64_t rip; char name[96]; } ProfSym;
+static DWORD WINAPI profile_thread(LPVOID arg)
+{
+    unsigned int start = ((unsigned int)(uintptr_t)arg) & 0xFFFF, secs = ((unsigned int)(uintptr_t)arg) >> 16;
+    typedef struct TS { DWORD tid; HANDLE h; uint64_t total; uint32_t nsym; struct { uint64_t rip; uint32_t n; } sym[4096]; } TS;
+    TS *ts = (TS *)calloc(256, sizeof(TS));
+    unsigned int nts = 0, i, k;
+    DWORD pid = GetCurrentProcessId(), self = GetCurrentThreadId();
+    long long t0, deadline;
+    LARGE_INTEGER f;
+    QueryPerformanceFrequency(&f);
+    Sleep(start * 1000);
+    {
+        HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+        THREADENTRY32 te;
+        te.dwSize = sizeof(te);
+        if (snap != INVALID_HANDLE_VALUE && Thread32First(snap, &te)) {
+            do {
+                if (te.th32OwnerProcessID == pid && te.th32ThreadID != self && nts < 256) {
+                    HANDLE h = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, te.th32ThreadID);
+                    if (h) { ts[nts].tid = te.th32ThreadID; ts[nts].h = h; nts++; }
+                }
+            } while (Thread32Next(snap, &te));
+        }
+        if (snap != INVALID_HANDLE_VALUE) CloseHandle(snap);
+    }
+    t0 = qpc_now();
+    deadline = t0 + (long long)secs * f.QuadPart;
+    while (qpc_now() < deadline) {
+        for (i = 0; i < nts; i++) {
+            CONTEXT ctx;
+            ctx.ContextFlags = CONTEXT_CONTROL;
+            if (SuspendThread(ts[i].h) == (DWORD)-1) continue;
+            if (GetThreadContext(ts[i].h, &ctx)) {
+                TS *t = &ts[i];
+                t->total++;
+                for (k = 0; k < t->nsym; k++) if (t->sym[k].rip == ctx.Rip) break;
+                if (k == t->nsym && t->nsym < 4096) { t->sym[k].rip = ctx.Rip; t->sym[k].n = 0; t->nsym++; }
+                if (k < t->nsym) t->sym[k].n++;
+            }
+            ResumeThread(ts[i].h);
+        }
+        Sleep(1);
+    }
+    for (i = 0; i < nts; i++) {
+        TS *t = &ts[i];
+        typedef struct { char name[96]; uint32_t n; } Agg;
+        Agg agg[256];
+        unsigned int na = 0;
+        if (t->total < 50) continue;
+        for (k = 0; k < t->nsym; k++) {
+            char buf[sizeof(SYMBOL_INFO) + 128];
+            SYMBOL_INFO *si = (SYMBOL_INFO *)buf;
+            DWORD64 disp = 0;
+            unsigned int j;
+            char nm[96];
+            memset(buf, 0, sizeof(buf));
+            si->SizeOfStruct = sizeof(SYMBOL_INFO);
+            si->MaxNameLen = 120;
+            if (SymFromAddr(GetCurrentProcess(), t->sym[k].rip, &disp, si)) snprintf(nm, sizeof(nm), "%s", si->Name);
+            else snprintf(nm, sizeof(nm), "?%llX", (unsigned long long)(t->sym[k].rip >> 12));
+            for (j = 0; j < na; j++) if (!strcmp(agg[j].name, nm)) break;
+            if (j == na && na < 256) { snprintf(agg[na].name, sizeof(agg[na].name), "%s", nm); agg[na].n = 0; na++; }
+            if (j < na) agg[j].n += t->sym[k].n;
+        }
+        for (k = 0; k < na; k++) {
+            unsigned int j;
+            for (j = k + 1; j < na; j++) if (agg[j].n > agg[k].n) { Agg tmp = agg[k]; agg[k] = agg[j]; agg[j] = tmp; }
+        }
+        fprintf(stderr, "[KPROF] tid %lu: %llu samples:", (unsigned long)t->tid, (unsigned long long)t->total);
+        {
+            const char *topn = getenv("RECOMP_KGPU_PROFILE_TOP");
+            unsigned int top = topn && *topn ? (unsigned int)atoi(topn) : 8;
+            for (k = 0; k < na && k < top; k++) fprintf(stderr, " %s %.1f%%", agg[k].name, 100.0 * agg[k].n / (double)t->total);
+        }
+        fprintf(stderr, "\n");
+    }
+    fflush(stderr);
+    return 0;
+}
+
+#include "kelvin_gpu_slow.inc"
+#include "kelvin_gpu_incl.inc"
+volatile DWORD g_black_main_tid;
+
+void kgpu_profile_maybe_start(void)
+{
+    const char *e = getenv("RECOMP_KGPU_PROFILE");
+    unsigned int a = 0, b = 0;
+    if (e && sscanf(e, "%u,%u", &a, &b) == 2 && b)
+        CloseHandle(CreateThread(NULL, 0, profile_thread, (LPVOID)(uintptr_t)((b << 16) | (a & 0xFFFF)), 0, NULL));
+    incl_maybe_start();
+    e = getenv("RECOMP_KGPU_SLOW");
+    a = 0; b = 0;
+    if (e && sscanf(e, "%u,%u", &a, &b) >= 1 && a)
+        CloseHandle(CreateThread(NULL, 0, slow_thread, (LPVOID)(uintptr_t)(((b & 0xFFFF) << 16) | (a & 0xFFFF)), 0, NULL));
+}
+
+#include "kelvin_gpu_async.inc"
diff --git a/src/nv2a/kelvin/kelvin_gpu.h b/src/nv2a/kelvin/kelvin_gpu.h
new file mode 100644
index 0000000..662239e
--- /dev/null
+++ b/src/nv2a/kelvin/kelvin_gpu.h
@@ -0,0 +1,131 @@
+/*
+ * Kelvin D3D11 backend: rasterization, pixel shading and output merging of
+ * the NV2A on the host GPU, for BLACK's draw subset.
+ *
+ * Enabled with RECOMP_KELVIN_GPU=1 together with RECOMP_NV2A_KELVIN=1. The
+ * CPU vertex stage (kelvin_vsh.c) still transforms the vertices; this module
+ * takes the transformed vertices of a draw, the decoded pixel/combiner state
+ * (KPixelState) and the bound target, and draws them. Surfaces live on the GPU
+ * at the requested host resolution; guest memory is not mirrored.
+ *
+ * Rendering entry points belong to the Kelvin GPU thread. The camera and
+ * viewmodel publication functions below may be called by the title thread.
+ */
+#ifndef XBOX_NV2A_KELVIN_GPU_H
+#define XBOX_NV2A_KELVIN_GPU_H
+
+#include "kelvin_render.h"
+
+/* RECOMP_KELVIN_GPU asks for the backend. */
+bool kgpu_enabled(void);
+/* The backend initialised and owns rendering. */
+bool kgpu_active(void);
+/* Create the device and shaders (idempotent). False: the CPU renderer stays. */
+bool kgpu_init(void);
+void kgpu_report(void);
+/* Profiling: QPC ticks the GPU thread spent in each part of a draw. */
+enum { KGP_VERTEX, KGP_TEX, KGP_UPLOAD, KGP_STATE, KGP_DRAW, KGP_FLIP, KGP_CLEAR, KGP_COUNT };
+extern long long g_kgpu_ticks[KGP_COUNT];
+
+/* The pusher read a new PUT: texture contents are revalidated once per kick. */
+void kgpu_note_kick(void);
+
+/* Host raster size for a full-screen guest target. */
+void kgpu_host_size(unsigned int *w, unsigned int *h);
+
+/* Slots of a vertex record, in float4 units; -1 where the draw has none. */
+enum { KG_POS, KG_D0, KG_D1, KG_FOG, KG_T0, KG_T1, KG_T2, KG_T3, KG_SLOTS };
+
+/* One vertex attribute of a draw whose vertices the GPU shades. */
+typedef struct KGpuAttrSrc {
+    uint32_t fmt;              /* 0: the inline value; 1 UB_D3D, 2 UB_OGL, 3 S1, 4 F, 5 S32K, 6 CMP */
+    uint32_t count;            /* components */
+    uint32_t stride;           /* bytes between elements */
+    const uint8_t *data;       /* element 0 */
+    int64_t lo, hi;            /* bytes of it the draw reads, relative to data */
+    float inline_value[4];
+} KGpuAttrSrc;
+
+typedef struct KGpuVsDraw {
+    const void *program;       /* Nv2aVshProgram */
+    uint32_t hash, start;
+    const float *constants;    /* 192 x 4 */
+    bool fog_enable;
+    int fog_mode;
+    float fog_param[2];
+    bool specular_enable, ignore_specular_alpha;
+    KGpuAttrSrc attr[16];
+} KGpuVsDraw;
+
+/* The GPU can shade this program's vertices now (its shader is compiled). */
+bool kgpu_vs_enabled(void);
+bool kgpu_vs_ready(const void *program, uint32_t hash, uint32_t start);
+
+/* KGpuDraw.clean: what the caller knows is unchanged since its previous draw (so what derives from it is kept). A
+ * caller that cannot tell leaves it zero. */
+enum { KG_CLEAN_T = 1, KG_CLEAN_PS = 2 };
+/* KGpuDraw.topology */
+enum { KG_TOPO_LIST = 0, KG_TOPO_STRIP = 1 };
+
+typedef struct KGpuDraw {
+    const KelvinTarget *t;
+    const KPixelState *ps;
+    bool cull_enable, ccw_front;
+    int cull_ctrl;
+    /* Polygon offset: bias in zeta units (zero for none) and the slope factor. */
+    float zbias, zslope;
+    /* Vertex records: vcount records of `stride` float4s, laid out by slot. */
+    const float *recs;
+    uint32_t vcount, stride;
+    int slot[KG_SLOTS];
+    /* With gvs set the GPU shades the vertices: recs/vcount/stride/slot are unused
+     * and indices are element numbers of the draw's vertex arrays. */
+    const KGpuVsDraw *gvs;
+    /* Triangle list over the records, or a triangle strip (restarts are 0xFFFFFFFF). */
+    const uint32_t *indices;
+    uint32_t icount;
+    unsigned int topology;
+    uint32_t index_limit;      /* every real index is below this; zero if not known (indices stay 32-bit) */
+    uint32_t clean;
+} KGpuDraw;
+
+void kgpu_draw(const KGpuDraw *d);
+
+/* NV097_CLEAR_SURFACE for the rectangle (host-stored pixels, scaled by the
+ * caller's kelvin_raster scale), channel mask in bit order B G R A. */
+void kgpu_clear(const KelvinTarget *t, bool color, bool depth, bool stencil,
+                uint32_t color_value, uint32_t zs_value, unsigned int channel_mask,
+                int x0, int y0, int x1, int y1, unsigned int color_format);
+
+/* Viewmodel scale: draws made with one of these vertex programs (hash up to 8, as kgpu's vertex program hash) have their
+ * window position scaled about the viewport centre by `scale` (the caller's ratio between the world camera's window and
+ * the one the first-person model was made for). Pass count 0 to clear. */
+void kgpu_set_viewmodel(const uint32_t *vs_hashes, int count, float scale);
+
+/* AO position reconstruction: publish the real camera's horizontal/vertical
+ * half-frustum after aspect, aim zoom and optional PC FOV. Invalid input disables
+ * AO until a valid camera arrives. Safe on the title thread. */
+void kgpu_set_ao_camera(float half_x, float half_y);
+
+/* RECOMP_KGPU_COMPARE=N: draw every frame with both renderers and compare the
+ * finished frame every N flips (640x480 host size only); the CPU frame is shown. */
+bool kgpu_compare_enabled(void);
+void kgpu_compare_frame(const KelvinTarget *t, unsigned int color_format);
+/* RECOMP_KGPU_PASSCMP (lab diagnostic): called by the CPU path after it has drawn what the GPU just drew. */
+void kgpu_pass_check(void);
+
+/* Asynchronous submission (kelvin_gpu_async.inc): kgpu_draw, kgpu_clear and kgpu_flip queue their work for a thread
+ * of their own. Everything the title can see of the GPU's progress goes through the queue as well. */
+bool kgpu_async_active(void);
+/* Wait until everything queued so far has been executed. */
+void kgpu_drain(void);
+/* Run fn(a, b) on the GPU thread behind everything queued before it (at once, if submission is synchronous). */
+void kgpu_defer_call(void (*fn)(uintptr_t, uintptr_t), uintptr_t a, uintptr_t b);
+/* The GET to publish given the pusher's `get`: no further than the oldest draw not yet executed. */
+uint32_t kgpu_get_bound(uint32_t get);
+
+/* FLIP_STALL: the target `t` holds the finished frame. */
+void kgpu_flip(const KelvinTarget *t, unsigned int color_format,
+               uint32_t aspect_w, uint32_t aspect_h);
+
+#endif
diff --git a/src/nv2a/kelvin/kelvin_gpu_async.inc b/src/nv2a/kelvin/kelvin_gpu_async.inc
new file mode 100644
index 0000000..d00641c
--- /dev/null
+++ b/src/nv2a/kelvin/kelvin_gpu_async.inc
@@ -0,0 +1,583 @@
+/* Asynchronous submission, included by kelvin_gpu.c after the draw, clear and flip it hands over.
+ *
+ * The pusher thread (A) parses the pushbuffer and works out each draw; the Direct3D work of drawing it -- the textures,
+ * the uploads, the state, the draw call itself -- is the larger half of its time. kgpu_draw, kgpu_clear and kgpu_flip
+ * now copy what they were given into a ring and a thread of its own (B) executes the copies, in order, with the same
+ * kgpu_*_now functions as before. Only B touches the Direct3D immediate context.
+ *
+ * What stays in order:
+ *   - Semaphore writes, and GET at PUT (which D3D reads as "the GPU is idle"), are calls queued behind the draws
+ *     before them (kgpu_defer_call).
+ *   - A notify (an interrupt that tells the title the GPU got here) waits for the queue to drain.
+ *   - GET is held at the oldest draw B has not finished (kgpu_get_bound): the title may reuse a draw's vertex memory
+ *     once GET is past it, and B reads that memory when it executes the draw. A is stopped from running further ahead
+ *     of B than a bounded number of pushbuffer words, so GET stays within D3D's fence-rewrite margin of what A has
+ *     read (see KG_GET_LAG in kelvin_render.c).
+ *   - At most RECOMP_KGPU_MAX_FLIPS frames (default 2) are queued, so the picture does not trail the game.
+ *
+ * RECOMP_KGPU_ASYNC=0 runs everything in the caller as before. The compare mode (RECOMP_KGPU_COMPARE) does too. */
+#include <synchapi.h>
+#pragma comment(lib, "synchronization.lib")
+
+extern volatile DWORD g_black_main_tid;
+extern void xbox_PinThread(const char *role);
+extern long long xbox_kernel_next_vblank_qpc(long long *period);
+extern void pc_input_frame_complete(void);
+
+#define KGQ_CAP ((size_t)32 << 20)
+#define KGQ_DRAWS 1024
+#define KGQ_ALIGN16(n) (((size_t)(n) + 15u) & ~(size_t)15u)
+
+enum { KGQ_PAD = 1, KGQ_DRAW, KGQ_CLEAR, KGQ_FLIP, KGQ_CALL };
+enum { KGD_T = 1, KGD_PS = 2, KGD_CONST = 4, KGD_GVS = 8, KGD_RECS = 16 };
+
+typedef struct KgHdr { uint32_t size, kind; uint64_t pad; } KgHdr;
+
+typedef struct KgDraw {
+    uint32_t flags, icount;
+    uint64_t epoch;
+    uint64_t ao_camera;             /* title camera sampled with this submission, independent of later title frames */
+    int32_t cull_enable, cull_ctrl, ccw_front, topology;
+    float zbias, zslope;
+    uint32_t vcount, stride, inl_bytes, index_limit;
+    uint64_t inl_base;               /* where the private vertex data (inline arrays) was, to rebase the pointers into it */
+    int32_t slot[KG_SLOTS];
+} KgDraw;
+
+typedef struct KgClear {
+    KelvinTarget t;
+    uint32_t color, depth, stencil, cv, zv, chan, fmt, pad;
+    int32_t x0, y0, x1, y1;
+} KgClear;
+
+typedef struct KgFlip {
+    KelvinTarget t;
+    uint32_t fmt, aspect_w, aspect_h, pad;
+    long long present_qpc;           /* do not present before this time (0: at once) */
+} KgFlip;
+
+typedef struct KgCall {
+    void (*fn)(uintptr_t, uintptr_t);
+    uintptr_t a, b;
+} KgCall;
+
+static int s_kq_mode = -1;                 /* -1 unread, 0 off, 1 on */
+static uint8_t *s_kq;
+static uint64_t s_kq_wr_local;             /* A: where the next packet goes (published only when complete) */
+static volatile LONG64 s_kq_wr;            /* published write position, bytes */
+static volatile LONG64 s_kq_rd;            /* B's read position, bytes */
+static volatile LONG64 s_kq_done;          /* packets B finished (a pad is not a packet) */
+static uint64_t s_kq_posted;               /* A: packets posted */
+static volatile LONG s_kq_b_sleep, s_kq_a_sleep;
+static uint64_t s_draws_posted;
+static volatile LONG64 s_draws_done;
+static uint64_t s_dget[KGQ_DRAWS], s_dwords[KGQ_DRAWS];
+static uint64_t s_flips_posted;
+static volatile LONG64 s_flips_done;
+static int s_max_flips = 2;
+static int s_pace_debug = -1;
+static double s_present_delay = 0.5;       /* in vblank periods; 0 presents as soon as the frame is drawn */
+static unsigned s_lag_words = 1280;
+static uint64_t s_a_waits_cap, s_a_waits_flip, s_a_waits_space, s_a_drains, s_b_sleeps;
+static uint64_t s_a_long_waits;
+static volatile long long s_a_wait_ticks, s_b_idle_ticks;      /* QPC ticks A spent waiting for B, B for A */
+volatile DWORD g_kgq_tid;
+
+/* What B has, and A's copy of it, so a draw sends only what changed since the last. */
+static KelvinTarget a_t, b_t;
+static KPixelState a_ps, b_ps;
+static float a_consts[192 * 4], b_consts[192 * 4];
+static bool a_has_t, a_has_ps, a_has_c;
+
+static bool kgq_enabled(void)
+{
+    return s_kq_mode > 0;
+}
+
+bool kgpu_async_active(void)
+{
+    return s_kq_mode > 0;
+}
+
+/* Until B has finished more than `seen` packets (read before the condition that is being waited on was tested, so a
+ * completion in between is not lost), or a millisecond has passed. */
+static void kgq_a_wait(LONG64 seen)
+{
+    int i;
+    long long t0 = qpc_now();
+    for (i = 0; i < 4000; i++) {
+        if (s_kq_done != seen) goto out;
+        _mm_pause();
+    }
+    s_kq_a_sleep = 1;
+    MemoryBarrier();
+    if (s_kq_done == seen) WaitOnAddress(&s_kq_done, &seen, sizeof(seen), 1);
+    s_kq_a_sleep = 0;
+out:
+    {
+        long long dt = qpc_now() - t0;
+        s_a_wait_ticks += dt;
+        if (dt > G.qpf / 2000) s_a_long_waits++;           /* over half a millisecond */
+    }
+}
+#define KGQ_A_WHILE(cond, counter)     for (;;) { LONG64 seen_ = s_kq_done; if (!(cond)) break; (counter)++; kgq_a_wait(seen_); }
+
+/* Finished frames waiting for their time to be shown, oldest first (GPU thread only). With a delay of more than a
+ * vblank period two or three are normally waiting. */
+#define KGQ_PEND 6
+typedef struct KgPend { long long at; unsigned slot; uint64_t value; uint32_t va, aw, ah; } KgPend;
+static KgPend s_pend[KGQ_PEND];
+static unsigned s_pend_n;
+static long long s_cur_present_qpc;
+
+/* How evenly frames reach the presenter: intervals between publications, 0.25 ms bins up to 10 ms. */
+static unsigned s_pubhist[40];
+static long long s_pub_prev;
+
+static void kgq_note_publish(void)
+{
+    long long now = qpc_now();
+    if (s_pub_prev) {
+        double ms = (double)(now - s_pub_prev) * 1000.0 / (double)G.qpf;
+        s_pubhist[ms >= 9.99 ? 39 : (unsigned)(ms * 4.0)]++;
+    }
+    s_pub_prev = now;
+}
+
+static void kgq_pub_oldest(void)
+{
+    KgPend p = s_pend[0];
+    memmove(&s_pend[0], &s_pend[1], (s_pend_n - 1) * sizeof(s_pend[0]));
+    s_pend_n--;
+    kgq_note_publish();
+    xbox_FramebufferPublishGpu(p.slot, p.value, p.va, p.aw, p.ah);
+}
+
+/* Show the frames whose time has come. */
+static void kgq_pub_poll(void)
+{
+    while (s_pend_n && qpc_now() >= s_pend[0].at) kgq_pub_oldest();
+}
+
+static unsigned long long s_dbg_def, s_dbg_imm, s_dbg_zero;
+static long long s_dbg_late_ticks;
+
+static void kgq_publish_frame(unsigned slot, uint64_t value, uint32_t va, uint32_t aspect_w, uint32_t aspect_h)
+{
+    long long at = s_cur_present_qpc;
+    if (!at) s_dbg_zero++;
+    else if (at > qpc_now()) s_dbg_def++;
+    else { s_dbg_imm++; s_dbg_late_ticks += qpc_now() - at; }
+    kgq_pub_poll();
+    if (at && at > qpc_now()) {
+        if (s_pend_n == KGQ_PEND) kgq_pub_oldest();       /* never expected: more frames in flight than the queue allows */
+        s_pend[s_pend_n].at = at; s_pend[s_pend_n].slot = slot; s_pend[s_pend_n].value = value;
+        s_pend[s_pend_n].va = va; s_pend[s_pend_n].aw = aspect_w; s_pend[s_pend_n].ah = aspect_h;
+        s_pend_n++;
+        return;
+    }
+    /* frames come out in order: anything waiting goes first */
+    while (s_pend_n) kgq_pub_oldest();
+    kgq_note_publish();
+    xbox_FramebufferPublishGpu(slot, value, va, aspect_w, aspect_h);
+}
+
+static void kgq_b_wait(uint64_t rd)
+{
+    int i;
+    for (i = 0; i < 8000; i++) {
+        if ((uint64_t)s_kq_wr != rd) return;
+        if (s_pend_n) kgq_pub_poll();
+        _mm_pause();
+    }
+    if (s_pend_n) {
+        /* a frame waits for its time: stay awake for it */
+        while ((uint64_t)s_kq_wr == rd && s_pend_n) {
+            kgq_pub_poll();
+            _mm_pause();                       /* not SwitchToThread: giving the core away can cost a whole time slice */
+        }
+        return;
+    }
+    s_kq_b_sleep = 1;
+    MemoryBarrier();
+    if ((uint64_t)s_kq_wr == rd) {
+        LONG64 seen = (LONG64)rd;
+        s_b_sleeps++;
+        WaitOnAddress(&s_kq_wr, &seen, sizeof(seen), 1);
+    }
+    s_kq_b_sleep = 0;
+}
+
+/* Room for a packet of `size` bytes (a multiple of 16), after a pad when it would wrap. */
+static uint8_t *kgq_alloc(size_t size)
+{
+    size_t off = (size_t)(s_kq_wr_local & (KGQ_CAP - 1)), pad = 0;
+    if (off + size > KGQ_CAP) pad = KGQ_CAP - off;
+    KGQ_A_WHILE(s_kq_wr_local + size + pad - (uint64_t)s_kq_rd > KGQ_CAP, s_a_waits_space)
+    if (pad) {
+        KgHdr *p = (KgHdr *)(s_kq + off);
+        p->size = (uint32_t)pad; p->kind = KGQ_PAD; p->pad = 0;
+        s_kq_wr_local += pad;
+        off = 0;
+    }
+    return s_kq + off;
+}
+
+static void kgq_publish(size_t size)
+{
+    s_kq_wr_local += size;
+    s_kq_posted++;
+    _InterlockedExchange64(&s_kq_wr, (LONG64)s_kq_wr_local);
+    if (s_kq_b_sleep) WakeByAddressSingle((PVOID)&s_kq_wr);
+}
+
+void kgpu_drain(void)
+{
+    if (!kgq_enabled()) return;
+    s_a_drains++;
+    {
+        uint64_t unused = 0;
+        KGQ_A_WHILE((uint64_t)s_kq_done < s_kq_posted, unused)
+    }
+}
+
+void kgpu_defer_call(void (*fn)(uintptr_t, uintptr_t), uintptr_t a, uintptr_t b)
+{
+    uint8_t *p;
+    KgCall *c;
+    size_t size = sizeof(KgHdr) + KGQ_ALIGN16(sizeof(KgCall));
+    if (!kgq_enabled()) { fn(a, b); return; }
+    p = kgq_alloc(size);
+    ((KgHdr *)p)->size = (uint32_t)size; ((KgHdr *)p)->kind = KGQ_CALL; ((KgHdr *)p)->pad = 0;
+    c = (KgCall *)(p + sizeof(KgHdr));
+    c->fn = fn; c->a = a; c->b = b;
+    kgq_publish(size);
+}
+
+/* The GET to publish: no further than the oldest draw B has not finished. */
+uint32_t kgpu_get_bound(uint32_t get)
+{
+    uint64_t done = (uint64_t)s_draws_done;
+    if (!kgq_enabled() || done >= s_draws_posted) return get;
+    return (uint32_t)s_dget[done % KGQ_DRAWS];
+}
+
+static bool kgq_guest_ptr(const uint8_t *p)
+{
+    const uint8_t *base = kelvin_guest(KELVIN_PHYS_WINDOW);
+    return p >= base && p < base + KELVIN_PHYS_SIZE;
+}
+
+void kgpu_draw(const KGpuDraw *d)
+{
+    uint8_t *p, *q;
+    KgDraw *k;
+    uint32_t flags = 0;
+    size_t size, tsz = KGQ_ALIGN16(sizeof(KelvinTarget)), psz = KGQ_ALIGN16(sizeof(KPixelState));
+    size_t gsz = KGQ_ALIGN16(sizeof(KGpuVsDraw)), csz = sizeof(a_consts), rsz = 0, isz, nsz = 0;
+    const uint8_t *inl_lo = NULL, *inl_hi = NULL;
+    int a;
+    uint64_t words;
+    const uint64_t ao_camera = kg_ao_camera_bits();
+    if (!kgq_enabled()) { s_ao_draw_camera = ao_camera; kgpu_draw_now(d); return; }
+    if (!G.ok || !d->icount || (!d->gvs && !d->vcount)) return;
+    if (!a_has_t || memcmp(&a_t, d->t, sizeof(a_t)) != 0) flags |= KGD_T;
+    if (!a_has_ps || memcmp(&a_ps, d->ps, sizeof(a_ps)) != 0) flags |= KGD_PS;
+    if (d->gvs) {
+        flags |= KGD_GVS;
+        if (!a_has_c || memcmp(a_consts, d->gvs->constants, sizeof(a_consts)) != 0) flags |= KGD_CONST;
+        for (a = 0; a < 16; a++) {
+            const KGpuAttrSrc *as = &d->gvs->attr[a];
+            const uint8_t *lo, *hi;
+            if (!as->fmt) continue;
+            lo = as->data + as->lo; hi = as->data + as->hi;
+            if (kgq_guest_ptr(lo)) continue;
+            if (!inl_lo || lo < inl_lo) inl_lo = lo;
+            if (!inl_hi || hi > inl_hi) inl_hi = hi;
+        }
+        if (inl_lo) nsz = KGQ_ALIGN16((size_t)(inl_hi - inl_lo));
+    } else {
+        flags |= KGD_RECS;
+        rsz = KGQ_ALIGN16((size_t)d->vcount * d->stride * 16);
+    }
+    isz = KGQ_ALIGN16((size_t)d->icount * 4);
+    csz = (flags & KGD_CONST) ? KGQ_ALIGN16(csz) : 0;
+    size = sizeof(KgHdr) + KGQ_ALIGN16(sizeof(KgDraw)) + ((flags & KGD_T) ? tsz : 0) + ((flags & KGD_PS) ? psz : 0) +
+           ((flags & KGD_GVS) ? gsz : 0) + csz + rsz + isz + nsz;
+    if (size > KGQ_CAP / 4) {
+        /* too large for the ring: everything before it finishes, then it runs here */
+        kgpu_drain();
+        G.epoch = s_kick_epoch;
+        s_ao_draw_camera = ao_camera;
+        kgpu_draw_now(d);
+        kg_cache_invalidate();           /* it ran with its own state: what the next queued draw leaves unchanged is not that */
+        return;
+    }
+    /* A may not run further ahead of B than the GET lag allows. */
+    words = g_kelvin.stats.words;
+    KGQ_A_WHILE(s_draws_posted > (uint64_t)s_draws_done &&
+                words - s_dwords[(uint64_t)s_draws_done % KGQ_DRAWS] > s_lag_words, s_a_waits_cap)
+    s_dget[s_draws_posted % KGQ_DRAWS] = g_kelvin_word_get;
+    s_dwords[s_draws_posted % KGQ_DRAWS] = words;
+    s_draws_posted++;
+
+    p = kgq_alloc(size);
+    ((KgHdr *)p)->size = (uint32_t)size; ((KgHdr *)p)->kind = KGQ_DRAW; ((KgHdr *)p)->pad = 0;
+    k = (KgDraw *)(p + sizeof(KgHdr));
+    k->flags = flags; k->icount = d->icount; k->epoch = s_kick_epoch;
+    k->ao_camera = ao_camera;
+    k->cull_enable = d->cull_enable ? 1 : 0; k->cull_ctrl = d->cull_ctrl; k->ccw_front = d->ccw_front ? 1 : 0;
+    k->topology = (int32_t)d->topology;
+    k->zbias = d->zbias; k->zslope = d->zslope;
+    k->vcount = d->vcount; k->stride = d->stride; k->inl_bytes = (uint32_t)(inl_lo ? inl_hi - inl_lo : 0);
+    k->index_limit = d->index_limit;
+    k->inl_base = (uint64_t)(uintptr_t)inl_lo;
+    for (a = 0; a < KG_SLOTS; a++) k->slot[a] = d->slot[a];
+    q = (uint8_t *)k + KGQ_ALIGN16(sizeof(KgDraw));
+    if (flags & KGD_T) { memcpy(q, d->t, sizeof(KelvinTarget)); memcpy(&a_t, d->t, sizeof(a_t)); a_has_t = true; q += tsz; }
+    if (flags & KGD_PS) { memcpy(q, d->ps, sizeof(KPixelState)); memcpy(&a_ps, d->ps, sizeof(a_ps)); a_has_ps = true; q += psz; }
+    if (flags & KGD_GVS) {
+        memcpy(q, d->gvs, sizeof(KGpuVsDraw)); q += gsz;
+        if (flags & KGD_CONST) {
+            memcpy(q, d->gvs->constants, sizeof(a_consts)); memcpy(a_consts, d->gvs->constants, sizeof(a_consts));
+            a_has_c = true; q += csz;
+        }
+    }
+    if (flags & KGD_RECS) { memcpy(q, d->recs, (size_t)d->vcount * d->stride * 16); q += rsz; }
+    memcpy(q, d->indices, (size_t)d->icount * 4); q += isz;
+    if (inl_lo) memcpy(q, inl_lo, (size_t)(inl_hi - inl_lo));
+    kgq_publish(size);
+}
+
+void kgpu_clear(const KelvinTarget *t, bool color, bool depth, bool stencil,
+                uint32_t color_value, uint32_t zs_value, unsigned int channel_mask,
+                int x0, int y0, int x1, int y1, unsigned int color_format)
+{
+    uint8_t *p;
+    KgClear *c;
+    size_t size = sizeof(KgHdr) + KGQ_ALIGN16(sizeof(KgClear));
+    if (!kgq_enabled()) {
+        kgpu_clear_now(t, color, depth, stencil, color_value, zs_value, channel_mask, x0, y0, x1, y1, color_format);
+        return;
+    }
+    if (!G.ok) return;
+    p = kgq_alloc(size);
+    ((KgHdr *)p)->size = (uint32_t)size; ((KgHdr *)p)->kind = KGQ_CLEAR; ((KgHdr *)p)->pad = 0;
+    c = (KgClear *)(p + sizeof(KgHdr));
+    memcpy(&c->t, t, sizeof(*t));
+    c->color = color; c->depth = depth; c->stencil = stencil; c->cv = color_value; c->zv = zs_value;
+    c->chan = channel_mask; c->fmt = color_format; c->pad = 0;
+    c->x0 = x0; c->y0 = y0; c->x1 = x1; c->y1 = y1;
+    kgq_publish(size);
+}
+
+void kgpu_flip(const KelvinTarget *t, unsigned int color_format, uint32_t aspect_w, uint32_t aspect_h)
+{
+    uint8_t *p;
+    KgFlip *f;
+    size_t size = sizeof(KgHdr) + KGQ_ALIGN16(sizeof(KgFlip));
+    if (!kgq_enabled()) { kgpu_flip_now(t, color_format, aspect_w, aspect_h); return; }
+    if (!G.ok) return;
+    /* The input context counts the game's frames: it is told at the flip, in the order the game polled, not when the
+     * picture is later shown (xbox_FramebufferInputByCaller). */
+    pc_input_frame_complete();
+    KGQ_A_WHILE(s_flips_posted - (uint64_t)s_flips_done >= (uint64_t)s_max_flips, s_a_waits_flip)
+    p = kgq_alloc(size);
+    ((KgHdr *)p)->size = (uint32_t)size; ((KgHdr *)p)->kind = KGQ_FLIP; ((KgHdr *)p)->pad = 0;
+    f = (KgFlip *)(p + sizeof(KgHdr));
+    memcpy(&f->t, t, sizeof(*t));
+    f->fmt = color_format; f->aspect_w = aspect_w; f->aspect_h = aspect_h; f->pad = 0;
+    f->present_qpc = 0;
+    if (s_present_delay > 0.0) {
+        /* The pusher goes on when the next vblank releases this flip; the frame is shown a fixed time after that, so
+         * frames are presented evenly however long each took to draw (a frame that is late is shown as soon as it is
+         * done). */
+        long long period = 0, next = xbox_kernel_next_vblank_qpc(&period);
+        if (next) {
+            /* Two flips queued for the same vblank (the game caught up after a late frame) are shown a period apart rather
+             * than together, so the picture moves evenly; the later one is never put off by more than a period. */
+            static long long last_target;
+            long long ideal = next + (long long)((double)period * s_present_delay), t = ideal;
+            if (last_target && t < last_target + period * 9 / 10) t = last_target + period * 9 / 10;
+            if (t - ideal > period) t = ideal;
+            last_target = t;
+            f->present_qpc = t;
+        }
+        if (s_pace_debug < 0) s_pace_debug = getenv("RECOMP_KGPU_PACE_DEBUG") != NULL;
+        if (s_pace_debug) {
+            static long long prev_pres, prev_post;
+            static int shown;
+            long long now = qpc_now();
+            if (prev_pres && (f->present_qpc - prev_pres > period * 3 / 2 || f->present_qpc - prev_pres < period / 2) && shown++ < 400)
+                fprintf(stderr, "[PACE] post +%.2f ms, next vblank in %.2f ms, target step %.2f ms\n",
+                        (double)(now - prev_post) * 1000.0 / (double)G.qpf, (double)(next - now) * 1000.0 / (double)G.qpf,
+                        (double)(f->present_qpc - prev_pres) * 1000.0 / (double)G.qpf);
+            prev_pres = f->present_qpc; prev_post = now;
+        }
+    }
+    s_flips_posted++;
+    kgq_publish(size);
+}
+
+static DWORD WINAPI kgq_thread(LPVOID unused)
+{
+    uint64_t rd = 0, done = 0, draws = 0, flips = 0;
+    static KGpuVsDraw gv;
+    (void)unused;
+    xbox_PinThread("GPU");
+    g_kgq_tid = GetCurrentThreadId();
+    for (;;) {
+        const KgHdr *h;
+        uint64_t wr = (uint64_t)s_kq_wr;
+        if (wr == rd) {
+            long long t0 = qpc_now();
+            kgq_b_wait(rd);
+            s_b_idle_ticks += qpc_now() - t0;
+            continue;
+        }
+        h = (const KgHdr *)(s_kq + (rd & (KGQ_CAP - 1)));
+        switch (h->kind) {
+        case KGQ_PAD:
+            rd += h->size;
+            s_kq_rd = (LONG64)rd;
+            continue;
+        case KGQ_DRAW: {
+            const KgDraw *k = (const KgDraw *)(h + 1);
+            const uint8_t *q = (const uint8_t *)k + KGQ_ALIGN16(sizeof(KgDraw));
+            KGpuDraw d;
+            int a;
+            if (k->flags & KGD_T) { memcpy(&b_t, q, sizeof(b_t)); q += KGQ_ALIGN16(sizeof(KelvinTarget)); }
+            if (k->flags & KGD_PS) { memcpy(&b_ps, q, sizeof(b_ps)); q += KGQ_ALIGN16(sizeof(KPixelState)); }
+            memset(&d, 0, sizeof(d));
+            d.t = &b_t; d.ps = &b_ps;
+            d.cull_enable = k->cull_enable != 0; d.cull_ctrl = k->cull_ctrl; d.ccw_front = k->ccw_front != 0;
+            d.topology = (unsigned int)k->topology; d.index_limit = k->index_limit;
+            d.zbias = k->zbias; d.zslope = k->zslope;
+            d.clean = ((k->flags & KGD_T) ? 0u : KG_CLEAN_T) | ((k->flags & KGD_PS) ? 0u : KG_CLEAN_PS);
+            for (a = 0; a < KG_SLOTS; a++) d.slot[a] = k->slot[a];
+            if (k->flags & KGD_GVS) {
+                memcpy(&gv, q, sizeof(gv)); q += KGQ_ALIGN16(sizeof(KGpuVsDraw));
+                if (k->flags & KGD_CONST) { memcpy(b_consts, q, sizeof(b_consts)); q += KGQ_ALIGN16(sizeof(b_consts)); }
+                gv.constants = b_consts;
+                d.gvs = &gv;
+            }
+            if (k->flags & KGD_RECS) {
+                d.recs = (const float *)q; d.vcount = k->vcount; d.stride = k->stride;
+                q += KGQ_ALIGN16((size_t)k->vcount * k->stride * 16);
+            }
+            d.indices = (const uint32_t *)q; d.icount = k->icount;
+            q += KGQ_ALIGN16((size_t)k->icount * 4);
+            if (k->inl_bytes) {
+                for (a = 0; a < 16; a++) {
+                    if (gv.attr[a].fmt && !kgq_guest_ptr(gv.attr[a].data + gv.attr[a].lo)) {
+                        gv.attr[a].data = q + ((intptr_t)(uintptr_t)gv.attr[a].data - (intptr_t)k->inl_base);
+                    }
+                }
+            }
+            G.epoch = k->epoch;
+            s_ao_draw_camera = k->ao_camera;
+            kgpu_draw_now(&d);
+            draws++;
+            break;
+        }
+        case KGQ_CLEAR: {
+            const KgClear *c = (const KgClear *)(h + 1);
+            kgpu_clear_now(&c->t, c->color != 0, c->depth != 0, c->stencil != 0, c->cv, c->zv, c->chan, c->x0, c->y0,
+                           c->x1, c->y1, c->fmt);
+            break;
+        }
+        case KGQ_FLIP: {
+            const KgFlip *f = (const KgFlip *)(h + 1);
+            s_cur_present_qpc = f->present_qpc;
+            kgpu_flip_now(&f->t, f->fmt, f->aspect_w, f->aspect_h);
+            s_cur_present_qpc = 0;
+            flips++;
+            break;
+        }
+        case KGQ_CALL: {
+            const KgCall *c = (const KgCall *)(h + 1);
+            c->fn(c->a, c->b);
+            break;
+        }
+        default:
+            break;
+        }
+        if (s_pend_n) kgq_pub_poll();
+        rd += h->size;
+        s_kq_rd = (LONG64)rd;
+        s_draws_done = (LONG64)draws;
+        s_flips_done = (LONG64)flips;
+        done++;
+        _InterlockedExchange64(&s_kq_done, (LONG64)done);
+        if (s_kq_a_sleep) WakeByAddressAll((PVOID)&s_kq_done);
+    }
+    return 0;
+}
+
+static void kgq_start(void)
+{
+    const char *e = getenv("RECOMP_KGPU_ASYNC");
+    if (s_kq_mode >= 0) return;
+    s_kq_mode = 0;
+    if (e && *e == '0') return;
+    if (kgpu_compare_enabled()) return;
+    if (!(e && *e)) {
+        /* The submission thread and the pusher each keep a processor busy next to the game's own thread: on a small
+         * machine that costs more than it gains. RECOMP_KGPU_ASYNC=1 forces it. */
+        SYSTEM_INFO si;
+        GetSystemInfo(&si);
+        if (si.dwNumberOfProcessors < 8) {
+            fprintf(stderr, "[KGPU] %lu logical processors: submitting from the pusher thread (RECOMP_KGPU_ASYNC=1 overrides)\n",
+                    (unsigned long)si.dwNumberOfProcessors);
+            return;
+        }
+    }
+    s_kq = (uint8_t *)VirtualAlloc(NULL, KGQ_CAP, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+    if (!s_kq) return;
+    e = getenv("RECOMP_KGPU_MAX_FLIPS");
+    if (e && *e) { s_max_flips = atoi(e); if (s_max_flips < 1) s_max_flips = 1; if (s_max_flips > 8) s_max_flips = 8; }
+    e = getenv("RECOMP_KGPU_PRESENT_DELAY");
+    if (e && *e) { s_present_delay = atof(e); if (s_present_delay < 0.0) s_present_delay = 0.0; if (s_present_delay > 4.0) s_present_delay = 4.0; }
+    if (s_present_delay > 0.0 && s_max_flips < 3 && !getenv("RECOMP_KGPU_MAX_FLIPS")) s_max_flips = 3;
+    e = getenv("RECOMP_KGPU_LAG_WORDS");
+    if (e && *e) { int v = atoi(e); if (v < 64) v = 64; if (v > 1800) v = 1800; s_lag_words = (unsigned)v; }
+    s_kq_mode = 1;
+    {
+        HANDLE th = CreateThread(NULL, 0, kgq_thread, NULL, 0, NULL);
+        if (!th) { s_kq_mode = 0; return; }
+        CloseHandle(th);
+    }
+    xbox_FramebufferInputByCaller(1);
+    fprintf(stderr, "[KGPU] asynchronous submission: %u MiB queue, GET lag %u words, %d frames in flight\n",
+            (unsigned)(KGQ_CAP >> 20), s_lag_words, s_max_flips);
+}
+
+static void kgq_report(void)
+{
+    static uint64_t p_cap, p_flip, p_space, p_drain, p_sleep, p_flips, p_long;
+    static long long p_a, p_b;
+    double k;
+    if (!kgq_enabled()) return;
+    k = G.frames > p_flips ? 1000.0 / (double)G.qpf / (double)(G.frames - p_flips) : 0.0;
+    fprintf(stderr, "[KGPU] async: per flip A waited for B %.2f ms, B waited for A %.2f ms; waits %llu on the GET lag, "
+                    "%llu on queued frames, %llu on ring space; %llu drains; B slept %llu times; %llu waits over 0.5 ms\n",
+            (s_a_wait_ticks - p_a) * k, (s_b_idle_ticks - p_b) * k,
+            (unsigned long long)(s_a_waits_cap - p_cap), (unsigned long long)(s_a_waits_flip - p_flip),
+            (unsigned long long)(s_a_waits_space - p_space), (unsigned long long)(s_a_drains - p_drain),
+            (unsigned long long)(s_b_sleeps - p_sleep), (unsigned long long)(s_a_long_waits - p_long));
+    p_long = s_a_long_waits;
+    {
+        char line[480];
+        int len = 0, b;
+        for (b = 0; b < 40; b++) {
+            if (s_pubhist[b] && len < 420) len += snprintf(line + len, sizeof(line) - len, " %.2f:%u", b * 0.25, s_pubhist[b]);
+        }
+        line[len] = 0;
+        fprintf(stderr, "[KGPU] presenter intervals by 0.25 ms bin:%s\n", line);
+        fprintf(stderr, "[KGPU] paced frames: %llu waited for their time, %llu late (mean %.2f ms late), %llu unpaced\n", s_dbg_def, s_dbg_imm,
+                s_dbg_imm ? (double)s_dbg_late_ticks * 1000.0 / (double)G.qpf / (double)s_dbg_imm : 0.0, s_dbg_zero);
+        memset(s_pubhist, 0, sizeof(s_pubhist));
+    }
+    p_cap = s_a_waits_cap; p_flip = s_a_waits_flip; p_space = s_a_waits_space; p_drain = s_a_drains; p_sleep = s_b_sleeps;
+    p_a = s_a_wait_ticks; p_b = s_b_idle_ticks; p_flips = G.frames;
+}
diff --git a/src/nv2a/kelvin/kelvin_gpu_draw.inc b/src/nv2a/kelvin/kelvin_gpu_draw.inc
new file mode 100644
index 0000000..f1bf2f8
--- /dev/null
+++ b/src/nv2a/kelvin/kelvin_gpu_draw.inc
@@ -0,0 +1,773 @@
+/* The draw, included by kelvin_gpu.c after feedback_copy.
+ *
+ * kgpu_draw_now draws one batch of triangles. Most of what a draw needs is the same as the draw before it: the
+ * surfaces, the combiner constants and the shader they select, the blend, depth and raster states, the textures. The
+ * caller says what it knows has not changed (KGpuDraw.clean), and what is derived from it is kept in s_dc; and the
+ * Direct3D state last set on the context is kept in s_bd, so a call that would set what is already set is not made.
+ * Everything else that touches the context's bindings (clears, the conversion passes) calls kg_bound_reset first, and
+ * so does anything that releases an object the cache may name (a texture, a surface, a state object). */
+
+typedef struct KgBound {
+    bool valid;
+    ID3D11RenderTargetView *rtv;
+    ID3D11DepthStencilView *dsv;
+    ID3D11BlendState *bs;
+    FLOAT bf[4];
+    ID3D11DepthStencilState *dss;
+    UINT sref;
+    ID3D11RasterizerState *rs;
+    D3D11_VIEWPORT vp;
+    D3D11_RECT sc;
+    ID3D11PixelShader *ps;
+    ID3D11VertexShader *vs;
+    ID3D11ShaderResourceView *srv[4];
+    ID3D11SamplerState *smp[4];
+    ID3D11ShaderResourceView *vsrv;
+    int mode;                    /* 1: GPU vertex shading (constant buffers b1..b3, arena at t9), 2: CPU vertices */
+    D3D11_PRIMITIVE_TOPOLOGY topo;
+    DXGI_FORMAT ibfmt;
+    bool fixed;                  /* the constant buffer, input layout and vertex-stage buffers that never change are bound */
+} KgBound;
+
+typedef struct KgDc {
+    bool valid;
+    int reject;                  /* 0 draw; 1 skip counted; 2 skip silently */
+    KGpuSurf *cs, *zs;
+    double sx, sy;
+    bool has_alpha;
+    unsigned int alpha_mode;
+    PSConst pc;
+    ID3D11PixelShader *psx;
+    bool psx_pending;
+    bool pc_changed;
+    ID3D11BlendState *bs;
+    ID3D11DepthStencilState *dss;
+    ID3D11RasterizerState *rs;
+    D3D11_VIEWPORT vp;
+    D3D11_RECT sc;
+    FLOAT bf[4];
+    UINT sref;
+    float zmax;
+    int cull_enable, cull_ctrl, ccw_front;
+    float zbias, zslope;
+    ID3D11ShaderResourceView *srv[4];
+    ID3D11SamplerState *smp[4];
+    bool tex_ok;                 /* the slots resolved to plain textures: nothing per draw */
+    uint64_t tex_epoch, tex_surfgen;
+} KgDc;
+
+static KgBound s_bd;
+static KgDc s_dc;
+static void kg_bound_reset(void)
+{
+    s_bd.valid = false;
+}
+
+static void kg_cache_invalidate(void)
+{
+    s_bd.valid = false;
+    s_dc.valid = false;
+}
+
+/* RECOMP_KGPU_PROBE=frame,x,y[,frames] (lab diagnostic, synchronous submission only): after every draw and clear of
+ * the flips in [frame, frame+frames) print the colour the target holds at (x, y) when it changed, with the draw that
+ * changed it. Finds which draw puts a pixel there. */
+static struct { int mode, f0, n, x, y; unsigned int ord; uint64_t frame; uint32_t last; bool have; ID3D11Texture2D *stage; } s_probe = { -1 };
+
+static void kg_probe(const KGpuSurf *cs, const KGpuDraw *d, const char *what)
+{
+    D3D11_BOX box;
+    D3D11_MAPPED_SUBRESOURCE ms;
+    uint32_t px;
+    uint64_t fr;
+    if (s_probe.mode < 0) {
+        const char *e = getenv("RECOMP_KGPU_PROBE");
+        int f = 0, x = 0, y = 0, n = 1;
+        s_probe.mode = e && sscanf(e, "%d,%d,%d,%d", &f, &x, &y, &n) >= 3 ? 1 : 0;
+        s_probe.f0 = f; s_probe.x = x; s_probe.y = y; s_probe.n = n > 0 ? n : 1;
+    }
+    if (s_probe.mode != 1 || !cs || !cs->tex || cs->bpp != 4) return;
+    fr = kgpu_compare_enabled() ? s_cmp_frames + 1 : G.frames;
+    if (fr < (uint64_t)s_probe.f0 || fr >= (uint64_t)s_probe.f0 + (uint64_t)s_probe.n) return;
+    if (s_probe.frame != fr) { s_probe.frame = fr; s_probe.ord = 0; s_probe.have = false; }
+    s_probe.ord++;
+    if ((unsigned int)s_probe.x >= cs->hw || (unsigned int)s_probe.y >= cs->hh) return;
+    if (!s_probe.stage) {
+        D3D11_TEXTURE2D_DESC td;
+        memset(&td, 0, sizeof(td));
+        td.Width = 1; td.Height = 1; td.MipLevels = td.ArraySize = 1; td.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+        td.SampleDesc.Count = 1; td.Usage = D3D11_USAGE_STAGING; td.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        if (FAILED(ID3D11Device_CreateTexture2D(G.dev, &td, NULL, &s_probe.stage))) return;
+    }
+    box.left = (UINT)s_probe.x; box.right = box.left + 1; box.top = (UINT)s_probe.y; box.bottom = box.top + 1;
+    box.front = 0; box.back = 1;
+    ID3D11DeviceContext_CopySubresourceRegion(G.ctx, (ID3D11Resource *)s_probe.stage, 0, 0, 0, 0, (ID3D11Resource *)cs->tex, 0, &box);
+    if (FAILED(ID3D11DeviceContext_Map(G.ctx, (ID3D11Resource *)s_probe.stage, 0, D3D11_MAP_READ, 0, &ms))) return;
+    px = *(const uint32_t *)ms.pData;
+    ID3D11DeviceContext_Unmap(G.ctx, (ID3D11Resource *)s_probe.stage, 0);
+    if (!s_probe.have || px != s_probe.last) {
+        if (d) {
+            const KPixelState *ps = d->ps;
+            fprintf(stderr, "[KPROBE] f%llu #%u %s: %08X -> %08X  icount %u vcount %u topo %u %s vs %08X blend %d(%d,%d) z %d/%d/%d tex0 %ux%u fmt %u\n",
+                    (unsigned long long)fr, s_probe.ord, what, s_probe.have ? s_probe.last : 0, px, d->icount, d->vcount, d->topology,
+                    d->gvs ? "gvs" : "cpu", d->gvs ? d->gvs->hash : 0, ps->blend, ps->blend_sfactor, ps->blend_dfactor,
+                    ps->depth_test, ps->depth_func, ps->depth_write, ps->tex[0].width, ps->tex[0].height, ps->tex[0].color_format);
+        } else {
+            fprintf(stderr, "[KPROBE] f%llu #%u %s: %08X -> %08X\n", (unsigned long long)fr, s_probe.ord, what,
+                    s_probe.have ? s_probe.last : 0, px);
+        }
+        s_probe.last = px; s_probe.have = true;
+    }
+}
+
+/* RECOMP_KGPU_PASSCMP=frame[,frames] (lab diagnostic, compare mode only): after each draw of those flips, finish the
+ * CPU renderer's work and compare the GPU's copy of the draw's colour target with the CPU's. Prints a line whenever a
+ * draw makes the two differ more than before, with the draw's state, and dumps the first few such targets. */
+static struct {
+    int mode, f0, n;
+    bool have;
+    KelvinTarget t;
+    KGpuSurf *cs, *zs;
+    unsigned int ord;
+    uint64_t frame;
+    char what[200];
+    uint64_t zbad_prev;
+    int dumped;
+    struct { uint32_t va; double mean; uint64_t gt8; } seen[16];
+} s_pc = { -1 };
+
+static void kg_pass_note(const KGpuDraw *d, KGpuSurf *cs, KGpuSurf *zs)
+{
+    const KPixelState *ps = d->ps;
+    uint64_t fr;
+    if (s_pc.mode < 0) {
+        const char *e = getenv("RECOMP_KGPU_PASSCMP");
+        int f = 0, n = 1;
+        s_pc.mode = e && sscanf(e, "%d,%d", &f, &n) >= 1 ? 1 : 0;
+        s_pc.f0 = f; s_pc.n = n > 0 ? n : 1;
+    }
+    s_pc.have = false;
+    if (s_pc.mode != 1 || !kgpu_compare_enabled() || !cs || cs->bpp != 4 || !d->t->color) return;
+    fr = s_cmp_frames + 1;
+    if (fr < (uint64_t)s_pc.f0 || fr >= (uint64_t)s_pc.f0 + (uint64_t)s_pc.n) return;
+    if (s_pc.frame != fr) { s_pc.frame = fr; s_pc.ord = 0; memset(s_pc.seen, 0, sizeof(s_pc.seen)); }
+    s_pc.ord++;
+    s_pc.t = *d->t;
+    s_pc.cs = cs;
+    s_pc.zs = zs;
+    s_pc.have = true;
+    snprintf(s_pc.what, sizeof(s_pc.what), "icount %u topo %u %s vs %08X blend %d(%d,%d) z %d/%d/%d tex0 %ux%u fmt %u tex1 %ux%u target %ux%u va %08X zva %08X real %d fromc %d",
+             d->icount, d->topology, d->gvs ? "gvs" : "cpu", d->gvs ? d->gvs->hash : 0, ps->blend, ps->blend_sfactor, ps->blend_dfactor,
+             ps->depth_test, ps->depth_func, ps->depth_write, ps->tex[0].width, ps->tex[0].height, ps->tex[0].color_format,
+             ps->tex[1].width, ps->tex[1].height, d->t->width, d->t->height, d->t->color_va,
+             zs ? zs->va : 0, zs ? (int)zs->real : -1, zs ? (int)zs->from_color : -1);
+}
+
+static uint32_t kg_pdep(uint32_t v, uint32_t mask)
+{
+    uint32_t r = 0, bit;
+    for (bit = 1; mask; bit <<= 1) {
+        uint32_t low = mask & (0u - mask);
+        if (v & bit) r |= low;
+        mask &= mask - 1;
+    }
+    return r;
+}
+
+/* Called by the CPU path once it has finished its own copy of the draw that kg_pass_note saw. */
+void kgpu_pass_check(void)
+{
+    ID3D11Texture2D *st;
+    D3D11_MAPPED_SUBRESOURCE ms;
+    unsigned int x, y, slot;
+    uint64_t sum = 0, gt8 = 0, gt32 = 0, pixels;
+    unsigned int maxd = 0;
+    double mean;
+    const KelvinTarget *t = &s_pc.t;
+    if (!s_pc.have) return;
+    s_pc.have = false;
+    kelvin_render_sync();
+    if (s_pc.cs->hw != t->width || s_pc.cs->hh != t->height) return;
+    if (!readback(s_pc.cs, &st, &ms)) return;
+    pixels = (uint64_t)t->width * t->height;
+    for (y = 0; y < t->height; y++) {
+        const uint8_t *g = (const uint8_t *)ms.pData + (size_t)y * ms.RowPitch;
+        for (x = 0; x < t->width; x++) {
+            const uint8_t *c;
+            unsigned int d0, d1, d2, d;
+            if (t->swizzled) c = t->color + (size_t)(kg_pdep(x, t->swz_mask_x) | kg_pdep(y, t->swz_mask_y)) * 4;
+            else c = t->color + (size_t)y * t->color_pitch + (size_t)x * 4;
+            d0 = (unsigned int)abs((int)g[x * 4] - (int)c[0]);
+            d1 = (unsigned int)abs((int)g[x * 4 + 1] - (int)c[1]);
+            d2 = (unsigned int)abs((int)g[x * 4 + 2] - (int)c[2]);
+            d = d0 > d1 ? d0 : d1;
+            if (d2 > d) d = d2;
+            sum += d0 + d1 + d2;
+            if (d > maxd) maxd = d;
+            if (d > 8) gt8++;
+            if (d > 32) gt32++;
+        }
+    }
+    mean = (double)sum / (3.0 * (double)pixels);
+    for (slot = 0; slot < 16 && s_pc.seen[slot].va && s_pc.seen[slot].va != t->color_va; slot++) {}
+    if (slot < 16) {
+        if (!s_pc.seen[slot].va) { s_pc.seen[slot].va = t->color_va; }
+        if (mean > s_pc.seen[slot].mean + 0.01 || gt8 > s_pc.seen[slot].gt8 + 40) {
+            fprintf(stderr, "[KPASS] f%llu #%u mean %.3f (was %.3f) max %u >8: %llu (was %llu) >32: %llu  %s\n",
+                    (unsigned long long)s_pc.frame, s_pc.ord, mean, s_pc.seen[slot].mean, maxd, (unsigned long long)gt8,
+                    (unsigned long long)s_pc.seen[slot].gt8, (unsigned long long)gt32, s_pc.what);
+            if (G.dump && *G.dump && s_pc.dumped < 24 && t->width * t->height >= 160 * 120) {
+                char path[512];
+                uint8_t *buf = (uint8_t *)malloc((size_t)t->width * t->height * 4);
+                if (buf) {
+                    for (y = 0; y < t->height; y++)
+                        for (x = 0; x < t->width; x++) {
+                            const uint8_t *c;
+                            if (t->swizzled) c = t->color + (size_t)(kg_pdep(x, t->swz_mask_x) | kg_pdep(y, t->swz_mask_y)) * 4;
+                            else c = t->color + (size_t)y * t->color_pitch + (size_t)x * 4;
+                            memcpy(buf + ((size_t)y * t->width + x) * 4, c, 4);
+                        }
+                    snprintf(path, sizeof(path), "%spass%03d_%u_cpu.bmp", G.dump, s_pc.dumped, s_pc.ord);
+                    write_bmp(path, buf, t->width, t->height, t->width * 4);
+                    snprintf(path, sizeof(path), "%spass%03d_%u_gpu.bmp", G.dump, s_pc.dumped, s_pc.ord);
+                    write_bmp(path, (const uint8_t *)ms.pData, t->width, t->height, ms.RowPitch);
+                    free(buf);
+                    s_pc.dumped++;
+                }
+            }
+        }
+        s_pc.seen[slot].mean = mean; s_pc.seen[slot].gt8 = gt8;
+    }
+    if (s_pc.zs && s_pc.zs->tex && t->zeta && t->zeta_bpp == 4 && !t->swizzled && s_pc.zs->hw == t->width && s_pc.zs->hh == t->height) {
+        static ID3D11Texture2D *zst;
+        static unsigned int zw, zh;
+        D3D11_TEXTURE2D_DESC td;
+        D3D11_MAPPED_SUBRESOURCE zm;
+        ID3D11Texture2D_GetDesc(s_pc.zs->tex, &td);
+        if (zst && (zw != td.Width || zh != td.Height)) { IUnknown_Release((IUnknown *)zst); zst = NULL; }
+        if (!zst) {
+            td.Usage = D3D11_USAGE_STAGING; td.BindFlags = 0; td.CPUAccessFlags = D3D11_CPU_ACCESS_READ; td.MiscFlags = 0;
+            if (SUCCEEDED(ID3D11Device_CreateTexture2D(G.dev, &td, NULL, &zst))) { zw = td.Width; zh = td.Height; }
+        }
+        if (zst) {
+            ID3D11DeviceContext_CopyResource(G.ctx, (ID3D11Resource *)zst, (ID3D11Resource *)s_pc.zs->tex);
+            if (SUCCEEDED(ID3D11DeviceContext_Map(G.ctx, (ID3D11Resource *)zst, 0, D3D11_MAP_READ, 0, &zm))) {
+                uint64_t bad = 0, far_cpu_near_gpu = 0;
+                int fx = -1, fy = -1;
+                uint32_t fc = 0, fg = 0;
+                for (y = 0; y < t->height; y++) {
+                    const float *gz = (const float *)((const uint8_t *)zm.pData + (size_t)y * zm.RowPitch);
+                    const uint32_t *cz = (const uint32_t *)(t->zeta + (size_t)y * t->zeta_pitch);
+                    for (x = 0; x < t->width; x++) {
+                        double gf = gz[x * 2];
+                        long gi = (long)floor((gf < 0 ? 0 : gf > 1 ? 1 : gf) * 16777215.0 + 0.5);
+                        long ci = (long)(cz[x] >> 8);
+                        if (labs(gi - ci) > 4096) {
+                            if (!bad) { fx = (int)x; fy = (int)y; fc = (uint32_t)ci; fg = (uint32_t)gi; }
+                            bad++;
+                            if (ci > 0xF00000 && gi < 0xE00000) far_cpu_near_gpu++;
+                        }
+                    }
+                }
+                if (bad > s_pc.zbad_prev + 20) {
+                    fprintf(stderr, "[KZ] f%llu #%u depth differs (>4096 of 24 bits): %llu pixels (was %llu), cpu far/gpu not: %llu, first at (%d,%d) cpu %06X gpu %06X  %s\n",
+                            (unsigned long long)s_pc.frame, s_pc.ord, (unsigned long long)bad, (unsigned long long)s_pc.zbad_prev,
+                            (unsigned long long)far_cpu_near_gpu, fx, fy, fc, fg, s_pc.what);
+                }
+                s_pc.zbad_prev = bad;
+                ID3D11DeviceContext_Unmap(G.ctx, (ID3D11Resource *)zst, 0);
+            }
+        }
+    }
+    ID3D11DeviceContext_Unmap(G.ctx, (ID3D11Resource *)st, 0);
+    IUnknown_Release((IUnknown *)st);
+}
+
+/* RECOMP_KGPU_DRAWLOG=frame[,frames] (lab diagnostic): a line for every draw and clear of those presented frames. */
+static struct { int mode, f0, n; unsigned int ord; uint64_t frame; float last[16]; bool have; } s_dl = { -1 };
+
+static bool kg_dl_on(void)
+{
+    uint64_t fr;
+    if (s_dl.mode < 0) {
+        const char *e = getenv("RECOMP_KGPU_DRAWLOG");
+        int f = 0, n = 1;
+        s_dl.mode = e && sscanf(e, "%d,%d", &f, &n) >= 1 ? 1 : 0;
+        s_dl.f0 = f; s_dl.n = n > 0 ? n : 1;
+    }
+    if (s_dl.mode != 1) return false;
+    fr = kgpu_compare_enabled() ? s_cmp_frames + 1 : G.frames;
+    if (fr < (uint64_t)s_dl.f0 || fr >= (uint64_t)s_dl.f0 + (uint64_t)s_dl.n) return false;
+    if (s_dl.frame != fr) { s_dl.frame = fr; s_dl.ord = 0; s_dl.have = false; }
+    s_dl.ord++;
+    return true;
+}
+
+static void kg_dl_draw(const KGpuDraw *d)
+{
+    const KPixelState *ps = d->ps;
+    if (!kg_dl_on()) return;
+    fprintf(stderr, "[KDL] f%llu #%u draw vs %08X icount %u topo %u target %ux%u z %d/%d/%d blend %d(%d,%d) at %d cull %d tex0 %ux%u zofs %g zmax %g\n",
+            (unsigned long long)s_dl.frame, s_dl.ord, d->gvs ? d->gvs->hash : 0, d->icount, d->topology, d->t->width, d->t->height,
+            ps->depth_test, ps->depth_func, ps->depth_write, ps->blend, ps->blend_sfactor, ps->blend_dfactor, ps->alpha_test,
+            d->cull_enable, ps->tex[0].width, ps->tex[0].height, (double)d->zbias, (double)ps->zmax);
+    fprintf(stderr, "[KDL]   targetva %08X depthva %08X depthclip %d zclip %g,%g cullctrl %d frontccw %d texturebase %08X,%08X,%08X,%08X texturevalid %d,%d,%d,%d\n",
+            d->t->color_va, d->t->zeta_va, (int)ps->depth_clip_cull, (double)ps->zclip_min, (double)ps->zclip_max,
+            d->cull_ctrl, (int)d->ccw_front,
+            ps->tex[0].base, ps->tex[1].base, ps->tex[2].base, ps->tex[3].base,
+            (int)ps->tex[0].valid, (int)ps->tex[1].valid, (int)ps->tex[2].valid, (int)ps->tex[3].valid);
+    if (d->gvs && d->gvs->constants) {
+        static float vp_last[8];
+        const float *v = d->gvs->constants + 4 * 58;       /* c[-38] viewport scale, c[-37] offset */
+        if (memcmp(vp_last, v, sizeof(vp_last)) != 0) {
+            memcpy(vp_last, v, sizeof(vp_last));
+            fprintf(stderr, "[KDL]   viewport scale %g %g %g %g offset %g %g %g %g\n", (double)v[0], (double)v[1], (double)v[2], (double)v[3],
+                    (double)v[4], (double)v[5], (double)v[6], (double)v[7]);
+        }
+    }
+    if (d->gvs && d->gvs->constants && (!s_dl.have || memcmp(s_dl.last, d->gvs->constants, sizeof(s_dl.last)) != 0)) {
+        const float *c = d->gvs->constants;
+        memcpy(s_dl.last, c, sizeof(s_dl.last)); s_dl.have = true;
+        fprintf(stderr, "[KDL]   c0 %g %g %g %g | c1 %g %g %g %g | c2 %g %g %g %g | c3 %g %g %g %g\n",
+                (double)c[0], (double)c[1], (double)c[2], (double)c[3], (double)c[4], (double)c[5], (double)c[6], (double)c[7],
+                (double)c[8], (double)c[9], (double)c[10], (double)c[11], (double)c[12], (double)c[13], (double)c[14], (double)c[15]);
+    }
+}
+
+static void kgpu_draw_now(const KGpuDraw *d)
+{
+    const KelvinTarget *t = d->t;
+    const KPixelState *ps = d->ps;
+    KgDc *dc = &s_dc;
+    VSConst vc;
+    ID3D11ShaderResourceView *vbsrv;
+    D3D11_MAPPED_SUBRESOURCE ms;
+    size_t at = 0, ib_at;
+    unsigned int i, k;
+    void *p;
+    long long prof_t;
+    bool new_t, new_ps, cull_changed;
+    bool short_idx = d->index_limit && d->index_limit <= 0xFFFFu;
+    D3D11_PRIMITIVE_TOPOLOGY topo = d->topology == KG_TOPO_STRIP ? D3D11_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP
+                                                                   : D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST;
+    DXGI_FORMAT ibfmt = short_idx ? DXGI_FORMAT_R16_UINT : DXGI_FORMAT_R32_UINT;
+    size_t ib_bytes;
+
+    if (!G.ok || !d->icount || (!d->gvs && !d->vcount)) return;
+    {
+        /* RECOMP_KGPU_SKIPVS=hash,hash (lab diagnostic): do not draw with those vertex programs. */
+        static const char *skip = (const char *)-1;
+        if (skip == (const char *)-1) skip = getenv("RECOMP_KGPU_SKIPVS");
+        if (skip && d->gvs) {
+            char key[16];
+            snprintf(key, sizeof(key), "%08X", d->gvs->hash);
+            if (strstr(skip, key)) return;
+        }
+    }
+    kt_begin();
+    if (!s_bd.valid) {
+        memset(&s_bd, 0, sizeof(s_bd));
+        s_bd.valid = true;
+        s_bd.vp.Width = -1.0f;                 /* not a real viewport or scissor: the first draw sets them */
+        s_bd.sc.left = -1;
+    }
+
+    new_t = !dc->valid || !(d->clean & KG_CLEAN_T);
+    new_ps = !dc->valid || !(d->clean & KG_CLEAN_PS);
+    cull_changed = dc->cull_enable != (int)d->cull_enable || dc->cull_ctrl != d->cull_ctrl || dc->ccw_front != (int)d->ccw_front ||
+                   dc->zbias != d->zbias || dc->zslope != d->zslope;
+    if (new_t || new_ps || cull_changed) {
+        KGpuSurf *cs = NULL, *zs = NULL;
+        const KGpuSurf *ref;
+        D3D11_VIEWPORT *vp = &dc->vp;
+        D3D11_RECT *sc = &dc->sc;
+        dc->valid = true;
+        dc->reject = 0;
+        dc->cull_enable = d->cull_enable ? 1 : 0; dc->cull_ctrl = d->cull_ctrl; dc->ccw_front = d->ccw_front ? 1 : 0;
+        dc->zbias = d->zbias; dc->zslope = d->zslope;
+        if (t->color) cs = surf_get(t, false, ps->color_format);
+        if (t->zeta && (ps->depth_test || ps->stencil_test)) zs = surf_get(t, true, ps->zeta_format);
+        dc->cs = cs; dc->zs = zs;
+        if (!cs && !zs) dc->reject = 1;
+        else if (d->cull_enable && d->cull_ctrl == NV_PGRAPH_SETUPRASTER_CULLCTRL_FRONT_AND_BACK) dc->reject = 2;
+        else if (cs && zs && (cs->hw != zs->hw || cs->hh != zs->hh)) dc->reject = 1;
+        if (!dc->reject) {
+            dc->sx = cs ? (double)cs->hw / (double)cs->gw : (double)zs->hw / (double)zs->gw;
+            dc->sy = cs ? (double)cs->hh / (double)cs->gh : (double)zs->hh / (double)zs->gh;
+            dc->has_alpha = ps->color_format == NV097_SET_SURFACE_FORMAT_COLOR_LE_A8R8G8B8 ||
+                            ps->color_format == NV097_SET_SURFACE_FORMAT_COLOR_LE_X1A7R8G8B8_Z1A7R8G8B8 ||
+                            ps->color_format == NV097_SET_SURFACE_FORMAT_COLOR_LE_X1A7R8G8B8_O1A7R8G8B8;
+            dc->alpha_mode = 0;
+            if (ps->color_format == NV097_SET_SURFACE_FORMAT_COLOR_LE_X8R8G8B8_O8R8G8B8) dc->alpha_mode = 1;
+            if (ps->color_format == NV097_SET_SURFACE_FORMAT_COLOR_LE_X8R8G8B8_Z8R8G8B8) dc->alpha_mode = 2;
+            fill_ps_const(&dc->pc, ps, dc->alpha_mode);
+            dc->pc_changed = true;
+            dc->psx = ps_lookup(&dc->pc);
+            dc->psx_pending = dc->psx == NULL;
+            dc->zmax = ps->zmax > 0.0f ? ps->zmax : 16777215.0f;
+            dc->bs = get_blend(ps, dc->alpha_mode, dc->has_alpha);
+            dc->dss = get_depth(ps, zs != NULL);
+            dc->rs = get_raster(d);
+            dc->bf[0] = ps->blend_color[0]; dc->bf[1] = ps->blend_color[1];
+            dc->bf[2] = ps->blend_color[2]; dc->bf[3] = ps->blend_color[3];
+            dc->sref = (UINT)ps->stencil_ref;
+            ref = cs ? cs : zs;
+            vp->TopLeftX = vp->TopLeftY = 0.0f; vp->Width = (FLOAT)ref->hw; vp->Height = (FLOAT)ref->hh;
+            vp->MinDepth = 0.0f; vp->MaxDepth = 1.0f;
+            sc->left = (LONG)floor(t->clip_x0 * dc->sx); sc->top = (LONG)floor(t->clip_y0 * dc->sy);
+            sc->right = (LONG)ceil(t->clip_x1 * dc->sx); sc->bottom = (LONG)ceil(t->clip_y1 * dc->sy);
+            if (sc->right > (LONG)ref->hw) sc->right = (LONG)ref->hw;
+            if (sc->bottom > (LONG)ref->hh) sc->bottom = (LONG)ref->hh;
+            if (sc->left < 0) sc->left = 0;
+            if (sc->top < 0) sc->top = 0;
+            dc->tex_ok = false;
+        }
+    }
+    if (dc->reject) {
+        if (dc->reject == 1) G.skipped++;
+        return;
+    }
+    kg_post_note_draw(ps, dc->cs, dc->zs);       /* the picture effects run when the HUD begins (kelvin_gpu_post.inc) */
+    if (dc->zs) {
+        if (ps->depth_write || ps->stencil_write) dc->zs->real = true;
+        depth_surface_refresh(dc->zs);
+    }
+
+    /* textures */
+    prof_t = kg_tick();
+    if (!dc->tex_ok || dc->tex_epoch != G.epoch || dc->tex_surfgen != s_surf_gen) {
+        KGpuSurf *cs = dc->cs;
+        bool plain = true;
+        for (i = 0; i < 4; i++) {
+            const KTexture *tx = &ps->tex[i];
+            KGpuSurf *fs;
+            dc->srv[i] = G.dummy_srv;
+            dc->smp[i] = NULL;
+            if (ps->tex_mode[i] != PS_TEXTUREMODES_PROJECT2D || !tx->valid) continue;
+            fs = surf_for_texture(tx);
+            if (fs) {
+                if (cs && fs == cs) {
+                    /* sampling the surface being drawn: read a copy of its pre-draw state, made for every draw */
+                    ID3D11Texture2D *cp = feedback_copy(fs);
+                    plain = false;
+                    if (cp) {
+                        static ID3D11ShaderResourceView *cp_srv;
+                        static ID3D11Texture2D *cp_tex;
+                        ID3D11DeviceContext_CopyResource(G.ctx, (ID3D11Resource *)cp, (ID3D11Resource *)fs->tex);
+                        if (cp_tex != cp) {
+                            SAFE_RELEASE(cp_srv);
+                            ID3D11Device_CreateShaderResourceView(G.dev, (ID3D11Resource *)cp, NULL, &cp_srv);
+                            cp_tex = cp;
+                        }
+                        dc->srv[i] = cp_srv;
+                    }
+                } else {
+                    dc->srv[i] = fs->srv;
+                }
+            } else {
+                KGpuSurf *ds = surf_depth_for_texture(tx);
+                ID3D11ShaderResourceView *v;
+                if (ds) plain = false;
+                v = ds ? depth_as_color(ds) : tex_get(tx);
+                if (v) dc->srv[i] = v;
+            }
+            dc->smp[i] = get_sampler(tx);
+        }
+        dc->tex_ok = plain;
+        dc->tex_epoch = G.epoch;
+        dc->tex_surfgen = s_surf_gen;
+    }
+    g_kgpu_ticks[KGP_TEX] += kg_tick() - prof_t;
+    prof_t = kg_tick();
+
+    if (!s_bd.valid) {
+        memset(&s_bd, 0, sizeof(s_bd));
+        s_bd.valid = true;
+        s_bd.vp.Width = -1.0f;
+        s_bd.sc.left = -1;
+    }
+
+    /* the combiner constants and the pixel shader they select */
+    if (dc->psx_pending) {
+        dc->psx = ps_lookup(&dc->pc);
+        if (dc->psx) dc->psx_pending = false;
+    }
+    if (dc->pc_changed) {
+        static PSConst last;
+        static bool have;
+        dc->pc_changed = false;
+        if (!have || memcmp(&last, &dc->pc, sizeof(last)) != 0) {
+            if (SUCCEEDED(ID3D11DeviceContext_Map(G.ctx, (ID3D11Resource *)G.cb_ps, 0, D3D11_MAP_WRITE_DISCARD, 0, &ms))) {
+                memcpy(ms.pData, &dc->pc, sizeof(dc->pc));
+                ID3D11DeviceContext_Unmap(G.ctx, (ID3D11Resource *)G.cb_ps, 0);
+                memcpy(&last, &dc->pc, sizeof(last));
+                have = true;
+            }
+        }
+    }
+
+    /* geometry */
+    if (d->gvs) {
+        /* raw guest vertex data: the ranges the attributes read, merged, in the arena */
+        typedef struct Rng { const uint8_t *lo, *hi; size_t off; } Rng;
+        const KGpuVsDraw *gv = d->gvs;
+        Rng rg[16], mg[16];
+        int nr = 0, nm = 0, a, j;
+        size_t total = 0;
+        uint32_t adesc[16][4];
+        float inl[16][4];
+        VSG gc;
+        const KGpuSurf *ref = dc->cs ? dc->cs : dc->zs;
+        for (a = 0; a < 16; a++) {
+            const KGpuAttrSrc *as = &gv->attr[a];
+            memset(adesc[a], 0, sizeof(adesc[a]));
+            memcpy(inl[a], as->inline_value, 16);
+            if (!as->fmt) continue;
+            rg[nr].lo = as->data + as->lo;
+            rg[nr].hi = as->data + as->hi;
+            rg[nr].off = (size_t)a;
+            for (j = nr; j > 0 && rg[j - 1].lo > rg[j].lo; j--) { Rng t2 = rg[j]; rg[j] = rg[j - 1]; rg[j - 1] = t2; }
+            nr++;
+        }
+        for (a = 0; a < nr; a++) {
+            if (nm && rg[a].lo <= mg[nm - 1].hi + 64) {
+                if (rg[a].hi > mg[nm - 1].hi) mg[nm - 1].hi = rg[a].hi;
+            } else {
+                mg[nm] = rg[a];
+                nm++;
+            }
+        }
+        for (a = 0; a < nm; a++) {
+            mg[a].off = total;
+            total += ((size_t)(mg[a].hi - mg[a].lo) + 15) & ~(size_t)15;
+        }
+        if (total == 0) total = 16;
+        p = ring_map(G.arena, &G.arena_pos, G.arena_cap, total / 16, 16, &at, &ms);
+        if (!p) return;
+        for (a = 0; a < nm; a++) memcpy((uint8_t *)p + mg[a].off, mg[a].lo, (size_t)(mg[a].hi - mg[a].lo));
+        ID3D11DeviceContext_Unmap(G.ctx, (ID3D11Resource *)G.arena, 0);
+        G.vb_bytes += total;
+        for (a = 0; a < 16; a++) {
+            const KGpuAttrSrc *as = &gv->attr[a];
+            const uint8_t *lo;
+            int64_t base;
+            if (!as->fmt) continue;
+            lo = as->data + as->lo;
+            for (j = 0; j < nm; j++) if (lo >= mg[j].lo && lo < mg[j].hi + 1) break;
+            if (j == nm) continue;
+            base = (int64_t)(at * 16 + mg[j].off) + (int64_t)(as->data - mg[j].lo);
+            adesc[a][0] = (uint32_t)base;
+            adesc[a][1] = as->stride;
+            adesc[a][2] = as->fmt;
+            adesc[a][3] = as->count;
+        }
+        memset(&gc, 0, sizeof(gc));
+        gc.scale[0] = 2.0f / (float)ref->gw;
+        gc.scale[1] = 2.0f / (float)ref->gh;
+        gc.scale[2] = 1.0f / dc->zmax;
+        gc.scale[3] = 18446744073709551616.0f;
+        gc.fog[0] = gv->fog_param[0]; gc.fog[1] = gv->fog_param[1];
+        gc.flags[0] = gv->fog_enable ? 1u : 0u;
+        gc.flags[1] = (uint32_t)gv->fog_mode;
+        gc.flags[2] = gv->specular_enable ? 1u : 0u;
+        gc.flags[3] = gv->ignore_specular_alpha ? 1u : 0u;
+        gc.vm[0] = kg_viewmodel_scale(gv->hash);
+        {
+            static VSG last_gc;
+            static bool have_gc;
+            if (!have_gc || memcmp(&last_gc, &gc, sizeof(gc)) != 0) {
+                if (SUCCEEDED(ID3D11DeviceContext_Map(G.ctx, (ID3D11Resource *)G.cb_gvs, 0, D3D11_MAP_WRITE_DISCARD, 0, &ms))) {
+                    memcpy(ms.pData, &gc, sizeof(gc));
+                    ID3D11DeviceContext_Unmap(G.ctx, (ID3D11Resource *)G.cb_gvs, 0);
+                    memcpy(&last_gc, &gc, sizeof(gc));
+                    have_gc = true;
+                }
+            }
+        }
+        if (SUCCEEDED(ID3D11DeviceContext_Map(G.ctx, (ID3D11Resource *)G.cb_a, 0, D3D11_MAP_WRITE_DISCARD, 0, &ms))) {
+            memcpy(ms.pData, adesc, sizeof(adesc));
+            memcpy((uint8_t *)ms.pData + sizeof(adesc), inl, sizeof(inl));
+            ID3D11DeviceContext_Unmap(G.ctx, (ID3D11Resource *)G.cb_a, 0);
+        }
+        {
+            static float last_c[192 * 4];
+            static bool have_last;
+            if (!have_last || memcmp(last_c, gv->constants, sizeof(last_c)) != 0) {
+                if (SUCCEEDED(ID3D11DeviceContext_Map(G.ctx, (ID3D11Resource *)G.cb_c, 0, D3D11_MAP_WRITE_DISCARD, 0, &ms))) {
+                    memcpy(ms.pData, gv->constants, sizeof(last_c));
+                    ID3D11DeviceContext_Unmap(G.ctx, (ID3D11Resource *)G.cb_c, 0);
+                    memcpy(last_c, gv->constants, sizeof(last_c));
+                    have_last = true;
+                }
+            }
+        }
+    } else {
+        const KGpuSurf *ref = dc->cs ? dc->cs : dc->zs;
+        p = ring_map(G.vb, &G.vb_pos, G.vb_cap, (size_t)d->vcount * d->stride, 16, &at, &ms);
+        if (!p) return;
+        memcpy(p, d->recs, (size_t)d->vcount * d->stride * 16);
+        ID3D11DeviceContext_Unmap(G.ctx, (ID3D11Resource *)G.vb, 0);
+        G.vb_bytes += (size_t)d->vcount * d->stride * 16;
+        memset(&vc, 0, sizeof(vc));
+        vc.scale[0] = 2.0f / (float)ref->gw;
+        vc.scale[1] = 2.0f / (float)ref->gh;
+        vc.scale[2] = 1.0f / dc->zmax;
+        vc.scale[3] = 18446744073709551616.0f;
+        for (i = 0; i < KG_SLOTS; i++) {
+            uint32_t s = d->slot[i] < 0 ? 0xFFFFFFFFu : (uint32_t)d->slot[i];
+            switch (i) {
+            case KG_POS: vc.rec0[2] = s; break;
+            case KG_D0: vc.rec0[3] = s; break;
+            case KG_D1: vc.rec1[0] = s; break;
+            case KG_FOG: vc.rec1[1] = s; break;
+            case KG_T0: vc.rec1[2] = s; break;
+            case KG_T1: vc.rec1[3] = s; break;
+            case KG_T2: vc.rec2[0] = s; break;
+            case KG_T3: vc.rec2[1] = s; break;
+            }
+        }
+        vc.rec0[1] = d->stride;
+        vc.rec0[0] = (uint32_t)at;
+        if (SUCCEEDED(ID3D11DeviceContext_Map(G.ctx, (ID3D11Resource *)G.cb_vs, 0, D3D11_MAP_WRITE_DISCARD, 0, &ms))) {
+            memcpy(ms.pData, &vc, sizeof(vc));
+            ID3D11DeviceContext_Unmap(G.ctx, (ID3D11Resource *)G.cb_vs, 0);
+        }
+    }
+    ib_bytes = (size_t)d->icount * (short_idx ? 2 : 4);
+    p = ring_map(G.ib, &G.ib_pos, G.ib_cap, (ib_bytes + 3) / 4, 4, &ib_at, &ms);
+    if (!p) return;
+    if (short_idx) {
+        uint16_t *w = (uint16_t *)p;
+        const uint32_t *src = d->indices;
+        for (i = 0; i < d->icount; i++) w[i] = (uint16_t)src[i];
+    } else {
+        memcpy(p, d->indices, ib_bytes);
+    }
+    ID3D11DeviceContext_Unmap(G.ctx, (ID3D11Resource *)G.ib, 0);
+
+    g_kgpu_ticks[KGP_UPLOAD] += kg_tick() - prof_t;
+    prof_t = kg_tick();
+    if (!dc->bs || !dc->dss || !dc->rs) return;
+
+    {
+        KgBound *b = &s_bd;
+        ID3D11RenderTargetView *rtv = dc->cs ? dc->cs->rtv : NULL;
+        ID3D11DepthStencilView *dsv = dc->zs ? dc->zs->dsv : NULL;
+        ID3D11PixelShader *psx = dc->psx ? dc->psx : (ps->smooth || !G.ps_flat) ? G.ps : G.ps_flat;
+        if (!b->fixed) {
+            ID3D11DeviceContext_IASetInputLayout(G.ctx, NULL);
+            ID3D11DeviceContext_PSSetConstantBuffers(G.ctx, 0, 1, &G.cb_ps);
+            b->fixed = true;
+        }
+        if (b->rtv != rtv || b->dsv != dsv) {
+            ID3D11DeviceContext_OMSetRenderTargets(G.ctx, rtv ? 1 : 0, rtv ? &rtv : NULL, dsv);
+            b->rtv = rtv; b->dsv = dsv;
+            /* binding a target takes its resource out of every input slot */
+            for (k = 0; k < 4; k++) b->srv[k] = NULL;
+        }
+        if (b->bs != dc->bs || memcmp(b->bf, dc->bf, sizeof(b->bf)) != 0) {
+            ID3D11DeviceContext_OMSetBlendState(G.ctx, dc->bs, dc->bf, 0xFFFFFFFFu);
+            b->bs = dc->bs; memcpy(b->bf, dc->bf, sizeof(b->bf));
+        }
+        if (b->dss != dc->dss || b->sref != dc->sref) {
+            ID3D11DeviceContext_OMSetDepthStencilState(G.ctx, dc->dss, dc->sref);
+            b->dss = dc->dss; b->sref = dc->sref;
+        }
+        if (b->rs != dc->rs) {
+            ID3D11DeviceContext_RSSetState(G.ctx, dc->rs);
+            b->rs = dc->rs;
+        }
+        if (memcmp(&b->vp, &dc->vp, sizeof(b->vp)) != 0) {
+            ID3D11DeviceContext_RSSetViewports(G.ctx, 1, &dc->vp);
+            b->vp = dc->vp;
+        }
+        if (memcmp(&b->sc, &dc->sc, sizeof(b->sc)) != 0) {
+            ID3D11DeviceContext_RSSetScissorRects(G.ctx, 1, &dc->sc);
+            b->sc = dc->sc;
+        }
+        if (b->topo != topo) {
+            ID3D11DeviceContext_IASetPrimitiveTopology(G.ctx, topo);
+            b->topo = topo;
+        }
+        if (b->ibfmt != ibfmt) {
+            ID3D11DeviceContext_IASetIndexBuffer(G.ctx, G.ib, ibfmt, 0);
+            b->ibfmt = ibfmt;
+        }
+        if (b->ps != psx) {
+            ID3D11DeviceContext_PSSetShader(G.ctx, psx, NULL, 0);
+            b->ps = psx;
+        }
+        if (d->gvs) {
+            KGpuVs *ve = vs_lookup(d->gvs->program, d->gvs->hash, d->gvs->start);
+            if (!ve || !ve->vs) return;
+            if (b->vs != ve->vs) {
+                ID3D11DeviceContext_VSSetShader(G.ctx, ve->vs, NULL, 0);
+                b->vs = ve->vs;
+            }
+            if (b->mode != 1) {
+                ID3D11Buffer *cbs[3];
+                cbs[0] = G.cb_gvs; cbs[1] = G.cb_c; cbs[2] = G.cb_a;
+                ID3D11DeviceContext_VSSetConstantBuffers(G.ctx, 1, 3, cbs);
+                vbsrv = G.arena_srv;
+                ID3D11DeviceContext_VSSetShaderResources(G.ctx, 9, 1, &vbsrv);
+                b->mode = 1;
+            }
+        } else {
+            if (b->vs != G.vs) {
+                ID3D11DeviceContext_VSSetShader(G.ctx, G.vs, NULL, 0);
+                b->vs = G.vs;
+            }
+            if (b->mode != 2) {
+                ID3D11DeviceContext_VSSetConstantBuffers(G.ctx, 1, 1, &G.cb_vs);
+                vbsrv = G.vb_srv;
+                ID3D11DeviceContext_VSSetShaderResources(G.ctx, 8, 1, &vbsrv);
+                b->mode = 2;
+            }
+        }
+        for (k = 0; k < 4; k++) {
+            ID3D11SamplerState *s = dc->smp[k];
+            if (!s) s = G.default_smp;
+            if (b->srv[k] != dc->srv[k]) {
+                ID3D11DeviceContext_PSSetShaderResources(G.ctx, k, 1, &dc->srv[k]);
+                b->srv[k] = dc->srv[k];
+            }
+            if (s && b->smp[k] != s) {
+                ID3D11DeviceContext_PSSetSamplers(G.ctx, k, 1, &s);
+                b->smp[k] = s;
+            }
+        }
+    }
+    g_kgpu_ticks[KGP_STATE] += kg_tick() - prof_t;
+    prof_t = kg_tick();
+    if (s_kp_mode != 0) {
+        KpInfo ki;
+        const KGpuSurf *rf = dc->cs ? dc->cs : dc->zs;
+        uint64_t h = 1469598103934665603ULL;
+        unsigned int q, nt = 0;
+        const PSConst *pc = &dc->pc;
+        memset(&ki, 0, sizeof(ki));
+        for (q = 0; q < 8; q++) {
+            unsigned int w;
+            for (w = 0; w < 4; w++) h = (h ^ pc->stage[q].rgb_in[w]) * 1099511628211ULL;
+            for (w = 0; w < 4; w++) h = (h ^ pc->stage[q].alpha_in[w]) * 1099511628211ULL;
+            for (w = 0; w < 2; w++) h = (h ^ pc->stage[q].outs[w]) * 1099511628211ULL;
+        }
+        for (q = 0; q < 4; q++) { h = (h ^ pc->texmode[q]) * 1099511628211ULL; if (d->slot[q] >= 0) nt++; }
+        ki.kind = 0; ki.psh = (uint32_t)(h ^ (h >> 32)); ki.icount = d->icount;
+        ki.tw = rf ? rf->hw : 0; ki.th = rf ? rf->hh : 0;
+        ki.blend = ps->blend ? 1 : 0; ki.ztest = (dc->zs && ps->depth_test) ? 1 : 0; ki.zwrite = (dc->zs && ps->depth_write) ? 1 : 0;
+        ki.ntex = (uint8_t)nt; ki.tex0w = ps->tex[0].width; ki.tex0h = ps->tex[0].height;
+        kp_mark(&ki);
+    }
+    ID3D11DeviceContext_DrawIndexed(G.ctx, d->icount, (UINT)(short_idx ? ib_at * 2 : ib_at), 0);
+    if (s_kp_mode != 0) kp_done();
+    g_kgpu_ticks[KGP_DRAW] += kg_tick() - prof_t;
+    if (s_dl.mode != 0) kg_dl_draw(d);
+    if (s_probe.mode != 0) kg_probe(dc->cs, d, "draw");
+    if (s_pc.mode != 0) kg_pass_note(d, dc->cs, dc->zs);
+    if (dc->cs) { dc->cs->ver++; dc->cs->wseq = ++s_wseq; }
+    if (dc->zs && (ps->depth_write || ps->stencil_write)) { dc->zs->ver++; dc->zs->wseq = ++s_wseq; }
+    G.draws++;
+    if (d->gvs) G.gvs_draws++;
+    G.tris += d->topology == KG_TOPO_STRIP ? (d->icount > 2 ? d->icount - 2 : 0) : d->icount / 3;
+}
diff --git a/src/nv2a/kelvin/kelvin_gpu_hlsl.inc b/src/nv2a/kelvin/kelvin_gpu_hlsl.inc
new file mode 100644
index 0000000..f605b38
--- /dev/null
+++ b/src/nv2a/kelvin/kelvin_gpu_hlsl.inc
@@ -0,0 +1,277 @@
+/* HLSL for the Kelvin D3D11 backend (kelvin_gpu.c includes this).
+ *
+ * The vertex stage here only places already-transformed vertices (the CPU
+ * vertex programs run first, kelvin_vsh.c); the pixel stage is an interpreter
+ * of the NV2A register combiners and texture stages with the same arithmetic
+ * and ordering as kelvin_pixel.c: every input of a combiner stage is read
+ * before any of its outputs is written.
+ */
+static const char kgpu_hlsl_common[] =
+"#ifdef KG_FLAT\n"            /* flat shading: the colours come from a triangle's first vertex */
+"#define KG_NI nointerpolation\n"
+"#else\n"
+"#define KG_NI\n"
+"#endif\n"
+"struct StageCfg {\n"
+"    uint4  rgb_in;\n"
+"    uint4  alpha_in;\n"
+"    uint4  outs;\n"
+"    float4 c0;\n"
+"    float4 c1;\n"
+"};\n"
+"cbuffer PSConst : register(b0) {\n"
+"    StageCfg stage[8];\n"
+"    uint4  fin_abcd;\n"
+"    uint4  fin_efg;\n"       /* x e, y f, z g, w flags */
+"    float4 final_c0;\n"
+"    float4 final_c1;\n"
+"    float4 fogcolor;\n"
+"    uint4  gen;\n"           /* x stages, y alpha func, z alpha ref, w unused */
+"    uint4  texmode;\n"
+"    uint4  texflags;\n"      /* bit0 valid, bit1 rect, bit2 alphakill, bits4-5 colorkey */
+"    float4 texrcp[4];\n"
+"    uint4  ckey;\n"
+"    uint4  ckeymask;\n"
+"    uint4  ofs;\n"           /* x: output alpha override (0 none, 1 force 1, 2 force 0) */
+"};\n"
+"cbuffer VSConst : register(b1) {\n"
+"    float4 vs_scale;\n"      /* x 2/guestW, y 2/guestH, z 1/zmax, w w-normalise factor */
+"    uint4  vs_rec0;\n"       /* x base, y stride, z pos slot, w d0 slot */
+"    uint4  vs_rec1;\n"       /* x d1 slot, y fog slot, z t0 slot, w t1 slot */
+"    uint4  vs_rec2;\n"       /* x t2 slot, y t3 slot, z..w unused */
+"    float4 vs_misc;\n"
+"};\n"
+"struct VSOut {\n"
+"    float4 pos : SV_Position;\n"
+"    KG_NI float4 d0  : TEXCOORD0;\n"
+"    KG_NI float4 d1  : TEXCOORD1;\n"
+"    float4 misc: TEXCOORD2;\n"
+"    float4 t0  : TEXCOORD3;\n"
+"    float4 t1  : TEXCOORD4;\n"
+"    float4 t2  : TEXCOORD5;\n"
+"    float4 t3  : TEXCOORD6;\n"
+"};\n";
+
+static const char kgpu_hlsl_vs[] =
+"Buffer<float4> VB : register(t8);\n"
+"float4 FetchRec(uint base, uint slot, float4 dflt) {\n"
+"    return slot == 0xFFFFFFFFu ? dflt : VB[base + slot];\n"
+"}\n"
+"VSOut vs_main(uint vid : SV_VertexID) {\n"
+"    VSOut o;\n"
+"    uint base = vs_rec0.x + vid * vs_rec0.y;\n"
+"    float4 p = VB[base + vs_rec0.z];\n"
+"    float w = p.w;\n"
+"    if (abs(w) < 1.0e-12) w *= vs_scale.w;\n"
+"    float2 ndc = float2(p.x * vs_scale.x - 1.0, 1.0 - p.y * vs_scale.y);\n"
+"    float zn = p.z * vs_scale.z;\n"
+"    o.pos = float4(ndc * w, zn * w, w);\n"
+"    o.d0 = FetchRec(base, vs_rec0.w, float4(0,0,0,1));\n"
+"    o.d1 = FetchRec(base, vs_rec1.x, float4(0,0,0,1));\n"
+"    float4 f = FetchRec(base, vs_rec1.y, float4(1,0,0,0));\n"
+"    o.misc = f;\n"
+"    o.t0 = FetchRec(base, vs_rec1.z, float4(0,0,0,1));\n"
+"    o.t1 = FetchRec(base, vs_rec1.w, float4(0,0,0,1));\n"
+"    o.t2 = FetchRec(base, vs_rec2.x, float4(0,0,0,1));\n"
+"    o.t3 = FetchRec(base, vs_rec2.y, float4(0,0,0,1));\n"
+"    return o;\n"
+"}\n";
+
+static const char kgpu_hlsl_ps[] =
+"Texture2D<float4> Tex0 : register(t0);\n"
+"Texture2D<float4> Tex1 : register(t1);\n"
+"Texture2D<float4> Tex2 : register(t2);\n"
+"Texture2D<float4> Tex3 : register(t3);\n"
+"SamplerState Smp0 : register(s0);\n"
+"SamplerState Smp1 : register(s1);\n"
+"SamplerState Smp2 : register(s2);\n"
+"SamplerState Smp3 : register(s3);\n"
+"\n"
+"float3 map3(float3 x, uint mod) {\n"
+"    if (mod == 0x00u) return max(x, 0.0);\n"
+"    if (mod == 0x20u) return 1.0 - clamp(x, 0.0, 1.0);\n"
+"    if (mod == 0x40u) return 2.0 * max(x, 0.0) - 1.0;\n"
+"    if (mod == 0x60u) return -2.0 * max(x, 0.0) + 1.0;\n"
+"    if (mod == 0x80u) return max(x, 0.0) - 0.5;\n"
+"    if (mod == 0xA0u) return -max(x, 0.0) + 0.5;\n"
+"    if (mod == 0xE0u) return -x;\n"
+"    return x;\n"
+"}\n"
+"float map1(float x, uint mod) {\n"
+"    return map3(float3(x, x, x), mod).x;\n"
+"}\n"
+"float3 mapout3(float3 x, uint m) {\n"
+"    if (m == 0x08u) return x - 0.5;\n"
+"    if (m == 0x10u) return x * 2.0;\n"
+"    if (m == 0x18u) return (x - 0.5) * 2.0;\n"
+"    if (m == 0x20u) return x * 4.0;\n"
+"    if (m == 0x30u) return x * 0.5;\n"
+"    return x;\n"
+"}\n"
+"float mapout1(float x, uint m) { return mapout3(float3(x, x, x), m).x; }\n"
+"float3 clamp1_3(float3 x) { return clamp(x, -1.0, 1.0); }\n"
+"float clamp1_1(float x) { return clamp(x, -1.0, 1.0); }\n"
+"\n"
+"bool Writable(uint r) { return r == 4u || r == 5u || (r >= 8u && r <= 13u); }\n"
+"\n"
+"float4 ps_main(VSOut v) : SV_Target {\n"
+"    float4 R[16];\n"
+"    float4 T[4];\n"
+"    bool killed = false;\n"
+"    float4 vt[4] = { v.t0, v.t1, v.t2, v.t3 };\n"
+"    float4 rcp[4] = { texrcp[0], texrcp[1], texrcp[2], texrcp[3] };\n"
+"    float4 s0, s1, s2, s3;\n"
+"    {\n"
+"        float2 uv0 = float2(0.0, 0.0); float2 uv1 = uv0; float2 uv2 = uv0; float2 uv3 = uv0;\n"
+"        if (vt[0].w != 0.0) uv0 = vt[0].xy / vt[0].w;\n"
+"        if (vt[1].w != 0.0) uv1 = vt[1].xy / vt[1].w;\n"
+"        if (vt[2].w != 0.0) uv2 = vt[2].xy / vt[2].w;\n"
+"        if (vt[3].w != 0.0) uv3 = vt[3].xy / vt[3].w;\n"
+"        if (texflags.x & 2u) uv0 *= rcp[0].xy;\n"
+"        if (texflags.y & 2u) uv1 *= rcp[1].xy;\n"
+"        if (texflags.z & 2u) uv2 *= rcp[2].xy;\n"
+"        if (texflags.w & 2u) uv3 *= rcp[3].xy;\n"
+"        s0 = Tex0.Sample(Smp0, uv0);\n"
+"        s1 = Tex1.Sample(Smp1, uv1);\n"
+"        s2 = Tex2.Sample(Smp2, uv2);\n"
+"        s3 = Tex3.Sample(Smp3, uv3);\n"
+"    }\n"
+"    float4 samp[4] = { s0, s1, s2, s3 };\n"
+"    [unroll] for (uint ti = 0; ti < 4; ti++) {\n"
+"        float4 t = float4(0.0, 0.0, 0.0, 1.0);\n"
+"        uint mode = ti == 0 ? texmode.x : ti == 1 ? texmode.y : ti == 2 ? texmode.z : texmode.w;\n"
+"        uint fl = ti == 0 ? texflags.x : ti == 1 ? texflags.y : ti == 2 ? texflags.z : texflags.w;\n"
+"        uint key = ti == 0 ? ckey.x : ti == 1 ? ckey.y : ti == 2 ? ckey.z : ckey.w;\n"
+"        uint kmask = ti == 0 ? ckeymask.x : ti == 1 ? ckeymask.y : ti == 2 ? ckeymask.z : ckeymask.w;\n"
+"        if (mode == 1u && (fl & 1u) != 0u && vt[ti].w != 0.0) {\n"
+"            t = samp[ti];\n"
+"            if ((fl & 4u) != 0u && t.a == 0.0) killed = true;\n"
+"            uint ckm = (fl >> 4) & 3u;\n"
+"            if (ckm != 0u) {\n"
+"                uint4 q = (uint4)(saturate(t) * 255.0 + 0.5);\n"
+"                uint c = (q.a << 24) | (q.r << 16) | (q.g << 8) | q.b;\n"
+"                if ((c & kmask) == (key & kmask)) {\n"
+"                    if (ckm == 3u) killed = true;\n"
+"                    else if (ckm == 1u) t.a = 0.0;\n"
+"                    else t = float4(0.0, 0.0, 0.0, 0.0);\n"
+"                }\n"
+"            }\n"
+"        } else if (mode == 1u) {\n"
+"            t = float4(0.0, 0.0, 0.0, 1.0);\n"
+"        }\n"
+"        T[ti] = t;\n"
+"    }\n"
+"    if (killed) discard;\n"
+"\n"
+"    uint fflags = fin_efg.w;\n"
+"    R[0] = float4(0, 0, 0, 0);\n"
+"    R[1] = stage[0].c0;\n"
+"    R[2] = stage[0].c1;\n"
+"    R[3] = float4(fogcolor.rgb, saturate(v.misc.x));\n"
+"    R[4] = v.d0;\n"
+"    R[5] = v.d1;\n"
+"    R[6] = float4(0, 0, 0, 0);\n"
+"    R[7] = float4(0, 0, 0, 0);\n"
+"    R[8] = T[0]; R[9] = T[1]; R[10] = T[2]; R[11] = T[3];\n"
+"    R[12] = float4(0.0, 0.0, 0.0, texmode.x != 0u ? T[0].a : 1.0);\n"
+"    R[13] = float4(0, 0, 0, 0);\n"
+"    R[14] = float4(0, 0, 0, 0);\n"
+"    R[15] = float4(0, 0, 0, 0);\n"
+"\n"
+"    uint nst = gen.x;\n"
+"    [loop] for (uint i = 0; i < nst; i++) {\n"
+"        StageCfg s = stage[i];\n"
+"        if (fflags & 0x20u) R[1] = s.c0; else R[1] = stage[0].c0;\n"
+"        if (fflags & 0x40u) R[2] = s.c1; else R[2] = stage[0].c1;\n"
+"        {\n"
+"            float3 a1 = (fflags & 4u) ? 1.0 - R[5].rgb : R[5].rgb;\n"
+"            float3 b1 = (fflags & 8u) ? 1.0 - R[12].rgb : R[12].rgb;\n"
+"            float3 sm = a1 + b1;\n"
+"            if (fflags & 2u) sm = clamp(sm, 0.0, 1.0);\n"
+"            R[14] = float4(sm, 0.0);\n"
+"        }\n"
+"        float3 ra[4];\n"
+"        float  aa[4];\n"
+"        uint   rin[4] = { s.rgb_in.x, s.rgb_in.y, s.rgb_in.z, s.rgb_in.w };\n"
+"        uint   ain[4] = { s.alpha_in.x, s.alpha_in.y, s.alpha_in.z, s.alpha_in.w };\n"
+"        [unroll] for (uint k = 0; k < 4; k++) {\n"
+"            float4 rv = R[rin[k] & 15u];\n"
+"            ra[k] = (rin[k] & 0x10u) ? map3(rv.aaa, rin[k] & 0xE0u) : map3(rv.rgb, rin[k] & 0xE0u);\n"
+"            float4 av = R[ain[k] & 15u];\n"
+"            aa[k] = map1((ain[k] & 0x10u) ? av.a : av.b, ain[k] & 0xE0u);\n"
+"        }\n"
+"        uint ro = s.outs.x;\n"
+"        uint rcd = ro & 15u, rab = (ro >> 4) & 15u, rmx = (ro >> 8) & 15u, rfl = ro >> 12;\n"
+"        uint rmap = rfl & 0x38u;\n"
+"        float3 ab3 = (rfl & 2u) ? dot(ra[0], ra[1]).xxx : ra[0] * ra[1];\n"
+"        float3 cd3 = (rfl & 1u) ? dot(ra[2], ra[3]).xxx : ra[2] * ra[3];\n"
+"        bool selr = ((fflags & 0x10u) != 0u) ? (R[12].a >= 0.5) : ((((uint)(R[12].a * 255.0)) & 1u) == 1u);\n"
+"        float3 mx3 = (rfl & 4u) ? (selr ? cd3 : ab3) : (ab3 + cd3);\n"
+"        float3 rab3 = clamp1_3(mapout3(ab3, rmap));\n"
+"        float3 rcd3 = clamp1_3(mapout3(cd3, rmap));\n"
+"        float3 rmx3 = clamp1_3(mapout3(mx3, rmap));\n"
+"        uint ao = s.outs.y;\n"
+"        uint acd = ao & 15u, aab = (ao >> 4) & 15u, amx = (ao >> 8) & 15u, afl = ao >> 12;\n"
+"        uint amap = afl & 0x38u;\n"
+"        float ab1 = aa[0] * aa[1];\n"
+"        float cd1 = aa[2] * aa[3];\n"
+"        float mx1 = (afl & 4u) ? (selr ? cd1 : ab1) : (ab1 + cd1);\n"
+"        float rab1 = clamp1_1(mapout1(ab1, amap));\n"
+"        float rcd1 = clamp1_1(mapout1(cd1, amap));\n"
+"        float rmx1 = clamp1_1(mapout1(mx1, amap));\n"
+"        // writes: RGB portion (ab, cd, mux) then alpha portion\n"
+"        if (Writable(rab)) { R[rab].rgb = rab3; if (rfl & 0x80u) R[rab].a = rab3.b; }\n"
+"        if (Writable(rcd)) { R[rcd].rgb = rcd3; if (rfl & 0x40u) R[rcd].a = rcd3.b; }\n"
+"        if (Writable(rmx)) { R[rmx].rgb = rmx3; }\n"
+"        if (Writable(aab)) { R[aab].a = rab1; }\n"
+"        if (Writable(acd)) { R[acd].a = rcd1; }\n"
+"        if (Writable(amx)) { R[amx].a = rmx1; }\n"
+"    }\n"
+"\n"
+"    float4 frag;\n"
+"    if (fflags & 1u) {\n"
+"        R[1] = final_c0;\n"
+"        R[2] = final_c1;\n"
+"        {\n"
+"            float3 a1 = (fflags & 4u) ? 1.0 - R[5].rgb : R[5].rgb;\n"
+"            float3 b1 = (fflags & 8u) ? 1.0 - R[12].rgb : R[12].rgb;\n"
+"            float3 sm = a1 + b1;\n"
+"            if (fflags & 2u) sm = clamp(sm, 0.0, 1.0);\n"
+"            R[14] = float4(sm, 0.0);\n"
+"        }\n"
+"        uint ine = fin_efg.x, inf = fin_efg.y, ing = fin_efg.z;\n"
+"        float4 ev = R[ine & 15u], fv = R[inf & 15u];\n"
+"        float3 e3 = (ine & 0x10u) ? map3(ev.aaa, ine & 0xE0u) : map3(ev.rgb, ine & 0xE0u);\n"
+"        float3 f3 = (inf & 0x10u) ? map3(fv.aaa, inf & 0xE0u) : map3(fv.rgb, inf & 0xE0u);\n"
+"        R[15] = float4(e3 * f3, 0.0);\n"
+"        uint fa = fin_abcd.x, fb = fin_abcd.y, fc = fin_abcd.z, fd = fin_abcd.w;\n"
+"        float4 av = R[fa & 15u], bv = R[fb & 15u], cv = R[fc & 15u], dv = R[fd & 15u];\n"
+"        float3 a3 = (fa & 0x10u) ? map3(av.aaa, fa & 0xE0u) : map3(av.rgb, fa & 0xE0u);\n"
+"        float3 b3 = (fb & 0x10u) ? map3(bv.aaa, fb & 0xE0u) : map3(bv.rgb, fb & 0xE0u);\n"
+"        float3 c3 = (fc & 0x10u) ? map3(cv.aaa, fc & 0xE0u) : map3(cv.rgb, fc & 0xE0u);\n"
+"        float3 d3 = (fd & 0x10u) ? map3(dv.aaa, fd & 0xE0u) : map3(dv.rgb, fd & 0xE0u);\n"
+"        float4 gv = R[ing & 15u];\n"
+"        float g1 = map1((ing & 0x10u) ? gv.a : gv.b, ing & 0xE0u);\n"
+"        frag = float4(d3 + c3 * (1.0 - a3) + b3 * a3, g1);\n"
+"    } else {\n"
+"        frag = R[12];\n"
+"    }\n"
+"\n"
+"    uint func = gen.y;\n"
+"    if (func != 7u) {\n"
+"        int fa = (int)floor(frag.a * 255.0 + 0.5);\n"
+"        int ref = (int)gen.z;\n"
+"        bool apass = true;\n"
+"        if (func == 0u) apass = false;\n"
+"        else if (func == 1u) apass = fa < ref;\n"
+"        else if (func == 2u) apass = fa == ref;\n"
+"        else if (func == 3u) apass = fa <= ref;\n"
+"        else if (func == 4u) apass = fa > ref;\n"
+"        else if (func == 5u) apass = fa != ref;\n"
+"        else if (func == 6u) apass = fa >= ref;\n"
+"        if (!apass) discard;\n"
+"    }\n"
+"    float4 o = saturate(frag);\n"
+"    if (ofs.x == 1u) o.a = 1.0; else if (ofs.x == 2u) o.a = 0.0;\n"
+"    return o;\n"
+"}\n";
diff --git a/src/nv2a/kelvin/kelvin_gpu_incl.inc b/src/nv2a/kelvin/kelvin_gpu_incl.inc
new file mode 100644
index 0000000..345e83c
--- /dev/null
+++ b/src/nv2a/kelvin/kelvin_gpu_incl.inc
@@ -0,0 +1,216 @@
+/* Inclusive profile of one thread (diagnostic), included by kelvin_gpu.c after kelvin_gpu_slow.inc.
+ *
+ * RECOMP_KGPU_PROFI=start,seconds[,tid]: sample one thread (default: the guest main thread, whose id the game
+ * records in g_black_main_tid from its Present callback) about every millisecond. Each sample's host stack is
+ * scanned for return addresses inside the executable's code; every distinct function found counts once, so the
+ * report lists, for the functions that account for the most time, the share of samples that were inside them or
+ * inside something they called:
+ *   [KPROFI] 61.2% sub_0020F6A0 ...   (exclusive: [KPROFI] self 9.1% sub_000205A0 ...)
+ * Needs the PDB beside the executable. The generated code is one host function per guest function, so the
+ * inclusive times are the game's own call tree. */
+extern volatile DWORD g_black_main_tid;
+extern volatile DWORD g_kelvin_pusher_tid;
+
+typedef struct InclEntry { char name[64]; uint32_t incl, self; } InclEntry;
+
+static DWORD WINAPI incl_thread(LPVOID arg)
+{
+    unsigned int start = ((unsigned int)(uintptr_t)arg) & 0xFFFF, secs = ((unsigned int)(uintptr_t)arg) >> 16;
+    InclEntry *tab = (InclEntry *)calloc(4096, sizeof(InclEntry));
+    struct { uint64_t addr; int16_t entry; } cache[8192];
+    unsigned int ntab = 0, i, samples = 0;
+    InclEntry *lines = (InclEntry *)calloc(8192, sizeof(InclEntry));
+    unsigned int nlines = 0;
+    DWORD tid = 0;
+    int pusher = 0;
+    HANDLE h;
+    LARGE_INTEGER f;
+    long long deadline;
+    uint64_t mod_lo = (uint64_t)(uintptr_t)GetModuleHandleA(NULL), mod_hi, code_hi;
+    const char *e = getenv("RECOMP_KGPU_PROFI");
+    unsigned int top_n = getenv("RECOMP_KGPU_PROFILE_TOP") ? (unsigned int)atoi(getenv("RECOMP_KGPU_PROFILE_TOP")) : 60;
+    if (top_n < 10) top_n = 10;
+    if (top_n > 400) top_n = 400;
+    {
+        const IMAGE_DOS_HEADER *dos = (const IMAGE_DOS_HEADER *)(uintptr_t)mod_lo;
+        const IMAGE_NT_HEADERS *nt = (const IMAGE_NT_HEADERS *)((const uint8_t *)dos + dos->e_lfanew);
+        mod_hi = mod_lo + nt->OptionalHeader.SizeOfImage;
+        code_hi = mod_lo + nt->OptionalHeader.BaseOfCode + nt->OptionalHeader.SizeOfCode;
+    }
+    memset(cache, 0, sizeof(cache));
+    if (e) {
+        const char *c = strchr(e, ',');
+        if (c && (c = strchr(c + 1, ','))) {
+            c++;
+            if (!strncmp(c, "pusher", 6)) {
+                pusher = 1;
+            } else tid = (DWORD)atoi(c);
+        }
+    }
+    QueryPerformanceFrequency(&f);
+    Sleep(start * 1000);
+    if (pusher) tid = g_kelvin_pusher_tid;
+    if (!tid) tid = g_black_main_tid;
+    if (!tid) { fprintf(stderr, "[KPROFI] no guest main thread id yet\n"); return 0; }
+    h = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, tid);
+    if (!h) return 0;
+    deadline = qpc_now() + (long long)secs * f.QuadPart;
+    while (qpc_now() < deadline) {
+        CONTEXT ctx;
+        ctx.ContextFlags = CONTEXT_CONTROL;
+        if (SuspendThread(h) != (DWORD)-1) {
+            if (GetThreadContext(h, &ctx)) {
+                uint64_t stack[768], seen_idx[64];
+                SIZE_T got = 0;
+                unsigned int k, nseen = 0;
+                uint64_t addrs[64];
+                unsigned int naddr = 0;
+                addrs[naddr++] = ctx.Rip;
+                {
+                    /* read in 512-byte pieces: a read that runs past the committed stack fails as a whole */
+                    SIZE_T off = 0, piece;
+                    got = 0;
+                    for (off = 0; off < sizeof(stack); off += 512) {
+                        if (!ReadProcessMemory(GetCurrentProcess(), (LPCVOID)(ctx.Rsp + off), (uint8_t *)stack + off, 512, &piece)) break;
+                        got += piece;
+                    }
+                    for (k = 0; k < got / 8 && naddr < 64; k++)
+                        if (stack[k] >= mod_lo && stack[k] < code_hi) addrs[naddr++] = stack[k];
+                }
+                ResumeThread(h);
+                for (k = 0; k < naddr; k++) {
+                    unsigned int slot = (unsigned int)((addrs[k] >> 4) * 2654435761u) % 8192, probes;
+                    int16_t entry = -1;
+                    for (probes = 0; probes < 8192; probes++, slot = (slot + 1) % 8192) {
+                        if (!cache[slot].addr) {
+                            char nm[64];
+                            unsigned int j;
+                            slow_name(addrs[k], nm, sizeof(nm), 0);
+                            for (j = 0; j < ntab; j++) if (!strcmp(tab[j].name, nm)) break;
+                            if (j == ntab && ntab < 4096) { snprintf(tab[ntab].name, sizeof(tab[ntab].name), "%s", nm); ntab++; }
+                            cache[slot].addr = addrs[k]; cache[slot].entry = (int16_t)(j < ntab ? j : -1);
+                            entry = cache[slot].entry;
+                            break;
+                        }
+                        if (cache[slot].addr == addrs[k]) { entry = cache[slot].entry; break; }
+                    }
+                    if (entry < 0) continue;
+                    {
+                        unsigned int q, dup = 0;
+                        for (q = 0; q < nseen; q++) if (seen_idx[q] == (uint64_t)entry) { dup = 1; break; }
+                        if (!dup && nseen < 64) { seen_idx[nseen++] = (uint64_t)entry; tab[entry].incl++; }
+                    }
+                    if (k == 0) tab[entry].self++;
+                }
+                {   /* the top frame by source line */
+                    char ln[64];
+                    unsigned int j;
+                    slow_name(addrs[0], ln, sizeof(ln), 1);
+                    if (!strncmp(ln, "_NLG", 4) || ln[0] == '?') {
+                        HMODULE hm = NULL;
+                        char mn[MAX_PATH];
+                        if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT, (LPCSTR)(uintptr_t)addrs[0], &hm) &&
+                            GetModuleFileNameA(hm, mn, sizeof(mn))) {
+                            const char *base = strrchr(mn, '\\');
+                            snprintf(ln, sizeof(ln), "%s [%s+0x%llX]", ln, base ? base + 1 : mn, (unsigned long long)(addrs[0] - (uint64_t)(uintptr_t)hm));
+                        }
+                    }
+                    for (j = 0; j < nlines; j++) if (!strcmp(lines[j].name, ln)) break;
+                    if (j == nlines && nlines < 8192) { snprintf(lines[nlines].name, sizeof(lines[nlines].name), "%s", ln); nlines++; }
+                    if (j < nlines) lines[j].self++;
+                }
+                samples++;
+            } else {
+                ResumeThread(h);
+            }
+        }
+        Sleep(1);
+    }
+    for (i = 0; i < ntab; i++) {
+        unsigned int j;
+        for (j = i + 1; j < ntab; j++)
+            if (tab[j].incl > tab[i].incl) { InclEntry t = tab[i]; tab[i] = tab[j]; tab[j] = t; }
+        if (i >= top_n) break;
+    }
+    fprintf(stderr, "[KPROFI] thread %lu, %u samples (inclusive share, self share)\n", (unsigned long)tid, samples);
+    for (i = 0; i < ntab && i < top_n; i++)
+        fprintf(stderr, "[KPROFI] %5.1f%% %5.1f%% %s\n", 100.0 * tab[i].incl / (double)(samples ? samples : 1),
+                100.0 * tab[i].self / (double)(samples ? samples : 1), tab[i].name);
+    fflush(stderr);
+    for (i = 0; i < nlines && i < top_n; i++) {
+        unsigned int j;
+        for (j = i + 1; j < nlines; j++) if (lines[j].self > lines[i].self) { InclEntry t = lines[i]; lines[i] = lines[j]; lines[j] = t; }
+        fprintf(stderr, "[KPROFL] %5.1f%% %s\n", 100.0 * lines[i].self / (double)(samples ? samples : 1), lines[i].name);
+    }
+    fflush(stderr);
+    CloseHandle(h);
+    free(tab);
+    free(lines);
+    return 0;
+}
+
+/* RECOMP_EXC_STAT=1: which exceptions the process takes, by thread and faulting address. The handler runs
+ * first in the chain and always lets the real handlers see the exception. */
+typedef struct ExcStat { DWORD tid; DWORD code; uint64_t rip, addr; uint32_t n; } ExcStat;
+static ExcStat s_exc[256];
+static volatile LONG s_nexc;
+static LONG CALLBACK exc_stat_veh(PEXCEPTION_POINTERS ep)
+{
+    DWORD tid = GetCurrentThreadId(), code = ep->ExceptionRecord->ExceptionCode;
+    uint64_t rip = ep->ContextRecord->Rip, addr = ep->ExceptionRecord->NumberParameters > 1 ? ep->ExceptionRecord->ExceptionInformation[1] : 0;
+    LONG i, n = s_nexc;
+    addr &= ~(uint64_t)0xFFF;
+    for (i = 0; i < n; i++) {
+        if (s_exc[i].tid == tid && s_exc[i].code == code && s_exc[i].rip == rip && s_exc[i].addr == addr) {
+            InterlockedIncrement((volatile LONG *)&s_exc[i].n);
+            return EXCEPTION_CONTINUE_SEARCH;
+        }
+    }
+    if (n < 256) {
+        i = InterlockedIncrement(&s_nexc) - 1;
+        if (i < 256) { s_exc[i].tid = tid; s_exc[i].code = code; s_exc[i].rip = rip; s_exc[i].addr = addr; s_exc[i].n = 1; }
+    }
+    return EXCEPTION_CONTINUE_SEARCH;
+}
+
+static DWORD WINAPI exc_stat_thread(LPVOID arg)
+{
+    (void)arg;
+    for (;;) {
+        LONG i, n;
+        Sleep(10000);
+        n = s_nexc < 256 ? s_nexc : 256;
+        for (i = 0; i < n; i++) {
+            LONG j;
+            unsigned long long tot = 0;
+            for (j = 0; j < i; j++) if (s_exc[j].tid == s_exc[i].tid) break;
+            if (j < i) continue;
+            for (j = 0; j < n; j++) if (s_exc[j].tid == s_exc[i].tid) tot += s_exc[j].n;
+            fprintf(stderr, "[KEXC] total tid %lu%s: %llu exceptions\n", (unsigned long)s_exc[i].tid,
+                    s_exc[i].tid == g_black_main_tid ? " (main)" : s_exc[i].tid == g_kelvin_pusher_tid ? " (pusher)" : "", tot);
+        }
+        for (i = 0; i < n; i++) {
+            if (s_exc[i].n >= 20) {
+                char nm[64];
+                slow_name(s_exc[i].rip, nm, sizeof(nm), 1);
+                fprintf(stderr, "[KEXC] tid %lu%s code 0x%08lX rip %s fault page 0x%llX x%u\n", (unsigned long)s_exc[i].tid,
+                        s_exc[i].tid == g_black_main_tid ? " (main)" : s_exc[i].tid == g_kelvin_pusher_tid ? " (pusher)" : "",
+                        (unsigned long)s_exc[i].code, nm, (unsigned long long)s_exc[i].addr, s_exc[i].n);
+            }
+        }
+        fflush(stderr);
+    }
+    return 0;
+}
+
+static void incl_maybe_start(void)
+{
+    const char *e = getenv("RECOMP_KGPU_PROFI");
+    unsigned int a = 0, b = 0;
+    if (getenv("RECOMP_EXC_STAT")) {
+        AddVectoredExceptionHandler(1, exc_stat_veh);
+        CloseHandle(CreateThread(NULL, 0, exc_stat_thread, NULL, 0, NULL));
+    }
+    if (e && sscanf(e, "%u,%u", &a, &b) >= 2 && b)
+        CloseHandle(CreateThread(NULL, 0, incl_thread, (LPVOID)(uintptr_t)(((b & 0xFFFF) << 16) | (a & 0xFFFF)), 0, NULL));
+}
diff --git a/src/nv2a/kelvin/kelvin_gpu_post.inc b/src/nv2a/kelvin/kelvin_gpu_post.inc
new file mode 100644
index 0000000..8db4ff6
--- /dev/null
+++ b/src/nv2a/kelvin/kelvin_gpu_post.inc
@@ -0,0 +1,823 @@
+/* Picture effects of the GPU renderer, included by kelvin_gpu.c after the surface and pass helpers.
+ *
+ * What the player chooses in the Video Settings page (pc_video.c) that the renderer does itself:
+ *
+ *   - AO runs on opaque scene colour just before the first blended draw, so transparent smoke is not darkened with its
+ *     background. Depth of field, FXAA and sharpening still run just before the HUD (or at flip if there is no HUD).
+ *     Each effect copies the colour target and draws back into it.
+ *   - super-sampling (SSAA) rasterises at twice the width and height (the raster size, G.host_*); at the flip a four-tap
+ *     tent resolve brings the frame down to the internal resolution (G.out_*), which is what is presented.
+ *   - anisotropic filtering is a sampler setting (get_sampler reads s_af).
+ *
+ * Everything is on the thread that owns the surfaces and the context, between draws; the passes leave the context's
+ * bindings to be set again (kg_cache_invalidate). */
+
+#include "kelvin_post_order.h"
+
+static const char kgpu_hlsl_post[] =
+"cbuffer PostCB : register(b0) {\n"
+"    float4 p0;   // x,y: 1 / scene size; z,w: scene size in pixels\n"
+"    float4 p1;   // DOF: radius/taps/smoothing/depth scale; AO: radius/directions/steps/strength\n"
+"    float4 p2;   // DOF: focus zone/near blur/sharpening; AO: bias/range/detail blend\n"
+"    float4 p3;   // Resolve: target size/reciprocal; AO: real camera half-frustum in x,y\n"
+"};\n"
+"Texture2D<float4> SceneTex : register(t0);\n"
+"Texture2D<float>  CocTex   : register(t1);\n"
+"Texture2D<float>  DepthTex : register(t2);\n"
+"Texture2D<float>  FocusTex : register(t3);\n"
+"SamplerState LinSmp : register(s0);\n"
+"SamplerState PtSmp  : register(s1);\n"
+"\n"
+"// Focus on a surface represented by the central aperture. A mean between foreground foliage\n"
+"// and the aimed background describes neither surface and pumps the whole picture's blur.\n"
+"// The median rejects minority occluders; a foreground subject filling the aperture still wins.\n"
+"// Cleared/invalid depth is not a subject, and a sky-only aperture preserves the last focus.\n"
+"float focus_ps(float4 p : SV_Position) : SV_Target {\n"
+"    float prev = FocusTex.Load(int3(0, 0, 0));\n"
+"    float samples[25];\n"
+"    [unroll] for (int k = 0; k < 25; ++k) samples[k] = 1.0;\n"
+"    int n = 0;\n"
+"    [unroll] for (int j = -2; j <= 2; j++) {\n"
+"        [unroll] for (int i = -2; i <= 2; i++) {\n"
+"            float2 uv = float2(0.5 + i * 0.010 * p0.w / p0.z, 0.5 + j * 0.010);\n"
+"            float d = DepthTex.SampleLevel(PtSmp, uv, 0);\n"
+"            if (d >= 0.0 && d < 0.99999) {\n"
+"                int k = n;\n"
+"                [loop] while (k > 0) {\n"
+"                    if (samples[k - 1] <= d) break;\n"
+"                    samples[k] = samples[k - 1];\n"
+"                    --k;\n"
+"                }\n"
+"                samples[k] = d;\n"
+"                ++n;\n"
+"            }\n"
+"        }\n"
+"    }\n"
+"    float target = n > 0 ? samples[n / 2] : prev;\n"
+"    if (!(prev >= 0.0 && prev <= 1.0)) return n > 0 ? target : 1.0;\n"
+"    return lerp(prev, target, p1.z);\n"
+"}\n"
+"\n"
+"// How much each pixel is out of focus, 0..1 of the largest blur: only what is behind the focus blurs, so the weapon and\n"
+"// hands in front of it stay sharp.\n"
+"float coc_ps(float4 p : SV_Position) : SV_Target {\n"
+"    float d = DepthTex.Load(int3((int2)p.xy, 0));\n"
+"    float f = FocusTex.Load(int3(0, 0, 0));\n"
+"    float dz = d - f;\n"
+"    float far = saturate((dz - p2.x) * p1.w);\n"
+"    float nr = saturate((-dz - p2.x) * p1.w) * p2.y;\n"
+"    return max(far, nr);\n"
+"}\n"
+"\n"
+"float4 dof_ps(float4 p : SV_Position) : SV_Target {\n"
+"    float2 uv = p.xy * p0.xy;\n"
+"    float4 center = SceneTex.SampleLevel(LinSmp, uv, 0);\n"
+"    float R = CocTex.SampleLevel(PtSmp, uv, 0) * p1.x;\n"
+"    if (R < 0.6) return center;\n"
+"    float rot = 6.2831853 * frac(52.9829189 * frac(dot(p.xy, float2(0.06711056, 0.00583715))));\n"
+"    float3 acc = center.rgb;\n"
+"    float wsum = 1.0;\n"
+"    int taps = (int)p1.y;\n"
+"    [loop] for (int i = 0; i < taps; i++) {\n"
+"        float r = sqrt((i + 0.5) / taps) * R;\n"
+"        float a = i * 2.39996323 + rot;\n"
+"        float2 o = float2(cos(a), sin(a)) * r;\n"
+"        float2 suv = uv + o * p0.xy;\n"
+"        float sc = CocTex.SampleLevel(PtSmp, suv, 0) * p1.x;\n"
+"        float w = saturate(sc - r + 1.0);\n"
+"        acc += SceneTex.SampleLevel(LinSmp, suv, 0).rgb * w;\n"
+"        wsum += w;\n"
+"    }\n"
+"    return float4(acc / wsum, center.a);\n"
+"}\n"
+"\n"
+"// FXAA: find the edges by their luma contrast, then blend along them. Pixels with little local contrast are left\n"
+"// alone, so fine texture detail is not softened.\n"
+"float luma(float3 c) { return dot(c, float3(0.299, 0.587, 0.114)); }\n"
+"float4 fxaa_ps(float4 p : SV_Position) : SV_Target {\n"
+"    float2 uv = p.xy * p0.xy;\n"
+"    float2 t = p0.xy;\n"
+"    float4 m4 = SceneTex.SampleLevel(LinSmp, uv, 0);\n"
+"    float3 rgbNW = SceneTex.SampleLevel(LinSmp, uv + float2(-1, -1) * t, 0).rgb;\n"
+"    float3 rgbNE = SceneTex.SampleLevel(LinSmp, uv + float2( 1, -1) * t, 0).rgb;\n"
+"    float3 rgbSW = SceneTex.SampleLevel(LinSmp, uv + float2(-1,  1) * t, 0).rgb;\n"
+"    float3 rgbSE = SceneTex.SampleLevel(LinSmp, uv + float2( 1,  1) * t, 0).rgb;\n"
+"    float lumaNW = luma(rgbNW), lumaNE = luma(rgbNE), lumaSW = luma(rgbSW), lumaSE = luma(rgbSE), lumaM = luma(m4.rgb);\n"
+"    float lumaMin = min(lumaM, min(min(lumaNW, lumaNE), min(lumaSW, lumaSE)));\n"
+"    float lumaMax = max(lumaM, max(max(lumaNW, lumaNE), max(lumaSW, lumaSE)));\n"
+"    if (lumaMax - lumaMin < max(0.0312, lumaMax * 0.125)) return m4;\n"
+"    float2 dir;\n"
+"    dir.x = -((lumaNW + lumaNE) - (lumaSW + lumaSE));\n"
+"    dir.y =  ((lumaNW + lumaSW) - (lumaNE + lumaSE));\n"
+"    float dirReduce = max((lumaNW + lumaNE + lumaSW + lumaSE) * (0.25 * 0.125), 1.0 / 128.0);\n"
+"    float rcpDirMin = 1.0 / (min(abs(dir.x), abs(dir.y)) + dirReduce);\n"
+"    dir = clamp(dir * rcpDirMin, -8.0, 8.0) * t;\n"
+"    float3 rgbA = 0.5 * (SceneTex.SampleLevel(LinSmp, uv + dir * (1.0 / 3.0 - 0.5), 0).rgb + SceneTex.SampleLevel(LinSmp, uv + dir * (2.0 / 3.0 - 0.5), 0).rgb);\n"
+"    float3 rgbB = rgbA * 0.5 + 0.25 * (SceneTex.SampleLevel(LinSmp, uv + dir * -0.5, 0).rgb + SceneTex.SampleLevel(LinSmp, uv + dir * 0.5, 0).rgb);\n"
+"    float lumaB = luma(rgbB);\n"
+"    return float4((lumaB < lumaMin || lumaB > lumaMax) ? rgbA : rgbB, m4.a);\n"
+"}\n"
+"\n"
+"// Contrast-adaptive sharpening (the AMD CAS idea): sharpen less where the neighbourhood is already contrasty.\n"
+"float4 sharpen_ps(float4 p : SV_Position) : SV_Target {\n"
+"    int2 q = (int2)p.xy;\n"
+"    float4 c = SceneTex.Load(int3(q, 0));\n"
+"    float3 a = SceneTex.Load(int3(q + int2(0, -1), 0)).rgb;\n"
+"    float3 b = SceneTex.Load(int3(q + int2(-1, 0), 0)).rgb;\n"
+"    float3 d = SceneTex.Load(int3(q + int2(1, 0), 0)).rgb;\n"
+"    float3 e = SceneTex.Load(int3(q + int2(0, 1), 0)).rgb;\n"
+"    float3 mn = min(c.rgb, min(min(a, b), min(d, e)));\n"
+"    float3 mx = max(c.rgb, max(max(a, b), max(d, e)));\n"
+"    float3 amp = sqrt(saturate(min(mn, 1.0 - mx) / max(mx, 0.0001)));\n"
+"    float3 w = amp * lerp(-0.125, -0.2, p2.z);\n"
+"    return float4(saturate((a * w + b * w + d * w + e * w + c.rgb) / (1.0 + 4.0 * w)), c.a);\n"
+"}\n"
+"\n"
+"// The super-sampling resolve: four bilinear taps at +-0.75 source texels are a 4x4 tent over the 2x2 block.\n"
+"float4 ssaa_ps(float4 p : SV_Position) : SV_Target {\n"
+"    float2 uv = p.xy * p3.zw;\n"
+"    float2 o = 0.75 * p0.xy;\n"
+"    float4 s = SceneTex.SampleLevel(LinSmp, uv + float2(-o.x, -o.y), 0) + SceneTex.SampleLevel(LinSmp, uv + float2(o.x, -o.y), 0) +\n"
+"               SceneTex.SampleLevel(LinSmp, uv + float2(-o.x,  o.y), 0) + SceneTex.SampleLevel(LinSmp, uv + float2(o.x,  o.y), 0);\n"
+"    return s * 0.25;\n"
+"}\n"
+"// AO uses p1=(pixel radius, directions/taps, steps, strength), p2=(bias, depth range, detail blend, 0),\n"
+"// and p3.xy=the real camera half-frustum. All methods share depth/normal reconstruction, not their kernels.\n"
+"float ao_hash(float2 p) { return frac(52.9829189 * frac(dot(p, float2(0.06711056, 0.00583715)))); }\n"
+"float ao_depth(float2 uv) { return DepthTex.SampleLevel(PtSmp, uv, 0); }\n"
+"// Perspective depth is 1-near/z (infinite-far approximation); near is a common scale.\n"
+"float ao_view_z(float d) { return min(4096.0, 1.0 / max(0.00010, 1.0 - d)); }\n"
+"float3 ao_pos(float2 uv) {\n"
+"    // Point-sampled depth belongs to this texel centre, not the unsnapped kernel coordinate.\n"
+"    uv = (clamp(floor(uv * p0.zw), float2(0, 0), p0.zw - 1.0) + 0.5) * p0.xy;\n"
+"    float z = ao_view_z(ao_depth(uv));\n"
+"    float2 n = float2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);\n"
+"    return float3(n * p3.xy * z, z);\n"
+"}\n"
+"float3 ao_normal(float2 uv, float3 c) {\n"
+"    float3 l = ao_pos(uv - float2(p0.x, 0)), r = ao_pos(uv + float2(p0.x, 0));\n"
+"    float3 u = ao_pos(uv - float2(0, p0.y)), d = ao_pos(uv + float2(0, p0.y));\n"
+"    // Choose the derivative on the same surface at depth discontinuities.\n"
+"    float3 dx = uv.x <= 0.5 * p0.x ? r - c : uv.x >= 1.0 - 0.5 * p0.x ? c - l :\n"
+"                abs(r.z - c.z) < abs(l.z - c.z) ? r - c : c - l;\n"
+"    float3 dy = uv.y <= 0.5 * p0.y ? c - d : uv.y >= 1.0 - 0.5 * p0.y ? u - c :\n"
+"                abs(u.z - c.z) < abs(d.z - c.z) ? u - c : c - d;\n"
+"    float3 n = cross(dx, dy);\n"
+"    float n2 = dot(n, n);\n"
+"    if (n2 < 1e-12) return float3(0, 0, -1);\n"
+"    n *= rsqrt(n2);\n"
+"    return dot(n, c) > 0 ? -n : n;\n"
+"}\n"
+"float ao_range(float3 c, float3 q) {\n"
+"    return saturate(1.0 - length(q - c) / max(0.01, c.z * p2.y));\n"
+"}\n"
+"float ao_visibility_sample(float2 uv, float3 c, float3 n) {\n"
+"    if (any(uv < 0) || any(uv > 1) || ao_depth(uv) >= 0.99999) return 0.0;\n"
+"    float3 q = ao_pos(uv), v = q - c;\n"
+"    float v2 = dot(v, v);\n"
+"    if (v2 < 1e-12) return 0.0;\n"
+"    return saturate(dot(n, v * rsqrt(v2)) - p2.x) * ao_range(c, q);\n"
+"}\n"
+"float ao_ssao_ps(float4 p : SV_Position) : SV_Target {\n"
+"    float2 uv = p.xy * p0.xy;\n"
+"    if (ao_depth(uv) >= 0.99999) return 1.0;\n"
+"    float3 c = ao_pos(uv), n = ao_normal(uv, c);\n"
+"    float rot = ao_hash(p.xy) * 6.2831853, occ = 0.0;\n"
+"    int taps = (int)p1.y;\n"
+"    // Independent radial samples, with no horizon search.\n"
+"    [loop] for (int i = 0; i < taps; i++) {\n"
+"        float a = i * 2.39996323 + rot;\n"
+"        float r = sqrt((i + 0.5) / taps) * p1.x;\n"
+"        occ += ao_visibility_sample(uv + float2(cos(a), sin(a)) * r * p0.xy, c, n);\n"
+"    }\n"
+"    return saturate(1.0 - p1.w * occ / taps);\n"
+"}\n"
+"float ao_hbao_ps(float4 p : SV_Position) : SV_Target {\n"
+"    float2 uv = p.xy * p0.xy;\n"
+"    if (ao_depth(uv) >= 0.99999) return 1.0;\n"
+"    float3 c = ao_pos(uv), n = ao_normal(uv, c);\n"
+"    float rot = ao_hash(p.xy) * 6.2831853, occ = 0.0;\n"
+"    int dirs = (int)p1.y, steps = (int)p1.z;\n"
+"    // Walk out along each ray and integrate its largest occluding horizon.\n"
+"    [loop] for (int i = 0; i < dirs; i++) {\n"
+"        float a = rot + i * 6.2831853 / dirs;\n"
+"        float2 dir = float2(cos(a), sin(a));\n"
+"        float horizon = 0.0;\n"
+"        [loop] for (int j = 0; j < steps; j++) {\n"
+"            float r = (j + 1.0) * p1.x / steps;\n"
+"            horizon = max(horizon, ao_visibility_sample(uv + dir * r * p0.xy, c, n));\n"
+"        }\n"
+"        occ += horizon;\n"
+"    }\n"
+"    return saturate(1.0 - p1.w * occ / dirs);\n"
+"}\n"
+"float ao_hbaop_ps(float4 p : SV_Position) : SV_Target {\n"
+"    float2 uv = p.xy * p0.xy;\n"
+"    if (ao_depth(uv) >= 0.99999) return 1.0;\n"
+"    float3 c = ao_pos(uv), n = ao_normal(uv, c);\n"
+"    // Interleaved 4x4 rotation, nonlinear radial sampling, and a separate near-detail term.\n"
+"    int2 cell = (int2)p.xy & 3;\n"
+"    float rot = (cell.x + cell.y * 4 + 0.5) * (6.2831853 / 16.0), occ = 0.0;\n"
+"    int dirs = (int)p1.y, steps = (int)p1.z;\n"
+"    [loop] for (int i = 0; i < dirs; i++) {\n"
+"        float a = rot + i * 6.2831853 / dirs;\n"
+"        float2 dir = float2(cos(a), sin(a));\n"
+"        float horizon = 0.0;\n"
+"        [loop] for (int j = 0; j < steps; j++) {\n"
+"            float r = sqrt((j + 0.5) / steps) * p1.x;\n"
+"            horizon = max(horizon, ao_visibility_sample(uv + dir * r * p0.xy, c, n));\n"
+"        }\n"
+"        occ += horizon;\n"
+"    }\n"
+"    float detail = ao_visibility_sample(uv + float2(2, 0) * p0.xy, c, n)\n"
+"                 + ao_visibility_sample(uv - float2(2, 0) * p0.xy, c, n)\n"
+"                 + ao_visibility_sample(uv + float2(0, 2) * p0.xy, c, n)\n"
+"                 + ao_visibility_sample(uv - float2(0, 2) * p0.xy, c, n);\n"
+"    return saturate(1.0 - p1.w * lerp(occ / dirs, detail * 0.25, p2.z));\n"
+"}\n"
+"float ao_gtao_ps(float4 p : SV_Position) : SV_Target {\n"
+"    float2 uv = p.xy * p0.xy;\n"
+"    if (ao_depth(uv) >= 0.99999) return 1.0;\n"
+"    float3 c = ao_pos(uv), n = ao_normal(uv, c);\n"
+"    float rot = ao_hash(p.xy) * 3.14159265, occ = 0.0;\n"
+"    int dirs = (int)p1.y, steps = (int)p1.z;\n"
+"    // Approximate slice/horizon integration in both directions of each slice.\n"
+"    [loop] for (int i = 0; i < dirs; i++) {\n"
+"        float a = rot + i * 3.14159265 / dirs;\n"
+"        float2 dir = float2(cos(a), sin(a));\n"
+"        float hp = 0.0, hn = 0.0;\n"
+"        [loop] for (int j = 0; j < steps; j++) {\n"
+"            float r = (j + 0.75) * p1.x / steps;\n"
+"            float2 offset = dir * r * p0.xy;\n"
+"            hp = max(hp, ao_visibility_sample(uv + offset, c, n));\n"
+"            hn = max(hn, ao_visibility_sample(uv - offset, c, n));\n"
+"        }\n"
+"        // Each horizon is sin(elevation); 1-cos(elevation) is its angular integral.\n"
+"        occ += (2.0 - sqrt(saturate(1.0 - hp * hp)) - sqrt(saturate(1.0 - hn * hn))) * 0.5;\n"
+"    }\n"
+"    return saturate(1.0 - p1.w * occ / dirs);\n"
+"}\n"
+"float ao_blur(float4 p, float2 axis) {\n"
+"    float2 uv = p.xy * p0.xy;\n"
+"    if (ao_depth(uv) >= 0.99999) return 1.0;\n"
+"    float z = ao_view_z(ao_depth(uv)), sum = 0.0, wsum = 0.0;\n"
+"    [unroll] for (int i = -2; i <= 2; i++) {\n"
+"        float2 q = uv + axis * i * p0.xy;\n"
+"        float dz = abs(ao_view_z(ao_depth(q)) - z);\n"
+"        float w = exp(-0.5 * i * i) * exp(-dz / max(0.001, z * 0.02));\n"
+"        sum += CocTex.SampleLevel(PtSmp, q, 0) * w;\n"
+"        wsum += w;\n"
+"    }\n"
+"    return sum / max(wsum, 1e-6);\n"
+"}\n"
+"float ao_blur_h_ps(float4 p : SV_Position) : SV_Target { return ao_blur(p, float2(1, 0)); }\n"
+"float ao_blur_v_ps(float4 p : SV_Position) : SV_Target { return ao_blur(p, float2(0, 1)); }\n"
+"float4 ao_composite_ps(float4 p : SV_Position) : SV_Target {\n"
+"    float2 uv = p.xy * p0.xy;\n"
+"    float4 c = SceneTex.SampleLevel(PtSmp, uv, 0);\n"
+"    return float4(c.rgb * CocTex.SampleLevel(PtSmp, uv, 0), c.a);\n"
+"}\n";
+
+typedef struct KgPostCb { float p0[4], p1[4], p2[4], p3[4]; } KgPostCb;
+
+static struct {
+    bool tried, ok;
+    ID3D11PixelShader *ps_focus, *ps_coc, *ps_dof, *ps_fxaa, *ps_sharp, *ps_ssaa;
+    bool ao_tried, ao_ok;
+    ID3D11PixelShader *ps_ao_ssao, *ps_ao_hbao, *ps_ao_hbaop, *ps_ao_gtao;
+    ID3D11PixelShader *ps_ao_blur_h, *ps_ao_blur_v, *ps_ao_comp;
+    ID3D11Buffer *cb;
+    ID3D11SamplerState *smp_lin, *smp_pt;
+    unsigned int w, h;                                      /* size of the scene copy and the blur map */
+    ID3D11Texture2D *copy, *coc;
+    ID3D11ShaderResourceView *copy_srv, *coc_srv;
+    ID3D11RenderTargetView *coc_rtv;
+    ID3D11Texture2D *ao[2];                                /* full-resolution visibility mask and blur scratch */
+    ID3D11ShaderResourceView *ao_srv[2];
+    ID3D11RenderTargetView *ao_rtv[2];
+    ID3D11Texture2D *focus[2];
+    ID3D11ShaderResourceView *focus_srv[2];
+    ID3D11RenderTargetView *focus_rtv[2];
+    unsigned int focus_cur;
+    ID3D11Texture2D *ss;                                    /* the resolved frame at the internal resolution */
+    ID3D11ShaderResourceView *ss_srv;
+    ID3D11RenderTargetView *ss_rtv;
+    unsigned int ss_w, ss_h;
+    /* the settings in force (pc_video.c), read when its generation changes */
+    unsigned int gen;
+    bool cfg;
+    int aa, dof, sharpen, ao_method, ao_quality;
+    bool scene_fx;                                          /* any effect that runs on the scene */
+    /* this frame */
+    unsigned int world;                                     /* depth-writing draws on the main target */
+    uint64_t ao_camera;                                     /* first world draw's queued camera, fixed for this frame */
+    bool ao_done;
+    bool done;
+    long long last_qpc;                                     /* last successful autofocus update, not merely a scene pass */
+    long long focus_trace_qpc;                              /* opt-in successful-observation trace, at most once per five seconds */
+    int depth_stats;                                        /* RECOMP_KGPU_DEPTH_STATS=n: depth percentiles every n frames */
+    char ao_dump[MAX_PATH], ao_scene_prefix[MAX_PATH];
+    uint64_t ao_dump_frame, ao_scene_frame;
+    bool ao_dump_done, ao_scene_done, post_trace, ao_skip_traced, focus_skipped;
+} s_post;
+
+static void kg_post_free(void)
+{
+    unsigned int i;
+    SAFE_RELEASE(s_post.copy_srv); SAFE_RELEASE(s_post.copy);
+    SAFE_RELEASE(s_post.coc_srv); SAFE_RELEASE(s_post.coc_rtv); SAFE_RELEASE(s_post.coc);
+    for (i = 0; i < 2; i++) { SAFE_RELEASE(s_post.ao_srv[i]); SAFE_RELEASE(s_post.ao_rtv[i]); SAFE_RELEASE(s_post.ao[i]); }
+    for (i = 0; i < 2; i++) { SAFE_RELEASE(s_post.focus_srv[i]); SAFE_RELEASE(s_post.focus_rtv[i]); SAFE_RELEASE(s_post.focus[i]); }
+    SAFE_RELEASE(s_post.ss_srv); SAFE_RELEASE(s_post.ss_rtv); SAFE_RELEASE(s_post.ss);
+    s_post.w = s_post.h = s_post.ss_w = s_post.ss_h = 0;
+    s_post.focus_cur = 0;
+}
+
+static ID3D11PixelShader *post_shader(const char *entry)
+{
+    ID3DBlob *b = compile_hlsl("", kgpu_hlsl_post, entry, "ps_5_0");
+    ID3D11PixelShader *ps = NULL;
+    if (!b) return NULL;
+    if (FAILED(ID3D11Device_CreatePixelShader(G.dev, ID3D10Blob_GetBufferPointer(b), ID3D10Blob_GetBufferSize(b), NULL, &ps))) ps = NULL;
+    ID3D10Blob_Release(b);
+    return ps;
+}
+
+static bool post_init(void)
+{
+    D3D11_SAMPLER_DESC sd;
+    if (s_post.tried) return s_post.ok;
+    s_post.tried = true;
+    s_post.ps_focus = post_shader("focus_ps"); s_post.ps_coc = post_shader("coc_ps"); s_post.ps_dof = post_shader("dof_ps");
+    s_post.ps_fxaa = post_shader("fxaa_ps"); s_post.ps_sharp = post_shader("sharpen_ps"); s_post.ps_ssaa = post_shader("ssaa_ps");
+    if (!s_post.ps_focus || !s_post.ps_coc || !s_post.ps_dof || !s_post.ps_fxaa || !s_post.ps_sharp || !s_post.ps_ssaa) {
+        fprintf(stderr, "[KGPU] picture effects unavailable: their shaders did not compile\n");
+        return false;
+    }
+    if (!make_buffer(sizeof(KgPostCb), D3D11_BIND_CONSTANT_BUFFER, &s_post.cb)) return false;
+    memset(&sd, 0, sizeof(sd));
+    sd.Filter = D3D11_FILTER_MIN_MAG_MIP_LINEAR; sd.AddressU = sd.AddressV = sd.AddressW = D3D11_TEXTURE_ADDRESS_CLAMP;
+    sd.MaxAnisotropy = 1; sd.ComparisonFunc = D3D11_COMPARISON_NEVER; sd.MaxLOD = D3D11_FLOAT32_MAX;
+    if (FAILED(ID3D11Device_CreateSamplerState(G.dev, &sd, &s_post.smp_lin))) return false;
+    sd.Filter = D3D11_FILTER_MIN_MAG_MIP_POINT;
+    if (FAILED(ID3D11Device_CreateSamplerState(G.dev, &sd, &s_post.smp_pt))) return false;
+    s_post.ok = true;
+    return true;
+}
+
+/* AO has independent shader availability, so a failed AO compile cannot disable the other picture effects. */
+static bool post_ao_init(void)
+{
+    if (s_post.ao_tried) return s_post.ao_ok;
+    s_post.ao_tried = true;
+    s_post.ps_ao_ssao = post_shader("ao_ssao_ps"); s_post.ps_ao_hbao = post_shader("ao_hbao_ps");
+    s_post.ps_ao_hbaop = post_shader("ao_hbaop_ps"); s_post.ps_ao_gtao = post_shader("ao_gtao_ps");
+    s_post.ps_ao_blur_h = post_shader("ao_blur_h_ps"); s_post.ps_ao_blur_v = post_shader("ao_blur_v_ps");
+    s_post.ps_ao_comp = post_shader("ao_composite_ps");
+    s_post.ao_ok = s_post.ps_ao_ssao && s_post.ps_ao_hbao && s_post.ps_ao_hbaop && s_post.ps_ao_gtao &&
+                   s_post.ps_ao_blur_h && s_post.ps_ao_blur_v && s_post.ps_ao_comp;
+    if (!s_post.ao_ok) fprintf(stderr, "[KGPU] ambient occlusion unavailable: its shaders did not compile\n");
+    return s_post.ao_ok;
+}
+
+static bool post_texture(unsigned int w, unsigned int h, DXGI_FORMAT fmt, ID3D11Texture2D **tex, ID3D11ShaderResourceView **srv,
+                         ID3D11RenderTargetView **rtv)
+{
+    D3D11_TEXTURE2D_DESC td;
+    memset(&td, 0, sizeof(td));
+    td.Width = w; td.Height = h; td.MipLevels = td.ArraySize = 1; td.Format = fmt; td.SampleDesc.Count = 1;
+    td.Usage = D3D11_USAGE_DEFAULT; td.BindFlags = D3D11_BIND_SHADER_RESOURCE | (rtv ? D3D11_BIND_RENDER_TARGET : 0);
+    if (FAILED(ID3D11Device_CreateTexture2D(G.dev, &td, NULL, tex))) return false;
+    if (FAILED(ID3D11Device_CreateShaderResourceView(G.dev, (ID3D11Resource *)*tex, NULL, srv))) return false;
+    if (rtv && FAILED(ID3D11Device_CreateRenderTargetView(G.dev, (ID3D11Resource *)*tex, NULL, rtv))) return false;
+    return true;
+}
+
+/* The scene copy and the blur map at the size of the target, and the focus pair. */
+static bool post_scene_resources(unsigned int w, unsigned int h)
+{
+    unsigned int i;
+    if (s_post.copy && s_post.w == w && s_post.h == h) return true;
+    kg_post_free();
+    if (!post_texture(w, h, DXGI_FORMAT_B8G8R8A8_UNORM, &s_post.copy, &s_post.copy_srv, NULL) ||
+        !post_texture(w, h, DXGI_FORMAT_R8_UNORM, &s_post.coc, &s_post.coc_srv, &s_post.coc_rtv)) { kg_post_free(); return false; }
+    for (i = 0; i < 2; i++) {
+        const FLOAT unset[4] = { -1.0f, -1.0f, -1.0f, -1.0f };
+        if (!post_texture(1, 1, DXGI_FORMAT_R32_FLOAT, &s_post.focus[i], &s_post.focus_srv[i], &s_post.focus_rtv[i])) { kg_post_free(); return false; }
+        ID3D11DeviceContext_ClearRenderTargetView(G.ctx, s_post.focus_rtv[i], unset);
+    }
+    s_post.w = w; s_post.h = h;
+    return true;
+}
+
+static bool post_ao_resources(unsigned int w, unsigned int h)
+{
+    unsigned int i;
+    if (s_post.ao[0] && s_post.ao[1]) return true; /* scene resource resize frees both */
+    for (i = 0; i < 2; i++) {
+        if (!post_texture(w, h, DXGI_FORMAT_R8_UNORM, &s_post.ao[i], &s_post.ao_srv[i], &s_post.ao_rtv[i])) {
+            unsigned int j;
+            for (j = 0; j < 2; j++) { SAFE_RELEASE(s_post.ao_srv[j]); SAFE_RELEASE(s_post.ao_rtv[j]); SAFE_RELEASE(s_post.ao[j]); }
+            return false;
+        }
+    }
+    return true;
+}
+
+static void post_cb(float w, float h, float taps, float radius, float focus_alpha, float depth_scale, float zone, float near_blur,
+                    float sharpen, float out_w, float out_h)
+{
+    D3D11_MAPPED_SUBRESOURCE ms;
+    KgPostCb c;
+    memset(&c, 0, sizeof(c));
+    c.p0[0] = 1.0f / w; c.p0[1] = 1.0f / h; c.p0[2] = w; c.p0[3] = h;
+    c.p1[0] = radius; c.p1[1] = taps; c.p1[2] = focus_alpha; c.p1[3] = depth_scale;
+    c.p2[0] = zone; c.p2[1] = near_blur; c.p2[2] = sharpen;
+    c.p3[0] = out_w; c.p3[1] = out_h; c.p3[2] = 1.0f / out_w; c.p3[3] = 1.0f / out_h;
+    if (SUCCEEDED(ID3D11DeviceContext_Map(G.ctx, (ID3D11Resource *)s_post.cb, 0, D3D11_MAP_WRITE_DISCARD, 0, &ms))) {
+        memcpy(ms.pData, &c, sizeof(c));
+        ID3D11DeviceContext_Unmap(G.ctx, (ID3D11Resource *)s_post.cb, 0);
+    }
+}
+
+/* Quality changes the sampling/radius; the mask stays at scene resolution and both blur passes keep five taps. */
+static bool post_ao_cb(unsigned int w, unsigned int h)
+{
+    static const float ssao_taps[4] = { 8, 12, 18, 24 }, ssao_radius[4] = { 5, 8, 11, 15 };
+    static const float hbao_dirs[4] = { 4, 6, 8, 10 }, hbao_radius[4] = { 8, 10, 13, 16 };
+    static const float hbaop_dirs[4] = { 6, 8, 10, 12 }, hbaop_radius[4] = { 10, 13, 17, 21 };
+    static const float gtao_dirs[4] = { 4, 6, 8, 8 }, gtao_radius[4] = { 9, 12, 16, 20 };
+    int q = s_post.ao_quality;
+    D3D11_MAPPED_SUBRESOURCE ms;
+    KgPostCb c;
+    if (q < PCV_AOQ_LOW || q > PCV_AOQ_ULTRA) q = PCV_AOQ_HIGH;
+    memset(&c, 0, sizeof(c));
+    c.p0[0] = 1.0f / w; c.p0[1] = 1.0f / h; c.p0[2] = (float)w; c.p0[3] = (float)h;
+    c.p1[0] = ssao_radius[q]; c.p1[1] = ssao_taps[q]; c.p1[2] = (float)(3 + q); c.p1[3] = 0.48f + 0.08f * q;
+    c.p2[0] = 0.025f; c.p2[1] = 0.30f; c.p2[2] = 0.32f;
+    if (s_post.ao_method == PCV_AO_HBAO) {
+        c.p1[0] = hbao_radius[q]; c.p1[1] = hbao_dirs[q]; c.p1[3] = 0.70f + 0.05f * q;
+    } else if (s_post.ao_method == PCV_AO_HBAO_PLUS) {
+        c.p1[0] = hbaop_radius[q]; c.p1[1] = hbaop_dirs[q]; c.p1[3] = 0.68f + 0.05f * q;
+    } else if (s_post.ao_method == PCV_AO_GTAO) {
+        c.p1[0] = gtao_radius[q]; c.p1[1] = gtao_dirs[q]; c.p1[3] = 1.80f;
+        c.p2[0] = 0.015f; c.p2[1] = 0.48f;
+    }
+    if (!kg_ao_camera(s_post.ao_camera, &c.p3[0], &c.p3[1])) return false;
+    if (SUCCEEDED(ID3D11DeviceContext_Map(G.ctx, (ID3D11Resource *)s_post.cb, 0, D3D11_MAP_WRITE_DISCARD, 0, &ms))) {
+        memcpy(ms.pData, &c, sizeof(c));
+        ID3D11DeviceContext_Unmap(G.ctx, (ID3D11Resource *)s_post.cb, 0);
+        return true;
+    }
+    return false;
+}
+
+/* One full-screen pass: `ps` reading up to four textures, into `rtv` of size w x h. */
+static void post_pass(ID3D11PixelShader *ps, ID3D11RenderTargetView *rtv, unsigned int w, unsigned int h,
+                      ID3D11ShaderResourceView *t0, ID3D11ShaderResourceView *t1, ID3D11ShaderResourceView *t2,
+                      ID3D11ShaderResourceView *t3)
+{
+    ID3D11ShaderResourceView *in[4], *none[4] = { NULL, NULL, NULL, NULL };
+    ID3D11SamplerState *smp[2];
+    in[0] = t0; in[1] = t1; in[2] = t2; in[3] = t3;
+    smp[0] = s_post.smp_lin; smp[1] = s_post.smp_pt;
+    ID3D11DeviceContext_OMSetRenderTargets(G.ctx, 1, &rtv, NULL);
+    fullscreen_pass_state(w, h);
+    ID3D11DeviceContext_OMSetDepthStencilState(G.ctx, G.ds_none, 0);
+    ID3D11DeviceContext_PSSetShader(G.ctx, ps, NULL, 0);
+    ID3D11DeviceContext_PSSetConstantBuffers(G.ctx, 0, 1, &s_post.cb);
+    ID3D11DeviceContext_PSSetSamplers(G.ctx, 0, 2, smp);
+    ID3D11DeviceContext_PSSetShaderResources(G.ctx, 0, 4, in);
+    ID3D11DeviceContext_Draw(G.ctx, 3, 0);
+    ID3D11DeviceContext_PSSetShaderResources(G.ctx, 0, 4, none);
+}
+
+/* The depth of field presets: taps, largest blur radius as a fraction of the picture height. */
+static void post_dof_preset(int level, float *taps, float *radius)
+{
+    *taps = level >= 3 ? 32.0f : level == 2 ? 20.0f : 12.0f;
+    *radius = level >= 3 ? 0.030f : level == 2 ? 0.020f : 0.012f;
+}
+
+static void kg_post_depth_stats(KGpuSurf *zs)
+{
+    static ID3D11Texture2D *stage;
+    static unsigned int sw, sh;
+    D3D11_MAPPED_SUBRESOURCE ms;
+    unsigned int x, y, n = 0, cap = zs->hw * zs->hh / 16 + 1, k;
+    float *v;
+    if (!stage || sw != zs->hw || sh != zs->hh) {
+        D3D11_TEXTURE2D_DESC td;
+        SAFE_RELEASE(stage);
+        memset(&td, 0, sizeof(td));
+        td.Width = zs->hw; td.Height = zs->hh; td.MipLevels = td.ArraySize = 1; td.Format = DXGI_FORMAT_R32G8X24_TYPELESS;
+        td.SampleDesc.Count = 1; td.Usage = D3D11_USAGE_STAGING; td.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        if (FAILED(ID3D11Device_CreateTexture2D(G.dev, &td, NULL, &stage))) return;
+        sw = zs->hw; sh = zs->hh;
+    }
+    ID3D11DeviceContext_CopyResource(G.ctx, (ID3D11Resource *)stage, (ID3D11Resource *)zs->tex);
+    if (FAILED(ID3D11DeviceContext_Map(G.ctx, (ID3D11Resource *)stage, 0, D3D11_MAP_READ, 0, &ms))) return;
+    v = (float *)malloc(cap * sizeof(float));
+    if (v) {
+        for (y = 0; y < zs->hh; y += 4)
+            for (x = 0; x < zs->hw; x += 4) {
+                const float d = *(const float *)((const uint8_t *)ms.pData + (size_t)y * ms.RowPitch + (size_t)x * 8);
+                if (n < cap && d < 0.99999f) v[n++] = d;
+            }
+        if (n) {
+            for (x = 1; x < n; x++) { float t = v[x]; for (k = x; k > 0 && v[k - 1] > t; k--) v[k] = v[k - 1]; v[k] = t; }
+            fprintf(stderr, "[KDEPTH] %u non-sky samples: min %.6f p5 %.6f p25 %.6f p50 %.6f p75 %.6f p95 %.6f max %.6f\n", n, (double)v[0],
+                    (double)v[n / 20], (double)v[n / 4], (double)v[n / 2], (double)v[n * 3 / 4], (double)v[n * 19 / 20], (double)v[n - 1]);
+        } else fprintf(stderr, "[KDEPTH] no non-sky samples\n");
+        free(v);
+    }
+    ID3D11DeviceContext_Unmap(G.ctx, (ID3D11Resource *)stage, 0);
+}
+
+/* Opt-in captures only read back one requested frame. No staging resources or CPU copies live between frames. */
+static uint8_t *post_ao_colour_capture(ID3D11Texture2D *tex, unsigned int w, unsigned int h, const char *path)
+{
+    KGpuSurf cs;
+    ID3D11Texture2D *stage = NULL;
+    D3D11_MAPPED_SUBRESOURCE ms;
+    uint8_t *pixels;
+    unsigned int y;
+    memset(&cs, 0, sizeof(cs));
+    cs.tex = tex; cs.hw = w; cs.hh = h;
+    if (!readback(&cs, &stage, &ms)) return NULL;
+    pixels = (uint8_t *)malloc((size_t)w * h * 4);
+    if (pixels) {
+        for (y = 0; y < h; y++) memcpy(pixels + (size_t)y * w * 4, (const uint8_t *)ms.pData + (size_t)y * ms.RowPitch, (size_t)w * 4);
+        if (path && *path) write_bmp(path, pixels, w, h, w * 4);
+    }
+    ID3D11DeviceContext_Unmap(G.ctx, (ID3D11Resource *)stage, 0);
+    SAFE_RELEASE(stage);
+    return pixels;
+}
+
+static void post_ao_mask_capture(unsigned int w, unsigned int h, uint64_t frame)
+{
+    D3D11_TEXTURE2D_DESC td;
+    D3D11_MAPPED_SUBRESOURCE ms;
+    ID3D11Texture2D *stage = NULL;
+    uint8_t *pixels;
+    unsigned int x, y, minv = 255, maxv = 0;
+    uint64_t sum = 0, nonwhite = 0;
+    memset(&td, 0, sizeof(td));
+    td.Width = w; td.Height = h; td.MipLevels = td.ArraySize = 1; td.Format = DXGI_FORMAT_R8_UNORM;
+    td.SampleDesc.Count = 1; td.Usage = D3D11_USAGE_STAGING; td.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    if (FAILED(ID3D11Device_CreateTexture2D(G.dev, &td, NULL, &stage))) return;
+    ID3D11DeviceContext_CopyResource(G.ctx, (ID3D11Resource *)stage, (ID3D11Resource *)s_post.ao[0]);
+    if (FAILED(ID3D11DeviceContext_Map(G.ctx, (ID3D11Resource *)stage, 0, D3D11_MAP_READ, 0, &ms))) { SAFE_RELEASE(stage); return; }
+    pixels = (uint8_t *)malloc((size_t)w * h * 4);
+    for (y = 0; y < h; y++) {
+        const uint8_t *row = (const uint8_t *)ms.pData + (size_t)y * ms.RowPitch;
+        for (x = 0; x < w; x++) {
+            unsigned int v = row[x];
+            if (v < minv) minv = v;
+            if (v > maxv) maxv = v;
+            sum += v; nonwhite += v < 255;
+            if (pixels) {
+                size_t k = ((size_t)y * w + x) * 4;
+                pixels[k] = pixels[k + 1] = pixels[k + 2] = (uint8_t)v; pixels[k + 3] = 255;
+            }
+        }
+    }
+    if (pixels) { write_bmp(s_post.ao_dump, pixels, w, h, w * 4); free(pixels); }
+    fprintf(stderr, "[KAO] frame %llu method %d quality %d mask min %u max %u mean %.4f occluded %llu/%llu\n",
+            (unsigned long long)frame, s_post.ao_method, s_post.ao_quality, minv, maxv, (double)sum / ((double)w * h),
+            (unsigned long long)nonwhite, (unsigned long long)((uint64_t)w * h));
+    ID3D11DeviceContext_Unmap(G.ctx, (ID3D11Resource *)stage, 0);
+    SAFE_RELEASE(stage);
+}
+
+static void post_ao_scene_compare(KGpuSurf *cs, const uint8_t *before, const char *after_path, uint64_t frame)
+{
+    uint8_t *after = post_ao_colour_capture(cs->tex, cs->hw, cs->hh, after_path);
+    uint64_t changed = 0, sum = 0;
+    unsigned int x, y, maxd = 0;
+    if (before && after) {
+        for (y = 0; y < cs->hh; y++) for (x = 0; x < cs->hw; x++) {
+            size_t k = ((size_t)y * cs->hw + x) * 4;
+            unsigned int ch, pixel_diff = 0;
+            for (ch = 0; ch < 3; ch++) {
+                unsigned int d = (unsigned int)abs((int)before[k + ch] - (int)after[k + ch]);
+                sum += d; if (d > maxd) maxd = d; pixel_diff |= d;
+            }
+            changed += pixel_diff != 0;
+        }
+        fprintf(stderr, "[KAO] frame %llu method %d quality %d same-frame changed pixels %llu abs-sum %llu max RGB difference %u\n",
+                (unsigned long long)frame, s_post.ao_method, s_post.ao_quality, (unsigned long long)changed, (unsigned long long)sum, maxd);
+    } else fprintf(stderr, "[KAO] frame %llu same-frame colour readback failed\n", (unsigned long long)frame);
+    free(after);
+}
+
+/* The effects on the finished scene in `cs`. AO and depth of field need its real depth buffer in `zs`. */
+static void kg_post_ao_scene(KGpuSurf *cs, KGpuSurf *zs)
+{
+    if (s_post.ao_done) return;
+    if (s_post.ao_method == PCV_AO_OFF || !cs || cs->bpp != 4 || cs->dxfmt != DXGI_FORMAT_B8G8R8A8_UNORM ||
+        !post_init() || !post_scene_resources(cs->hw, cs->hh)) return;
+    if (s_post.ao_method != PCV_AO_OFF && zs && zs->depth && zs->real && zs->srv && zs->hw == cs->hw && zs->hh == cs->hh && post_ao_init() &&
+        post_ao_resources(cs->hw, cs->hh) && post_ao_cb(cs->hw, cs->hh)) {
+        ID3D11PixelShader *ps = s_post.ps_ao_ssao;
+        const uint64_t frame = G.frames + 1;
+        bool scene_capture = !s_post.ao_scene_done && (s_post.post_trace || *s_post.ao_scene_prefix) && frame >= s_post.ao_scene_frame;
+        bool mask_capture = !s_post.ao_dump_done && *s_post.ao_dump && frame >= s_post.ao_dump_frame;
+        uint8_t *before = NULL;
+        char before_path[MAX_PATH + 16], after_path[MAX_PATH + 16];
+        /* A failed early attempt must allow a later draw with valid scene depth. */
+        s_post.ao_done = true;
+        before_path[0] = after_path[0] = 0;
+        if (s_post.ao_method == PCV_AO_HBAO) ps = s_post.ps_ao_hbao;
+        else if (s_post.ao_method == PCV_AO_HBAO_PLUS) ps = s_post.ps_ao_hbaop;
+        else if (s_post.ao_method == PCV_AO_GTAO) ps = s_post.ps_ao_gtao;
+        if (scene_capture || mask_capture) {
+            float hx = 0.0f, hy = 0.0f;
+            kg_ao_camera(s_post.ao_camera, &hx, &hy);
+            fprintf(stderr, "[KAO] frame %llu queued world camera halfX %.9g halfY %.9g\n", (unsigned long long)frame, (double)hx, (double)hy);
+        }
+        if (scene_capture) {
+            if (*s_post.ao_scene_prefix) {
+                snprintf(before_path, sizeof(before_path), "%s_before.bmp", s_post.ao_scene_prefix);
+                snprintf(after_path, sizeof(after_path), "%s_after.bmp", s_post.ao_scene_prefix);
+            }
+            before = post_ao_colour_capture(cs->tex, cs->hw, cs->hh, before_path);
+            s_post.ao_scene_done = true;
+        }
+        ID3D11DeviceContext_CopyResource(G.ctx, (ID3D11Resource *)s_post.copy, (ID3D11Resource *)cs->tex);
+        post_pass(ps, s_post.ao_rtv[0], cs->hw, cs->hh, NULL, NULL, zs->srv, NULL);
+        post_pass(s_post.ps_ao_blur_h, s_post.ao_rtv[1], cs->hw, cs->hh, NULL, s_post.ao_srv[0], zs->srv, NULL);
+        post_pass(s_post.ps_ao_blur_v, s_post.ao_rtv[0], cs->hw, cs->hh, NULL, s_post.ao_srv[1], zs->srv, NULL);
+        post_pass(s_post.ps_ao_comp, cs->rtv, cs->hw, cs->hh, s_post.copy_srv, s_post.ao_srv[0], NULL, NULL);
+        if (mask_capture) { s_post.ao_dump_done = true; post_ao_mask_capture(cs->hw, cs->hh, frame); }
+        if (scene_capture) { post_ao_scene_compare(cs, before, after_path, frame); free(before); }
+        kg_cache_invalidate();
+    }
+}
+
+static void kg_post_scene(KGpuSurf *cs, KGpuSurf *zs)
+{
+    float taps, radius, depth_scale = 140.0f;
+    long long now = qpc_now();
+    s_post.done = true;
+    if (!s_post.scene_fx || !cs || cs->bpp != 4 || cs->dxfmt != DXGI_FORMAT_B8G8R8A8_UNORM || !post_init() ||
+        !post_scene_resources(cs->hw, cs->hh)) return;
+    {
+        const char *e = getenv("RECOMP_KGPU_DOF_SCALE");
+        if (e && *e) depth_scale = (float)atof(e);
+    }
+    if (s_post.depth_stats > 0 && zs && (G.frames % (uint64_t)s_post.depth_stats) == 0) kg_post_depth_stats(zs);
+    if (s_post.ao_method != PCV_AO_OFF && !s_post.ao_camera && !s_post.ao_skip_traced &&
+        (s_post.post_trace || *s_post.ao_scene_prefix || *s_post.ao_dump)) {
+        s_post.ao_skip_traced = true;
+        fprintf(stderr, "[KAO] frame %llu ambient occlusion skipped: no valid queued world camera\n", (unsigned long long)(G.frames + 1));
+    }
+    kg_post_ao_scene(cs, zs);
+    if (s_post.dof && (!zs || !zs->depth || !zs->real || !zs->srv || zs->hw != cs->hw || zs->hh != cs->hh)) {
+        if (s_post.post_trace && !s_post.focus_skipped)
+            fprintf(stderr, "[KPOST] frame %llu autofocus skipped: depth present=%d depth=%d real=%d sampleable=%d size=%ux%u scene=%ux%u\n",
+                    (unsigned long long)(G.frames + 1), zs != NULL, zs ? (int)zs->depth : 0,
+                    zs ? (int)zs->real : 0, zs && zs->srv != NULL, zs ? zs->hw : 0, zs ? zs->hh : 0, cs->hw, cs->hh);
+        s_post.focus_skipped = true;
+    }
+    if (s_post.dof && zs && zs->depth && zs->real && zs->srv && zs->hw == cs->hw && zs->hh == cs->hh) {
+        const unsigned int next = s_post.focus_cur ^ 1u;
+        const double dt = s_post.last_qpc ? (double)(now - s_post.last_qpc) / (double)G.qpf : -1.0;
+        const float alpha = kg_post_focus_blend(dt);
+        if (s_post.post_trace && (s_post.focus_skipped || !s_post.last_qpc))
+            fprintf(stderr, "[KPOST] frame %llu autofocus acquired: observation gap %.9g alpha %.9g\n",
+                    (unsigned long long)(G.frames + 1), dt, (double)alpha);
+        s_post.focus_skipped = false;
+        post_dof_preset(s_post.dof, &taps, &radius);
+        ID3D11DeviceContext_CopyResource(G.ctx, (ID3D11Resource *)s_post.copy, (ID3D11Resource *)cs->tex);
+        post_cb((float)cs->hw, (float)cs->hh, taps, radius * (float)cs->hh, alpha, depth_scale, 0.002f, 0.0f, 0.0f, 1.0f, 1.0f);
+        post_pass(s_post.ps_focus, s_post.focus_rtv[next], 1, 1, NULL, NULL, zs->srv, s_post.focus_srv[s_post.focus_cur]);
+        s_post.focus_cur = next;
+        post_pass(s_post.ps_coc, s_post.coc_rtv, cs->hw, cs->hh, NULL, NULL, zs->srv, s_post.focus_srv[next]);
+        post_pass(s_post.ps_dof, cs->rtv, cs->hw, cs->hh, s_post.copy_srv, s_post.coc_srv, NULL, NULL);
+        /* A frame without usable depth did not observe a focus surface. Keep
+         * the last observation time so a long interruption actually triggers
+         * kg_post_focus_blend's immediate reacquisition when depth returns. */
+        s_post.last_qpc = now;
+        if (s_post.post_trace && (!s_post.focus_trace_qpc ||
+            (double)(now - s_post.focus_trace_qpc) / (double)G.qpf >= 5.0)) {
+            fprintf(stderr, "[KPOST] frame %llu autofocus updated: observation gap %.9g alpha %.9g depth=%ux%u scene=%ux%u\n",
+                    (unsigned long long)(G.frames + 1), dt, (double)alpha, zs->hw, zs->hh, cs->hw, cs->hh);
+            s_post.focus_trace_qpc = now;
+        }
+    }
+    if (s_post.aa == PCV_AA_FXAA) {
+        ID3D11DeviceContext_CopyResource(G.ctx, (ID3D11Resource *)s_post.copy, (ID3D11Resource *)cs->tex);
+        post_cb((float)cs->hw, (float)cs->hh, 0, 0, 0, 0, 0, 0, 0, 1.0f, 1.0f);
+        post_pass(s_post.ps_fxaa, cs->rtv, cs->hw, cs->hh, s_post.copy_srv, NULL, NULL, NULL);
+    }
+    if (s_post.sharpen) {
+        ID3D11DeviceContext_CopyResource(G.ctx, (ID3D11Resource *)s_post.copy, (ID3D11Resource *)cs->tex);
+        post_cb((float)cs->hw, (float)cs->hh, 0, 0, 0, 0, 0, 0, s_post.sharpen == 1 ? 0.25f : s_post.sharpen == 2 ? 0.55f : 0.9f, 1.0f, 1.0f);
+        post_pass(s_post.ps_sharp, cs->rtv, cs->hw, cs->hh, s_post.copy_srv, NULL, NULL, NULL);
+    }
+    kg_cache_invalidate();
+}
+
+/* The target of a draw is the main full-screen target (the world, then the HUD, are drawn to it). */
+static inline bool post_main_target(const KGpuSurf *cs)
+{
+    return cs && !cs->depth && cs->gw == 640 && cs->gh == 480;
+}
+
+/* Called for every draw once its surfaces are known, before its state is bound. */
+static void kg_post_note_draw(const KPixelState *ps, const KGpuSurf *cs, KGpuSurf *zs)
+{
+    if (!s_post.scene_fx || !post_main_target(cs)) return;
+    if (ps->depth_write && zs) {
+        if (!s_post.world) s_post.ao_camera = s_ao_draw_camera;
+        s_post.world++;
+        return;
+    }
+    if (kg_post_order_should_apply_ao_before_blend(s_post.world, ps->depth_write, ps->blend, &s_post.ao_done))
+        kg_post_ao_scene((KGpuSurf *)cs, zs);
+    /* The HUD and menus: depth test on, always passing, nothing written. */
+    if (!s_post.done && s_post.world >= 4 && ps->depth_test && ps->depth_func == 7 && !ps->depth_write)
+        kg_post_scene((KGpuSurf *)cs, zs);
+}
+
+/* A change in the settings: the sampler cache, the draw state and the passes follow. */
+static void kg_post_poll(void)
+{
+    const unsigned int gen = pc_video_generation();
+    unsigned int i;
+    PcVideoSettings v;
+    if (s_post.cfg && gen == s_post.gen) return;
+    pc_video_get(&v);
+    s_post.gen = gen;
+    if (!s_post.cfg) {
+        const char *e = getenv("RECOMP_KGPU_DEPTH_STATS");
+        s_post.depth_stats = e && *e ? atoi(e) : 0;
+        e = getenv("RECOMP_KGPU_AO_DUMP");
+        if (e && *e) snprintf(s_post.ao_dump, sizeof(s_post.ao_dump), "%s", e);
+        e = getenv("RECOMP_KGPU_AO_DUMP_FRAME");
+        s_post.ao_dump_frame = e && *e ? strtoull(e, NULL, 0) : 120;
+        e = getenv("RECOMP_KGPU_AO_SCENE_DUMP_PREFIX");
+        if (e && *e) snprintf(s_post.ao_scene_prefix, sizeof(s_post.ao_scene_prefix), "%s", e);
+        e = getenv("RECOMP_KGPU_AO_SCENE_DUMP_FRAME");
+        s_post.ao_scene_frame = e && *e ? strtoull(e, NULL, 0) : 120;
+        e = getenv("RECOMP_KGPU_POST_TRACE");
+        s_post.post_trace = e && *e && atoi(e) != 0;
+    }
+    if (s_post.cfg && !s_post.dof && v.dof && s_post.focus_rtv[0] && s_post.focus_rtv[1]) {
+        const FLOAT unset[4] = { -1.0f, -1.0f, -1.0f, -1.0f };
+        for (i = 0; i < 2; i++) ID3D11DeviceContext_ClearRenderTargetView(G.ctx, s_post.focus_rtv[i], unset);
+        s_post.focus_cur = 0;
+    }
+    s_post.cfg = true;
+    s_post.aa = (int)v.aa; s_post.dof = (int)v.dof; s_post.sharpen = (int)v.sharpen;
+    s_post.ao_method = (int)v.ao_method; s_post.ao_quality = (int)v.ao_quality;
+    s_post.scene_fx = s_post.ao_method != PCV_AO_OFF || s_post.aa == PCV_AA_FXAA || s_post.dof || s_post.sharpen || s_post.depth_stats > 0;
+    if ((int)v.af != s_af) {
+        unsigned int i;
+        s_af = (int)v.af;
+        for (i = 0; i < (unsigned int)G.nsampler && i < 256; i++) SAFE_RELEASE(G.sampler[i].ptr);
+        G.nsampler = 0;
+        kg_cache_invalidate();
+    }
+}
+
+/* Before a flip: a frame with no HUD gets its effects now; the frame state starts again afterwards. */
+static void kg_post_before_flip(const KelvinTarget *t, unsigned int color_format)
+{
+    kg_post_poll();
+    if (s_post.scene_fx && !s_post.done && s_post.world >= 4) {
+        KGpuSurf *cs = surf_get(t, false, color_format);
+        KGpuSurf *zs = t->zeta_va ? surf_find(t->zeta_va, true) : NULL;
+        if (post_main_target(cs)) kg_post_scene(cs, zs);
+    }
+}
+
+static void kg_post_after_flip(void)
+{
+    s_post.world = 0;
+    s_post.ao_camera = 0;
+    s_post.ao_done = false;
+    s_post.done = false;
+}
+
+/* The frame to present: the target itself, or under super-sampling that target resolved down to the internal resolution. */
+static ID3D11Texture2D *kg_post_flip_source(KGpuSurf *cs, unsigned int *w, unsigned int *h)
+{
+    if (G.out_w == 0 || G.out_h == 0 || (G.out_w == cs->hw && G.out_h == cs->hh) || cs->hw % G.out_w || cs->hh % G.out_h ||
+        !post_init()) { *w = cs->hw; *h = cs->hh; return cs->tex; }
+    if (!s_post.ss || s_post.ss_w != G.out_w || s_post.ss_h != G.out_h) {
+        SAFE_RELEASE(s_post.ss_srv); SAFE_RELEASE(s_post.ss_rtv); SAFE_RELEASE(s_post.ss);
+        if (!post_texture(G.out_w, G.out_h, DXGI_FORMAT_B8G8R8A8_UNORM, &s_post.ss, &s_post.ss_srv, &s_post.ss_rtv)) {
+            SAFE_RELEASE(s_post.ss_srv); SAFE_RELEASE(s_post.ss_rtv); SAFE_RELEASE(s_post.ss);
+            *w = cs->hw; *h = cs->hh; return cs->tex;
+        }
+        s_post.ss_w = G.out_w; s_post.ss_h = G.out_h;
+    }
+    post_cb((float)cs->hw, (float)cs->hh, 0, 0, 0, 0, 0, 0, 0, (float)G.out_w, (float)G.out_h);
+    post_pass(s_post.ps_ssaa, s_post.ss_rtv, G.out_w, G.out_h, cs->srv, NULL, NULL, NULL);
+    kg_cache_invalidate();
+    *w = G.out_w; *h = G.out_h;
+    return s_post.ss;
+}
diff --git a/src/nv2a/kelvin/kelvin_gpu_prof.inc b/src/nv2a/kelvin/kelvin_gpu_prof.inc
new file mode 100644
index 0000000..7c239d5
--- /dev/null
+++ b/src/nv2a/kelvin/kelvin_gpu_prof.inc
@@ -0,0 +1,156 @@
+/* Per-draw GPU profile (diagnostic), included by kelvin_gpu.c after kelvin_gpu_time.inc.
+ *
+ * RECOMP_KGPU_GPUPROF=1 (with RECOMP_KGPU_GPUTIME set to any value, the frame brackets are shared): a timestamp
+ * is written before every draw, clear and conversion pass; the time between two marks belongs to the pass that
+ * started at the first. Passes are grouped by what they are (target size, combiner program, blend and depth
+ * state, first texture size) and the periodic report lists the groups that cost the most GPU time per frame:
+ *   [KGPUPROF] 1.92 ms/frame, 3.0 draws/frame, 4.1 Mtris: T 3440x1440 ps 3A9F0012 blend 1 z 1/0 tex0 640x480 ... */
+#define KP_MAX_MARKS 6144
+#define KP_CATS 512
+
+typedef struct KpInfo {
+    uint64_t key;
+    uint32_t tw, th, tex0w, tex0h, icount, kind;
+    uint32_t psh;
+    uint8_t blend, ztest, zwrite, ntex;
+} KpInfo;
+
+typedef struct KpSlot {
+    ID3D11Query *mark[KP_MAX_MARKS];
+    ID3D11Query *endm[KP_MAX_MARKS];
+    KpInfo info[KP_MAX_MARKS];
+    unsigned int n;
+} KpSlot;
+
+typedef struct KpCat {
+    KpInfo info;
+    double ms;
+    uint64_t draws, tris;
+} KpCat;
+
+static KpSlot *s_kp[KT_RING];
+static KpCat s_kpc[KP_CATS];
+static int s_kp_mode = -1;
+static uint64_t s_kp_frames;
+
+static bool kp_on(void)
+{
+    if (s_kp_mode < 0) {
+        const char *e = getenv("RECOMP_KGPU_GPUPROF");
+        s_kp_mode = e && *e && *e != '0';
+    }
+    return s_kp_mode == 1 && kt_on() && s_kt_open;
+}
+
+/* Called right before a pass is issued. kind: 0 draw, 1 clear, 2 conversion pass. */
+static void kp_mark(const KpInfo *in)
+{
+    KtSlot *s;
+    KpSlot *k;
+    D3D11_QUERY_DESC qd;
+    unsigned int slot;
+    if (!kp_on()) return;
+    slot = s_kt_cur % KT_RING;
+    s = &s_kt[slot];
+    if (!s_kp[slot]) s_kp[slot] = (KpSlot *)calloc(1, sizeof(KpSlot));
+    k = s_kp[slot];
+    if (!k || k->n >= KP_MAX_MARKS - 1) return;
+    if (!k->mark[k->n]) {
+        qd.MiscFlags = 0;
+        qd.Query = D3D11_QUERY_TIMESTAMP;
+        if (FAILED(ID3D11Device_CreateQuery(G.dev, &qd, &k->mark[k->n]))) return;
+    }
+    ID3D11DeviceContext_End(G.ctx, (ID3D11Asynchronous *)k->mark[k->n]);
+    k->info[k->n] = *in;
+    k->n++;
+    (void)s;
+}
+
+/* Called right after the pass was issued: the time between the two marks is what the pass itself kept the GPU
+ * busy, without the gaps where the GPU waited for the CPU to submit the next one. */
+static void kp_done(void)
+{
+    KpSlot *k;
+    D3D11_QUERY_DESC qd;
+    unsigned int slot;
+    if (!kp_on()) return;
+    slot = s_kt_cur % KT_RING;
+    k = s_kp[slot];
+    if (!k || !k->n) return;
+    if (!k->endm[k->n - 1]) {
+        qd.MiscFlags = 0;
+        qd.Query = D3D11_QUERY_TIMESTAMP;
+        if (FAILED(ID3D11Device_CreateQuery(G.dev, &qd, &k->endm[k->n - 1]))) return;
+    }
+    ID3D11DeviceContext_End(G.ctx, (ID3D11Asynchronous *)k->endm[k->n - 1]);
+    k->info[k->n - 1].ntex |= 0;   /* keeps the layout; the end mark exists for index n - 1 */
+    k->info[k->n - 1].kind |= 0x100u;
+}
+
+static uint64_t kp_key(const KpInfo *i)
+{
+    uint64_t h = 1469598103934665603ULL;
+    uint32_t v[9];
+    unsigned int k;
+    v[0] = i->tw; v[1] = i->th; v[2] = i->tex0w; v[3] = i->tex0h; v[4] = i->kind; v[5] = i->psh;
+    v[6] = (uint32_t)i->blend | ((uint32_t)i->ztest << 8) | ((uint32_t)i->zwrite << 16) | ((uint32_t)i->ntex << 24);
+    v[7] = v[8] = 0;
+    for (k = 0; k < 7; k++) h = (h ^ v[k]) * 1099511628211ULL;
+    return h;
+}
+
+/* A finished frame: read its marks, charge each interval to the pass that began it. */
+static void kp_collect(unsigned int slot, UINT64 t_end, UINT64 freq)
+{
+    KpSlot *k = s_kp[slot];
+    unsigned int i;
+    if (!k || !k->n) return;
+    for (i = 0; i < k->n; i++) {
+        UINT64 t0 = 0, t1 = t_end;
+        double ms;
+        unsigned int c, probes;
+        uint64_t key;
+        if (ID3D11DeviceContext_GetData(G.ctx, (ID3D11Asynchronous *)k->mark[i], &t0, sizeof(t0), 0) != S_OK) continue;
+        if (k->info[i].kind & 0x100u) {
+            if (ID3D11DeviceContext_GetData(G.ctx, (ID3D11Asynchronous *)k->endm[i], &t1, sizeof(t1), 0) != S_OK) continue;
+            k->info[i].kind &= ~0x100u;
+        } else if (i + 1 < k->n && ID3D11DeviceContext_GetData(G.ctx, (ID3D11Asynchronous *)k->mark[i + 1], &t1, sizeof(t1), 0) != S_OK) continue;
+        ms = (double)(t1 - t0) * 1000.0 / (double)freq;
+        key = kp_key(&k->info[i]);
+        for (probes = 0, c = (unsigned int)(key % KP_CATS); probes < KP_CATS; probes++, c = (c + 1) % KP_CATS) {
+            if (!s_kpc[c].draws) { s_kpc[c].info = k->info[i]; s_kpc[c].info.key = key; break; }
+            if (s_kpc[c].info.key == key) break;
+        }
+        if (probes == KP_CATS) continue;
+        s_kpc[c].ms += ms;
+        s_kpc[c].draws++;
+        s_kpc[c].tris += k->info[i].icount / 3;
+    }
+    k->n = 0;
+    s_kp_frames++;
+}
+
+static void kp_report(void)
+{
+    unsigned int shown, i, j;
+    unsigned int order[KP_CATS], n = 0;
+    double total = 0.0;
+    if (!kp_on() && s_kp_mode != 1) return;
+    if (!s_kp_frames) return;
+    for (i = 0; i < KP_CATS; i++) if (s_kpc[i].draws) { order[n++] = i; total += s_kpc[i].ms; }
+    for (i = 0; i < n; i++)
+        for (j = i + 1; j < n; j++)
+            if (s_kpc[order[j]].ms > s_kpc[order[i]].ms) { unsigned int t = order[i]; order[i] = order[j]; order[j] = t; }
+    fprintf(stderr, "[KGPUPROF] %.2f ms/frame over %llu frames; top groups:\n", total / (double)s_kp_frames,
+            (unsigned long long)s_kp_frames);
+    for (shown = 0; shown < n && shown < 14; shown++) {
+        const KpCat *c = &s_kpc[order[shown]];
+        static const char *const kinds[] = { "draw", "clear", "pass" };
+        fprintf(stderr, "[KGPUPROF] %5.2f ms/frame %5.1f %s/frame %6.0f ktris/frame: T %ux%u ps %08X blend %u z %u/%u tex%u %ux%u\n",
+                c->ms / (double)s_kp_frames, (double)c->draws / (double)s_kp_frames, kinds[c->info.kind % 3],
+                (double)c->tris / (double)s_kp_frames / 1000.0, c->info.tw, c->info.th, c->info.psh, c->info.blend,
+                c->info.ztest, c->info.zwrite, c->info.ntex, c->info.tex0w, c->info.tex0h);
+    }
+    memset(s_kpc, 0, sizeof(s_kpc));
+    s_kp_frames = 0;
+}
diff --git a/src/nv2a/kelvin/kelvin_gpu_pss.inc b/src/nv2a/kelvin/kelvin_gpu_pss.inc
new file mode 100644
index 0000000..18fe4d2
--- /dev/null
+++ b/src/nv2a/kelvin/kelvin_gpu_pss.inc
@@ -0,0 +1,343 @@
+/* Specialised pixel shaders, included by kelvin_gpu.c after kelvin_gpu_vsh.inc.
+ *
+ * The ubershader in kelvin_gpu_hlsl.inc interprets the register combiners at run time: dynamic register
+ * indexing, a loop over stages, nested mapping chains, four texture samples whether used or not. Most of the GPU
+ * time of a frame went into that interpretation. Here the same program is written out for one combiner
+ * configuration: registers are plain locals, the stage loop is unrolled, every mapping and output selection is
+ * folded, and only the textures a draw uses are sampled. Everything that varies per draw but is not part of the
+ * configuration (stage constants, fog colour, texture size reciprocals, colour keys, alpha reference) stays in
+ * the PSConst constant buffer, so one shader serves every draw with the same configuration.
+ *
+ * Shaders compile on the worker threads shared with the vertex programs; until one is ready the draw uses the
+ * ubershader, so there are no stalls, only a slower first few frames. Compiled code is cached on disk next to the
+ * vertex programs (ps_<key>_<source hash>.bin). RECOMP_KGPU_PS_SPEC=0 turns this off.
+ *
+ * The generator mirrors the arithmetic and ordering of the ubershader statement by statement (every input of a
+ * stage is read before any output of it is written; the outputs are written rgb-ab, rgb-cd, rgb-mux, then the
+ * alpha ones); RECOMP_KGPU_COMPARE shows the difference to the CPU renderer for either path. */
+
+typedef struct KGpuPs {
+    bool used;
+    uint64_t key;
+    volatile LONG state;               /* 0 compiling, 1 ready, 2 unusable */
+    ID3D11PixelShader *ps;
+    char *source;
+} KGpuPs;
+
+#define KG_PS_MAX 2048
+static KGpuPs s_ps[KG_PS_MAX];
+static int s_ps_spec = -1;
+
+/* The ubershader's map3/map1 for a known modifier. `x` is the operand expression. */
+static void ps_map(char *out, size_t cap, const char *x, uint32_t mod)
+{
+    switch (mod & 0xE0u) {
+    case 0x00: snprintf(out, cap, "max(%s, 0.0)", x); break;
+    case 0x20: snprintf(out, cap, "(1.0 - clamp(%s, 0.0, 1.0))", x); break;
+    case 0x40: snprintf(out, cap, "(2.0 * max(%s, 0.0) - 1.0)", x); break;
+    case 0x60: snprintf(out, cap, "(-2.0 * max(%s, 0.0) + 1.0)", x); break;
+    case 0x80: snprintf(out, cap, "(max(%s, 0.0) - 0.5)", x); break;
+    case 0xA0: snprintf(out, cap, "(-max(%s, 0.0) + 0.5)", x); break;
+    case 0xE0: snprintf(out, cap, "(-%s)", x); break;
+    default:   snprintf(out, cap, "%s", x); break;
+    }
+}
+
+/* mapout: x scaled / biased by the output mapping bits (rfl & 0x38). */
+static void ps_mapout(char *out, size_t cap, const char *x, uint32_t m)
+{
+    switch (m & 0x38u) {
+    case 0x08: snprintf(out, cap, "(%s - 0.5)", x); break;
+    case 0x10: snprintf(out, cap, "(%s * 2.0)", x); break;
+    case 0x18: snprintf(out, cap, "((%s - 0.5) * 2.0)", x); break;
+    case 0x20: snprintf(out, cap, "(%s * 4.0)", x); break;
+    case 0x30: snprintf(out, cap, "(%s * 0.5)", x); break;
+    default:   snprintf(out, cap, "%s", x); break;
+    }
+}
+
+static bool ps_writable(uint32_t r) { return r == 4u || r == 5u || (r >= 8u && r <= 13u); }
+
+/* Input operand of a combiner: register `in & 15`, alpha replicated when bit 4 is set, mapped. */
+static void ps_input3(char *out, size_t cap, uint32_t in)
+{
+    char x[40];
+    snprintf(x, sizeof(x), "r%u.%s", in & 15u, (in & 0x10u) ? "aaa" : "rgb");
+    ps_map(out, cap, x, in & 0xE0u);
+}
+
+static void ps_input1(char *out, size_t cap, uint32_t in)
+{
+    char x[40];
+    snprintf(x, sizeof(x), "r%u.%s", in & 15u, (in & 0x10u) ? "a" : "b");
+    ps_map(out, cap, x, in & 0xE0u);
+}
+
+static uint64_t ps_key_of(const PSConst *c)
+{
+    uint64_t h = 1469598103934665603ULL;
+    uint32_t nst = c->gen[0] > 8 ? 8 : c->gen[0];
+    unsigned int i, k;
+#define PS_MIX(v) h = (h ^ (uint64_t)(uint32_t)(v)) * 1099511628211ULL
+    PS_MIX(nst); PS_MIX(c->gen[1]); PS_MIX(c->ofs[0]); PS_MIX(c->gen[3]);
+    for (k = 0; k < 4; k++) { PS_MIX(c->texmode[k]); PS_MIX(c->texflags[k]); PS_MIX(c->fin_abcd[k]); PS_MIX(c->fin_efg[k]); }
+    for (i = 0; i < nst; i++) {
+        for (k = 0; k < 4; k++) { PS_MIX(c->stage[i].rgb_in[k]); PS_MIX(c->stage[i].alpha_in[k]); }
+        PS_MIX(c->stage[i].outs[0]); PS_MIX(c->stage[i].outs[1]);
+    }
+#undef PS_MIX
+    return h ? h : 1;
+}
+
+/* The shader for one configuration. Returns a malloc'd string (the caller prepends the common declarations). */
+static char *ps_generate(const PSConst *c)
+{
+    StrBuf b = { NULL, 0, 0 };
+    uint32_t nst = c->gen[0] > 8 ? 8 : c->gen[0], fflags = c->fin_efg[3], func = c->gen[1];
+    unsigned int i, k;
+    char ex[96], ey[96], buf[256];
+    if (c->gen[3]) sb_add(&b, "//KG_FLAT\n");
+    sb_add(&b,
+        "Texture2D<float4> Tex0 : register(t0);\nTexture2D<float4> Tex1 : register(t1);\n"
+        "Texture2D<float4> Tex2 : register(t2);\nTexture2D<float4> Tex3 : register(t3);\n"
+        "SamplerState Smp0 : register(s0);\nSamplerState Smp1 : register(s1);\n"
+        "SamplerState Smp2 : register(s2);\nSamplerState Smp3 : register(s3);\n"
+        "float4 ps_main(VSOut v) : SV_Target {\n"
+        "    bool killed = false;\n");
+    /* textures: only the ones in use are sampled; the sample sits outside any branch so its derivatives are defined */
+    for (i = 0; i < 4; i++) {
+        uint32_t mode = c->texmode[i], fl = c->texflags[i];
+        const char *comp = i == 0 ? "x" : i == 1 ? "y" : i == 2 ? "z" : "w";
+        if (mode == 1u && (fl & 1u)) {
+            sb_add(&b,
+                "    float2 uv%u = float2(0.0, 0.0);\n"
+                "    if (v.t%u.w != 0.0) uv%u = v.t%u.xy / v.t%u.w;\n", i, i, i, i, i);
+            if (fl & 2u) sb_add(&b, "    uv%u *= texrcp[%u].xy;\n", i, i);
+            sb_add(&b,
+                "    float4 s%u = Tex%u.Sample(Smp%u, uv%u);\n"
+                "    float4 t%u = float4(0.0, 0.0, 0.0, 1.0);\n"
+                "    if (v.t%u.w != 0.0) {\n"
+                "        t%u = s%u;\n", i, i, i, i, i, i, i, i);
+            if (fl & 4u) sb_add(&b, "        if (t%u.a == 0.0) killed = true;\n", i);
+            if ((fl >> 4) & 3u) {
+                uint32_t ckm = (fl >> 4) & 3u;
+                sb_add(&b,
+                    "        {\n"
+                    "            uint4 q = (uint4)(saturate(t%u) * 255.0 + 0.5);\n"
+                    "            uint cc = (q.a << 24) | (q.r << 16) | (q.g << 8) | q.b;\n"
+                    "            if ((cc & ckeymask.%s) == (ckey.%s & ckeymask.%s)) {\n", i, comp, comp, comp);
+                if (ckm == 3u) sb_add(&b, "                killed = true;\n");
+                else if (ckm == 1u) sb_add(&b, "                t%u.a = 0.0;\n", i);
+                else sb_add(&b, "                t%u = float4(0.0, 0.0, 0.0, 0.0);\n", i);
+                sb_add(&b, "            }\n        }\n");
+            }
+            sb_add(&b, "    }\n");
+        } else {
+            sb_add(&b, "    float4 t%u = float4(0.0, 0.0, 0.0, 1.0);\n", i);
+        }
+    }
+    sb_add(&b, "    if (killed) discard;\n");
+    sb_add(&b,
+        "    float4 r0 = float4(0, 0, 0, 0);\n"
+        "    float4 r1 = stage[0].c0;\n"
+        "    float4 r2 = stage[0].c1;\n"
+        "    float4 r3 = float4(fogcolor.rgb, saturate(v.misc.x));\n"
+        "    float4 r4 = v.d0;\n"
+        "    float4 r5 = v.d1;\n"
+        "    float4 r6 = float4(0, 0, 0, 0);\n"
+        "    float4 r7 = float4(0, 0, 0, 0);\n"
+        "    float4 r8 = t0; float4 r9 = t1; float4 r10 = t2; float4 r11 = t3;\n"
+        "    float4 r12 = float4(0.0, 0.0, 0.0, %s);\n"
+        "    float4 r13 = float4(0, 0, 0, 0);\n"
+        "    float4 r14 = float4(0, 0, 0, 0);\n"
+        "    float4 r15 = float4(0, 0, 0, 0);\n", c->texmode[0] != 0u ? "t0.a" : "1.0");
+
+    for (i = 0; i < nst; i++) {
+        uint32_t ro = c->stage[i].outs[0], ao = c->stage[i].outs[1];
+        uint32_t rcd = ro & 15u, rab = (ro >> 4) & 15u, rmx = (ro >> 8) & 15u, rfl = ro >> 12, rmap = rfl & 0x38u;
+        uint32_t acd = ao & 15u, aab = (ao >> 4) & 15u, amx = (ao >> 8) & 15u, afl = ao >> 12, amap = afl & 0x38u;
+        sb_add(&b, "    {\n");
+        sb_add(&b, "        r1 = stage[%u].c0;\n", (fflags & 0x20u) ? i : 0u);
+        sb_add(&b, "        r2 = stage[%u].c1;\n", (fflags & 0x40u) ? i : 0u);
+        sb_add(&b, "        {\n            float3 a1 = %s;\n            float3 b1 = %s;\n            float3 sm = a1 + b1;\n",
+               (fflags & 4u) ? "1.0 - r5.rgb" : "r5.rgb", (fflags & 8u) ? "1.0 - r12.rgb" : "r12.rgb");
+        if (fflags & 2u) sb_add(&b, "            sm = clamp(sm, 0.0, 1.0);\n");
+        sb_add(&b, "            r14 = float4(sm, 0.0);\n        }\n");
+        for (k = 0; k < 4; k++) {
+            ps_input3(ex, sizeof(ex), c->stage[i].rgb_in[k]);
+            ps_input1(ey, sizeof(ey), c->stage[i].alpha_in[k]);
+            sb_add(&b, "        float3 ra%u = %s;\n        float aa%u = %s;\n", k, ex, k, ey);
+        }
+        sb_add(&b, "        float3 ab3 = %s;\n", (rfl & 2u) ? "dot(ra0, ra1).xxx" : "ra0 * ra1");
+        sb_add(&b, "        float3 cd3 = %s;\n", (rfl & 1u) ? "dot(ra2, ra3).xxx" : "ra2 * ra3");
+        if ((rfl & 4u) || (afl & 4u)) {
+            if (fflags & 0x10u) sb_add(&b, "        bool selr = r12.a >= 0.5;\n");
+            else sb_add(&b, "        bool selr = ((((uint)(r12.a * 255.0)) & 1u) == 1u);\n");
+        }
+        sb_add(&b, "        float3 mx3 = %s;\n", (rfl & 4u) ? "(selr ? cd3 : ab3)" : "(ab3 + cd3)");
+        ps_mapout(ex, sizeof(ex), "ab3", rmap); sb_add(&b, "        float3 rab3 = clamp(%s, -1.0, 1.0);\n", ex);
+        ps_mapout(ex, sizeof(ex), "cd3", rmap); sb_add(&b, "        float3 rcd3 = clamp(%s, -1.0, 1.0);\n", ex);
+        ps_mapout(ex, sizeof(ex), "mx3", rmap); sb_add(&b, "        float3 rmx3 = clamp(%s, -1.0, 1.0);\n", ex);
+        sb_add(&b, "        float ab1 = aa0 * aa1;\n        float cd1 = aa2 * aa3;\n");
+        sb_add(&b, "        float mx1 = %s;\n", (afl & 4u) ? "(selr ? cd1 : ab1)" : "(ab1 + cd1)");
+        ps_mapout(ex, sizeof(ex), "ab1", amap); sb_add(&b, "        float rab1 = clamp(%s, -1.0, 1.0);\n", ex);
+        ps_mapout(ex, sizeof(ex), "cd1", amap); sb_add(&b, "        float rcd1 = clamp(%s, -1.0, 1.0);\n", ex);
+        ps_mapout(ex, sizeof(ex), "mx1", amap); sb_add(&b, "        float rmx1 = clamp(%s, -1.0, 1.0);\n", ex);
+        if (ps_writable(rab)) {
+            sb_add(&b, "        r%u.rgb = rab3;\n", rab);
+            if (rfl & 0x80u) sb_add(&b, "        r%u.a = rab3.b;\n", rab);
+        }
+        if (ps_writable(rcd)) {
+            sb_add(&b, "        r%u.rgb = rcd3;\n", rcd);
+            if (rfl & 0x40u) sb_add(&b, "        r%u.a = rcd3.b;\n", rcd);
+        }
+        if (ps_writable(rmx)) sb_add(&b, "        r%u.rgb = rmx3;\n", rmx);
+        if (ps_writable(aab)) sb_add(&b, "        r%u.a = rab1;\n", aab);
+        if (ps_writable(acd)) sb_add(&b, "        r%u.a = rcd1;\n", acd);
+        if (ps_writable(amx)) sb_add(&b, "        r%u.a = rmx1;\n", amx);
+        sb_add(&b, "    }\n");
+        (void)buf;
+    }
+
+    sb_add(&b, "    float4 frag;\n");
+    if (fflags & 1u) {
+        uint32_t ine = c->fin_efg[0], inf = c->fin_efg[1], ing = c->fin_efg[2];
+        sb_add(&b, "    {\n        r1 = final_c0;\n        r2 = final_c1;\n");
+        sb_add(&b, "        {\n            float3 a1 = %s;\n            float3 b1 = %s;\n            float3 sm = a1 + b1;\n",
+               (fflags & 4u) ? "1.0 - r5.rgb" : "r5.rgb", (fflags & 8u) ? "1.0 - r12.rgb" : "r12.rgb");
+        if (fflags & 2u) sb_add(&b, "            sm = clamp(sm, 0.0, 1.0);\n");
+        sb_add(&b, "            r14 = float4(sm, 0.0);\n        }\n");
+        ps_input3(ex, sizeof(ex), ine); ps_input3(ey, sizeof(ey), inf);
+        sb_add(&b, "        float3 e3 = %s;\n        float3 f3 = %s;\n        r15 = float4(e3 * f3, 0.0);\n", ex, ey);
+        ps_input3(ex, sizeof(ex), c->fin_abcd[0]); sb_add(&b, "        float3 a3 = %s;\n", ex);
+        ps_input3(ex, sizeof(ex), c->fin_abcd[1]); sb_add(&b, "        float3 b3 = %s;\n", ex);
+        ps_input3(ex, sizeof(ex), c->fin_abcd[2]); sb_add(&b, "        float3 c3 = %s;\n", ex);
+        ps_input3(ex, sizeof(ex), c->fin_abcd[3]); sb_add(&b, "        float3 d3 = %s;\n", ex);
+        ps_input1(ex, sizeof(ex), ing); sb_add(&b, "        float g1 = %s;\n", ex);
+        sb_add(&b, "        frag = float4(d3 + c3 * (1.0 - a3) + b3 * a3, g1);\n    }\n");
+    } else {
+        sb_add(&b, "    frag = r12;\n");
+    }
+    if (func != 7u) {
+        static const char *const cmp[] = { NULL, "fa < ref", "fa == ref", "fa <= ref", "fa > ref", "fa != ref", "fa >= ref" };
+        if (func == 0u) {
+            sb_add(&b, "    discard;\n");
+        } else if (func < 7u) {
+            sb_add(&b, "    {\n        int fa = (int)floor(frag.a * 255.0 + 0.5);\n        int ref = (int)gen.z;\n"
+                       "        if (!(%s)) discard;\n    }\n", cmp[func]);
+        }
+    }
+    sb_add(&b, "    float4 o = saturate(frag);\n");
+    if (c->ofs[0] == 1u) sb_add(&b, "    o.a = 1.0;\n");
+    else if (c->ofs[0] == 2u) sb_add(&b, "    o.a = 0.0;\n");
+    sb_add(&b, "    return o;\n}\n");
+    return b.p;
+}
+
+static void ps_cache_path(char *out, size_t cap, const KGpuPs *e)
+{
+    const char *dir = getenv("RECOMP_KGPU_CACHE");
+    uint32_t sh = e->source ? fnv_bytes(e->source, strlen(e->source)) : 0;
+    snprintf(out, cap, "%s/ps_%08X%08X_%08X.bin", dir && *dir ? dir : "kgpu-cache",
+             (uint32_t)(e->key >> 32), (uint32_t)e->key, sh);
+}
+
+static bool ps_try_cache(KGpuPs *e)
+{
+    char path[512];
+    FILE *f;
+    void *buf;
+    long n;
+    ps_cache_path(path, sizeof(path), e);
+    f = fopen(path, "rb");
+    if (!f) return false;
+    fseek(f, 0, SEEK_END);
+    n = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    buf = n > 0 ? malloc((size_t)n) : NULL;
+    if (buf && fread(buf, 1, (size_t)n, f) == (size_t)n &&
+        SUCCEEDED(ID3D11Device_CreatePixelShader(G.dev, buf, (SIZE_T)n, NULL, &e->ps))) {
+        free(buf); fclose(f);
+        return true;
+    }
+    free(buf); fclose(f);
+    return false;
+}
+
+static void ps_compile(KGpuPs *e)
+{
+    ID3DBlob *code = NULL, *errors = NULL;
+    HRESULT hr;
+    size_t lc = strlen(kgpu_hlsl_common), ls = strlen(e->source);
+    char *full = (char *)malloc(lc + ls + 1);
+    long long t0 = qpc_now();
+    if (!full) { InterlockedExchange(&e->state, 2); return; }
+    if (!strncmp(e->source, "//KG_FLAT", 9)) {
+        /* the flat-shading variant: defined before the common declarations see it */
+        static const char flat_def[] = "#define KG_FLAT 1\n";
+        size_t lf = sizeof(flat_def) - 1;
+        char *g = (char *)realloc(full, lf + lc + ls + 1);
+        if (!g) { free(full); InterlockedExchange(&e->state, 2); return; }
+        full = g;
+        memcpy(full, flat_def, lf);
+        memcpy(full + lf, kgpu_hlsl_common, lc);
+        memcpy(full + lf + lc, e->source, ls + 1);
+        lc += lf;
+    } else {
+        memcpy(full, kgpu_hlsl_common, lc);
+        memcpy(full + lc, e->source, ls + 1);
+    }
+    hr = G.compile(full, lc + ls, "kgpu_ps", NULL, NULL, "ps_main", "ps_5_0", D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &code, &errors);
+    if (SUCCEEDED(hr) &&
+        SUCCEEDED(ID3D11Device_CreatePixelShader(G.dev, ID3D10Blob_GetBufferPointer(code), ID3D10Blob_GetBufferSize(code), NULL, &e->ps))) {
+        char path[512];
+        FILE *f;
+        CreateDirectoryA(getenv("RECOMP_KGPU_CACHE") && *getenv("RECOMP_KGPU_CACHE") ? getenv("RECOMP_KGPU_CACHE") : "kgpu-cache", NULL);
+        ps_cache_path(path, sizeof(path), e);
+        f = fopen(path, "wb");
+        if (f) { fwrite(ID3D10Blob_GetBufferPointer(code), 1, ID3D10Blob_GetBufferSize(code), f); fclose(f); }
+        InterlockedExchange(&e->state, 1);
+        fprintf(stderr, "[KGPU] pixel program %016llX compiled in %.0f ms\n", (unsigned long long)e->key,
+                (double)(qpc_now() - t0) * 1000.0 / (double)G.qpf);
+    } else {
+        fprintf(stderr, "[KGPU] pixel program %016llX did not compile: %s\n", (unsigned long long)e->key,
+                errors ? (const char *)ID3D10Blob_GetBufferPointer(errors) : "(no log)");
+        if (getenv("RECOMP_KGPU_SHADER_LOG")) fprintf(stderr, "%s\n", e->source);
+        InterlockedExchange(&e->state, 2);
+    }
+    if (errors) ID3D10Blob_Release(errors);
+    if (code) ID3D10Blob_Release(code);
+    free(full);
+}
+
+/* The specialised shader for this draw's configuration once it is ready, else NULL (use the ubershader). */
+static ID3D11PixelShader *ps_lookup(const PSConst *c)
+{
+    uint64_t key;
+    unsigned int i, slot;
+    KGpuPs *e = NULL;
+    if (s_ps_spec < 0) {
+        const char *env = getenv("RECOMP_KGPU_PS_SPEC");
+        s_ps_spec = !(env && *env && *env == '0');
+    }
+    if (!s_ps_spec) return NULL;
+    key = ps_key_of(c);
+    slot = (unsigned int)(key % KG_PS_MAX);
+    for (i = 0; i < KG_PS_MAX; i++, slot = (slot + 1) % KG_PS_MAX) {
+        KGpuPs *q = &s_ps[slot];
+        if (!q->used) { e = q; break; }
+        if (q->key == key) return q->state == 1 ? q->ps : NULL;
+    }
+    if (!e) return NULL;
+    e->used = true; e->key = key; e->state = 0;
+    e->source = ps_generate(c);
+    if (!e->source) { e->state = 2; return NULL; }
+    if (ps_try_cache(e)) {
+        e->state = 1;
+        return e->ps;
+    }
+    kg_job_post(1, e);
+    return NULL;
+}
+
+static void kg_job_ps(void *p) { ps_compile((KGpuPs *)p); }
diff --git a/src/nv2a/kelvin/kelvin_gpu_slow.inc b/src/nv2a/kelvin/kelvin_gpu_slow.inc
new file mode 100644
index 0000000..5262db0
--- /dev/null
+++ b/src/nv2a/kelvin/kelvin_gpu_slow.inc
@@ -0,0 +1,181 @@
+/* Slow-flip sampler (diagnostic), included by kelvin_gpu.c after the sampling profiler.
+ *
+ * RECOMP_KGPU_SLOW=ms[,start_seconds]: sample the instruction pointer of the busiest threads (cumulative
+ * CPU time, at most six) every millisecond, and for each flip interval longer than `ms` print what each
+ * of them was doing in it: "[KSLOW] flip N 87.3 ms, tid T (80 samples): sub_0012ABCD 60% ...". Finds the
+ * cause of single slow frames, which an aggregate profile averages away. Needs the PDB beside the .exe. */
+#define SLOW_UP 6
+typedef struct SlowSample { long long t; uint64_t rip, up[SLOW_UP]; unsigned int th; } SlowSample;
+#define SLOW_RING 65536
+#define SLOW_MAX_THREADS 8
+
+static void slow_name(uint64_t addr, char *out, size_t cap, int with_line)
+{
+    char buf[sizeof(SYMBOL_INFO) + 128];
+    SYMBOL_INFO *si = (SYMBOL_INFO *)buf;
+    DWORD64 disp = 0;
+    memset(buf, 0, sizeof(buf));
+    si->SizeOfStruct = sizeof(SYMBOL_INFO);
+    si->MaxNameLen = 120;
+    if (SymFromAddr(GetCurrentProcess(), addr, &disp, si)) {
+        IMAGEHLP_LINE64 line;
+        DWORD ldisp = 0;
+        memset(&line, 0, sizeof(line));
+        line.SizeOfStruct = sizeof(line);
+        if (with_line && SymGetLineFromAddr64(GetCurrentProcess(), addr, &ldisp, &line)) snprintf(out, cap, "%s@%lu", si->Name, (unsigned long)line.LineNumber);
+        else snprintf(out, cap, "%s", si->Name);
+    } else snprintf(out, cap, "?%llX", (unsigned long long)(addr >> 12));
+}
+
+static void slow_report(const SlowSample *ring, uint64_t wrote, const DWORD *tids, long long t0, long long t1, uint64_t flip, double ms)
+{
+    unsigned int th;
+    uint64_t first = wrote > SLOW_RING ? wrote - SLOW_RING : 0, i;
+    for (th = 0; th < SLOW_MAX_THREADS; th++) {
+        typedef struct { char name[96]; unsigned int n; } Agg;
+        Agg agg[192];
+        unsigned int na = 0, total = 0, k;
+        for (i = first; i < wrote; i++) {
+            const SlowSample *x = &ring[i % SLOW_RING];
+            char nm[128], a[48], u[SLOW_UP][40];
+            unsigned int j, nu = 0, chosen = 0;
+            size_t len;
+            if (x->th != th || x->t <= t0 || x->t > t1) continue;
+            total++;
+            slow_name(x->rip, a, sizeof(a), 1);
+            for (j = 0; j < SLOW_UP && x->up[j]; j++) slow_name(x->up[j], u[nu++], sizeof(u[0]), 0);
+            len = (size_t)snprintf(nm, sizeof(nm), "%s", a);
+            /* the first two guest functions (sub_...) on the stack, else the first two named frames */
+            for (j = 0; j < nu && chosen < 2; j++)
+                if (!strncmp(u[j], "sub_", 4)) { len += (size_t)snprintf(nm + len, sizeof(nm) - len, "<%s", u[j]); chosen++; }
+            for (j = 0; j < nu && chosen < 2 && !chosen; j++)
+                if (u[j][0] != '?') { len += (size_t)snprintf(nm + len, sizeof(nm) - len, "<%s", u[j]); chosen++; }
+            (void)len;
+            for (j = 0; j < na; j++) if (!strcmp(agg[j].name, nm)) break;
+            if (j == na && na < 192) { snprintf(agg[na].name, sizeof(agg[na].name), "%s", nm); agg[na].n = 0; na++; }
+            if (j < na) agg[j].n++;
+        }
+        if (!total) continue;
+        for (k = 0; k < na; k++) {
+            unsigned int j;
+            for (j = k + 1; j < na; j++) if (agg[j].n > agg[k].n) { Agg tmp = agg[k]; agg[k] = agg[j]; agg[j] = tmp; }
+        }
+        fprintf(stderr, "[KSLOW] flip %llu %.1f ms, tid %lu (%u samples):", (unsigned long long)flip, ms, (unsigned long)tids[th], total);
+        for (k = 0; k < na && k < 10; k++) fprintf(stderr, " %s %.0f%%", agg[k].name, 100.0 * agg[k].n / (double)total);
+        fprintf(stderr, "\n");
+    }
+}
+
+/* The busiest threads of the process by cumulative CPU time. */
+static unsigned int slow_pick(DWORD self, DWORD pid, DWORD *tids, HANDLE *hs)
+{
+    HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+    THREADENTRY32 te;
+    struct { DWORD tid; ULONGLONG cpu; } best[SLOW_MAX_THREADS];
+    static struct { DWORD tid; ULONGLONG cpu; } seen[1024];      /* CPU time at the previous pick, per thread */
+    static unsigned int nseen;
+    unsigned int nb = 0, nth = 0, i;
+    te.dwSize = sizeof(te);
+    if (snap != INVALID_HANDLE_VALUE && Thread32First(snap, &te)) {
+        do {
+            HANDLE h;
+            FILETIME c, e, k, u;
+            if (te.th32OwnerProcessID != pid || te.th32ThreadID == self) continue;
+            h = OpenThread(THREAD_QUERY_LIMITED_INFORMATION, FALSE, te.th32ThreadID);
+            if (!h) continue;
+            if (GetThreadTimes(h, &c, &e, &k, &u)) {
+                ULONGLONG total = (((ULONGLONG)k.dwHighDateTime << 32) | k.dwLowDateTime) + (((ULONGLONG)u.dwHighDateTime << 32) | u.dwLowDateTime);
+                ULONGLONG cpu = total;                    /* ranked by what it used since the last pick */
+                unsigned int j, q;
+                for (q = 0; q < nseen && seen[q].tid != te.th32ThreadID; q++) ;
+                if (q < nseen) { cpu = total >= seen[q].cpu ? total - seen[q].cpu : 0; seen[q].cpu = total; }
+                else if (nseen < 1024) { seen[nseen].tid = te.th32ThreadID; seen[nseen].cpu = total; nseen++; cpu = 0; }
+                j = nb < SLOW_MAX_THREADS ? nb : SLOW_MAX_THREADS - 1;
+                if (nb < SLOW_MAX_THREADS || cpu > best[j].cpu) {
+                    best[j].tid = te.th32ThreadID; best[j].cpu = cpu;
+                    if (nb < SLOW_MAX_THREADS) nb++;
+                    while (j > 0 && best[j].cpu > best[j - 1].cpu) {
+                        DWORD tt = best[j].tid; ULONGLONG cc = best[j].cpu;
+                        best[j].tid = best[j - 1].tid; best[j].cpu = best[j - 1].cpu;
+                        best[j - 1].tid = tt; best[j - 1].cpu = cc;
+                        j--;
+                    }
+                }
+            }
+            CloseHandle(h);
+        } while (Thread32Next(snap, &te));
+    }
+    if (snap != INVALID_HANDLE_VALUE) CloseHandle(snap);
+    for (i = 0; i < SLOW_MAX_THREADS; i++) if (hs[i]) { CloseHandle(hs[i]); hs[i] = NULL; }
+    for (i = 0; i < nb; i++) {
+        HANDLE h = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, best[i].tid);
+        if (h) { hs[nth] = h; tids[nth++] = best[i].tid; }
+    }
+    return nth;
+}
+
+static DWORD WINAPI slow_thread(LPVOID arg)
+{
+    unsigned int thr = ((unsigned int)(uintptr_t)arg) & 0xFFFF, start = ((unsigned int)(uintptr_t)arg) >> 16;
+    SlowSample *ring = (SlowSample *)calloc(SLOW_RING, sizeof(SlowSample));
+    DWORD tids[SLOW_MAX_THREADS] = { 0 };
+    HANDLE hs[SLOW_MAX_THREADS] = { 0 };
+    unsigned int nth = 0;
+    uint64_t wrote = 0;
+    long long last_pick = 0;
+    LONG64 seen;
+    DWORD pid = GetCurrentProcessId(), self = GetCurrentThreadId();
+    uint64_t mod_lo = (uint64_t)(uintptr_t)GetModuleHandleA(NULL), mod_hi;
+    if (!ring) return 0;
+    {
+        const IMAGE_DOS_HEADER *dos = (const IMAGE_DOS_HEADER *)(uintptr_t)mod_lo;
+        const IMAGE_NT_HEADERS *nt = (const IMAGE_NT_HEADERS *)((const uint8_t *)dos + dos->e_lfanew);
+        mod_hi = mod_lo + nt->OptionalHeader.SizeOfImage;
+    }
+    Sleep(start * 1000);
+    seen = s_flip_count;
+    for (;;) {
+        long long now = qpc_now();
+        unsigned int i;
+        LONG64 fc;
+        if (now - last_pick > (long long)G.qpf / 4) {
+            last_pick = now;
+            nth = slow_pick(self, pid, tids, hs);
+        }
+        for (i = 0; i < nth; i++) {
+            CONTEXT ctx;
+            ctx.ContextFlags = CONTEXT_CONTROL;
+            if (SuspendThread(hs[i]) == (DWORD)-1) continue;
+            if (GetThreadContext(hs[i], &ctx)) {
+                SlowSample *x = &ring[wrote % SLOW_RING];
+                uint64_t stack[512];
+                SIZE_T got = 0;
+                unsigned int k, found = 0;
+                x->t = qpc_now(); x->rip = ctx.Rip; x->th = i;
+                memset(x->up, 0, sizeof(x->up));
+                /* the first few addresses inside the executable found on the stack (return addresses, mostly) */
+                if (ReadProcessMemory(GetCurrentProcess(), (LPCVOID)ctx.Rsp, stack, sizeof(stack), &got)) {
+                    for (k = 0; k < got / 8 && found < SLOW_UP; k++)
+                        if (stack[k] >= mod_lo && stack[k] < mod_hi) x->up[found++] = stack[k];
+                }
+                wrote++;
+            }
+            ResumeThread(hs[i]);
+        }
+        fc = s_flip_count;
+        while (seen < fc) {
+            long long t0, t1;
+            seen++;
+            if (fc - seen >= 1000) continue;
+            t0 = s_flip_q[(seen - 1) & 1023]; t1 = s_flip_q[seen & 1023];
+            if (t0 && t1 > t0) {
+                double ms = (double)(t1 - t0) * 1000.0 / (double)G.qpf;
+                if (ms > (double)thr) slow_report(ring, wrote, tids, t0, t1, (uint64_t)seen, ms);
+            }
+        }
+        Sleep(1);
+    }
+    return 0;
+}
+
+void kgpu_symbol_name(uint64_t addr, char *out, size_t cap) { slow_name(addr, out, cap, 0); }
diff --git a/src/nv2a/kelvin/kelvin_gpu_time.inc b/src/nv2a/kelvin/kelvin_gpu_time.inc
new file mode 100644
index 0000000..2bcd677
--- /dev/null
+++ b/src/nv2a/kelvin/kelvin_gpu_time.inc
@@ -0,0 +1,106 @@
+/* GPU frame timing (diagnostic), included by kelvin_gpu.c.
+ *
+ * RECOMP_KGPU_GPUTIME=ms: bracket each frame's GPU work (from its first draw or clear to its flip) with
+ * D3D11 timestamp queries, collect them a few frames later without stalling, add the average and the
+ * worst frame to the periodic [KGPU] report and print every frame that took longer than `ms`:
+ *   [KGPU] GPU frame 8731: 31.2 ms (1920 draws)
+ * Tells a GPU-bound hitch (the CPU then waits inside Map/Unmap, which the "upload" figure shows) from a
+ * CPU-bound one. Unset, every hook is one test of a flag. */
+#define KT_RING 8
+typedef struct KtSlot {
+    ID3D11Query *disjoint, *begin, *end;
+    bool pending;
+    uint64_t frame;
+    unsigned int draws;
+} KtSlot;
+static KtSlot s_kt[KT_RING];
+static int s_kt_mode = -1;                 /* -1 unread, 0 off, 1 on */
+static double s_kt_thresh_ms;
+static bool s_kt_open;
+static unsigned int s_kt_cur, s_kt_draws;
+static double s_kt_sum_ms, s_kt_max_ms;
+static uint64_t s_kt_frames;
+
+static bool kt_on(void)
+{
+    if (s_kt_mode < 0) {
+        const char *e = getenv("RECOMP_KGPU_GPUTIME");
+        s_kt_mode = e && *e && *e != '0';
+        s_kt_thresh_ms = e && *e ? atof(e) : 0.0;
+    }
+    return s_kt_mode == 1 && G.ok;
+}
+
+static void kt_begin(void)
+{
+    KtSlot *s;
+    D3D11_QUERY_DESC qd;
+    if (!kt_on()) return;
+    if (s_kt_open) { s_kt_draws++; return; }
+    s = &s_kt[s_kt_cur % KT_RING];
+    if (s->pending) return;                 /* the ring is full: skip this frame's measurement */
+    if (!s->disjoint) {
+        qd.MiscFlags = 0;
+        qd.Query = D3D11_QUERY_TIMESTAMP_DISJOINT;
+        if (FAILED(ID3D11Device_CreateQuery(G.dev, &qd, &s->disjoint))) { s_kt_mode = 0; return; }
+        qd.Query = D3D11_QUERY_TIMESTAMP;
+        if (FAILED(ID3D11Device_CreateQuery(G.dev, &qd, &s->begin)) || FAILED(ID3D11Device_CreateQuery(G.dev, &qd, &s->end))) { s_kt_mode = 0; return; }
+    }
+    ID3D11DeviceContext_Begin(G.ctx, (ID3D11Asynchronous *)s->disjoint);
+    ID3D11DeviceContext_End(G.ctx, (ID3D11Asynchronous *)s->begin);
+    s_kt_open = true;
+    s_kt_draws = 1;
+}
+
+static void kt_end(uint64_t frame)
+{
+    KtSlot *s;
+    if (!kt_on() || !s_kt_open) return;
+    s = &s_kt[s_kt_cur % KT_RING];
+    ID3D11DeviceContext_End(G.ctx, (ID3D11Asynchronous *)s->end);
+    ID3D11DeviceContext_End(G.ctx, (ID3D11Asynchronous *)s->disjoint);
+    s->pending = true;
+    s->frame = frame;
+    s->draws = s_kt_draws;
+    s_kt_cur++;
+    s_kt_open = false;
+}
+
+static void kp_collect(unsigned int slot, UINT64 t_end, UINT64 freq);
+static void kp_report(void);
+
+/* Collect finished frames, oldest first, without waiting. */
+static void kt_poll(void)
+{
+    unsigned int i;
+    if (!kt_on()) return;
+    for (i = 0; i < KT_RING; i++) {
+        KtSlot *s = &s_kt[(s_kt_cur + i) % KT_RING];      /* oldest first */
+        D3D11_QUERY_DATA_TIMESTAMP_DISJOINT dj;
+        UINT64 t0, t1;
+        if (!s->pending) continue;
+        if (ID3D11DeviceContext_GetData(G.ctx, (ID3D11Asynchronous *)s->disjoint, &dj, sizeof(dj), D3D11_ASYNC_GETDATA_DONOTFLUSH) != S_OK) continue;
+        if (ID3D11DeviceContext_GetData(G.ctx, (ID3D11Asynchronous *)s->begin, &t0, sizeof(t0), D3D11_ASYNC_GETDATA_DONOTFLUSH) != S_OK) continue;
+        if (ID3D11DeviceContext_GetData(G.ctx, (ID3D11Asynchronous *)s->end, &t1, sizeof(t1), D3D11_ASYNC_GETDATA_DONOTFLUSH) != S_OK) continue;
+        s->pending = false;
+        if (!dj.Disjoint && dj.Frequency) kp_collect((s_kt_cur + i) % KT_RING, t1, dj.Frequency);
+        if (!dj.Disjoint && dj.Frequency) {
+            double ms = (double)(t1 - t0) * 1000.0 / (double)dj.Frequency;
+            s_kt_sum_ms += ms;
+            if (ms > s_kt_max_ms) s_kt_max_ms = ms;
+            s_kt_frames++;
+            if (s_kt_thresh_ms > 1.0 && ms > s_kt_thresh_ms)
+                fprintf(stderr, "[KGPU] GPU frame %llu: %.1f ms (%u draws)\n", (unsigned long long)s->frame, ms, s->draws);
+        }
+    }
+}
+
+static void kt_report(void)
+{
+    if (!kt_on() || !s_kt_frames) return;
+    fprintf(stderr, "[KGPU] GPU time per frame: avg %.2f ms, worst %.2f ms over %llu frames\n",
+            s_kt_sum_ms / (double)s_kt_frames, s_kt_max_ms, (unsigned long long)s_kt_frames);
+    s_kt_sum_ms = s_kt_max_ms = 0.0;
+    s_kt_frames = 0;
+    kp_report();
+}
diff --git a/src/nv2a/kelvin/kelvin_gpu_vsh.inc b/src/nv2a/kelvin/kelvin_gpu_vsh.inc
new file mode 100644
index 0000000..b96f4ee
--- /dev/null
+++ b/src/nv2a/kelvin/kelvin_gpu_vsh.inc
@@ -0,0 +1,529 @@
+/* The GPU vertex path of the Kelvin D3D11 backend (included by kelvin_gpu.c).
+ *
+ * A transform program (nv2a_vsh_cpu's parsed steps, straight-line code) becomes
+ * an HLSL vertex shader that also fetches and decodes the draw's attributes from
+ * a raw copy of the guest vertex data. Semantics follow nv2a_vsh_cpu.c and the
+ * epilogue of kelvin_vsh.c (1/16 pixel position snapping, w clamping, fog factor,
+ * colour clamping), so the shaded vertices equal the CPU stage's.
+ */
+#include "nv2a_vsh_cpu/nv2a_vsh_disassembler.h"
+
+static const char kgpu_vsh_head[] =
+"struct VSOut {\n"
+"    float4 pos : SV_Position;\n"
+"    float4 d0  : TEXCOORD0;\n"
+"    float4 d1  : TEXCOORD1;\n"
+"    float4 misc: TEXCOORD2;\n"
+"    float4 t0  : TEXCOORD3;\n"
+"    float4 t1  : TEXCOORD4;\n"
+"    float4 t2  : TEXCOORD5;\n"
+"    float4 t3  : TEXCOORD6;\n"
+"};\n"
+"cbuffer VSG : register(b1) {\n"
+"    float4 g_scale;\n"       /* x 2/guestW, y 2/guestH, z 1/zmax, w 2^64 */
+"    float4 g_fog;\n"         /* x fog param 0, y fog param 1 */
+"    uint4  g_flags;\n"       /* x fog enable, y fog mode, z specular enable, w ignore specular alpha */
+"    float4 g_vm;\n"          /* x viewmodel scale about the viewport centre c[-37] */
+"};\n"
+"cbuffer VCB : register(b2) { float4 C[192]; };\n"
+"cbuffer ACB : register(b3) { uint4 adesc[16]; float4 inl[16]; };\n"
+"Buffer<uint> VAB : register(t9);\n"
+"\n"
+"uint LoadU32(uint addr) {\n"
+"    uint a0 = addr & ~3u;\n"
+"    uint sh = (addr & 3u) * 8u;\n"
+"    uint lo = VAB[a0 >> 2];\n"
+"    if (sh == 0u) return lo;\n"
+"    uint hi = VAB[(a0 >> 2) + 1u];\n"
+"    return (lo >> sh) | (hi << (32u - sh));\n"
+"}\n"
+"uint LoadU8(uint addr) { return (VAB[addr >> 2] >> ((addr & 3u) * 8u)) & 0xFFu; }\n"
+"int LoadS16(uint addr) { return (int)(LoadU32(addr) << 16) >> 16; }\n"
+"float4 FetchAttr(uint a, uint e) {\n"
+"    uint4 d = adesc[a];\n"
+"    float4 r = float4(0.0, 0.0, 0.0, 1.0);\n"
+"    if (d.z == 0u) return inl[a];\n"
+"    uint addr = d.x + e * d.y;\n"
+"    if (d.z == 1u) {\n"
+"        uint w = LoadU32(addr);\n"
+"        r = float4((float)((w >> 16) & 255u), (float)((w >> 8) & 255u), (float)(w & 255u), (float)(w >> 24)) / 255.0;\n"
+"    } else if (d.z == 2u) {\n"
+"        for (uint i = 0; i < 4u; i++) if (i < d.w) r[i] = (float)LoadU8(addr + i) / 255.0;\n"
+"    } else if (d.z == 3u) {\n"
+"        for (uint i = 0; i < 4u; i++) if (i < d.w) r[i] = max(-1.0, (float)LoadS16(addr + i * 2u) / 32767.0);\n"
+"    } else if (d.z == 4u) {\n"
+"        for (uint i = 0; i < 4u; i++) if (i < d.w) r[i] = asfloat(LoadU32(addr + i * 4u));\n"
+"    } else if (d.z == 5u) {\n"
+"        for (uint i = 0; i < 4u; i++) if (i < d.w) r[i] = (float)LoadS16(addr + i * 2u);\n"
+"    } else if (d.z == 6u) {\n"
+"        uint v = LoadU32(addr);\n"
+"        int x = (int)(v << 21) >> 21;\n"
+"        int y = (int)((v >> 11) << 21) >> 21;\n"
+"        int z = (int)v >> 22;\n"
+"        r = float4((float)x / 1023.0, (float)y / 1023.0, (float)z / 511.0, 1.0);\n"
+"    }\n"
+"    return r;\n"
+"}\n"
+"\n"
+"float vm(float a, float b) { return (a == 0.0 || b == 0.0) ? 0.0 : a * b; }\n"
+"float4 vmul(float4 a, float4 b) { return float4(vm(a.x, b.x), vm(a.y, b.y), vm(a.z, b.z), vm(a.w, b.w)); }\n"
+"float4 vdp3(float4 a, float4 b) { return (vm(a.x, b.x) + vm(a.y, b.y) + vm(a.z, b.z)).xxxx; }\n"
+"float4 vdph(float4 a, float4 b) { return (vm(a.x, b.x) + vm(a.y, b.y) + vm(a.z, b.z) + b.w).xxxx; }\n"
+"float4 vdp4(float4 a, float4 b) { return (vm(a.x, b.x) + vm(a.y, b.y) + vm(a.z, b.z) + vm(a.w, b.w)).xxxx; }\n"
+"float4 vdst(float4 a, float4 b) { return float4(1.0, vm(a.y, b.y), a.z, b.w); }\n"
+"float4 vmin(float4 a, float4 b) { return float4(a.x < b.x ? a.x : b.x, a.y < b.y ? a.y : b.y, a.z < b.z ? a.z : b.z, a.w < b.w ? a.w : b.w); }\n"
+"float4 vmax(float4 a, float4 b) { return float4(a.x > b.x ? a.x : b.x, a.y > b.y ? a.y : b.y, a.z > b.z ? a.z : b.z, a.w > b.w ? a.w : b.w); }\n"
+"float lt1(float a, float b) { return (a < b || (asuint(a) == 0x80000000u && asuint(b) == 0u)) ? 1.0 : 0.0; }\n"
+"float4 vslt(float4 a, float4 b) { return float4(lt1(a.x, b.x), lt1(a.y, b.y), lt1(a.z, b.z), lt1(a.w, b.w)); }\n"
+"float4 vsge(float4 a, float4 b) { return 1.0 - vslt(a, b); }\n"
+"float4 vrcp(float4 a) {\n"
+"    float x = a.x, r;\n"
+"    if (x == 1.0) r = 1.0;\n"
+"    else if (x == 0.0) r = (asuint(x) & 0x80000000u) ? -asfloat(0x7F800000u) : asfloat(0x7F800000u);\n"
+"    else r = 1.0 / x;\n"
+"    return r.xxxx;\n"
+"}\n"
+"float4 vrcc(float4 a) {\n"
+"    float x = a.x, r;\n"
+"    if (x == 1.0) r = 1.0;\n"
+"    else {\n"
+"        r = 1.0 / x;\n"
+"        if (r > 0.0) {\n"
+"            if (r < 5.42101e-020) r = 5.42101e-020;\n"
+"            else if (r > 1.884467e+019) r = asfloat(0x5F800000u);\n"
+"        } else {\n"
+"            if (r < -1.884467e+019) r = asfloat(0xDF800000u);\n"
+"            else if (r > -5.42101e-020) r = -5.42101e-020;\n"
+"        }\n"
+"    }\n"
+"    return r.xxxx;\n"
+"}\n"
+"float4 vrsq(float4 a) {\n"
+"    float x = abs(a.x), r;\n"
+"    if (x == 1.0) r = 1.0;\n"
+"    else if (x == 0.0) r = asfloat(0x7F800000u);\n"
+"    else r = 1.0 / sqrt(x);\n"
+"    return r.xxxx;\n"
+"}\n"
+"float4 vexp(float4 a) {\n"
+"    float t = floor(a.x);\n"
+"    return float4(exp2(t), a.x - t, exp2(a.x), 1.0);\n"
+"}\n"
+"float4 vlog(float4 a) {\n"
+"    float t = abs(a.x);\n"
+"    if (t == 0.0) return float4(-asfloat(0x7F800000u), 1.0, -asfloat(0x7F800000u), 1.0);\n"
+"    if (isinf(t)) return float4(asfloat(0x7F800000u), 1.0, asfloat(0x7F800000u), 1.0);\n"
+"    uint bits = asuint(t);\n"
+"    float e = (float)((int)((bits >> 23) & 0xFFu) - 127);\n"
+"    float m = asfloat((bits & 0x7FFFFFu) | 0x3F800000u);\n"
+"    return float4(e, m, log2(t), 1.0);\n"
+"}\n"
+"float4 vlit(float4 a) {\n"
+"    float4 r = float4(1.0, 0.0, 0.0, 1.0);\n"
+"    float power = clamp(a.w, -127.9961, 127.9961);\n"
+"    if (a.x > 0.0) {\n"
+"        r.y = a.x;\n"
+"        if (a.y > 0.0) r.z = pow(a.y, power);\n"
+"    }\n"
+"    return r;\n"
+"}\n"
+"float clamp_away(float t) {\n"
+"    float lo = asfloat(0x1F800000u), hi = asfloat(0x5F800000u);\n"
+"    if (t > 0.0 || asuint(t) == 0u) return t < lo ? lo : (t > hi ? hi : t);\n"
+"    return t < -hi ? -hi : (t > -lo ? -lo : t);\n"
+"}\n"
+"float4 clamp_color(float4 c) {\n"
+"    float4 r = c;\n"
+"    r.x = isnan(c.x) ? 1.0 : clamp(c.x, 0.0, 1.0);\n"
+"    r.y = isnan(c.y) ? 1.0 : clamp(c.y, 0.0, 1.0);\n"
+"    r.z = isnan(c.z) ? 1.0 : clamp(c.z, 0.0, 1.0);\n"
+"    r.w = isnan(c.w) ? 1.0 : clamp(c.w, 0.0, 1.0);\n"
+"    return r;\n"
+"}\n"
+"float fog_factor(float d) {\n"
+"    uint m = g_flags.y;\n"
+"    float f = 1.0, infr = 0.0, nanr = 0.0;\n"
+"    if (m == 0u || m == 4u) { infr = 1.0; nanr = 1.0; f = g_fog.x + d * g_fog.y - 1.0; }\n"
+"    else if (m == 1u) { infr = 1.0; nanr = 1.0; f = g_fog.x + exp2(d * g_fog.y * 16.0) - 1.5; }\n"
+"    else if (m == 5u) { f = g_fog.x + exp2(d * g_fog.y * 16.0) - 1.5; }\n"
+"    else if (m == 3u || m == 7u) { f = g_fog.x + exp2(-d * d * g_fog.y * g_fog.y * 32.0) - 1.5; }\n"
+"    if (m == 4u || m == 5u || m == 7u) f = abs(f);\n"
+"    if (isinf(d)) return infr;\n"
+"    if (isnan(f)) f = nanr;\n"
+"    return clamp(f, -3.402823466e38, 3.402823466e38);\n"
+"}\n";
+
+/* ---- program -> HLSL ----------------------------------------------------------------- */
+
+typedef struct StrBuf { char *p; size_t n, cap; } StrBuf;
+
+static void sb_add(StrBuf *b, const char *fmt, ...)
+{
+    va_list ap;
+    int need;
+    va_start(ap, fmt);
+    need = _vscprintf(fmt, ap);
+    va_end(ap);
+    if (need < 0) return;
+    if (b->n + (size_t)need + 1 > b->cap) {
+        size_t cap = b->cap ? b->cap : 4096;
+        char *g;
+        while (cap < b->n + (size_t)need + 1) cap *= 2;
+        g = (char *)realloc(b->p, cap);
+        if (!g) return;
+        b->p = g; b->cap = cap;
+    }
+    va_start(ap, fmt);
+    vsnprintf(b->p + b->n, b->cap - b->n, fmt, ap);
+    va_end(ap);
+    b->n += (size_t)need;
+}
+
+/* An operand as an HLSL expression. */
+static bool vsh_operand(const Nv2aVshInput *in, char *out, size_t cap, uint32_t *attr_mask)
+{
+    char base[48];
+    static const char sw[4] = { 'x', 'y', 'z', 'w' };
+    switch (in->type) {
+    case NV2ART_TEMPORARY:
+        if (in->index == 12) snprintf(base, sizeof(base), "o0");
+        else if (in->index < 12) snprintf(base, sizeof(base), "r%u", in->index);
+        else return false;
+        break;
+    case NV2ART_INPUT:
+        if (in->index > 15) return false;
+        snprintf(base, sizeof(base), "v%u", in->index);
+        *attr_mask |= 1u << in->index;
+        break;
+    case NV2ART_CONTEXT:
+        if (in->index > 191) return false;
+        if (in->is_relative) snprintf(base, sizeof(base), "C[clamp((int)%u + (int)a0, 0, 191)]", in->index);
+        else snprintf(base, sizeof(base), "C[%u]", in->index);
+        break;
+    default:
+        return false;
+    }
+    snprintf(out, cap, "%s(%s.%c%c%c%c)", in->is_negated ? "-" : "", base,
+             sw[in->swizzle[0] & 3], sw[in->swizzle[1] & 3], sw[in->swizzle[2] & 3], sw[in->swizzle[3] & 3]);
+    return true;
+}
+
+static bool vsh_op(StrBuf *b, const Nv2aVshOperation *op, const char *tag, int step,
+                   uint32_t *attr_mask, bool *needs_a0)
+{
+    char in[3][96];
+    const char *fn = NULL;
+    int nin = 0, k;
+    char dest[2][16];
+    (void)needs_a0;
+    if (op->opcode == NV2AOP_NOP) return true;
+    switch (op->opcode) {
+    case NV2AOP_MOV: case NV2AOP_ARL: case NV2AOP_RCP: case NV2AOP_RCC: case NV2AOP_RSQ:
+    case NV2AOP_EXP: case NV2AOP_LOG: case NV2AOP_LIT:
+        nin = 1; break;
+    case NV2AOP_MUL: case NV2AOP_ADD: case NV2AOP_DP3: case NV2AOP_DPH: case NV2AOP_DP4:
+    case NV2AOP_DST: case NV2AOP_MIN: case NV2AOP_MAX: case NV2AOP_SLT: case NV2AOP_SGE:
+        nin = 2; break;
+    case NV2AOP_MAD:
+        nin = 3; break;
+    default:
+        return false;
+    }
+    for (k = 0; k < nin; k++) {
+        if (!vsh_operand(&op->inputs[k], in[k], sizeof(in[k]), attr_mask)) return false;
+    }
+    for (k = 0; k < nin; k++) sb_add(b, "        float4 %s_i%d = %s;\n", tag, k, in[k]);
+    switch (op->opcode) {
+    case NV2AOP_MOV: sb_add(b, "        float4 %s_res = %s_i0;\n", tag, tag); break;
+    case NV2AOP_ARL: sb_add(b, "        float4 %s_res = floor(%s_i0.x + 0.001).xxxx;\n", tag, tag); break;
+    case NV2AOP_MUL: fn = "vmul"; break;
+    case NV2AOP_ADD: sb_add(b, "        float4 %s_res = %s_i0 + %s_i1;\n", tag, tag, tag); break;
+    case NV2AOP_MAD: sb_add(b, "        float4 %s_res = vmul(%s_i0, %s_i1) + %s_i2;\n", tag, tag, tag, tag); break;
+    case NV2AOP_DP3: fn = "vdp3"; break;
+    case NV2AOP_DPH: fn = "vdph"; break;
+    case NV2AOP_DP4: fn = "vdp4"; break;
+    case NV2AOP_DST: fn = "vdst"; break;
+    case NV2AOP_MIN: fn = "vmin"; break;
+    case NV2AOP_MAX: fn = "vmax"; break;
+    case NV2AOP_SLT: fn = "vslt"; break;
+    case NV2AOP_SGE: fn = "vsge"; break;
+    case NV2AOP_RCP: sb_add(b, "        float4 %s_res = vrcp(%s_i0);\n", tag, tag); break;
+    case NV2AOP_RCC: sb_add(b, "        float4 %s_res = vrcc(%s_i0);\n", tag, tag); break;
+    case NV2AOP_RSQ: sb_add(b, "        float4 %s_res = vrsq(%s_i0);\n", tag, tag); break;
+    case NV2AOP_EXP: sb_add(b, "        float4 %s_res = vexp(%s_i0);\n", tag, tag); break;
+    case NV2AOP_LOG: sb_add(b, "        float4 %s_res = vlog(%s_i0);\n", tag, tag); break;
+    case NV2AOP_LIT: sb_add(b, "        float4 %s_res = vlit(%s_i0);\n", tag, tag); break;
+    default: return false;
+    }
+    if (fn) sb_add(b, "        float4 %s_res = %s(%s_i0, %s_i1);\n", tag, fn, tag, tag);
+    (void)step;
+    (void)dest;
+    return true;
+}
+
+static bool vsh_writes(StrBuf *b, const Nv2aVshOperation *op, const char *tag)
+{
+    int k;
+    if (op->opcode == NV2AOP_NOP) return true;
+    for (k = 0; k < 2; k++) {
+        const Nv2aVshOutput *o = &op->outputs[k];
+        char name[16];
+        switch (o->type) {
+        case NV2ART_NONE: continue;
+        case NV2ART_ADDRESS:
+            sb_add(b, "        a0 = %s_res.x;\n", tag);
+            continue;
+        case NV2ART_OUTPUT:
+            if (o->index > 12) return false;
+            snprintf(name, sizeof(name), "o%u", o->index);
+            break;
+        case NV2ART_TEMPORARY:
+            if (o->index > 11) return false;
+            snprintf(name, sizeof(name), "r%u", o->index);
+            break;
+        default:
+            return false;       /* constant writes: the CPU stage runs this program */
+        }
+        if (o->writemask & NV2AWM_X) sb_add(b, "        %s.x = %s_res.x;\n", name, tag);
+        if (o->writemask & NV2AWM_Y) sb_add(b, "        %s.y = %s_res.y;\n", name, tag);
+        if (o->writemask & NV2AWM_Z) sb_add(b, "        %s.z = %s_res.z;\n", name, tag);
+        if (o->writemask & NV2AWM_W) sb_add(b, "        %s.w = %s_res.w;\n", name, tag);
+    }
+    return true;
+}
+
+/* The complete vertex shader source for a program, or NULL if the GPU cannot run it. */
+static char *vsh_generate(const Nv2aVshProgram *prog)
+{
+    StrBuf b = { NULL, 0, 0 };
+    uint32_t attr_mask = 0;
+    bool needs_a0 = false;
+    const Nv2aVshStep *st;
+    int step = 0, i;
+    sb_add(&b, "%s", kgpu_vsh_head);
+    /* the body is generated first so the attribute list is known */
+    {
+        StrBuf body = { NULL, 0, 0 };
+        for (st = prog->steps;; st++, step++) {
+            sb_add(&body, "    { // step %d\n", step);
+            if (!vsh_op(&body, &st->mac, "m", step, &attr_mask, &needs_a0) ||
+                !vsh_op(&body, &st->ilu, "i", step, &attr_mask, &needs_a0) ||
+                !vsh_writes(&body, &st->mac, "m") ||
+                !vsh_writes(&body, &st->ilu, "i")) {
+                free(body.p); free(b.p);
+                return NULL;
+            }
+            sb_add(&body, "    }\n");
+            if (st->is_final || step > 400) break;
+        }
+        sb_add(&b, "VSOut vs_main(uint vid : SV_VertexID) {\n");
+        for (i = 0; i < 16; i++) {
+            if (attr_mask & (1u << i)) sb_add(&b, "    float4 v%d = FetchAttr(%d, vid);\n", i, i);
+        }
+        for (i = 0; i < 12; i++) sb_add(&b, "    float4 r%d = float4(0.0, 0.0, 0.0, 0.0);\n", i);
+        for (i = 0; i < 13; i++) sb_add(&b, "    float4 o%d = float4(0.0, 0.0, 0.0, 1.0);\n", i);
+        sb_add(&b, "    float a0 = 0.0;\n");
+        sb_add(&b, "%s", body.p ? body.p : "");
+        free(body.p);
+    }
+    sb_add(&b,
+        "    float4 pp = o0;\n"
+        "    if (g_vm.x != 1.0) pp.xy = C[59].xy + (pp.xy - C[59].xy) * g_vm.x;\n"
+        "    pp.x = trunc(pp.x * 16.0) / 16.0;\n"
+        "    pp.y = trunc(pp.y * 16.0) / 16.0;\n"
+        "    pp.w = clamp_away(pp.w);\n"
+        "    float fogv = g_flags.x != 0u ? fog_factor(o5.x) : 1.0;\n"
+        "    float4 c0 = clamp_color(o3);\n"
+        "    float4 c1 = float4(0.0, 0.0, 0.0, 1.0);\n"
+        "    if (g_flags.z != 0u) { c1 = clamp_color(o4); if (g_flags.w != 0u) c1.w = 1.0; }\n"
+        "    VSOut o;\n"
+        "    float w = pp.w;\n"
+        "    if (abs(w) < 1.0e-12) w *= g_scale.w;\n"
+        "    float2 ndc = float2(pp.x * g_scale.x - 1.0, 1.0 - pp.y * g_scale.y);\n"
+        "    o.pos = float4(ndc * w, pp.z * g_scale.z * w, w);\n"
+        "    o.d0 = c0;\n"
+        "    o.d1 = c1;\n"
+        "    o.misc = float4(fogv, 0.0, 0.0, 0.0);\n"
+        "    o.t0 = o9;\n"
+        "    o.t1 = o10;\n"
+        "    o.t2 = o11;\n"
+        "    o.t3 = o12;\n"
+        "    return o;\n"
+        "}\n");
+    return b.p;
+}
+
+/* ---- shader cache with an asynchronous compiler -------------------------------------------- */
+
+typedef struct KGpuVs {
+    bool used;
+    uint32_t hash, start;
+    volatile LONG state;               /* 0 compiling, 1 ready, 2 unusable */
+    ID3D11VertexShader *vs;
+    char *source;
+} KGpuVs;
+
+#define KG_VS_MAX 512
+static KGpuVs s_vs[KG_VS_MAX];
+/* Compile jobs (vertex programs, kind 0, and specialised pixel programs, kind 1) for the worker threads. */
+typedef struct KgJob { int kind; void *p; } KgJob;
+#define KG_JOB_MAX 4096
+static KgJob s_jobs[KG_JOB_MAX];
+static volatile LONG s_job_head, s_job_claim;    /* jobs queued / jobs taken by a compiler thread */
+static HANDLE s_job_sem;                         /* released once per queued job */
+#define KG_VS_WORKERS_MAX 8
+static void kg_job_ps(void *p);
+static int s_vs_enabled = -1;
+
+static uint32_t fnv_bytes(const void *p, size_t n)
+{
+    const uint8_t *b = (const uint8_t *)p;
+    uint32_t h = 2166136261u;
+    size_t i;
+    for (i = 0; i < n; i++) h = (h ^ b[i]) * 16777619u;
+    return h;
+}
+
+static void vs_cache_path(char *out, size_t cap, const KGpuVs *e)
+{
+    const char *dir = getenv("RECOMP_KGPU_CACHE");
+    uint32_t sh = e->source ? fnv_bytes(e->source, strlen(e->source)) : 0;
+    snprintf(out, cap, "%s/vs_%08X_%08X_%08X.bin", dir && *dir ? dir : "kgpu-cache", e->hash, e->start, sh);
+}
+
+static bool vs_try_cache(KGpuVs *e)
+{
+    char path[512];
+    FILE *f;
+    void *buf;
+    long n;
+    vs_cache_path(path, sizeof(path), e);
+    f = fopen(path, "rb");
+    if (!f) return false;
+    fseek(f, 0, SEEK_END);
+    n = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    buf = n > 0 ? malloc((size_t)n) : NULL;
+    if (buf && fread(buf, 1, (size_t)n, f) == (size_t)n &&
+        SUCCEEDED(ID3D11Device_CreateVertexShader(G.dev, buf, (SIZE_T)n, NULL, &e->vs))) {
+        free(buf); fclose(f);
+        return true;
+    }
+    free(buf); fclose(f);
+    return false;
+}
+
+static void vs_compile(KGpuVs *e)
+{
+    ID3DBlob *code = NULL, *errors = NULL;
+    HRESULT hr;
+    long long t0 = qpc_now();
+    hr = G.compile(e->source, strlen(e->source), "kgpu_vsh", NULL, NULL, "vs_main", "vs_5_0",
+                   D3DCOMPILE_OPTIMIZATION_LEVEL1, 0, &code, &errors);
+    if (SUCCEEDED(hr) &&
+        SUCCEEDED(ID3D11Device_CreateVertexShader(G.dev, ID3D10Blob_GetBufferPointer(code),
+                                                  ID3D10Blob_GetBufferSize(code), NULL, &e->vs))) {
+        char path[512];
+        FILE *f;
+        CreateDirectoryA(getenv("RECOMP_KGPU_CACHE") && *getenv("RECOMP_KGPU_CACHE") ? getenv("RECOMP_KGPU_CACHE")
+                                                                                       : "kgpu-cache", NULL);
+        vs_cache_path(path, sizeof(path), e);
+        f = fopen(path, "wb");
+        if (f) {
+            fwrite(ID3D10Blob_GetBufferPointer(code), 1, ID3D10Blob_GetBufferSize(code), f);
+            fclose(f);
+        }
+        InterlockedExchange(&e->state, 1);
+        fprintf(stderr, "[KGPU] vertex program %08X/%u compiled in %.0f ms\n", e->hash, e->start,
+                (double)(qpc_now() - t0) * 1000.0 / (double)G.qpf);
+    } else {
+        fprintf(stderr, "[KGPU] vertex program %08X/%u did not compile: %s\n", e->hash, e->start,
+                errors ? (const char *)ID3D10Blob_GetBufferPointer(errors) : "(no log)");
+        InterlockedExchange(&e->state, 2);
+    }
+    if (errors) ID3D10Blob_Release(errors);
+    if (code) ID3D10Blob_Release(code);
+}
+
+static DWORD WINAPI vs_worker(LPVOID arg)
+{
+    (void)arg;
+    for (;;) {
+        LONG idx;
+        KgJob j;
+        WaitForSingleObject(s_job_sem, INFINITE);
+        idx = InterlockedIncrement(&s_job_claim) - 1;
+        j = s_jobs[idx % KG_JOB_MAX];
+        if (j.kind == 0) vs_compile((KGpuVs *)j.p);
+        else kg_job_ps(j.p);
+    }
+    return 0;
+}
+
+static void kg_job_post(int kind, void *p)
+{
+    if (!s_job_sem) {
+        /* Programs compile in parallel: a level's first frames name dozens of them at once, and until one is
+         * ready its draws run the CPU vertex stage (vertex programs) or the ubershader (pixel programs).
+         * RECOMP_KGPU_VS_THREADS overrides the count. */
+        const char *e2 = getenv("RECOMP_KGPU_VS_THREADS");
+        int n = e2 && *e2 ? atoi(e2) : 4, i;
+        SYSTEM_INFO si;
+        GetSystemInfo(&si);
+        if (n > (int)si.dwNumberOfProcessors / 2) n = (int)si.dwNumberOfProcessors / 2;
+        if (n < 1) n = 1;
+        if (n > KG_VS_WORKERS_MAX) n = KG_VS_WORKERS_MAX;
+        s_job_sem = CreateSemaphoreA(NULL, 0, KG_JOB_MAX, NULL);
+        for (i = 0; i < n; i++) {
+            HANDLE th = CreateThread(NULL, 0, vs_worker, NULL, 0, NULL);
+            if (th) { SetThreadPriority(th, THREAD_PRIORITY_BELOW_NORMAL); CloseHandle(th); }
+        }
+    }
+    s_jobs[s_job_head % KG_JOB_MAX].kind = kind;
+    s_jobs[s_job_head % KG_JOB_MAX].p = p;
+    InterlockedIncrement(&s_job_head);
+    ReleaseSemaphore(s_job_sem, 1, NULL);
+}
+
+bool kgpu_vs_enabled(void)
+{
+    if (s_vs_enabled < 0) {
+        const char *e = getenv("RECOMP_KGPU_CPU_VERTICES");
+        s_vs_enabled = !(e && *e && *e != '0');
+    }
+    return s_vs_enabled != 0 && G.ok;
+}
+
+/* The compiled shader for a program, once ready. Starts its translation and
+ * compilation the first time a program is seen; until then (or if the GPU cannot
+ * run it) false, and the draw uses the CPU vertex stage. */
+static KGpuVs *vs_lookup(const void *program, uint32_t hash, uint32_t start)
+{
+    KGpuVs *e = NULL;
+    unsigned int i, slot = (hash ^ (start * 40503u)) % KG_VS_MAX;
+    for (i = 0; i < KG_VS_MAX; i++, slot = (slot + 1) % KG_VS_MAX) {
+        KGpuVs *q = &s_vs[slot];
+        if (!q->used) { e = q; break; }
+        if (q->hash == hash && q->start == start) return q->state == 1 ? q : NULL;
+    }
+    if (!e) return NULL;
+    e->used = true; e->hash = hash; e->start = start; e->state = 0;
+    e->source = vsh_generate((const Nv2aVshProgram *)program);
+    if (!e->source) {
+        e->state = 2;
+        fprintf(stderr, "[KGPU] vertex program %08X/%u runs on the CPU (unsupported operation)\n", hash, start);
+        return NULL;
+    }
+    if (vs_try_cache(e)) {
+        e->state = 1;
+        fprintf(stderr, "[KGPU] vertex program %08X/%u loaded from the shader cache\n", hash, start);
+        return e;
+    }
+    kg_job_post(0, e);
+    return NULL;
+}
+
+bool kgpu_vs_ready(const void *program, uint32_t hash, uint32_t start)
+{
+    return vs_lookup(program, hash, start) != NULL;
+}
diff --git a/src/nv2a/kelvin/kelvin_int.h b/src/nv2a/kelvin/kelvin_int.h
