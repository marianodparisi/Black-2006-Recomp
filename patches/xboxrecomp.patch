diff --git a/src/nv2a/kelvin/kelvin.c b/src/nv2a/kelvin/kelvin.c
new file mode 100644
index 0000000..c6f3b23
--- /dev/null
+++ b/src/nv2a/kelvin/kelvin.c
@@ -0,0 +1,946 @@
+/*
+ * Kelvin: the NV2A command front end -- the PFIFO DMA pusher, object lookup,
+ * and the GPU thread that runs them.
+ *
+ * The pusher follows xemu's pfifo_run_pusher (hw/xbox/nv2a/pfifo.c): it walks
+ * the channel's pushbuffer from DMA_GET to DMA_PUT, following jumps, calls and
+ * returns, keeps an unfinished method header's state across the end of a
+ * segment, translates object handles for methods 0x180..0x1FC through RAMHT,
+ * and only then advances DMA_GET. GET therefore says what the GPU has actually
+ * consumed, which is what D3D's ring-space and fence logic rely on.
+ *
+ * Enabled with RECOMP_NV2A_KELVIN=1. It replaces the ack thread's GET=PUT
+ * echo and the survey/executor in src/kernel/nv2a_pb_*.c for that run.
+ *
+ * Copyright (c) 2012 espes
+ * Copyright (c) 2015 Jannik Vogel
+ * Copyright (c) 2018-2025 Matt Borgerson
+ * (xemu PFIFO/RAMHT/DMA-object logic this follows)
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include <stdlib.h>
+#include <windows.h>
+#include <intrin.h>
+
+#include "kelvin_int.h"
+#include "kelvin.h"
+#include "kelvin_workers.h"
+#include "kelvin_render.h"
+#include "kelvin_gpu.h"
+
+extern ptrdiff_t xbox_GetMemoryOffset(void);
+
+KelvinState g_kelvin;
+
+static volatile LONG s_active;
+static HANDLE s_thread;
+
+/* Presentation metadata is ordered by the exact pushbuffer parameter VA,
+ * independently of the title/GPU threads' timing. The title must register
+ * before PUT exposes that word. Unmarked flips always keep normal policy.
+ * This lock is never held while acquiring the register-model lock. */
+#define KELVIN_FRAME_ASPECT_CAPACITY 16
+typedef struct FrameAspect {
+    uint32_t va, width, height;
+} FrameAspect;
+static FrameAspect s_frame_aspects[KELVIN_FRAME_ASPECT_CAPACITY];
+static SRWLOCK s_frame_aspects_lock = SRWLOCK_INIT;
+static volatile LONG s_frame_aspects_count;
+/* Only the GPU pusher writes these; FLIP_STALL immediately passes them by
+ * value to the renderer, which drains its workers before publication. */
+uint32_t g_kelvin_frame_aspect_w, g_kelvin_frame_aspect_h;
+
+int kelvin_mark_frame_aspect(uint32_t flip_data_va,
+                            uint32_t aspect_w, uint32_t aspect_h)
+{
+    unsigned i, n;
+    int marked = 0;
+    if ((flip_data_va & 3u) || flip_data_va < KELVIN_PHYS_WINDOW ||
+        (uint64_t)flip_data_va + 4u >
+            (uint64_t)KELVIN_PHYS_WINDOW + KELVIN_PHYS_SIZE ||
+        !aspect_w || !aspect_h || aspect_w > 8192u || aspect_h > 8192u)
+        return 0;
+    AcquireSRWLockExclusive(&s_frame_aspects_lock);
+    n = (unsigned)s_frame_aspects_count;
+    for (i = 0; i < n; ++i) {
+        if (s_frame_aspects[i].va == flip_data_va) {
+            /* Ring reuse while a marker is unresolved violates the caller
+             * contract. Discard the ambiguous old entry and reject the new
+             * one, rather than attributing either frame to the other. */
+            s_frame_aspects[i] = s_frame_aspects[n - 1u];
+            InterlockedExchange(&s_frame_aspects_count, (LONG)(n - 1u));
+            goto done;
+        }
+    }
+    if (n < KELVIN_FRAME_ASPECT_CAPACITY) {
+        s_frame_aspects[n].va = flip_data_va;
+        s_frame_aspects[n].width = aspect_w;
+        s_frame_aspects[n].height = aspect_h;
+        InterlockedExchange(&s_frame_aspects_count, (LONG)(n + 1u));
+        marked = 1;
+    }
+done:
+    ReleaseSRWLockExclusive(&s_frame_aspects_lock);
+    return marked;
+}
+
+static void frame_aspect_for_method(uint32_t parameter_va, uint32_t method)
+{
+    unsigned i, n;
+    g_kelvin_frame_aspect_w = g_kelvin_frame_aspect_h = 0;
+    /* Ordinary gameplay has no metadata and takes no additional lock. */
+#ifdef _MSC_VER
+    if (!ReadAcquire(&s_frame_aspects_count)) return;
+#else
+    if (!__atomic_load_n(&s_frame_aspects_count, __ATOMIC_ACQUIRE)) return;
+#endif
+    AcquireSRWLockExclusive(&s_frame_aspects_lock);
+    n = (unsigned)s_frame_aspects_count;
+    for (i = 0; i < n; ++i) {
+        if (s_frame_aspects[i].va == parameter_va) {
+            /* Consume even if a malformed/replaced packet now names a
+             * different method, so its marker cannot survive a ring wrap. */
+            if (method == NV097_FLIP_STALL) {
+                g_kelvin_frame_aspect_w = s_frame_aspects[i].width;
+                g_kelvin_frame_aspect_h = s_frame_aspects[i].height;
+            }
+            s_frame_aspects[i] = s_frame_aspects[n - 1u];
+            InterlockedExchange(&s_frame_aspects_count, (LONG)(n - 1u));
+            break;
+        }
+    }
+    ReleaseSRWLockExclusive(&s_frame_aspects_lock);
+}
+
+/* ---- guest memory ---------------------------------------------------------- */
+
+uint8_t *kelvin_guest(uint32_t va)
+{
+    return (uint8_t *)xbox_GetMemoryOffset() + va;
+}
+
+uint8_t *kelvin_aperture(uint32_t offset)
+{
+    return kelvin_guest(KELVIN_APERTURE_VA + offset);
+}
+
+uint32_t kelvin_aperture_r32(uint32_t offset)
+{
+    return *(volatile uint32_t *)kelvin_aperture(offset);
+}
+
+static void aperture_w32(uint32_t offset, uint32_t v)
+{
+    *(volatile uint32_t *)kelvin_aperture(offset) = v;
+}
+
+uint32_t kelvin_pramin_r32(uint32_t offset)
+{
+    if (offset > KELVIN_PRAMIN_SIZE - 4) {
+        return 0;
+    }
+    return kelvin_aperture_r32(KELVIN_PRAMIN_BASE + offset);
+}
+
+/* ---- unimplemented-feature accounting -------------------------------------- */
+
+static const char *const s_unsupported_names[KU_COUNT] = {
+    "method on unmodelled object class", "Kelvin method without handler",
+    "fixed-function lighting", "fixed-function texgen",
+    "fixed-function skinning", "fixed-function fog generation",
+    "point primitives", "polygon mode (point/line)",
+    "texture shader mode", "texture colour format", "3D texture",
+    "cube texture", "texture border", "shadow-map texture",
+    "surface colour format", "swizzled render target", "float depth buffer",
+    "logic op", "window clip", "zpass reports",
+    "unresolvable DMA context", "image blit operation", "convolution filter",
+    "HILO dot mapping", "specular power reconstruction",
+};
+
+void kelvin_unsupported(int what, const char *detail, uint32_t value)
+{
+    uint64_t n;
+
+    if (what < 0 || what >= KU_COUNT) {
+        return;
+    }
+    /* Raster threads report too (texture and dot-mapping modes met per
+     * fragment), so the count is atomic. */
+    n = (uint64_t)InterlockedIncrement64(
+        (volatile LONG64 *)&g_kelvin.stats.unsupported[what]);
+    if (n == 1 || n == 1000 || n == 1000000) {
+        fprintf(stderr, "[KELVIN] not implemented: %s (%s, 0x%08X) x%llu\n",
+                s_unsupported_names[what], detail ? detail : "", value,
+                (unsigned long long)n);
+        fflush(stderr);
+    }
+}
+
+/* ---- objects ------------------------------------------------------------- */
+
+bool kelvin_ramht_lookup(uint32_t handle, uint32_t *instance,
+                         unsigned int *engine)
+{
+    uint32_t ramht = kelvin_aperture_r32(KELVIN_PFIFO_BASE + NV_PFIFO_RAMHT);
+    uint32_t size = 1u << (GET_MASK(ramht, NV_PFIFO_RAMHT_SIZE) + 12);
+    uint32_t base = GET_MASK(ramht, NV_PFIFO_RAMHT_BASE_ADDRESS) << 12;
+    uint32_t chid = GET_MASK(kelvin_aperture_r32(KELVIN_PFIFO_BASE +
+                                                 NV_PFIFO_CACHE1_PUSH1),
+                             NV_PFIFO_CACHE1_PUSH1_CHID);
+    unsigned int bits = ctz32(size) - 1;
+    uint32_t hash = 0, h = handle, entry_handle, entry_context;
+
+    while (h) {
+        hash ^= h & ((1u << bits) - 1);
+        h >>= bits;
+    }
+    hash ^= chid << (bits - 4);
+    if (hash * 8 >= size) {
+        return false;
+    }
+    entry_handle = kelvin_pramin_r32(base + hash * 8);
+    entry_context = kelvin_pramin_r32(base + hash * 8 + 4);
+    if (entry_handle != handle || !(entry_context & NV_RAMHT_STATUS)) {
+        return false;
+    }
+    if (instance) {
+        *instance = (entry_context & NV_RAMHT_INSTANCE) << 4;
+    }
+    if (engine) {
+        *engine = (entry_context & NV_RAMHT_ENGINE) >> 16;
+    }
+    return true;
+}
+
+uint32_t kelvin_dma_limit(uint32_t instance)
+{
+    return kelvin_pramin_r32(instance + 4);
+}
+
+uint32_t kelvin_dma_va(uint32_t instance, uint32_t offset, uint32_t bytes)
+{
+    uint32_t flags = kelvin_pramin_r32(instance);
+    uint32_t limit = kelvin_pramin_r32(instance + 4);
+    uint32_t frame = kelvin_pramin_r32(instance + 8);
+    uint64_t base = (frame & NV_DMA_ADDRESS) | GET_MASK(flags, NV_DMA_ADJUST);
+    uint64_t phys = base + offset;
+
+    if (bytes && (uint64_t)offset + bytes - 1 > limit) {
+        return 0;
+    }
+    if (phys + bytes > KELVIN_PHYS_SIZE) {
+        return 0;
+    }
+    return KELVIN_PHYS_WINDOW + (uint32_t)phys;
+}
+
+/* ---- the DMA pusher --------------------------------------------------------- */
+
+typedef struct Pusher {
+    bool started;
+    uint32_t get;                  /* offset in the pushbuffer DMA object */
+    uint32_t method, subchannel, count;
+    bool non_inc;
+    uint32_t subroutine;           /* return offset */
+    bool in_subroutine;
+    uint32_t dma_instance;         /* pushbuffer DMA object, 0 = physical */
+} Pusher;
+
+static Pusher s_push;
+
+/* The pushbuffer DMA object as kelvin_dma_va reads it, read once each time
+ * the pusher takes the lock rather than for every word. */
+typedef struct PushMap {
+    uint64_t base;
+    uint32_t limit;
+} PushMap;
+
+static void push_map(PushMap *m)
+{
+    if (s_push.dma_instance) {
+        uint32_t flags = kelvin_pramin_r32(s_push.dma_instance);
+        uint32_t frame = kelvin_pramin_r32(s_push.dma_instance + 8);
+        m->limit = kelvin_pramin_r32(s_push.dma_instance + 4);
+        m->base = (frame & NV_DMA_ADDRESS) | GET_MASK(flags, NV_DMA_ADJUST);
+    }
+}
+
+/* kelvin_dma_va(dma_instance, offset, 4), or the physical window. */
+static uint32_t pushbuffer_va(const PushMap *m, uint32_t offset)
+{
+    if (s_push.dma_instance) {
+        uint64_t phys = m->base + offset;
+        if ((uint64_t)offset + 3 > m->limit || phys + 4 > KELVIN_PHYS_SIZE) {
+            return 0;
+        }
+        return KELVIN_PHYS_WINDOW + (uint32_t)phys;
+    }
+    return offset < KELVIN_PHYS_SIZE ? KELVIN_PHYS_WINDOW + offset : 0;
+}
+
+/* Words the pusher reads per hold of the lock at most. */
+#define KELVIN_WORDS_PER_LOCK 256
+
+/* Words read between publications of GET: 1 KiB. */
+#define KELVIN_GET_EVERY 256
+
+static void publish_get_raw(uint32_t get)
+{
+    aperture_w32(KELVIN_USER_DMA_GET, get);
+    aperture_w32(KELVIN_PFIFO_BASE + NV_PFIFO_CACHE1_DMA_GET, get);
+}
+
+/* With asynchronous GPU submission the final GET of a run (at PUT, which reads as "the GPU is idle") is published by
+ * the GPU thread behind the draws before it, while the pusher goes on publishing GET as it reads. Each publication has
+ * a sequence number and a late one that a newer one has overtaken is dropped, so GET never goes back. */
+static LONG s_pub_seq;
+static volatile LONG s_pub_applied, s_pub_lock;
+
+static void publish_get_seq(LONG seq, uint32_t get)
+{
+    while (InterlockedExchange(&s_pub_lock, 1)) YieldProcessor();
+    if ((LONG)(seq - s_pub_applied) > 0) {
+        s_pub_applied = seq;
+        publish_get_raw(get);
+    }
+    InterlockedExchange(&s_pub_lock, 0);
+}
+
+static void publish_get_thunk(uintptr_t seq, uintptr_t get)
+{
+    publish_get_seq((LONG)seq, (uint32_t)get);
+}
+
+static void publish_get(uint32_t get)
+{
+    publish_get_seq(++s_pub_seq, get);
+}
+
+/* GET at PUT: once everything the pusher handed to the GPU thread has been executed. */
+static void publish_get_idle(uint32_t get)
+{
+    LONG seq = ++s_pub_seq;
+    if (kgpu_async_active()) kgpu_defer_call(publish_get_thunk, (uintptr_t)seq, (uintptr_t)get);
+    else publish_get_seq(seq, get);
+}
+
+static bool flip_stall_complete(KelvinState *pg)
+{
+    return PG_GET_MASK(NV_PGRAPH_SURFACE, NV_PGRAPH_SURFACE_READ_3D)
+           != PG_GET_MASK(NV_PGRAPH_SURFACE, NV_PGRAPH_SURFACE_WRITE_3D);
+}
+
+/* How long a flip stall may wait for the ISR before the pusher completes it
+ * itself. Without RECOMP_VBLANK no ISR ever runs, and a stall that nothing can
+ * end is a hang; with it, the ISR normally answers within a frame. */
+static DWORD s_flip_timeout_ms = 100;
+
+/* Whether the engine may not take the next method, as xemu's puller decides
+ * it: PGRAPH's FIFO access switched off by the title (its interrupt handler
+ * does that while it works), a notify or context switch waiting for the
+ * title to acknowledge it, or a flip stall. Lock held. */
+static bool pusher_stalled(KelvinState *pg)
+{
+    static DWORD stall_start;
+
+    if (!(pgraph_reg_r(pg, NV_PGRAPH_FIFO) & NV_PGRAPH_FIFO_ACCESS) ||
+        pg->waiting_for_nop || pg->waiting_for_context_switch) {
+        return true;
+    }
+    if (!pg->waiting_for_flip) {
+        return false;
+    }
+    if (flip_stall_complete(pg)) {
+        pg->waiting_for_flip = false;
+        stall_start = 0;
+        return false;
+    }
+    if (!stall_start) {
+        stall_start = GetTickCount();
+        return true;
+    }
+    if (GetTickCount() - stall_start >= s_flip_timeout_ms) {
+        static unsigned said;
+        uint32_t modulo = PG_GET_MASK(NV_PGRAPH_SURFACE,
+                                      NV_PGRAPH_SURFACE_MODULO_3D);
+        uint32_t next = PG_GET_MASK(NV_PGRAPH_SURFACE,
+                                    NV_PGRAPH_SURFACE_READ_3D) + 1;
+        if (said++ < 3) {
+            fprintf(stderr, "[KELVIN] flip stall not released by a vblank"
+                            " ISR within %lu ms; completing it (set"
+                            " RECOMP_VBLANK to deliver vblank)\n",
+                    (unsigned long)s_flip_timeout_ms);
+            fflush(stderr);
+        }
+        if (modulo) {
+            next %= modulo;
+        }
+        PG_SET_MASK(NV_PGRAPH_SURFACE, NV_PGRAPH_SURFACE_READ_3D, next);
+        pg->waiting_for_flip = false;
+        stall_start = 0;
+        return false;
+    }
+    return true;
+}
+
+static void dispatch(KelvinState *pg, uint32_t subchannel, uint32_t method,
+                     uint32_t parameter, bool inc)
+{
+    {
+        /* RECOMP_KELVIN_METHODSTAT=1: once a second, the methods that arrived most often */
+        static int stat_on = -1;
+        static uint32_t ids[512];
+        static unsigned cnt[512];
+        static ULONGLONG last;
+        if (stat_on < 0) { const char *e = getenv("RECOMP_KELVIN_METHODSTAT"); stat_on = e && *e && *e != '0'; }
+        if (stat_on) {
+            unsigned k = (method >> 2) & 511u, probes = 0;
+            ULONGLONG now = GetTickCount64();
+            while (probes < 512 && cnt[k] && ids[k] != method) { k = (k + 1) & 511u; probes++; }
+            if (probes < 512) { ids[k] = method; cnt[k]++; }
+            if (!last) last = now;
+            if (now - last >= 1000) {
+                unsigned order[512], n = 0, i, j;
+                for (i = 0; i < 512; i++) if (cnt[i]) order[n++] = i;
+                for (i = 0; i < n && i < 14; i++)
+                    for (j = i + 1; j < n; j++) if (cnt[order[j]] > cnt[order[i]]) { unsigned t = order[i]; order[i] = order[j]; order[j] = t; }
+                fprintf(stderr, "[KMETH] last second:");
+                for (i = 0; i < n && i < 14; i++) fprintf(stderr, " 0x%X x%u", ids[order[i]], cnt[order[i]]);
+                fprintf(stderr, "\n");
+                memset(cnt, 0, sizeof(cnt));
+                last = now;
+            }
+        }
+    }
+    if (method >= 0x180 && method < 0x200 && method != 0) {
+        uint32_t instance;
+        if (!kelvin_ramht_lookup(parameter, &instance, NULL)) {
+            kelvin_unsupported(KU_DMA_UNRESOLVED, "object handle", parameter);
+            return;
+        }
+        parameter = instance;
+    } else if (method == 0) {
+        uint32_t instance;
+        if (!kelvin_ramht_lookup(parameter, &instance, NULL)) {
+            kelvin_unsupported(KU_DMA_UNRESOLVED, "SET_OBJECT handle",
+                               parameter);
+            return;
+        }
+        parameter = instance;
+    }
+    kelvin_pgraph_method(pg, subchannel, method, parameter, inc);
+}
+
+/* Run the pusher until GET reaches PUT or the engine stalls. Returns the
+ * number of words consumed. */
+static int s_batch_ok = -1;
+
+static uint32_t pusher_run(KelvinState *pg, uint32_t put)
+{
+    if (s_batch_ok < 0) { const char *e = getenv("RECOMP_KELVIN_RUNS"); s_batch_ok = !(e && *e == '0'); }
+    uint32_t words = 0, since_publish = 0;
+    kgpu_note_kick();
+    unsigned int chid = GET_MASK(kelvin_aperture_r32(KELVIN_PFIFO_BASE +
+                                                     NV_PFIFO_CACHE1_PUSH1),
+                                 NV_PFIFO_CACHE1_PUSH1_CHID);
+    const uint8_t *window = kelvin_guest(KELVIN_PHYS_WINDOW);
+    bool stop = false;
+    uint32_t held = 0;
+    unsigned int lock_poll = 0;
+    bool recheck = true;
+    PushMap map;
+
+    while (s_push.get != put) {
+        uint32_t va, word;
+        bool transferred = false;
+
+        /* A word at a time under the lock, so the title's register
+         * accesses interleave with methods as they would on hardware: the
+         * lock is kept from one word to the next only while no register
+         * access (or vblank) is waiting for it, and for a bounded number of
+         * words. */
+        if (held && (held >= KELVIN_WORDS_PER_LOCK || ((++lock_poll & 3) == 0 && kelvin_lock_wanted()))) {
+            kelvin_unlock();
+            kelvin_lock_yield();
+            held = 0;
+        }
+        if (!held) {
+            recheck = true;
+            if (g_kelvin_tracing) {
+                long long t0 = kelvin_ticks(), t1;
+                kelvin_lock();
+                t1 = kelvin_ticks();
+                if (t1 - t0 > 1000) {
+                    kelvin_render_trace_event(5, t0, t1, 0);
+                }
+            } else {
+                kelvin_lock();
+            }
+            push_map(&map);
+        }
+        held++;
+        /* What can stop the engine -- FIFO access off, a notify or context switch waiting for the title, the channel
+         * not current -- changes only through register accesses, which need the lock this thread holds, or through
+         * methods that set the waiting flags. So it is looked at when the lock was just taken, and while a flag says
+         * the engine is waiting. */
+        if (recheck || pg->waiting_for_nop || pg->waiting_for_context_switch || pg->waiting_for_flip) {
+            stop = pusher_stalled(pg);
+            if (!stop && s_push.count) {
+                kelvin_context_switch(pg, chid);
+                stop = pg->waiting_for_context_switch;
+            }
+            recheck = false;
+            if (stop) {
+                break;
+            }
+        }
+        va = pushbuffer_va(&map, s_push.get);
+        if (!va) {
+            static int said;
+            if (!said++) {
+                fprintf(stderr, "[KELVIN] DMA_GET 0x%08X is outside the"
+                                " pushbuffer; stopping\n", s_push.get);
+                fflush(stderr);
+            }
+            s_push.get = put;
+            break;
+        }
+        if (s_push.count > 1 && s_push.non_inc && !g_kelvin_tracing && s_batch_ok) {
+            /* A run of data words for one method that takes them in bulk (indices, inline vertex data). The
+             * run stays inside one lock hold and one GET-publication interval, as the per-word path would. */
+            uint32_t n = s_push.count, room = KELVIN_GET_EVERY - since_publish;
+            if (n > room) n = room;
+            if (n > 64) n = 64;
+            if (put > s_push.get) {
+                uint32_t avail = (put - s_push.get) >> 2;
+                if (n > avail) n = avail;
+            } else {
+                n = 1;
+            }
+            if (n > 1 && pushbuffer_va(&map, s_push.get + 4u * (n - 1)) == va + 4u * (n - 1) &&
+                kelvin_pgraph_method_run(pg, s_push.subchannel, s_push.method,
+                                         (const uint32_t *)(window + (va - KELVIN_PHYS_WINDOW)), n)) {
+                s_push.get += 4u * n;
+                words += n;
+                pg->stats.words += n;
+                held += n - 1;
+                g_kelvin_word_get = s_push.get - 4;
+                s_push.count -= n;
+                since_publish += n;
+                if (since_publish >= KELVIN_GET_EVERY && s_push.get != put) {
+                    publish_get(kelvin_render_get_bound(s_push.get, pg->stats.words));
+                    since_publish = 0;
+                }
+                continue;
+            }
+        }
+        word = *(volatile const uint32_t *)(window + (va - KELVIN_PHYS_WINDOW));
+        s_push.get += 4;
+        words++;
+        pg->stats.words++;
+        frame_aspect_for_method(va, s_push.count ? s_push.method : UINT32_MAX);
+
+        if (s_push.count) {
+            g_kelvin_word_get = s_push.get - 4;
+            if (g_kelvin_tracing) {
+                long long t0 = kelvin_ticks(), t1;
+                dispatch(pg, s_push.subchannel, s_push.method, word,
+                         !s_push.non_inc);
+                t1 = kelvin_ticks();
+                if (t1 - t0 > 2000) {
+                    kelvin_render_trace_event(6, t0, t1,
+                                              s_push.subchannel << 16 | s_push.method);
+                }
+            } else {
+                dispatch(pg, s_push.subchannel, s_push.method, word,
+                         !s_push.non_inc);
+            }
+            if (!s_push.non_inc) {
+                s_push.method += 4;
+            }
+            s_push.count--;
+        } else if ((word & 0xe0000003) == 0x20000000 || (word & 3) == 1) {
+            uint32_t target = (word & 3) == 1 ? word & 0xfffffffc
+                                              : word & 0x1fffffff;
+            if (pg->stats.jumps < 4) {
+                fprintf(stderr, "[KELVIN] pushbuffer jump at 0x%08X ->"
+                                " 0x%08X\n", s_push.get - 4, target);
+                fflush(stderr);
+            }
+            s_push.get = target;
+            transferred = true;
+            pg->stats.jumps++;
+        } else if ((word & 3) == 2) {
+            if (s_push.in_subroutine) {
+                fprintf(stderr, "[KELVIN] nested pushbuffer call at"
+                                " 0x%08X\n", s_push.get - 4);
+            }
+            s_push.subroutine = s_push.get;
+            s_push.in_subroutine = true;
+            s_push.get = word & 0xfffffffc;            /* call */
+            transferred = true;
+            pg->stats.calls++;
+        } else if (word == 0x00020000) {
+            if (s_push.in_subroutine) {                /* return */
+                s_push.get = s_push.subroutine;
+                s_push.in_subroutine = false;
+                transferred = true;
+            }
+        } else if ((word & 0xe0030003) == 0 ||
+                   (word & 0xe0030003) == 0x40000000) {
+            s_push.method = word & 0x1fff;
+            s_push.subchannel = (word >> 13) & 7;
+            s_push.count = (word >> 18) & 0x7ff;
+            s_push.non_inc = (word & 0xe0030003) == 0x40000000;
+        } else {
+            static unsigned said;
+            if (said++ < 8) {
+                fprintf(stderr, "[KELVIN] reserved pushbuffer command 0x%08X"
+                                " at 0x%08X\n", word, s_push.get - 4);
+            }
+        }
+
+        /* Publish progress in batches: a long segment should let the title
+         * see its ring space coming back before the whole thing is done.
+         * GET must also stay close to what has been read. D3D's fence wait
+         * (BLACK's 0x0026CC10) rewrites four reserved words at a fence into
+         * WAIT_FOR_IDLE and a notify when GET is at least 0x2400 bytes short
+         * of them, then sleeps until the notify interrupts; words the pusher
+         * had already read, with GET not yet showing it, never notify. So
+         * publish every KELVIN_GET_EVERY words, well inside that margin --
+         * but never GET at PUT, which reads as idle and waits for the drain
+         * below. */
+        if (transferred) {
+            /* Word counts bound GET lag only within a contiguous segment.
+             * An arbitrary jump or call can skip the fence margin in one
+             * word. Finish vertex reads and expose the new location before
+             * reading any word there; raster ordering remains in its queue.
+             * GET at PUT still waits for the idle drain below. */
+            kelvin_render_geometry_sync();
+            if (s_push.get != put) {
+                publish_get(s_push.get);
+            }
+            since_publish = 0;
+        } else if (++since_publish >= KELVIN_GET_EVERY && s_push.get != put) {
+            publish_get(kelvin_render_get_bound(s_push.get, pg->stats.words));
+            since_publish = 0;
+        }
+    }
+    if (held) {
+        kelvin_unlock();
+        kelvin_lock_yield();
+    }
+    /* GET at PUT reads as idle to D3D, and so does a pusher that stopped: the
+     * pixels behind it are written first. */
+    if (!kgpu_async_active()) kelvin_render_sync_for(KT_SYNC_IDLE);
+    publish_get_idle(s_push.get);
+    return words;
+}
+
+/* ---- the GPU thread ----------------------------------------------------------- */
+
+volatile DWORD g_kelvin_pusher_tid;
+extern void xbox_PinThread(const char *role);
+
+static DWORD WINAPI kelvin_thread(LPVOID arg)
+{
+    KelvinState *pg = &g_kelvin;
+    g_kelvin_pusher_tid = GetCurrentThreadId();
+    xbox_PinThread("PUSHER");
+    DWORD last_report = GetTickCount();
+    (void)arg;
+
+    long long loop_mark = kelvin_ticks();
+    int waited = -1;              /* the last loop read no word: KT_WAIT_* */
+
+    g_kelvin_timing = getenv("RECOMP_KELVIN_TIMING") != NULL;
+    /* RECOMP_KELVIN_GPU: the D3D11 backend is created on the thread that owns it. */
+    if (kgpu_enabled()) {
+        if (kgpu_init()) {
+            fprintf(stderr, "[KELVIN] GPU backend active\n");
+        } else {
+            fprintf(stderr, "[KELVIN] GPU backend unavailable; CPU renderer retained\n");
+        }
+        fflush(stderr);
+    }
+
+    for (;;) {
+        uint32_t put = kelvin_aperture_r32(KELVIN_USER_DMA_PUT);
+        uint32_t done = 0;
+
+        if (g_kelvin_timing > 0) {
+            long long now = kelvin_ticks();
+            g_kelvin_ticks[KT_LOOP] += now - loop_mark;
+            if (waited >= 0) {
+                g_kelvin_ticks[waited] += now - loop_mark;
+            }
+            loop_mark = now;
+        }
+
+        /* On hardware a write to the active channel's USER DMA_PUT lands in
+         * PFIFO CACHE1_DMA_PUT; D3D's idle checks compare that register with
+         * CACHE1_DMA_GET, and a PUT left at 0 reads as work outstanding. */
+        aperture_w32(KELVIN_PFIFO_BASE + NV_PFIFO_CACHE1_DMA_PUT, put);
+
+        if (!s_push.started) {
+            if (put) {
+                /* D3D sets PUT and GET together when it creates the channel;
+                 * the first movement of PUT is where execution begins. */
+                s_push.get = kelvin_aperture_r32(KELVIN_USER_DMA_GET);
+                s_push.dma_instance = GET_MASK(
+                    kelvin_aperture_r32(KELVIN_PFIFO_BASE +
+                                        NV_PFIFO_CACHE1_DMA_INSTANCE),
+                    NV_PFIFO_CACHE1_DMA_INSTANCE_ADDRESS) << 4;
+                s_push.started = true;
+                fprintf(stderr, "[KELVIN] pusher started: GET 0x%08X PUT"
+                                " 0x%08X, pushbuffer DMA instance 0x%05X%s\n",
+                        s_push.get, put, s_push.dma_instance,
+                        s_push.dma_instance ? "" : " (physical)");
+                fprintf(stderr, "[KELVIN]   PFIFO CACHE1 DMA_PUT 0x%08X"
+                                " DMA_GET 0x%08X; DMA object %08X %08X %08X\n",
+                        kelvin_aperture_r32(KELVIN_PFIFO_BASE +
+                                            NV_PFIFO_CACHE1_DMA_PUT),
+                        kelvin_aperture_r32(KELVIN_PFIFO_BASE +
+                                            NV_PFIFO_CACHE1_DMA_GET),
+                        kelvin_pramin_r32(s_push.dma_instance),
+                        kelvin_pramin_r32(s_push.dma_instance + 4),
+                        kelvin_pramin_r32(s_push.dma_instance + 8));
+                {
+                    PushMap map;
+                    uint32_t va;
+                    int k;
+                    push_map(&map);
+                    va = pushbuffer_va(&map, s_push.get);
+                    fprintf(stderr, "[KELVIN]   first words at GET (VA"
+                                    " 0x%08X):", va);
+                    for (k = 0; va && k < 8; k++) {
+                        fprintf(stderr, " %08X",
+                                *(uint32_t *)kelvin_guest(va + k * 4));
+                    }
+                    fprintf(stderr, "\n");
+                }
+                fflush(stderr);
+            }
+        } else if (put != s_push.get) {
+            long long t0 = kelvin_ticks();
+            done = pusher_run(pg, put);
+            if (g_kelvin_timing > 0) {
+                g_kelvin_ticks[KT_PUSHER] += kelvin_ticks() - t0;
+            }
+            kelvin_render_trace_event(4, t0, kelvin_ticks(), done);
+        }
+
+        if (GetTickCount() - last_report > 10000) {
+            last_report = GetTickCount();
+            kelvin_report();
+        }
+        waited = done ? -1 : put == s_push.get ? KT_WAIT_PUT
+                                : pg->waiting_for_flip ? KT_WAIT_FLIP : KT_WAIT_ACK;
+        if (!done) {
+            long long t0 = kelvin_ticks();
+            /* Nothing to do: wait for PUT to move, or for what the engine is waiting on to be cleared, spinning a
+             * little before giving the processor away (a Sleep(0) is a system call at every turn). */
+            unsigned int spins;
+            bool was_stalled = pg->waiting_for_nop || pg->waiting_for_context_switch || pg->waiting_for_flip;
+            for (spins = 0; spins < 3000; spins++) {
+                bool stalled;
+                _mm_pause();
+                stalled = pg->waiting_for_nop || pg->waiting_for_context_switch || pg->waiting_for_flip;
+                if (stalled != was_stalled) break;
+                if (!stalled && kelvin_aperture_r32(KELVIN_USER_DMA_PUT) != s_push.get) break;
+            }
+            if (spins == 3000) Sleep(0);
+            kelvin_render_trace_event(3, t0, kelvin_ticks(), (uint32_t)waited);
+        }
+    }
+    return 0;
+}
+
+int kelvin_enabled(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char *e = getenv("RECOMP_NV2A_KELVIN");
+        on = (e && *e && *e != '0') ? 1 : 0;
+    }
+    return on;
+}
+
+int kelvin_active(void)
+{
+    /* InterlockedExchange publishes the initialized engine. Acquire its
+     * state on every query without a read-modify-write on the shared flag. */
+#ifdef _MSC_VER
+    return ReadAcquire(&s_active) != 0;
+#else
+    return __atomic_load_n(&s_active, __ATOMIC_ACQUIRE) != 0;
+#endif
+}
+
+void kelvin_start(void)
+{
+    const char *t;
+
+    if (!kelvin_enabled() || kelvin_active()) {
+        return;
+    }
+    kelvin_pgraph_init(&g_kelvin, NULL);
+    if (!kelvin_mmio_start(&g_kelvin)) {
+        fprintf(stderr, "[KELVIN] NV2A engine not started: its interrupt"
+                        " registers could not be modelled\n");
+        fflush(stderr);
+        return;
+    }
+    t = getenv("RECOMP_NV2A_FLIP_TIMEOUT_MS");
+    if (t) {
+        s_flip_timeout_ms = (DWORD)strtoul(t, NULL, 0);
+    }
+    InterlockedExchange(&s_active, 1);
+    s_thread = CreateThread(NULL, 0, kelvin_thread, NULL, 0, NULL);
+    fprintf(stderr, "[KELVIN] NV2A engine on the CPU: %s\n",
+            s_thread ? "started" : "FAILED to start");
+    fflush(stderr);
+}
+
+void kelvin_report(void)
+{
+    const KelvinStats *s = &g_kelvin.stats;
+    int i;
+
+    fprintf(stderr, "[KELVIN] %llu words, %llu methods (%llu unhandled),"
+                    " %llu jumps, %llu calls | %llu draws (%llu no-op),"
+                    " %llu triangles, %llu lines, %llu pixels | %llu clears,"
+                    " %llu flips,"
+                    " %llu semaphores, %llu blits, %llu notifies\n",
+            (unsigned long long)s->words, (unsigned long long)s->methods,
+            (unsigned long long)s->unhandled_methods,
+            (unsigned long long)s->jumps, (unsigned long long)s->calls,
+            (unsigned long long)s->draws, (unsigned long long)s->draws_nop,
+            (unsigned long long)s->triangles, (unsigned long long)s->lines,
+            (unsigned long long)s->pixels,
+            (unsigned long long)s->clears, (unsigned long long)s->flips,
+            (unsigned long long)s->semaphores,
+            (unsigned long long)s->image_blits,
+            (unsigned long long)s->notifies);
+    if (s->triangles_bounds_clamped) {
+        fprintf(stderr, "[KELVIN]   triangle bounds outside integer range: %llu"
+                        " clipped before conversion\n",
+                (unsigned long long)s->triangles_bounds_clamped);
+    }
+    if (s->swizzled_clears) {
+        fprintf(stderr, "[KELVIN]   swizzled clears: %llu\n",
+                (unsigned long long)s->swizzled_clears);
+    }
+    if (s->raster_batches) {
+        fprintf(stderr, "[KELVIN]   raster batches: %llu; waited for all"
+                        " earlier: %llu one-thread, %llu snapshot,"
+                        " %llu conflict\n",
+                (unsigned long long)s->raster_batches,
+                (unsigned long long)s->raster_batches_single,
+                (unsigned long long)s->raster_batches_snapshot,
+                (unsigned long long)s->raster_batches_conflict);
+    }
+    if (s->vertices) {
+        fprintf(stderr, "[KELVIN]   vertices shaded: %llu, %llu of them in"
+                        " parallel; %llu draws set up on the raster threads\n",
+                (unsigned long long)s->vertices,
+                (unsigned long long)s->vertices_parallel,
+                (unsigned long long)s->draws_deferred);
+    }
+    if (g_kelvin_timing > 0) {
+        /* Milliseconds per flip since the last report. */
+        static long long prev[KT_COUNT], prev_lanes, prev_loops;
+        static uint64_t prev_flips;
+        long long lanes, loops, d[KT_COUNT];
+        LARGE_INTEGER f;
+        uint64_t flips = s->flips - prev_flips;
+        double k;
+        int i;
+        QueryPerformanceFrequency(&f);
+        kwork_busy_ticks(&lanes, &loops);
+        for (i = 0; i < KT_COUNT; i++) {
+            d[i] = g_kelvin_ticks[i] - prev[i];
+            prev[i] = g_kelvin_ticks[i];
+        }
+        k = flips ? 1000.0 / (double)f.QuadPart / (double)flips : 0.0;
+        fprintf(stderr, "[KELVIN]   ms per flip over %llu flips: loop %.1f, pusher"
+                        " %.1f, draws %.1f (vertex loops %.1f, queue full %.1f);"
+                        " draw jobs waited for %.1f;"
+                        " drains: clear %.1f, semaphore %.1f, flip %.1f,"
+                        " notify %.1f, idle %.1f, other %.1f; workers busy:"
+                        " lanes %.1f, vertex items %.1f; no words: for PUT %.1f,"
+                " flip %.1f, ack %.1f\n",
+                (unsigned long long)flips, d[KT_LOOP] * k, d[KT_PUSHER] * k,
+                d[KT_DRAW] * k, d[KT_PRESHADE] * k, d[KT_SUBMIT] * k,
+                d[KT_GEOMETRY] * k,
+                d[KT_SYNC_CLEAR] * k, d[KT_SYNC_SEMAPHORE] * k,
+                d[KT_SYNC_FLIP] * k, d[KT_SYNC_NOTIFY] * k,
+                d[KT_SYNC_IDLE] * k, d[KT_SYNC_OTHER] * k,
+                (lanes - prev_lanes) * k, (loops - prev_loops) * k,
+                d[KT_WAIT_PUT] * k, d[KT_WAIT_FLIP] * k, d[KT_WAIT_ACK] * k);
+        {
+            extern volatile long long g_kelvin_notify_ticks, g_kelvin_notify_count;
+            static long long prev_nt, prev_nc;
+            long long nc = g_kelvin_notify_count - prev_nc;
+            fprintf(stderr, "[KELVIN]   notify raise->ack: %lld in %.0f us each on average\n", nc,
+                    nc ? (double)(g_kelvin_notify_ticks - prev_nt) * 1e6 / (double)f.QuadPart / (double)nc : 0.0);
+            prev_nt = g_kelvin_notify_ticks; prev_nc = g_kelvin_notify_count;
+        }
+        {
+            extern volatile long g_kelvin_sync_count[16];
+            static long prev_sc[16];
+            fprintf(stderr, "[KELVIN]   syncs per flip: clear %.1f semaphore %.1f flip %.1f notify %.1f idle %.1f other %.1f\n",
+                    flips ? (g_kelvin_sync_count[KT_SYNC_CLEAR] - prev_sc[KT_SYNC_CLEAR]) / (double)flips : 0.0,
+                    flips ? (g_kelvin_sync_count[KT_SYNC_SEMAPHORE] - prev_sc[KT_SYNC_SEMAPHORE]) / (double)flips : 0.0,
+                    flips ? (g_kelvin_sync_count[KT_SYNC_FLIP] - prev_sc[KT_SYNC_FLIP]) / (double)flips : 0.0,
+                    flips ? (g_kelvin_sync_count[KT_SYNC_NOTIFY] - prev_sc[KT_SYNC_NOTIFY]) / (double)flips : 0.0,
+                    flips ? (g_kelvin_sync_count[KT_SYNC_IDLE] - prev_sc[KT_SYNC_IDLE]) / (double)flips : 0.0,
+                    flips ? (g_kelvin_sync_count[KT_SYNC_OTHER] - prev_sc[KT_SYNC_OTHER]) / (double)flips : 0.0);
+            for (i = 0; i < 16; i++) prev_sc[i] = g_kelvin_sync_count[i];
+        }
+        prev_lanes = lanes;
+        prev_loops = loops;
+        prev_flips = s->flips;
+        {
+            static long long prev_scan[3];
+            long long now[3];
+            for (i = 0; i < 3; i++) {
+                now[i] = g_kelvin_scan[i];
+            }
+            if (flips) {
+                fprintf(stderr, "[KELVIN]   per flip: %lld positions scanned,"
+                                " %lld fragments, %lld written\n",
+                        (now[0] - prev_scan[0]) / (long long)flips,
+                        (now[1] - prev_scan[1]) / (long long)flips,
+                        (now[2] - prev_scan[2]) / (long long)flips);
+            }
+            for (i = 0; i < 3; i++) {
+                prev_scan[i] = now[i];
+            }
+        }
+    }
+    kelvin_mmio_report();
+    kgpu_report();
+    fprintf(stderr, "[KELVIN]   pusher: GET 0x%08X PUT 0x%08X%s%s%s%s\n",
+            s_push.get, kelvin_aperture_r32(KELVIN_USER_DMA_PUT),
+            g_kelvin.waiting_for_nop ? ", waiting for notify ack" : "",
+            g_kelvin.waiting_for_context_switch ? ", waiting for context"
+                                                  " switch" : "",
+            g_kelvin.waiting_for_flip ? ", in flip stall" : "",
+            g_kelvin.regs && !(pgraph_reg_r(&g_kelvin, NV_PGRAPH_FIFO) &
+                               NV_PGRAPH_FIFO_ACCESS)
+                ? ", FIFO access off" : "");
+    for (i = 0; i < KU_COUNT; i++) {
+        if (s->unsupported[i]) {
+            fprintf(stderr, "[KELVIN]   not implemented: %-34s x%llu\n",
+                    s_unsupported_names[i],
+                    (unsigned long long)s->unsupported[i]);
+        }
+    }
+    fflush(stderr);
+}
diff --git a/src/nv2a/kelvin/kelvin.h b/src/nv2a/kelvin/kelvin.h
new file mode 100644
index 0000000..428add6
--- /dev/null
+++ b/src/nv2a/kelvin/kelvin.h
@@ -0,0 +1,58 @@
+/*
+ * Kelvin: NV2A 3D engine on the CPU -- public interface for the runtime.
+ *
+ * Enabled with RECOMP_NV2A_KELVIN=1. See kelvin.c.
+ */
+#ifndef XBOX_NV2A_KELVIN_H
+#define XBOX_NV2A_KELVIN_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Whether RECOMP_NV2A_KELVIN asks for the engine. */
+int kelvin_enabled(void);
+
+/* Whether the engine is running. While it is, it owns DMA_GET: nothing else
+ * may acknowledge pushbuffer progress on its behalf. */
+int kelvin_active(void);
+
+/* Attach presentation aspect to one not-yet-published FLIP_STALL parameter.
+ * The caller registers the exact physical guest VA before publishing PUT.
+ * The GPU consumes it once at that word; no later title state is sampled.
+ * Returns zero on invalid input, a duplicate outstanding VA or a full queue.
+ * Zero aspect belongs to ordinary unmarked frames, so is not registered. */
+int kelvin_mark_frame_aspect(uint32_t flip_data_va,
+                            uint32_t aspect_w, uint32_t aspect_h);
+
+/* Start the GPU thread. Call once the NV2A aperture is mapped. */
+void kelvin_start(void);
+
+/* Counters and unimplemented features seen so far, to stderr. */
+void kelvin_report(void);
+
+/* The GPU interrupt, for the kernel's interrupt thread.
+ *
+ * While the engine runs, the PMC, PGRAPH and PCRTC register pages have real
+ * interrupt semantics (see kelvin_mmio.c), so the line is level-triggered as
+ * on hardware: kelvin_irq_asserted() says whether the title's ISR should run
+ * now, and kelvin_irq_event() is signalled whenever the line may have gone
+ * up, so the interrupt thread need not wait out its tick. */
+int kelvin_irq_asserted(void);
+void *kelvin_irq_event(void);
+
+/* The display's vertical blank: sets PCRTC_INTR_0's VBLANK bit through the
+ * register model. */
+void kelvin_vblank(void);
+
+/* Whether the register at this aperture offset belongs to the register model
+ * while the engine runs -- host code must not treat it as plain memory. */
+int kelvin_owns_register(unsigned int offset);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/src/nv2a/kelvin/kelvin_enums.h b/src/nv2a/kelvin/kelvin_enums.h
new file mode 100644
index 0000000..bb5c93b
--- /dev/null
+++ b/src/nv2a/kelvin/kelvin_enums.h
@@ -0,0 +1,86 @@
+/*
+ * Kelvin: hardware encodings the vertex stage and primitive assembly decode.
+ *
+ * Field values of NV_PGRAPH_CSV0_C/CSV0_D/CSV1 (lights, texgen, fog, skinning,
+ * material colour sources) and NV097_SET_BEGIN_END. These are register
+ * encodings -- facts about the NV2A -- written out here for this engine; the
+ * names follow the conventions used across NV2A emulators so the code reads
+ * against their documentation.
+ */
+#ifndef XBOX_NV2A_KELVIN_ENUMS_H
+#define XBOX_NV2A_KELVIN_ENUMS_H
+
+/* Light type, two bits per light in NV_PGRAPH_CSV0_D. */
+enum {
+    LIGHT_OFF = 0,
+    LIGHT_INFINITE = 1,
+    LIGHT_LOCAL = 2,
+    LIGHT_SPOT = 3,
+};
+
+/* Texture coordinate generation, per coordinate in NV_PGRAPH_CSV1_A/B. */
+enum {
+    TEXGEN_DISABLE = 0,
+    TEXGEN_EYE_LINEAR = 1,
+    TEXGEN_OBJECT_LINEAR = 2,
+    TEXGEN_SPHERE_MAP = 3,
+    TEXGEN_NORMAL_MAP = 4,
+    TEXGEN_REFLECTION_MAP = 5,
+};
+
+/* NV_PGRAPH_CONTROL_3_FOG_MODE. 2 and 6 are not valid encodings. */
+enum {
+    FOG_MODE_LINEAR = 0,
+    FOG_MODE_EXP = 1,
+    FOG_MODE_EXP2 = 3,
+    FOG_MODE_LINEAR_ABS = 4,
+    FOG_MODE_EXP_ABS = 5,
+    FOG_MODE_EXP2_ABS = 7,
+};
+
+/* NV_PGRAPH_CSV0_D_FOGGENMODE: where the fog coordinate comes from. */
+enum {
+    FOGGEN_SPEC_ALPHA = 0,
+    FOGGEN_RADIAL = 1,
+    FOGGEN_PLANAR = 2,
+    FOGGEN_ABS_PLANAR = 3,
+    FOGGEN_FOG_X = 4,
+};
+
+/* NV_PGRAPH_CSV0_D_SKIN: vertex blending weights and matrices. */
+enum {
+    SKINNING_OFF = 0,
+    SKINNING_1WEIGHTS = 1,
+    SKINNING_2WEIGHTS2MATRICES = 2,
+    SKINNING_2WEIGHTS = 3,
+    SKINNING_3WEIGHTS3MATRICES = 4,
+    SKINNING_3WEIGHTS = 5,
+    SKINNING_4WEIGHTS4MATRICES = 6,
+};
+
+/* NV_PGRAPH_CSV0_C emission/ambient/diffuse/specular source. */
+enum {
+    MATERIAL_COLOR_SRC_MATERIAL = 0,
+    MATERIAL_COLOR_SRC_DIFFUSE = 1,
+    MATERIAL_COLOR_SRC_SPECULAR = 2,
+};
+
+/* NV097_SET_BEGIN_END operations; 0 ends a primitive. */
+enum {
+    PRIM_TYPE_INVALID = 0,
+    PRIM_TYPE_POINTS = 1,
+    PRIM_TYPE_LINES = 2,
+    PRIM_TYPE_LINE_LOOP = 3,
+    PRIM_TYPE_LINE_STRIP = 4,
+    PRIM_TYPE_TRIANGLES = 5,
+    PRIM_TYPE_TRIANGLE_STRIP = 6,
+    PRIM_TYPE_TRIANGLE_FAN = 7,
+    PRIM_TYPE_QUADS = 8,
+    PRIM_TYPE_QUAD_STRIP = 9,
+    PRIM_TYPE_POLYGON = 10,
+};
+
+/* A transform program instruction is four 32-bit words. */
+#define VSH_TOKEN_SIZE 4
+
+#endif
diff --git a/src/nv2a/kelvin/kelvin_gpu.c b/src/nv2a/kelvin/kelvin_gpu.c
new file mode 100644
index 0000000..d7ceca6
--- /dev/null
+++ b/src/nv2a/kelvin/kelvin_gpu.c
@@ -0,0 +1,2214 @@
+/*
+ * Kelvin D3D11 backend. See kelvin_gpu.h.
+ *
+ * Pixel semantics follow kelvin_pixel.c (the CPU reference); the shader that
+ * evaluates them is kelvin_gpu_hlsl.inc.
+ */
+#define COBJMACROS
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <d3d11_4.h>
+#include <dxgi1_4.h>
+#include <d3dcompiler.h>
+#include <intrin.h>
+#include <nmmintrin.h>
+#include <tlhelp32.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdarg.h>
+#include <math.h>
+
+#include "kelvin_gpu.h"
+#include "kelvin_int.h"
+#include "../../video/fb_present.h"
+#include "../../video/pc_video.h"
+
+#include "kelvin_gpu_hlsl.inc"
+
+/* ---- constant buffer layouts (mirror the HLSL) ------------------------------- */
+
+typedef struct PSStage {
+    uint32_t rgb_in[4], alpha_in[4], outs[4];
+    float c0[4], c1[4];
+} PSStage;
+
+typedef struct PSConst {
+    PSStage stage[8];
+    uint32_t fin_abcd[4];
+    uint32_t fin_efg[4];
+    float final_c0[4], final_c1[4];
+    float fogcolor[4];
+    uint32_t gen[4];
+    uint32_t texmode[4];
+    uint32_t texflags[4];
+    float texrcp[4][4];
+    uint32_t ckey[4];
+    uint32_t ckeymask[4];
+    uint32_t ofs[4];
+} PSConst;
+
+typedef struct VSG {
+    float scale[4];
+    float fog[4];
+    uint32_t flags[4];
+    float vm[4];                 /* x: viewmodel scale about the viewport centre (1 for none) */
+} VSG;
+
+static volatile uint32_t s_vm_hash[8];
+static volatile int s_vm_count;
+static volatile float s_vm_scale = 1.0f;
+
+/* The camera hook runs on the title thread while the GPU consumes the pair.
+ * Publish both frustum dimensions together, including when aim/FOV changes. */
+static volatile LONG64 s_ao_camera;
+static uint64_t s_ao_draw_camera; /* GPU-owned camera snapshot of the draw currently being consumed */
+
+void kgpu_set_ao_camera(float half_x, float half_y)
+{
+    union { float half[2]; LONG64 bits; } camera;
+    if (!(half_x > 0.001f && half_x < 100.0f && half_y > 0.001f && half_y < 100.0f)) {
+        InterlockedExchange64(&s_ao_camera, 0);
+        return;
+    }
+    camera.half[0] = half_x; camera.half[1] = half_y;
+    InterlockedExchange64(&s_ao_camera, camera.bits);
+}
+
+static uint64_t kg_ao_camera_bits(void)
+{
+    return (uint64_t)InterlockedCompareExchange64(&s_ao_camera, 0, 0);
+}
+
+static bool kg_ao_camera(uint64_t bits, float *half_x, float *half_y)
+{
+    union { float half[2]; LONG64 bits; } camera;
+    camera.bits = (LONG64)bits;
+    if (!camera.bits) return false;
+    *half_x = camera.half[0]; *half_y = camera.half[1];
+    return true;
+}
+
+void kgpu_set_viewmodel(const uint32_t *vs_hashes, int count, float scale)
+{
+    int i;
+    if (count > 8) count = 8;
+    s_vm_count = 0;
+    for (i = 0; i < count; i++) s_vm_hash[i] = vs_hashes[i];
+    s_vm_scale = scale;
+    s_vm_count = count < 0 ? 0 : count;
+}
+
+static float kg_viewmodel_scale(uint32_t vs_hash)
+{
+    int i, n = s_vm_count;
+    for (i = 0; i < n; i++) if (s_vm_hash[i] == vs_hash) return s_vm_scale;
+    return 1.0f;
+}
+
+typedef struct VSConst {
+    float scale[4];
+    uint32_t rec0[4], rec1[4], rec2[4];
+    float misc[4];
+} VSConst;
+
+/* ---- state ----------------------------------------------------------------------- */
+
+#define KG_MAX_SURF 32
+#define KG_TEX_SLOTS 4096
+#define KG_STAGING 3
+
+typedef struct KGpuSurf {
+    bool used, depth, swz;
+    uint32_t va, pitch, format;
+    unsigned int gw, gh, hw, hh, bpp;
+    DXGI_FORMAT dxfmt;
+    ID3D11Texture2D *tex;
+    ID3D11RenderTargetView *rtv;
+    ID3D11DepthStencilView *dsv;
+    ID3D11ShaderResourceView *srv;
+    uint64_t clock;
+    /* Games reuse surface memory as another kind of surface (BLACK's glare pass reads the
+     * depth buffer as an ARGB texture and uses a colour target as a depth buffer). `ver`
+     * counts the writes; conv_* is the depth buffer read back as packed Z24S8 words, and a
+     * depth surface that was made from a colour surface remembers which write it holds. */
+    uint64_t ver;
+    ID3D11Texture2D *conv_tex;
+    ID3D11RenderTargetView *conv_rtv;
+    ID3D11ShaderResourceView *conv_srv;
+    uint64_t conv_ver;
+    bool from_color, real;        /* real: cleared or drawn to as a depth buffer */
+    uint64_t src_ver;
+    /* Which of two surfaces over the same memory was written last (s_wseq at the write): the one written later
+     * holds what the memory holds. */
+    uint64_t wseq;
+} KGpuSurf;
+
+typedef struct KGpuTex {
+    bool used;
+    uint32_t base, fmt, w, h, pitch, levels, palette, palette_len;
+    uint32_t span;
+    uint64_t sig[2];
+    uint64_t epoch, clock;
+    size_t bytes;
+    ID3D11Texture2D *tex;
+    ID3D11ShaderResourceView *srv;
+} KGpuTex;
+
+typedef struct KeyedPtr { uint64_t key; void *ptr; } KeyedPtr;
+
+static struct {
+    int tried, ok;
+    ID3D11Device *dev;
+    ID3D11DeviceContext *ctx;
+    ID3D11DeviceContext1 *ctx1;
+    HMODULE compiler;
+    HRESULT (WINAPI *compile)(LPCVOID, SIZE_T, LPCSTR, const D3D_SHADER_MACRO *,
+                              ID3DInclude *, LPCSTR, LPCSTR, UINT, UINT,
+                              ID3DBlob **, ID3DBlob **);
+    ID3D11VertexShader *vs;
+    ID3D11PixelShader *ps, *ps_flat;
+    ID3D11VertexShader *clear_vs;
+    ID3D11PixelShader *clear_ps, *clear_depth_ps, *d2c_ps, *c2d_ps;
+    ID3D11BlendState *bs_none;
+    ID3D11DepthStencilState *ds_none, *ds_always;
+    ID3D11RasterizerState *rs_none;
+    ID3D11Buffer *cb_ps, *cb_vs, *cb_clear, *vb, *ib;
+    ID3D11Buffer *arena, *cb_gvs, *cb_c, *cb_a;
+    ID3D11ShaderResourceView *arena_srv;
+    size_t arena_cap, arena_pos;           /* in float4s */
+    ID3D11ShaderResourceView *vb_srv;
+    size_t vb_cap, vb_pos, ib_cap, ib_pos;     /* in float4s / indices */
+    ID3D11ShaderResourceView *dummy_srv;
+    ID3D11Texture2D *dummy_tex;
+    ID3D11SamplerState *default_smp;
+    KGpuSurf surf[KG_MAX_SURF];
+    KGpuTex *tex;
+    size_t tex_bytes;
+    KeyedPtr blend[256], depth[256], raster[128], sampler[256];
+    int nblend, ndepth, nraster, nsampler;
+    ID3D11Texture2D *fb_copy;
+    unsigned int fb_w, fb_h;
+    DXGI_FORMAT fb_fmt;
+    ID3D11Texture2D *stage[KG_STAGING];
+    uint64_t stage_frame[KG_STAGING];
+    uint32_t stage_va[KG_STAGING];
+    unsigned int stage_aspect_w[KG_STAGING], stage_aspect_h[KG_STAGING];
+    unsigned int stage_w, stage_h;
+    uint64_t epoch, clock, frames;
+    const char *dump;
+    unsigned int dump_every;
+    long long qpf;
+    unsigned int host_w, host_h;               /* the raster size of the full-screen targets */
+    unsigned int out_w, out_h;                 /* the size presented: the raster, or half of it under super-sampling */
+    /* counters */
+    uint64_t gvs_draws, draws, tris, tex_uploads, tex_hits, tex_validations, vb_bytes, skipped;
+} G;
+
+long long g_kgpu_ticks[KGP_COUNT];
+static long long s_flip_prev_qpc;
+static unsigned int s_hist[6];            /* flip intervals: <=18, <=20, <=25, <=34, <=70, longer (ms) */
+static unsigned int s_fine[40];           /* the same in bins of half a millisecond, up to 20 ms */
+static double s_hist_max_ms;
+static volatile LONG64 s_flip_count;      /* flips so far and the qpc of each, for the slow-flip sampler */
+static volatile long long s_flip_q[1024];
+void kgpu_profile_maybe_start(void);
+static int s_enabled = -1;
+
+static long long qpc_now(void)
+{
+    LARGE_INTEGER t;
+    QueryPerformanceCounter(&t);
+    return t.QuadPart;
+}
+/* The per-stage CPU times of the periodic report cost eight clock reads per draw; they are on only with
+ * RECOMP_KGPU_TIMES=1. */
+static int s_times = -1;
+static long long kg_tick(void)
+{
+    if (s_times < 0) { const char *e = getenv("RECOMP_KGPU_TIMES"); s_times = e && *e && *e != '0'; }
+    return s_times ? qpc_now() : 0;
+}
+#define PROF(which, stmt) do { long long p0_ = kg_tick(); stmt; g_kgpu_ticks[which] += kg_tick() - p0_; } while (0)
+
+
+bool kgpu_enabled(void)
+{
+    if (s_enabled < 0) {
+        const char *e = getenv("RECOMP_KELVIN_GPU");
+        s_enabled = e && *e && *e != '0';
+    }
+    return s_enabled != 0;
+}
+
+bool kgpu_active(void)
+{
+    return G.ok != 0;
+}
+
+/* Texture contents are revalidated once per kick. With asynchronous submission the kick counter travels with each
+ * draw (kelvin_gpu_async.inc) and the submitting thread sets G.epoch from it. */
+static uint64_t s_kick_epoch;
+static uint64_t s_surf_gen;              /* bumped when a surface is created or freed */
+static void kg_bound_reset(void);        /* the draw path's record of the context's bindings is stale */
+static void kg_cache_invalidate(void);   /* ... and so is what it derived from surfaces, states and textures */
+static void kg_post_poll(void);          /* the picture settings (kelvin_gpu_post.inc) */
+static void kgq_start(void);
+static bool kgq_enabled(void);
+static void kgq_report(void);
+/* Hand a finished frame to the presenter: at once, or at the time the flip was queued with (kelvin_gpu_async.inc). */
+static void kgq_publish_frame(unsigned slot, uint64_t value, uint32_t va, uint32_t aspect_w, uint32_t aspect_h);
+
+void kgpu_note_kick(void)
+{
+    s_kick_epoch++;
+    if (!kgq_enabled()) G.epoch++;
+}
+
+void kgpu_host_size(unsigned int *w, unsigned int *h)
+{
+    *w = G.host_w;
+    *h = G.host_h;
+}
+
+#include "kelvin_gpu_time.inc"
+#include "kelvin_gpu_prof.inc"
+
+#define SAFE_RELEASE(p) do { if (p) { IUnknown_Release((IUnknown *)(p)); (p) = NULL; } } while (0)
+#define HR_CHECK(expr, what) do { HRESULT hr_ = (expr); if (FAILED(hr_)) { \
+    fprintf(stderr, "[KGPU] %s failed: 0x%08lX\n", what, (unsigned long)hr_); return false; } } while (0)
+
+/* ---- hashing -------------------------------------------------------------------- */
+
+static void sig_bytes(const uint8_t *p, size_t n, uint64_t out[2])
+{
+    uint64_t a = 0x9E3779B97F4A7C15ull, b = 0xC2B2AE3D27D4EB4Full, c = 0x165667B19E3779F9ull;
+    size_t i = 0;
+    for (; i + 24 <= n; i += 24) {
+        uint64_t x, y, z;
+        memcpy(&x, p + i, 8); memcpy(&y, p + i + 8, 8); memcpy(&z, p + i + 16, 8);
+        a = _mm_crc32_u64(a, x);
+        b = _mm_crc32_u64(b, y);
+        c = _mm_crc32_u64(c, z);
+    }
+    for (; i < n; i++) {
+        a = _mm_crc32_u8((unsigned int)a, p[i]);
+    }
+    out[0] = (a & 0xFFFFFFFFull) | (b << 32);
+    out[1] = (c & 0xFFFFFFFFull) | ((uint64_t)n << 32);
+}
+
+/* ---- device ---------------------------------------------------------------------- */
+
+static ID3DBlob *compile_hlsl(const char *a, const char *b, const char *entry,
+                              const char *target)
+{
+    size_t la = strlen(a), lb = strlen(b);
+    char *src = (char *)malloc(la + lb + 1);
+    ID3DBlob *code = NULL, *errors = NULL;
+    HRESULT hr;
+    if (!src) return NULL;
+    memcpy(src, a, la);
+    memcpy(src + la, b, lb + 1);
+    hr = G.compile(src, la + lb, "kelvin_gpu", NULL, NULL, entry, target,
+                   D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &code, &errors);
+    if (FAILED(hr)) {
+        fprintf(stderr, "[KGPU] HLSL %s failed 0x%08lX:\n%s\n", entry, (unsigned long)hr,
+                errors ? (const char *)ID3D10Blob_GetBufferPointer(errors) : "(no log)");
+        code = NULL;
+    } else if (errors && getenv("RECOMP_KGPU_SHADER_LOG")) {
+        fprintf(stderr, "[KGPU] HLSL %s warnings:\n%s\n", entry,
+                (const char *)ID3D10Blob_GetBufferPointer(errors));
+    }
+    if (errors) ID3D10Blob_Release(errors);
+    free(src);
+    return code;
+}
+
+/* The ubershader with flat shading (colours from a triangle's first vertex), for draws whose specialised shader is not ready. */
+static ID3DBlob *compile_flat_ps(void)
+{
+    static const char def[] = "#define KG_FLAT 1\n";
+    size_t ld = sizeof(def) - 1, lc = strlen(kgpu_hlsl_common), lp = strlen(kgpu_hlsl_ps);
+    char *src = (char *)malloc(ld + lc + lp + 1);
+    ID3DBlob *code = NULL, *errors = NULL;
+    HRESULT hr;
+    if (!src) return NULL;
+    memcpy(src, def, ld); memcpy(src + ld, kgpu_hlsl_common, lc); memcpy(src + ld + lc, kgpu_hlsl_ps, lp + 1);
+    hr = G.compile(src, ld + lc + lp, "kgpu_flat", NULL, NULL, "ps_main", "ps_5_0", D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &code, &errors);
+    if (FAILED(hr)) {
+        fprintf(stderr, "[KGPU] flat-shading pixel shader failed 0x%08lX: %s\n", (unsigned long)hr,
+                errors ? (const char *)ID3D10Blob_GetBufferPointer(errors) : "(no log)");
+        code = NULL;
+    }
+    if (errors) ID3D10Blob_Release(errors);
+    free(src);
+    return code;
+}
+
+static bool make_buffer(UINT bytes, UINT bind, ID3D11Buffer **out)
+{
+    D3D11_BUFFER_DESC d;
+    memset(&d, 0, sizeof(d));
+    d.ByteWidth = bytes;
+    d.Usage = D3D11_USAGE_DYNAMIC;
+    d.BindFlags = bind;
+    d.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+    HR_CHECK(ID3D11Device_CreateBuffer(G.dev, &d, NULL, out), "CreateBuffer");
+    return true;
+}
+
+/* d2c_ps: above 2^23 a float holds whole numbers only, so adding 0.5 rounds to even: it moved odd depths up by one and
+ * turned the far plane (1.0 -> 16777215.5) into 2^24, which packs as zero. */
+static const char kgpu_hlsl_clear[] =
+"cbuffer ClearCB : register(b0) { float4 color; float depth; float3 pad; };\n"
+"float4 clear_vs(uint i : SV_VertexID) : SV_Position {\n"
+"    float2 uv = float2((i << 1) & 2, i & 2);\n"
+"    return float4(uv.x * 2 - 1, 1 - uv.y * 2, 0, 1);\n"
+"}\n"
+"float4 clear_ps(float4 p : SV_Position) : SV_Target { return color; }\n"
+"float clear_depth_ps(float4 p : SV_Position) : SV_Depth { return depth; }\n"
+"Texture2D<float> DepthTex : register(t0);\n"
+"Texture2D<float4> ColorTex : register(t0);\n"
+"float4 d2c_ps(float4 p : SV_Position) : SV_Target {\n"
+"    float s = saturate(DepthTex.Load(int3((int2)p.xy, 0))) * 16777215.0;\n"
+"    uint z = s >= 8388608.0 ? (uint)s : (uint)(s + 0.5);\n"
+"    return float4((float)((z >> 8) & 255u) / 255.0, (float)(z & 255u) / 255.0, 0.0, (float)((z >> 16) & 255u) / 255.0);\n"
+"}\n"
+"float c2d_ps(float4 p : SV_Position) : SV_Depth {\n"
+"    float4 c = ColorTex.Load(int3((int2)p.xy, 0));\n"
+"    uint z = ((uint)(c.a * 255.0 + 0.5) << 16) | ((uint)(c.r * 255.0 + 0.5) << 8) | (uint)(c.g * 255.0 + 0.5);\n"
+"    return (float)z / 16777215.0;\n"
+"}\n";
+
+/* The Video Settings page asks for another raster size: it is applied between two frames, on the thread that
+ * owns the surfaces (kg_apply_pending_size, at the end of a flip), so no draw ever straddles it. */
+static volatile LONG64 s_pending_size;      /* raster width, raster height, output width, output height: 16 bits each */
+static void kgpu_request_host_size(unsigned int w, unsigned int h, unsigned int ow, unsigned int oh)
+{
+    if (w < 640 || h < 480 || w > 8192 || h > 8192 || (uint64_t)w * h > 16777216u || ow < 640 || oh < 480 || ow > w || oh > h) return;
+    InterlockedExchange64(&s_pending_size, ((LONG64)w << 48) | ((LONG64)h << 32) | ((LONG64)ow << 16) | (LONG64)oh);
+}
+
+bool kgpu_init(void)
+{
+    IDXGIFactory1 *factory = NULL;
+    IDXGIAdapter1 *adapter = NULL, *best = NULL;
+    SIZE_T best_mem = 0;
+    LUID best_luid = { 0, 0 };
+    UINT i, flags = D3D11_CREATE_DEVICE_BGRA_SUPPORT;
+    D3D_FEATURE_LEVEL levels[2] = { D3D_FEATURE_LEVEL_11_1, D3D_FEATURE_LEVEL_11_0 };
+    D3D_FEATURE_LEVEL got;
+    ID3DBlob *vsb = NULL, *psb = NULL, *psfb = NULL, *cvs = NULL, *cps = NULL, *cdps = NULL;
+    D3D11_SHADER_RESOURCE_VIEW_DESC srvd;
+    LARGE_INTEGER f;
+    HRESULT hr;
+
+    if (G.tried) return G.ok != 0;
+    G.tried = 1;
+    if (!kgpu_enabled()) return false;
+    QueryPerformanceFrequency(&f);
+    G.qpf = f.QuadPart;
+    {
+        /* The raster size is the player's internal resolution (pc_video.c): RECOMP_RENDER_WIDTH/HEIGHT still
+         * override it, and the Video Settings page changes it while the game runs (kgpu_request_host_size). */
+        unsigned int rw, rh, ow, oh;
+        pc_video_raster_size(&rw, &rh);
+        pc_video_render_size(&ow, &oh);
+        G.host_w = rw; G.host_h = rh;
+        G.out_w = ow < rw ? ow : rw; G.out_h = oh < rh ? oh : rh;
+    }
+    if (G.host_w < 640 || G.host_h < 480 || G.host_w > 8192 || G.host_h > 8192) {
+        G.host_w = 640; G.host_h = 480;
+    }
+    if (G.out_w < 640 || G.out_h < 480) { G.out_w = G.host_w; G.out_h = G.host_h; }
+    G.dump = getenv("RECOMP_KELVIN_DUMP");
+    {
+        const char *e = getenv("RECOMP_KELVIN_EVERY");
+        G.dump_every = e ? (unsigned int)strtoul(e, NULL, 0) : 1;
+        if (!G.dump_every) G.dump_every = 1;
+    }
+
+    G.compiler = LoadLibraryA("d3dcompiler_47.dll");
+    if (G.compiler) *(FARPROC *)&G.compile = GetProcAddress(G.compiler, "D3DCompile");
+    if (!G.compile) { fprintf(stderr, "[KGPU] d3dcompiler_47.dll unavailable\n"); return false; }
+
+    hr = CreateDXGIFactory1(&IID_IDXGIFactory1, (void **)&factory);
+    if (FAILED(hr)) { fprintf(stderr, "[KGPU] DXGI factory failed 0x%08lX\n", (unsigned long)hr); return false; }
+    for (i = 0; IDXGIFactory1_EnumAdapters1(factory, i, &adapter) != DXGI_ERROR_NOT_FOUND; i++) {
+        DXGI_ADAPTER_DESC1 d;
+        IDXGIAdapter1_GetDesc1(adapter, &d);
+        if (!(d.Flags & DXGI_ADAPTER_FLAG_SOFTWARE) && d.DedicatedVideoMemory > best_mem) {
+            if (best) IDXGIAdapter1_Release(best);
+            best = adapter; best_mem = d.DedicatedVideoMemory; best_luid = d.AdapterLuid;
+            fprintf(stderr, "[KGPU] adapter %u: %ls, %zu MiB\n", i, d.Description,
+                    (size_t)(d.DedicatedVideoMemory >> 20));
+        } else {
+            IDXGIAdapter1_Release(adapter);
+        }
+    }
+    IDXGIFactory1_Release(factory);
+    if (!best) { fprintf(stderr, "[KGPU] no hardware adapter\n"); return false; }
+    xbox_FramebufferGpuAdapter((uint32_t)best_luid.LowPart, (int32_t)best_luid.HighPart);
+    if (getenv("RECOMP_KGPU_DEBUG")) flags |= D3D11_CREATE_DEVICE_DEBUG;
+    hr = D3D11CreateDevice((IDXGIAdapter *)best, D3D_DRIVER_TYPE_UNKNOWN, NULL, flags,
+                           levels, 2, D3D11_SDK_VERSION, &G.dev, &got, &G.ctx);
+    if (FAILED(hr) && (flags & D3D11_CREATE_DEVICE_DEBUG)) {
+        flags &= ~D3D11_CREATE_DEVICE_DEBUG;
+        hr = D3D11CreateDevice((IDXGIAdapter *)best, D3D_DRIVER_TYPE_UNKNOWN, NULL, flags,
+                               levels, 2, D3D11_SDK_VERSION, &G.dev, &got, &G.ctx);
+    }
+    IDXGIAdapter1_Release(best);
+    if (FAILED(hr)) { fprintf(stderr, "[KGPU] D3D11CreateDevice failed 0x%08lX\n", (unsigned long)hr); return false; }
+    ID3D11DeviceContext_QueryInterface(G.ctx, &IID_ID3D11DeviceContext1, (void **)&G.ctx1);
+
+    vsb = compile_hlsl(kgpu_hlsl_common, kgpu_hlsl_vs, "vs_main", "vs_5_0");
+    psb = compile_hlsl(kgpu_hlsl_common, kgpu_hlsl_ps, "ps_main", "ps_5_0");
+    psfb = compile_flat_ps();
+    cvs = compile_hlsl("", kgpu_hlsl_clear, "clear_vs", "vs_5_0");
+    cps = compile_hlsl("", kgpu_hlsl_clear, "clear_ps", "ps_5_0");
+    cdps = compile_hlsl("", kgpu_hlsl_clear, "clear_depth_ps", "ps_5_0");
+    if (!vsb || !psb || !cvs || !cps || !cdps) return false;
+    HR_CHECK(ID3D11Device_CreateVertexShader(G.dev, ID3D10Blob_GetBufferPointer(vsb),
+             ID3D10Blob_GetBufferSize(vsb), NULL, &G.vs), "CreateVertexShader");
+    HR_CHECK(ID3D11Device_CreatePixelShader(G.dev, ID3D10Blob_GetBufferPointer(psb),
+             ID3D10Blob_GetBufferSize(psb), NULL, &G.ps), "CreatePixelShader");
+    if (psfb) ID3D11Device_CreatePixelShader(G.dev, ID3D10Blob_GetBufferPointer(psfb), ID3D10Blob_GetBufferSize(psfb), NULL, &G.ps_flat);
+    HR_CHECK(ID3D11Device_CreateVertexShader(G.dev, ID3D10Blob_GetBufferPointer(cvs),
+             ID3D10Blob_GetBufferSize(cvs), NULL, &G.clear_vs), "CreateVertexShader(clear)");
+    HR_CHECK(ID3D11Device_CreatePixelShader(G.dev, ID3D10Blob_GetBufferPointer(cps),
+             ID3D10Blob_GetBufferSize(cps), NULL, &G.clear_ps), "CreatePixelShader(clear)");
+    HR_CHECK(ID3D11Device_CreatePixelShader(G.dev, ID3D10Blob_GetBufferPointer(cdps),
+             ID3D10Blob_GetBufferSize(cdps), NULL, &G.clear_depth_ps), "CreatePixelShader(clear depth)");
+    ID3D10Blob_Release(vsb); ID3D10Blob_Release(psb);
+    ID3D10Blob_Release(cvs); ID3D10Blob_Release(cps); ID3D10Blob_Release(cdps);
+    {
+        ID3DBlob *d2c = compile_hlsl("", kgpu_hlsl_clear, "d2c_ps", "ps_5_0");
+        ID3DBlob *c2d = compile_hlsl("", kgpu_hlsl_clear, "c2d_ps", "ps_5_0");
+        D3D11_BLEND_DESC bd;
+        D3D11_DEPTH_STENCIL_DESC dd;
+        D3D11_RASTERIZER_DESC rd;
+        if (!d2c || !c2d) return false;
+        HR_CHECK(ID3D11Device_CreatePixelShader(G.dev, ID3D10Blob_GetBufferPointer(d2c),
+                 ID3D10Blob_GetBufferSize(d2c), NULL, &G.d2c_ps), "CreatePixelShader(d2c)");
+        HR_CHECK(ID3D11Device_CreatePixelShader(G.dev, ID3D10Blob_GetBufferPointer(c2d),
+                 ID3D10Blob_GetBufferSize(c2d), NULL, &G.c2d_ps), "CreatePixelShader(c2d)");
+        ID3D10Blob_Release(d2c); ID3D10Blob_Release(c2d);
+        memset(&bd, 0, sizeof(bd));
+        bd.RenderTarget[0].RenderTargetWriteMask = D3D11_COLOR_WRITE_ENABLE_ALL;
+        memset(&dd, 0, sizeof(dd));
+        memset(&rd, 0, sizeof(rd));
+        rd.FillMode = D3D11_FILL_SOLID; rd.CullMode = D3D11_CULL_NONE; rd.DepthClipEnable = FALSE;
+        HR_CHECK(ID3D11Device_CreateBlendState(G.dev, &bd, &G.bs_none), "CreateBlendState(none)");
+        HR_CHECK(ID3D11Device_CreateDepthStencilState(G.dev, &dd, &G.ds_none), "CreateDepthStencilState(none)");
+        dd.DepthEnable = TRUE; dd.DepthWriteMask = D3D11_DEPTH_WRITE_MASK_ALL; dd.DepthFunc = D3D11_COMPARISON_ALWAYS;
+        HR_CHECK(ID3D11Device_CreateDepthStencilState(G.dev, &dd, &G.ds_always), "CreateDepthStencilState(always)");
+        HR_CHECK(ID3D11Device_CreateRasterizerState(G.dev, &rd, &G.rs_none), "CreateRasterizerState(none)");
+    }
+
+    if (!make_buffer(sizeof(PSConst), D3D11_BIND_CONSTANT_BUFFER, &G.cb_ps) ||
+        !make_buffer(sizeof(VSConst), D3D11_BIND_CONSTANT_BUFFER, &G.cb_vs) ||
+        !make_buffer(32, D3D11_BIND_CONSTANT_BUFFER, &G.cb_clear)) return false;
+    G.vb_cap = (size_t)4 * 1024 * 1024;           /* float4s: 64 MiB */
+    G.ib_cap = (size_t)4 * 1024 * 1024;           /* indices: 16 MiB */
+    if (!make_buffer((UINT)(G.vb_cap * 16), D3D11_BIND_SHADER_RESOURCE, &G.vb) ||
+        !make_buffer((UINT)(G.ib_cap * 4), D3D11_BIND_INDEX_BUFFER, &G.ib)) return false;
+    G.arena_cap = (size_t)4 * 1024 * 1024;        /* float4s: 64 MiB of raw vertex data */
+    if (!make_buffer((UINT)(G.arena_cap * 16), D3D11_BIND_SHADER_RESOURCE, &G.arena) ||
+        !make_buffer(64, D3D11_BIND_CONSTANT_BUFFER, &G.cb_gvs) ||
+        !make_buffer(192 * 16, D3D11_BIND_CONSTANT_BUFFER, &G.cb_c) ||
+        !make_buffer(32 * 16, D3D11_BIND_CONSTANT_BUFFER, &G.cb_a)) return false;
+    {
+        D3D11_SHADER_RESOURCE_VIEW_DESC ad;
+        memset(&ad, 0, sizeof(ad));
+        ad.Format = DXGI_FORMAT_R32_UINT;
+        ad.ViewDimension = D3D11_SRV_DIMENSION_BUFFER;
+        ad.Buffer.FirstElement = 0;
+        ad.Buffer.NumElements = (UINT)(G.arena_cap * 4);
+        HR_CHECK(ID3D11Device_CreateShaderResourceView(G.dev, (ID3D11Resource *)G.arena, &ad, &G.arena_srv),
+                 "CreateShaderResourceView(arena)");
+    }
+    memset(&srvd, 0, sizeof(srvd));
+    srvd.Format = DXGI_FORMAT_R32G32B32A32_FLOAT;
+    srvd.ViewDimension = D3D11_SRV_DIMENSION_BUFFER;
+    srvd.Buffer.FirstElement = 0;
+    srvd.Buffer.NumElements = (UINT)G.vb_cap;
+    HR_CHECK(ID3D11Device_CreateShaderResourceView(G.dev, (ID3D11Resource *)G.vb, &srvd, &G.vb_srv),
+             "CreateShaderResourceView(vb)");
+    {
+        D3D11_TEXTURE2D_DESC td;
+        uint32_t px = 0xFFFFFFFFu;
+        D3D11_SUBRESOURCE_DATA init;
+        memset(&td, 0, sizeof(td));
+        td.Width = td.Height = 1; td.MipLevels = td.ArraySize = 1;
+        td.Format = DXGI_FORMAT_R8G8B8A8_UNORM; td.SampleDesc.Count = 1;
+        td.Usage = D3D11_USAGE_IMMUTABLE; td.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+        init.pSysMem = &px; init.SysMemPitch = 4; init.SysMemSlicePitch = 0;
+        HR_CHECK(ID3D11Device_CreateTexture2D(G.dev, &td, &init, &G.dummy_tex), "CreateTexture2D(dummy)");
+        HR_CHECK(ID3D11Device_CreateShaderResourceView(G.dev, (ID3D11Resource *)G.dummy_tex, NULL,
+                 &G.dummy_srv), "CreateShaderResourceView(dummy)");
+    }
+    G.tex = (KGpuTex *)calloc(KG_TEX_SLOTS, sizeof(KGpuTex));
+    if (!G.tex) return false;
+    {
+        D3D11_SAMPLER_DESC sd;
+        memset(&sd, 0, sizeof(sd));
+        sd.Filter = D3D11_FILTER_MIN_MAG_MIP_LINEAR;
+        sd.AddressU = sd.AddressV = sd.AddressW = D3D11_TEXTURE_ADDRESS_CLAMP;
+        sd.MaxAnisotropy = 1; sd.ComparisonFunc = D3D11_COMPARISON_NEVER; sd.MaxLOD = D3D11_FLOAT32_MAX;
+        HR_CHECK(ID3D11Device_CreateSamplerState(G.dev, &sd, &G.default_smp), "CreateSamplerState(default)");
+    }
+    G.ok = 1;
+    kg_post_poll();
+    pc_video_set_resize_hook(kgpu_request_host_size);
+    kgq_start();
+    kgpu_profile_maybe_start();
+    fprintf(stderr, "[KGPU] D3D11 feature level 0x%X; host raster %ux%u, presented at %ux%u\n", (unsigned)got,
+            G.host_w, G.host_h, G.out_w, G.out_h);
+    return true;
+}
