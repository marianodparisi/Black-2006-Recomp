+
+static void pad_script_load(void)
+{
+    const char *e = getenv("RECOMP_PAD_SCRIPT");
+
+    s_script_n = 0;
+    while (e && *e && s_script_n < PAD_SCRIPT_MAX) {
+        PadPress *p = &s_script[s_script_n];
+        char *end;
+        const char *q;
