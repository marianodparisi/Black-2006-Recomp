+    unsigned int log_height =
+        GET_MASK(parameter, NV097_SET_TEXTURE_FORMAT_BASE_SIZE_V);
+    unsigned int log_depth =
+        GET_MASK(parameter, NV097_SET_TEXTURE_FORMAT_BASE_SIZE_P);
