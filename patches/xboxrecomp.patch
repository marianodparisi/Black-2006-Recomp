+    "16 bit",        /* 0x1 */
+    "24 bit msb",    /* 0x2 */
+    "32 bit",        /* 0x3 */
+    "<invalid-0x4>", /* 0x4 */
+    "<invalid-0x5>", /* 0x5 */
+    "24 bit lsb",    /* 0x6 */
+    "<invalid-0x7>"  /* 0x7 */
+};
+
+const char *space_names[] = {
+    "x", /* DSP_SPACE_X, 0x0 */
+    "y", /* DSP_SPACE_Y, 0x1 */
